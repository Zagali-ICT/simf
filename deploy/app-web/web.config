<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site config for the SIMF Flutter web app (static hosting, D-376).
  Copied next to index.html by deploy/app-web/publish-app-web.ps1.

  - The app uses hash routing (/#/route), so NO URL-rewrite module is needed:
    every navigation hits index.html directly.
  - The mimeMap entries cover the Flutter build outputs IIS does not serve
    out of the box (.wasm CanvasKit, .json manifests, .bin asset bundles).
    Each is preceded by <remove> so the config also works on servers where
    the type is already registered globally (duplicate = 500.19).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".bin" />
      <mimeMap fileExtension=".bin" mimeType="application/octet-stream" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/otf" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
