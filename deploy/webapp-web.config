<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site config for the SIMF Flutter web app (static hosting, D-376).
  Copied next to index.html by deploy/app-web/publish-app-web.ps1.

  - The app uses hash routing (/#/route), so client navigation hits index.html
    directly (no SPA URL-rewrite needed).
  - The mimeMap entries cover the Flutter build outputs IIS does not serve
    out of the box (.wasm CanvasKit, .json manifests, .bin asset bundles).
    Each is preceded by <remove> so the config also works on servers where
    the type is already registered globally (duplicate = 500.19).
  - SAME-ORIGIN API PROXY (<rewrite>): /api/* is reverse-proxied to the API on
    https://localhost:12340, so the browser only ever talks to THIS origin and
    never validates the API's self-signed cert (no cert error, no CORS). The web
    app is built with its API base = this same origin (/api/v1).
    REQUIRES on the server: the IIS "URL Rewrite" + "Application Request Routing
    (ARR)" modules, with ARR proxy ENABLED (IIS Manager > server node > Application
    Request Routing Cache > Server Proxy Settings > Enable proxy).
    If ARR returns 502 validating the backend's self-signed cert (because the
    target host "localhost" does not match the cert CN "WIN-MAP9VAMAU4Q"), either
    trust that cert in the server's Local Machine > Trusted Root, or change the
    target below to https://WIN-MAP9VAMAU4Q:12340 (which matches the cert CN).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".bin" />
      <mimeMap fileExtension=".bin" mimeType="application/octet-stream" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/otf" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <!-- Reverse-proxy /api/* to the API on the same box (server-side hop),
             so the browser never sees the API's self-signed cert. -->
        <rule name="SIMF API same-origin proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="https://localhost:12340/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
