<Project>

  <!--
    Shared build settings for every SIMF project (SIMF-SES-001 section 4.3).
    Nullable, ImplicitUsings and TreatWarningsAsErrors are set here once;
    individual .csproj files do not redeclare them.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!--
      NCA Secure App-Dev Standard A6-13 / §1-13 — restore-time dependency
      auditing for every project. NuGetAudit raises a build warning (which
      TreatWarningsAsErrors turns into an error) for any direct OR transitive
      package with a known advisory. Pinned explicitly so the gate does not
      depend on the SDK default. The CI pipeline runs a second, explicit
      `dotnet list package` vulnerability scan as well.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

</Project>
