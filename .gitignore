# SIMF — .gitignore

# ── .NET build output ──────────────────────────────────────────────
[Bb]in/
[Oo]bj/
artifacts/
publish/
*.dll
*.exe
*.pdb

# ── Visual Studio / Rider ──────────────────────────────────────────
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# ── Flutter / Dart ─────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
*.iml
src/MobileApp/build/
Pods/
.gradle/
local.properties

# ── Secrets & environment ──────────────────────────────────────────
# Production config is applied via Machine-scope env vars (set-env-*.ps1);
# real secret values are NEVER committed. Only the placeholder template is.
appsettings.Production.json
appsettings.*.Local.json
*.env
.env
secrets.json
set-env-*.local.ps1

# ── Claude Code local settings ─────────────────────────────────────
.claude/settings.local.json

# ── Logs & temp ────────────────────────────────────────────────────
# Runtime log output only — root-anchored so source-tree `Logs/` folders
# (e.g. SIMF.Application/Logs, SIMF.Api/Endpoints/Admin/Logs) stay tracked.
*.log
/logs/
*.tmp

# ── UI-audit scratch (generated screenshots, run logs, helper scripts) ─
/.ui-audit/

# ── OS files ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
