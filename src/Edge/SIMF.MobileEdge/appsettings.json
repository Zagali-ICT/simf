{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "mobile-app-surface": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/app/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      }
    },
    "KnownProxies": []
  }
}
