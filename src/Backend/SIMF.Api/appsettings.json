{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/simf-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "SimfIdentityDb": "",
    "SimfAppDb": ""
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "FromAddress": "no-reply@simf.example",
    "FromName": "SIMF"
  },
  "SuperAdmin": {
    "Email": "superadmin@zagali-ict.com",
    "TempPassword": "",
    "TotpSecret": ""
  },
  "Jwt": {
    "Issuer": "SIMF",
    "Audience": "SIMF",
    "SigningKey": "",
    "AccessTokenMinutes": 5,
    "SessionLifetimeHours": 24,
    "StreamAudience": "simf-stream",
    "StreamTokenMinutes": 180
  },
  "DeviceKey": {
    "RequireStepUpForEnrol": true
  },
  "IdentityLifecycle": {
    "PasswordMaxAgeDays": 0,
    "PasswordHistoryCount": 0
  },
  "MediaImageStorage": {
    "RootPath": "App_Data/media"
  },
  "SpeakerPresentationStorage": {
    "RootPath": "App_Data/presentations"
  },
  "SessionRecordingStorage": {
    "RootPath": "App_Data/recordings",
    "MaxUploadBytes": 1073741824
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Cors": {
    "WebAppOrigins": []
  },
  "RateLimit": {
    "PermitLimit": 20,
    "WindowSeconds": 60
  },
  "Swagger": {
    "AllowSwagger": false,
    "Username": "",
    "Password": ""
  },
  "FaceDetection": {
    "Enabled": true,
    "MinConfidence": 0.5
  },
  "AllowedHosts": "*"
}
