{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/simf-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "SimfIdentityDb": "",
    "SimfAppDb": ""
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "FromAddress": "no-reply@simf.example",
    "FromName": "SIMF"
  },
  "SuperAdmin": {
    "Email": "superadmin@zagali-ict.com",
    "TempPassword": "",
    "TotpSecret": "",
    "PasswordChangeRequired": true
  },
  "Jwt": {
    "Issuer": "SIMF",
    "Audience": "SIMF",
    "SigningKey": "",
    "AccessTokenMinutes": 5,
    "SessionLifetimeHours": 24,
    "StreamAudience": "simf-stream",
    "StreamTokenMinutes": 180
  },
  "DeviceKey": {
    "RequireStepUpForEnrol": true
  },
  "IdentityLifecycle": {
    "PasswordMaxAgeDays": 0,
    "PasswordHistoryCount": 0,
    "DormantAccountDisableDays": 0
  },
  "UploadScanning": {
    "Enabled": true
  },
  "MediaImageStorage": {
    "RootPath": "App_Data/media"
  },
  "SpeakerPresentationStorage": {
    "RootPath": "App_Data/presentations"
  },
  "SessionRecordingStorage": {
    "RootPath": "App_Data/recordings",
    "MaxUploadBytes": 1073741824
  },
  "FileStorage": {
    "RootPath": "App_Data/files",
    "EncryptionKey": "",
    "KekVersion": 1
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Cors": {
    "WebAppOrigins": []
  },
  "MeetingLinks": {
    "PublicWebBaseUrl": "",
    "TokenTtlHours": 72
  },
  "RateLimit": {
    "PermitLimit": 20,
    "WindowSeconds": 60
  },
  "Swagger": {
    "AllowSwagger": false,
    "Username": "",
    "Password": ""
  },
  "FaceDetection": {
    "Enabled": true,
    "MinConfidence": 0.5
  },
  "Ai": {
    "DefaultProvider": "Echo",
    "Gemini": {
      "ApiKey": "",
      "BaseUrl": "https://generativelanguage.googleapis.com",
      "DefaultModel": "gemini-2.5-flash"
    },
    "Anthropic": {
      "ApiKey": "",
      "DefaultModel": "claude-haiku-4-5-20251001"
    },
    "OpenAi": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "DefaultModel": "gpt-4o-mini"
    }
  },
  "AllowedHosts": "*"
}
