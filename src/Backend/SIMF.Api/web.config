<?xml version="1.0" encoding="utf-8"?>
<!--
  D-768 — Raise the IIS request-filtering ceiling so a hero-video upload
  (POST /api/v1/admin/organization-profile/hero-video, up to
  OrganizationHeroVideo:MaxUploadBytes = 200 MiB) is not rejected by IIS with a
  413 BEFORE it reaches the endpoint. IIS request filtering defaults to
  30,000,000 bytes (~28.6 MiB), which a hero clip (or a session recording)
  exceeds — the endpoint's per-request Kestrel body-size override never runs
  because IIS blocks the request first.

  Only this ceiling is set here. The <aspNetCore> handler + in-process hosting
  block are injected by `dotnet publish` (the Web SDK merges this project
  web.config with the generated one — it does not replace it). Per-endpoint body
  size stays guarded by the server default (IISServerOptions / Kestrel
  MaxRequestBodySize = 30 MB): only the two upload endpoints raise it per-request
  (IHttpMaxRequestBodySizeFeature), so every OTHER endpoint keeps the 30 MB limit
  and this site-wide IIS ceiling does not widen their DoS surface.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 256 MiB — comfortably above the app's real 200 MiB cap
             (OrganizationHeroVideo:MaxUploadBytes) plus multipart overhead, so
             the app returns its friendly 400 on an oversized file rather than
             IIS returning a raw 413. -->
        <requestLimits maxAllowedContentLength="268435456" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
