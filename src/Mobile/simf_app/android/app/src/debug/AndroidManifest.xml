<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- DEBUG-ONLY: allow cleartext HTTP so a debug build can reach a local dev
         API (e.g. http://10.0.2.2:5175 from the emulator). The manifest merger
         applies this to debug builds only; it is never merged into release/prod. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
