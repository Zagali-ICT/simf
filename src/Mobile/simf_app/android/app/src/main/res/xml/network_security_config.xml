<?xml version="1.0" encoding="utf-8"?>
<!--
  D-768 — Host-scoped trust for the self-signed cert on the API host so the
  native video player (ExoPlayer/media3) can stream the CP-uploaded hero
  background video over TLS. Android's native player validates against the system
  trust store, which the app's Dart-level trust-all override does NOT cover, so the
  pinned cert is added as a trust anchor ONLY for this one host — every other
  connection keeps the normal system trust store.

  STALE ANCHOR (D-868): raw/simf_api_cert.pem was issued for the OLD hostname
  (CN and SAN both simf-api.zagali-ict.com), so it no longer matches the domain
  below and validates nothing. It is harmless — "system" is still listed, so
  normal trust applies — but it is not doing its job either. When api.simrsnf.com
  gets its certificate: if it is a real CA cert, DELETE this file and the .pem
  together; if it is another self-signed cert, replace the .pem with the new leaf.
-->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">api.simrsnf.com</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="@raw/simf_api_cert"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
