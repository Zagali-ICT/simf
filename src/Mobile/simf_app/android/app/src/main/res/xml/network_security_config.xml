<?xml version="1.0" encoding="utf-8"?>
<!--
  D-768 — Host-scoped trust for the self-signed cert on simf-api.zagali-ict.com so
  the native video player (ExoPlayer/media3) can stream the CP-uploaded hero
  background video over TLS. Android's native player validates against the system
  trust store, which the app's Dart-level trust-all override does NOT cover, so the
  pinned cert is added as a trust anchor ONLY for this one host — every other
  connection keeps the normal system trust store. Replace the API's self-signed cert
  with a real CA cert (win-acme / Let's Encrypt) and this whole file can be deleted.
-->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">simf-api.zagali-ict.com</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="@raw/simf_api_cert"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
