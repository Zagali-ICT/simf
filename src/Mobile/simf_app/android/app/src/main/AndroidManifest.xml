<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Every network call the app makes. Declared here rather than left to the
         merger: INTERNET reaches the release build only as a side-effect of the
         ML Kit dependency graph (play-services -> transport-backend-cct), and
         none of the app's own manifests contributed it. Dropping ML Kit face
         detection would otherwise take network access with it, silently. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- D-404 — the guided face-capture / liveness flow uses the live camera
         preview (the `camera` plugin); the camera is optional so devices
         without one can still install (and fall back to the gallery). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <!-- camera_android_camerax injects camera.any with NO android:required, and
         the attribute defaults to true - which made the shipped bundle
         camera-mandatory on Play, the opposite of what the two lines above
         decide. tools:replace is load-bearing: android:required uses an OR
         merge, so a plain required="false" here loses to the library's implied
         true and changes nothing. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required" />
    <!-- D-738 — biometric (Face-ID / fingerprint) device-key sign-in via
         local_auth. local_auth_android already merges this permission; declared
         here explicitly so the app's own manifest documents the capability. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- androidx.biometric contributes USE_FINGERPRINT uncapped. It has been
         deprecated since API 28 in favour of USE_BIOMETRIC above, so cap it
         rather than let it sit in the Play Console permission list on every
         API level. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="28" tools:replace="android:maxSdkVersion" />
    <!-- camera_android_camerax declares RECORD_AUDIO for video capture. This app
         never records: its only CameraController sets `enableAudio: false`
         (identity_verification_screen.dart) and there is no microphone code.
         Removed so the Play listing does not request a microphone the app never
         opens, and so the Data Safety form has nothing to declare for it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <!-- The merger IMPLIES READ_EXTERNAL_STORAGE from camerax's legacy
         WRITE_EXTERNAL_STORAGE, and the implied form carries NO maxSdkVersion,
         so it would apply on every API level. Declared explicitly with the cap
         instead. Not removed outright: image_picker takes the photo-picker path
         on API 33+, but the gallery route below that still needs read access. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- allowBackup defaults to TRUE, and Android auto-backup copies plaintext
         SharedPreferences to the user's Drive. That would take the AES-256
         offline badge key and the queued gate-scan backlog off a staff device,
         where neither the "armed only during the event" nor the reconcile
         control that justifies storing them in the clear still applies. Auth
         tokens were never at risk - they are Keystore-backed and the master key
         does not back up - but the badge key is not. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
