@* SimfIcon — a small inline-SVG icon set for the Simf* component library.
   Stroke icons on a 24x24 grid, drawn in currentColor so the parent controls
   the colour through a token. No icon-font or external asset dependency. *@

<svg class="simf-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @((MarkupString)Body)
</svg>

@code {
    /// <summary>The icon to draw — see the names in <see cref="Paths"/>.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>The rendered width and height in pixels. Defaults to 18.</summary>
    [Parameter] public int Size { get; set; } = 18;

    /// <summary>An optional extra CSS class.</summary>
    [Parameter] public string? Class { get; set; }

    private string Body =>
        Paths.TryGetValue(Name, out var body)
            ? body
            : throw new ArgumentException($"Unknown SimfIcon name '{Name}'.", nameof(Name));

    // Each entry is the inner SVG markup for one named icon.
