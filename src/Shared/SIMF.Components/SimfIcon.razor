@* SimfIcon — a small inline-SVG icon set for the Simf* component library.
   Stroke icons on a 24x24 grid, drawn in currentColor so the parent controls
   the colour through a token. No icon-font or external asset dependency. *@

<svg class="simf-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @((MarkupString)Body)
</svg>

