    /// <summary>The rendered width and height in pixels. Defaults to 18.</summary>
    [Parameter] public int Size { get; set; } = 18;

    /// <summary>An optional extra CSS class.</summary>
    [Parameter] public string? Class { get; set; }

    private string Body =>
        Paths.TryGetValue(Name, out var body)
            ? body
