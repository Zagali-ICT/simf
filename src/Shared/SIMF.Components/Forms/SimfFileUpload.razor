@* SimfFileUpload — a labelled file picker on the SIMF field shell.
   The client picks the file; the server validates by
   magic bytes (the same pattern as the avatar). For
   ID-card images on the visitor profile.

   The picked-file status (`PickedFilename` parameter) is
   rendered inside an aria-live region. Sighted keyboard users see a
   visible "Picked: foo.png" line; screen readers hear it announced
   without focus moving. `aria-describedby` includes the status region
   so the input's accessible name composes naturally. *@
@namespace SIMF.Components.Forms

<div class="simf-field @(HasError ? "simf-field--error" : null) @(Disabled ? "simf-field--disabled" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="simf-field__label" for="@_id">@Label</label>
    }
    <div class="simf-field__control simf-field__control--file">
        <input id="@_id" class="simf-fileupload__input"
               type="file"
               accept="@Accept"
               disabled="@Disabled"
               aria-invalid="@(HasError ? "true" : null)"
               aria-describedby="@DescribedBy"
               @onchange="OnNativeChangedAsync" />
    </div>
    @* Status region — always rendered (Blazor must keep the DOM node so
       aria-live updates fire), but visually empty until a file is picked. *@
    <p class="simf-fileupload__status" id="@_statusId" aria-live="polite">
        @if (!string.IsNullOrEmpty(PickedFilename))
        {
            <span>@(string.IsNullOrEmpty(PickedLabel) ? "Picked:" : PickedLabel) @PickedFilename</span>
        }
    </p>
    @if (!string.IsNullOrEmpty(Helper) && !HasError)
    {
        <p class="simf-field__helper" id="@_helperId">@Helper</p>
    }
    @if (HasError && !string.IsNullOrEmpty(Error))
    {
        <p class="simf-field__error" id="@_errorId" role="alert">
            <SimfIcon Name="alert" Size="14" Class="simf-field__error-icon" />
            @Error
        </p>
    }
</div>

@code {
    private readonly string _id = "simf-file-" + Guid.NewGuid().ToString("N");
    private readonly string _helperId = "simf-file-helper-" + Guid.NewGuid().ToString("N");
    private readonly string _errorId = "simf-file-error-" + Guid.NewGuid().ToString("N");
    private readonly string _statusId = "simf-file-status-" + Guid.NewGuid().ToString("N");

    private string? DescribedBy
    {
        get
        {
            // Compose every relevant id so screen readers
            // announce error (or helper) AND the picked-file status.
            var ids = new List<string>(3);
            if (HasError) ids.Add(_errorId);
            else if (!string.IsNullOrEmpty(Helper)) ids.Add(_helperId);
            if (!string.IsNullOrEmpty(PickedFilename)) ids.Add(_statusId);
            return ids.Count == 0 ? null : string.Join(' ', ids);
        }
    }

    /// <summary>The field label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Helper text shown under the field.</summary>
    [Parameter] public string? Helper { get; set; }

    /// <summary>Error message; turns the field red when non-empty.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>The MIME / extension filter passed to <c>accept</c>. E.g. <c>image/*,.pdf</c>.</summary>
    [Parameter] public string? Accept { get; set; }

    /// <summary>The name of the most-recently-picked file,
    /// supplied by the parent after reading it via JS interop. Renders
    /// inside an aria-live region so the choice is announced to screen
    /// readers and visible to sighted keyboard users.</summary>
    [Parameter] public string? PickedFilename { get; set; }

    /// <summary>Localised prefix for the picked-file
    /// status (e.g. "Picked:" / "تم الاختيار:"). Defaults to English so
    /// the component works without a caller-provided label.</summary>
    [Parameter] public string? PickedLabel { get; set; }

    /// <summary>The DOM element id — useful so the page can read the chosen
    /// file from JS interop and POST it to a CP proxy (mirrors the avatar
    /// upload pattern).</summary>
    public string ElementId => _id;

    /// <summary>Raised when the user picks a file — the parent reads
    /// <see cref="ElementId"/> via JS interop to upload the bytes.</summary>
    [Parameter] public EventCallback OnFilePicked { get; set; }

    /// <summary>Disables the picker.</summary>
    [Parameter] public bool Disabled { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    private Task OnNativeChangedAsync(ChangeEventArgs _) =>
        OnFilePicked.InvokeAsync();
}
