@* SimfCheckList — a multi-select checkbox list with the SIMF field
   shell. Used for the visitor's Interests picker on the
   /account/profile page (الاهتمامات). Pattern mirrors SimfRadioGroup
   but allows multiple values. *@
@namespace SIMF.Components.Forms
@typeparam TItem

<div class="simf-field @(HasError ? "simf-field--error" : null) @(Disabled ? "simf-field--disabled" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="simf-field__label" id="@_labelId">@Label</span>
    }
    <div class="simf-checklist @(Inline ? "simf-checklist--inline" : null)"
         role="group"
         aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : _labelId)"
         aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)"
         aria-invalid="@(HasError ? "true" : null)"
         aria-describedby="@DescribedBy">
        @foreach (var item in Items ?? Array.Empty<TItem>())
        {
            var optionValue = ValueFor is null ? item?.ToString() ?? string.Empty : ValueFor(item) ?? string.Empty;
            var optionLabel = LabelFor is null ? optionValue : LabelFor(item) ?? optionValue;
            var optionId = $"{_groupId}-{optionValue}";
            var isChecked = _selectedValues.Contains(optionValue);
            <label class="simf-checklist__item" for="@optionId">
                <input id="@optionId" type="checkbox" name="@_groupId"
                       value="@optionValue"
                       checked="@isChecked"
                       disabled="@Disabled"
                       @onchange="@(args => OnToggledAsync(item, optionValue, args))" />
                <span class="simf-checklist__label">@optionLabel</span>
            </label>
        }
    </div>
    @if (!string.IsNullOrEmpty(Helper) && !HasError)
    {
        <p class="simf-field__helper" id="@_helperId">@Helper</p>
    }
    @if (HasError && !string.IsNullOrEmpty(Error))
    {
        <p class="simf-field__error" id="@_errorId" role="alert">
            <SimfIcon Name="alert" Size="14" Class="simf-field__error-icon" />
            @Error
        </p>
    }
</div>

@code {
    private readonly string _groupId = "simf-checklist-" + Guid.NewGuid().ToString("N");
    private readonly string _labelId = "simf-checklist-label-" + Guid.NewGuid().ToString("N");
    private readonly string _helperId = "simf-checklist-helper-" + Guid.NewGuid().ToString("N");
    private readonly string _errorId = "simf-checklist-error-" + Guid.NewGuid().ToString("N");
    private HashSet<string> _selectedValues = new(StringComparer.Ordinal);

    private string? DescribedBy =>
        HasError ? _errorId
        : !string.IsNullOrEmpty(Helper) ? _helperId
        : null;

    /// <summary>The group label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Fallback accessible name when <see cref="Label"/> is empty.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Helper text shown under the group.</summary>
    [Parameter] public string? Helper { get; set; }

    /// <summary>Error message; turns the group red when non-empty.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>When true, lays the options on one row (wraps as needed).</summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>The available items.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TItem>? Items { get; set; }

    /// <summary>Produces the option's posted value. Defaults to <c>ToString()</c>.</summary>
    [Parameter] public Func<TItem, string?>? ValueFor { get; set; }

    /// <summary>Produces the option's visible label. Defaults to the value.</summary>
    [Parameter] public Func<TItem, string?>? LabelFor { get; set; }

    /// <summary>The currently-selected items.</summary>
    [Parameter] public IReadOnlyList<TItem>? Values { get; set; }

    /// <summary>Raised whenever the user toggles an item — emits the new
    /// selected set.</summary>
    [Parameter] public EventCallback<IReadOnlyList<TItem>> ValuesChanged { get; set; }

    /// <summary>Disables every checkbox in the group.</summary>
    [Parameter] public bool Disabled { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    protected override void OnParametersSet()
    {
        _selectedValues = new HashSet<string>(StringComparer.Ordinal);
        if (Values is null) return;
        foreach (var value in Values)
        {
            var key = ValueFor is null ? value?.ToString() ?? string.Empty : ValueFor(value) ?? string.Empty;
            _selectedValues.Add(key);
        }
    }

    private async Task OnToggledAsync(TItem item, string raw, ChangeEventArgs args)
    {
        var checkedNow = args.Value is bool b && b;
        if (checkedNow) _selectedValues.Add(raw); else _selectedValues.Remove(raw);

        var emitted = (Items ?? Array.Empty<TItem>())
            .Where(candidate =>
            {
                var key = ValueFor is null
                    ? candidate?.ToString() ?? string.Empty
                    : ValueFor(candidate) ?? string.Empty;
                return _selectedValues.Contains(key);
            })
            .ToList();
        await ValuesChanged.InvokeAsync(emitted);
    }
}
