@* SimfCheckbox — a labelled checkbox primitive. Pairs an
   <input type="checkbox"> with a label and the standard SIMF form spacing. *@
@namespace SIMF.Components.Forms

<label class="simf-checkbox">
    <input type="checkbox"
           checked="@Value"
           disabled="@(Disabled ? "disabled" : null)"
           @onchange="OnChangedAsync" />
    <span class="simf-checkbox__label">@ChildContent</span>
</label>

@code {
    /// <summary>Whether the checkbox is checked. Two-way bindable via <c>@bind-Value</c>.</summary>
    [Parameter] public bool Value { get; set; }

    /// <summary>Fired when the value changes — needed for <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>Disables the input.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The label text.</summary>
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    private Task OnChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value is bool typed && typed;
        return ValueChanged.InvokeAsync(value);
    }
}
