@* SimfTooltip — a CSS-only hover hint (decision D-044 c). Wraps any content
   and shows a small tooltip on hover and keyboard focus-within. No JS, no
   portal — keeps server-rendered pages light. Direction-aware. *@
@namespace SIMF.Components.Forms

<span class="simf-tooltip simf-tooltip--@Placement" tabindex="0">
    @ChildContent
    <span class="simf-tooltip__bubble" role="tooltip">@Label</span>
</span>

@code {
    /// <summary>The tooltip text.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>Placement — <c>top</c> (default) or <c>bottom</c>.</summary>
    [Parameter] public string Placement { get; set; } = "top";

    /// <summary>The trigger content (an icon, a button, a span of text).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
