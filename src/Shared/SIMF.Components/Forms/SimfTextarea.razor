@* SimfTextarea — a multi-line text field (decision D-044). Same field
   shell as SimfTextField — label, helper, error positions match — so a
   form with a mix of single and multi-line inputs reads consistently. *@
@namespace SIMF.Components.Forms

<div class="simf-field @(HasError ? "simf-field--error" : null) @(Disabled ? "simf-field--disabled" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="simf-field__label" for="@_id">@Label</label>
    }
    <div class="simf-field__control simf-field__control--textarea">
        <textarea id="@_id" class="simf-field__input simf-field__textarea"
                  rows="@Rows" maxlength="@MaxLength"
                  placeholder="@Placeholder"
                  disabled="@Disabled"
                  value="@Value"
                  aria-invalid="@(HasError ? "true" : null)"
                  aria-describedby="@DescribedBy"
                  @oninput="OnInputAsync"></textarea>
    </div>
    @if (!string.IsNullOrEmpty(Helper) && !HasError)
    {
        <p class="simf-field__helper" id="@_helperId">@Helper</p>
    }
    @if (HasError && !string.IsNullOrEmpty(Error))
    {
        <p class="simf-field__error" id="@_errorId" role="alert">
            <SimfIcon Name="alert" Size="14" Class="simf-field__error-icon" />
            @Error
        </p>
    }
</div>

@code {
    private readonly string _id = "simf-textarea-" + Guid.NewGuid().ToString("N");
    private readonly string _helperId = "simf-textarea-helper-" + Guid.NewGuid().ToString("N");
    private readonly string _errorId = "simf-textarea-error-" + Guid.NewGuid().ToString("N");

    private string? DescribedBy =>
        HasError ? _errorId
        : !string.IsNullOrEmpty(Helper) ? _helperId
        : null;

    /// <summary>The field label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Helper text shown under the field.</summary>
    [Parameter] public string? Helper { get; set; }

    /// <summary>Error message; turns the field red when non-empty.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>The placeholder shown while empty.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>The visible row count. Defaults to 4.</summary>
    [Parameter] public int Rows { get; set; } = 4;

    /// <summary>Maximum allowed character count. Defaults to 500.</summary>
    [Parameter] public int MaxLength { get; set; } = 500;

    /// <summary>The current value.</summary>
    [Parameter] public string Value { get; set; } = string.Empty;

    /// <summary>Raised on every keystroke with the new value.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Disables the field (e.g. while a submit is in flight).</summary>
    [Parameter] public bool Disabled { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    private Task OnInputAsync(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
