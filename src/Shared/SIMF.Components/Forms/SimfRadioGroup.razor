@* SimfRadioGroup — a typed labelled radio group. One
   field shell (label + helper + error) wrapping a set of native radio
   inputs. Used for mutually-exclusive choices like "Saudi / non-Saudi" or
   "Visitor / Exhibitor / Press" on the visitor profile. *@
@namespace SIMF.Components.Forms
@typeparam TValue

<div class="simf-field @(HasError ? "simf-field--error" : null) @(Disabled ? "simf-field--disabled" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="simf-field__label" id="@_labelId">@Label</span>
    }
    <div class="simf-radiogroup @(Inline ? "simf-radiogroup--inline" : null)"
         role="radiogroup"
         aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : _labelId)"
         aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)"
         aria-invalid="@(HasError ? "true" : null)"
         aria-describedby="@DescribedBy">
        @foreach (var item in Items ?? Array.Empty<TValue>())
        {
            var optionValue = ValueFor is null ? item?.ToString() ?? string.Empty : ValueFor(item) ?? string.Empty;
            var optionLabel = LabelFor is null ? optionValue : LabelFor(item) ?? optionValue;
            var optionId = $"{_groupId}-{optionValue}";
            <label class="simf-radio" for="@optionId">
                <input id="@optionId" type="radio" name="@_groupId"
                       value="@optionValue"
                       checked="@(string.Equals(_currentValueString, optionValue, StringComparison.Ordinal))"
                       disabled="@Disabled"
                       @onchange="@(() => OnChangedAsync(item, optionValue))" />
                <span class="simf-radio__label">@optionLabel</span>
            </label>
        }
    </div>
    @if (!string.IsNullOrEmpty(Helper) && !HasError)
    {
        <p class="simf-field__helper" id="@_helperId">@Helper</p>
    }
    @if (HasError && !string.IsNullOrEmpty(Error))
    {
        <p class="simf-field__error" id="@_errorId" role="alert">
            <SimfIcon Name="alert" Size="14" Class="simf-field__error-icon" />
            @Error
        </p>
    }
</div>

@code {
    private readonly string _groupId = "simf-radio-" + Guid.NewGuid().ToString("N");
    private readonly string _labelId = "simf-radio-label-" + Guid.NewGuid().ToString("N");
    private readonly string _helperId = "simf-radio-helper-" + Guid.NewGuid().ToString("N");
    private readonly string _errorId = "simf-radio-error-" + Guid.NewGuid().ToString("N");
    private string _currentValueString = string.Empty;

    private string? DescribedBy =>
        HasError ? _errorId
        : !string.IsNullOrEmpty(Helper) ? _helperId
        : null;

    /// <summary>The group label. When omitted, callers should pass
    /// <see cref="AriaLabel"/> so the radiogroup still has an accessible
    /// name.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Fallback accessible name when <see cref="Label"/> is empty.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Helper text shown under the group.</summary>
    [Parameter] public string? Helper { get; set; }

    /// <summary>Error message; turns the group red when non-empty.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>When true, lays the options on one row.</summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>The radio options.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TValue>? Items { get; set; }

    /// <summary>Produces the option's posted value. Defaults to <c>ToString()</c>.</summary>
    [Parameter] public Func<TValue, string?>? ValueFor { get; set; }

    /// <summary>Produces the option's visible label. Defaults to the value.</summary>
    [Parameter] public Func<TValue, string?>? LabelFor { get; set; }

    /// <summary>The current value.</summary>
    [Parameter] public TValue? Value { get; set; }

    /// <summary>Raised whenever the user picks a different option.</summary>
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>Disables every option in the group.</summary>
    [Parameter] public bool Disabled { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    protected override void OnParametersSet()
    {
        if (Value is null) { _currentValueString = string.Empty; return; }
        _currentValueString = ValueFor is null
            ? Value.ToString() ?? string.Empty
            : ValueFor(Value) ?? string.Empty;
    }

    private async Task OnChangedAsync(TValue item, string raw)
    {
        _currentValueString = raw;
        await ValueChanged.InvokeAsync(item);
    }
}
