@* SimfDatePicker — a labelled date input on the SIMF field shell (decision
   D-044 c). The native <input type="date"> stays accessible and keyboard-
   friendly; we add nothing custom. ISO 8601 YYYY-MM-DD over the wire.
   Used for DOB / arrival / departure on the visitor profile (myComment #18). *@
@namespace SIMF.Components.Forms

<div class="simf-field @(HasError ? "simf-field--error" : null) @(Disabled ? "simf-field--disabled" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="simf-field__label" for="@_id">@Label</label>
    }
    <div class="simf-field__control simf-field__control--date">
        <input id="@_id" class="simf-field__input simf-field__date"
               type="date"
               min="@Min" max="@Max"
               disabled="@Disabled"
               value="@Value"
               @onchange="OnNativeChangedAsync" />
    </div>
    @if (!string.IsNullOrEmpty(Helper) && !HasError)
    {
        <p class="simf-field__helper">@Helper</p>
    }
    @if (HasError && !string.IsNullOrEmpty(Error))
    {
        <p class="simf-field__error" role="alert">
            <SimfIcon Name="alert" Size="14" Class="simf-field__error-icon" />
            @Error
        </p>
    }
</div>

@code {
    private readonly string _id = "simf-date-" + Guid.NewGuid().ToString("N");

    /// <summary>The field label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Helper text shown under the field.</summary>
    [Parameter] public string? Helper { get; set; }

    /// <summary>Error message; turns the field red when non-empty.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>The earliest allowed date (ISO 8601 YYYY-MM-DD).</summary>
    [Parameter] public string? Min { get; set; }

    /// <summary>The latest allowed date (ISO 8601 YYYY-MM-DD).</summary>
    [Parameter] public string? Max { get; set; }

    /// <summary>The current value (ISO 8601 YYYY-MM-DD; empty for "not set").</summary>
    [Parameter] public string Value { get; set; } = string.Empty;

    /// <summary>Raised whenever the picked date changes.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Disables the picker.</summary>
    [Parameter] public bool Disabled { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    private Task OnNativeChangedAsync(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
