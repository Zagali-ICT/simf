@* SimfPasswordField — a password input with a show / hide control, bound to
   the form's EditContext. *@
@inherits SimfFieldBase

<div class="simf-field @(HasError ? "simf-field--error" : null) @(Disabled ? "simf-field--disabled" : null)">
    <label class="simf-field__label" for="@FieldElementId">@Label</label>
    <div class="simf-field__control">
        <SimfIcon Name="lock" Class="simf-field__icon" />
        <InputText id="@FieldElementId" class="simf-field__input"
                   Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                   type="@(_revealed ? "text" : "password")" autocomplete="@Autocomplete"
                   disabled="@Disabled"
                   aria-invalid="@(HasError ? "true" : null)"
                   aria-describedby="@DescribedBy" />
        <button type="button" class="simf-password__toggle" @onclick="ToggleReveal"
                disabled="@Disabled" aria-label="@ToggleLabel" aria-pressed="@_revealed">
            <SimfIcon Name="@(_revealed ? "eye-off" : "eye")" />
        </button>
    </div>
    @if (HasError)
    {
        <div class="simf-field__error" id="@ErrorElementId" role="alert">
            <SimfIcon Name="alert" Size="14" Class="simf-field__error-icon" />
            <span>@ErrorMessage</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(Helper))
    {
        <div class="simf-field__helper" id="@HelperElementId">@Helper</div>
    }
</div>

@code {
    /// <summary>The HTML <c>autocomplete</c> hint — <c>current-password</c> or <c>new-password</c>.</summary>
    [Parameter] public string Autocomplete { get; set; } = "current-password";

    /// <summary>Optional helper text shown below the field when there is no error.</summary>
    [Parameter] public string? Helper { get; set; }

    /// <summary>The accessible label for the show / hide control. The host supplies it localised.</summary>
    [Parameter] public string ShowLabel { get; set; } = "Show password";

    /// <summary>The accessible label for the control when the password is visible.</summary>
    [Parameter] public string HideLabel { get; set; } = "Hide password";

    private bool _revealed;

    private string ToggleLabel => _revealed ? HideLabel : ShowLabel;

    private string? DescribedBy =>
        HasError ? ErrorElementId
        : !string.IsNullOrEmpty(Helper) ? HelperElementId
        : null;

    private void ToggleReveal() => _revealed = !_revealed;
}
