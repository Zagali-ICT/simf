@* SimfTextField — a labelled single-line input bound to the form's EditContext.
   Renders its own validation message (styled), an optional leading icon and
   optional helper text. *@
@inherits SimfFieldBase
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="simf-field @(HasError ? "simf-field--error" : null) @(Disabled ? "simf-field--disabled" : null)">
    <label class="simf-field__label" for="@FieldElementId">@Label</label>
    <div class="simf-field__control">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <SimfIcon Name="@Icon" Class="simf-field__icon" />
        }
        @if (Numeric)
        {
            @* Numeric mode — a raw input restricted to digits. The C# handler
               keeps the bound model digit-only even if the JS cleaner never
               loads; the JS cleaner (attached on first render) strips any
               non-digit from the DOM in place so letters never appear. *@
            <input id="@FieldElementId" class="simf-field__input"
                   type="text" inputmode="numeric" pattern="[0-9]*"
                   value="@Value" @oninput="OnNumericInputAsync"
                   autocomplete="@Autocomplete"
                   placeholder="@Placeholder" disabled="@Disabled"
                   maxlength="@(MaxLength?.ToString())"
                   aria-invalid="@(HasError ? "true" : null)"
                   aria-describedby="@DescribedBy" />
        }
        else
        {
            <InputText id="@FieldElementId" class="simf-field__input"
                       Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                       type="@Type" inputmode="@InputMode" autocomplete="@Autocomplete"
                       placeholder="@Placeholder" disabled="@Disabled"
                       maxlength="@(MaxLength?.ToString())"
                       min="@Min" max="@Max"
                       aria-invalid="@(HasError ? "true" : null)"
                       aria-describedby="@DescribedBy" />
        }
    </div>
    @if (HasError)
    {
        <div class="simf-field__error" id="@ErrorElementId" role="alert">
            <SimfIcon Name="alert" Size="14" Class="simf-field__error-icon" />
            <span>@ErrorMessage</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(Helper))
    {
        <div class="simf-field__helper" id="@HelperElementId">@Helper</div>
    }
</div>

@code {
    private IJSObjectReference? _numericModule;

    /// <summary>The HTML input type — <c>text</c>, <c>email</c>, etc.</summary>
    [Parameter] public string Type { get; set; } = "text";

    /// <summary>An optional leading icon name (see <see cref="SimfIcon" />).</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Optional helper text shown below the field when there is no error.</summary>
    [Parameter] public string? Helper { get; set; }

    /// <summary>An optional placeholder. Labels do the work; placeholders stay rare.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>The HTML <c>autocomplete</c> hint.</summary>
    [Parameter] public string? Autocomplete { get; set; }

    /// <summary>The HTML <c>inputmode</c> hint.</summary>
    [Parameter] public string? InputMode { get; set; }

    /// <summary>The maxlength attribute — the browser stops the user typing
    /// once they hit this many characters. Defence-in-depth alongside the
    /// server-side FluentValidation rule.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Opt-in digit-only mode (B3 — D-221 hardening). When true the
    /// field accepts digits only: a C# strip keeps the bound model clean and a
    /// small JS cleaner removes any pasted / typed non-digit from the DOM in
    /// place. Default false — every existing consumer is unaffected.</summary>
    [Parameter] public bool Numeric { get; set; }

    /// <summary>HTML <c>min</c> attribute — restricts the minimum value
    /// on <c>datetime-local</c> / <c>number</c> / <c>date</c> inputs.</summary>
    [Parameter] public string? Min { get; set; }

    /// <summary>HTML <c>max</c> attribute — restricts the maximum value
    /// on <c>datetime-local</c> / <c>number</c> / <c>date</c> inputs.</summary>
    [Parameter] public string? Max { get; set; }

    private string? DescribedBy =>
        HasError ? ErrorElementId
        : !string.IsNullOrEmpty(Helper) ? HelperElementId
        : null;

    // Numeric mode — strip non-digits so the bound model is always digit-only,
    // independent of the JS cosmetic cleaner. Honours MaxLength.
    private async Task OnNumericInputAsync(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var digits = new string(raw.Where(char.IsAsciiDigit).ToArray());
        if (MaxLength is { } max && digits.Length > max)
        {
            digits = digits[..max];
        }
        if (!string.Equals(digits, Value, StringComparison.Ordinal))
        {
            await ValueChanged.InvokeAsync(digits);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Numeric)
        {
            try
            {
                _numericModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "/_content/SIMF.Components/js/simf-numeric.js");
                await _numericModule.InvokeVoidAsync("digitsOnly", FieldElementId);
            }
            catch (JSException)
            {
                // Best-effort cosmetic cleaner — the C# strip already keeps the
                // model digit-only, so a JS load failure is non-fatal.
            }
            catch (InvalidOperationException)
            {
                // JS interop unavailable (e.g. prerender) — same fallback.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        // SimfFieldBase.Dispose() (IDisposable) is NOT called by the renderer
        // when a component also implements IAsyncDisposable, so unsubscribe the
        // validation handler here, then release the imported JS module.
        Dispose();
        if (_numericModule is not null)
        {
            try { await _numericModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit already gone */ }
            catch (JSException) { /* module already torn down */ }
        }
    }
}
