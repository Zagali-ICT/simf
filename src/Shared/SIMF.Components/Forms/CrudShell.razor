@* CrudShell — the one switch every CRUD list page renders to host an add /
   edit / view / delete form (D-353). Based on the per-user Presentation
   choice it frames the same form either as a popup (CrudDialogFrame) or a
   full page (CrudPageFrame). The shell is parameter-agnostic: the list page
   binds the form's typed parameters directly in ChildContent, so the frame
   never has to forward them. Renders nothing while Open is false. *@
@namespace SIMF.Components.Forms

@if (Open)
{
    @if (Presentation == CrudPresentation.Page)
    {
        <CrudPageFrame Title="@Title" CloseLabel="@CloseLabel" OnClose="OnClose">
            @ChildContent
        </CrudPageFrame>
    }
    else
    {
        <CrudDialogFrame Title="@Title" CloseLabel="@CloseLabel" OnClose="OnClose">
            @ChildContent
        </CrudDialogFrame>
    }
}

@code {
    /// <summary>True to show the form; false renders nothing.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Whether to frame the form as a popup or a full page.</summary>
    [Parameter] public CrudPresentation Presentation { get; set; } = CrudPresentation.Dialog;

    /// <summary>The form title shown in the frame header / dialog title.</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>The accessible label for the close affordance.</summary>
    [Parameter] public string CloseLabel { get; set; } = "Close";

    /// <summary>Raised when the user closes the form (cancel / close / save
    /// handled by the form itself, which also invokes its own callbacks).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>The hosted form — the list page binds its typed parameters here.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
