@* SimfBrandPanel — the navy brand panel of the authentication screens. The
   white SIMF logo sits at the top; the white SIMF wordmark text sits below
   the logo; an optional subtitle line (for example "Control Panel") and a
   muted caption anchor the foot. A quiet compass-and-anchor texture is laid
   behind the lot. *@
@namespace SIMF.Components.Layout

<div class="simf-brand">
    <div class="simf-brand__texture" aria-hidden="true"></div>
    <img class="simf-brand__logo"
         src="/_content/SIMF.Components/img/simf-logo.png"
         alt="SIMF — Saudi International Maritime Forum" />
    <div class="simf-brand__wordmark">
        <SimfWordmark Reversed="true" />
    </div>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <p class="simf-brand__subtitle">@Subtitle</p>
    }
    @if (!string.IsNullOrEmpty(Caption))
    {
        <p class="simf-brand__caption">@Caption</p>
    }
</div>

@code {
    /// <summary>The line under the wordmark — e.g. "Control Panel".</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>An optional muted caption anchored to the foot of the panel.</summary>
    [Parameter] public string? Caption { get; set; }
}
