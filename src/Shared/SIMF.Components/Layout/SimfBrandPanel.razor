@* SimfBrandPanel — the navy brand panel of the authentication screens. The
   white SIMF logo sits at the top; the white SIMF wordmark text sits below
   the logo; an optional subtitle line (for example "Control Panel") and a
   muted caption anchor the foot. A quiet compass-and-anchor texture is laid
   behind the lot. *@
@namespace SIMF.Components.Layout

<div class="simf-brand">
    <div class="simf-brand__texture" aria-hidden="true"></div>
    @* H22 — D-081: logo alt is the only accessible name for the brand
       image on every sign-in / sign-up / forgot / reset page; pre-H22 it
       was hard-coded English, which an Arabic-locale screen reader
       (with H6's <html lang="ar">) speaks with English phonemes mangled
       by the Arabic engine. AltText is the caller-supplied localised
       string; the English fallback covers callers that haven't been
       wired through the resx pattern yet. *@
    <img class="simf-brand__logo"
         src="/_content/SIMF.Components/img/simf-logo.png"
         alt="@AltText" />
    <div class="simf-brand__wordmark">
        <SimfWordmark Reversed="true" />
    </div>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <p class="simf-brand__subtitle">@Subtitle</p>
    }
    @if (!string.IsNullOrEmpty(Caption))
    {
        <p class="simf-brand__caption">@Caption</p>
    }
</div>

@code {
    /// <summary>The line under the wordmark — e.g. "Control Panel".</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>An optional muted caption anchored to the foot of the panel.</summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>
    /// Localised alt text for the SIMF logo (the only
    /// accessible name for the brand image). Defaults to the English
    /// fallback so callers that don't wire a localised string still get
    /// a sensible name. Arabic callers pass <c>@L["Brand.LogoAlt"]</c>
    /// from the CP / Website resx files.
    /// </summary>
    [Parameter] public string AltText { get; set; } =
        "SIMF — Saudi International Maritime Forum";
}
