@* SimfPageHeader — a content-region page header: the page title and an
   optional primary action. *@
@namespace SIMF.Components.Layout

<header class="simf-page-header">
    <h1 class="simf-page-header__title">@Title</h1>
    @if (Actions is not null)
    {
        <div class="simf-page-header__actions">@Actions</div>
    }
</header>

@code {
    /// <summary>The page title.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>An optional action area, trailing the title.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
