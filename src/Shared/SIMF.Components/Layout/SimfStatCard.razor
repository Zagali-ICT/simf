@* SimfStatCard — a dashboard summary tile. A surface
   with a small title, a large value, and an optional delta. Used on
   /dashboard pages and module home screens. *@
@namespace SIMF.Components.Layout

@if (Href is not null)
{
    <a href="@Href" class="simf-stat simf-stat--clickable">
        <p class="simf-stat__title">@Title</p>
        <p class="simf-stat__value">@Value</p>
        @if (!string.IsNullOrEmpty(Delta))
        {
            <p class="simf-stat__delta simf-stat__delta--@DeltaTone">@Delta</p>
        }
    </a>
}
else
{
    <div class="simf-stat">
        <p class="simf-stat__title">@Title</p>
        <p class="simf-stat__value">@Value</p>
        @if (!string.IsNullOrEmpty(Delta))
        {
            <p class="simf-stat__delta simf-stat__delta--@DeltaTone">@Delta</p>
        }
    </div>
}

@code {
    /// <summary>The tile title (small caption text above the value).</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>The large value text — e.g. "237" or "$12.3k".</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;

    /// <summary>Optional navigation link — when set the card becomes a clickable anchor.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Optional delta line — e.g. "+12 this week".</summary>
    [Parameter] public string? Delta { get; set; }

    /// <summary>Delta tone — <c>positive</c> (default), <c>negative</c>, or <c>neutral</c>.</summary>
    [Parameter] public string DeltaTone { get; set; } = "positive";
}
