<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Nullable, ImplicitUsings and TreatWarningsAsErrors come from Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.7" />
    <!-- D-830: AuthorizeView for SimfActionGate — SimfDataGrid renders its own
         mutating buttons, so the permission gate has to live inside the grid.
         Same 10.0.7 pin as its sibling; resolves to the shared framework at
         runtime in both hosts. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- GridQuery / GridPage<T> for SimfDataGrid (decision D-044). -->
    <ProjectReference Include="..\SIMF.Common\SIMF.Common.csproj" />
  </ItemGroup>

</Project>
