@* CrudPresentationToggle — the toolbar button that lets the admin choose how
   a list page's add / edit / view forms open: as a popup or as a full page
   (D-353). The label shows the action it performs (what it will switch to).
   It persists the choice for this page via CpPreferences (localStorage) and
   raises ValueChanged so the host re-renders. Self-localising (Grid.View.*),
   so a host just binds Value + PageKey. Drop it in the grid's CustomToolbar. *@
@namespace SIMF.ControlPanel.Components

<SimfToolbarButton Icon="@(Value == CrudPresentation.Dialog ? "maximize" : "window")"
                   Title="@ActionLabel"
                   OnClick="ToggleAsync">
    @ActionLabel
</SimfToolbarButton>
