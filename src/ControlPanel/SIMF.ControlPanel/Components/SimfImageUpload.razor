@* D-357 — reusable media-asset control: upload a file OR set an external link
   for one (category, owner), with a live preview. CP-only (drives the BFF asset
   passthroughs + simfAccount JS); used by every entity Add/Edit form. The owner
   row must already exist (OwnerId non-empty) — same as the Media image pattern.
   Labels self-localise from the shared Admin.Asset.* resources; a host may still
   override any single label via the matching parameter. *@

<div class="simf-image-upload">
    <SimfImageThumb Src="@PreviewSrc" Alt="@Alt" Class="simf-image-upload__thumb" />

    @if (_error is not null)
    {
        <SimfAlert Variant="error">@_error</SimfAlert>
    }
    @if (_success is not null)
    {
        <SimfAlert Variant="success">@_success</SimfAlert>
    }

    @if (OwnerId == Guid.Empty)
    {
        <p class="simf-field__hint">@SaveFirstText</p>
    }
    else
    {
        <div class="simf-image-upload__modes">
            <SimfButton Type="button" Variant="@(_mode == Mode.Upload ? "primary" : "secondary")"
                        OnClick="@(() => _mode = Mode.Upload)">@UploadTabText</SimfButton>
            <SimfButton Type="button" Variant="@(_mode == Mode.Link ? "primary" : "secondary")"
                        OnClick="@(() => _mode = Mode.Link)">@LinkTabText</SimfButton>
        </div>

        @if (_mode == Mode.Upload)
        {
            <label class="simf-field">
                <span class="simf-field__label">@KindText</span>
                <select class="simf-field__input" @bind="_uploadKind" disabled="@_busy">
                    <option value="Image">@KindImageText</option>
                    <option value="Document">@KindDocumentText</option>
                </select>
            </label>
            <label class="simf-field">
                <span class="simf-field__label">@FileText</span>
                <input id="@_inputId" type="file" class="simf-field__input"
                       accept="image/png,image/jpeg,image/webp,application/pdf" disabled="@_busy" />
            </label>
            <SimfButton Type="button" Loading="_busy" OnClick="UploadAsync">@UploadButtonText</SimfButton>
        }
        else
        {
            <label class="simf-field">
                <span class="simf-field__label">@KindText</span>
                <select class="simf-field__input" @bind="_linkKind" disabled="@_busy">
                    <option value="Image">@KindImageText</option>
                    <option value="Video">@KindVideoText</option>
                    <option value="Document">@KindDocumentText</option>
                </select>
            </label>
            <label class="simf-field">
                <span class="simf-field__label">@UrlText</span>
                <input type="url" class="simf-field__input" placeholder="https://..."
                       @bind="_url" disabled="@_busy" />
            </label>
            <SimfButton Type="button" Loading="_busy" OnClick="SaveLinkAsync">@SaveLinkButtonText</SimfButton>
        }
    }
</div>
