@* §6.16 (NAV-005) — was the untouched Blazor scaffold: a bare <h3> outside the CP
   shell, unlocalized, with no way back, so a mistyped URL dropped the admin onto a
   blank English page. Now mirrors NotPermitted.razor. *@
@page "/not-found"
@layout CpShellLayout
@attribute [AllowAnonymous]
@inject IStringLocalizer<Strings> L

<PageTitle>@L["NotFound.Title"] · SIMF</PageTitle>

<SimfPageHeader Title='@L["NotFound.Title"]' />

<div class="simf-panel">
    <p class="simf-panel__text">@L["NotFound.Text"]</p>
    <p class="simf-panel__action">
        <SimfLink Href="/">@L["NotFound.Back"]</SimfLink>
    </p>
</div>
