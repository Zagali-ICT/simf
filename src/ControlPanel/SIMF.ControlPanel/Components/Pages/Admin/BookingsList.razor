@* #6/#17 (owner 2026-07-20) — read-only booking MONITOR (was the P2.2/D-227
   approval queue). Bookings auto-confirm — there is no approval step — and no-show
   seats are released automatically 3 minutes before start by
   ReservationNoShowReleaseWorker, so this page only lists the active (confirmed,
   still-held) visitor reservations and exports them. SimfDataGrid (D-255). *@
@page "/admin/bookings"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Bookings.View)]
@using SIMF.Contracts.Sessions
@using SIMF.Contracts.Authentication

<PageTitle>@L["Admin.Bookings.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Bookings.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfAlert Variant="info">@L["Admin.Bookings.MonitorHint"]</SimfAlert>

        <SimfDataGrid TItem="ActiveBookingRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.ReservationId.ToString())"
                      RowLabel="@(r => r.AttendeeName)"
                      Caption="@L["Admin.Bookings.Title"]"
                      OnExport="OnExportAsync"
                      ExportLabel="@L["Grid.Export"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.Bookings.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="ActiveBookingRow" Key="session"
                                    Header="@L["Admin.Bookings.Col.Session"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.SessionTitle</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ActiveBookingRow" Key="start"
                                    Header="@L["Admin.Bookings.Col.Start"]"
                                    Sortable="true">
                    <CellTemplate>@context.SessionStartUtc.FormatSaudi("dd-MM-yyyy hh:mm tt")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ActiveBookingRow" Key="seat"
                                    Header="@L["Admin.Bookings.Col.Seat"]"
                                    Sortable="true" Filterable="true">
                    @* D-485 — an open-seating join has no row/seat; show it as
                       general admission rather than a blank cell. *@
                    <CellTemplate>@(context.RowLabel is null
                        ? L["Admin.Bookings.GeneralAdmission"]
                        : $"{context.RowLabel}{context.SeatNumber}")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ActiveBookingRow" Key="attendee"
                                    Header="@L["Admin.Bookings.Col.Attendee"]">
                    <CellTemplate>@context.AttendeeName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ActiveBookingRow" Key="bookedAt"
                                    Header="@L["Admin.Bookings.Col.BookedAt"]"
                                    Sortable="true">
                    <CellTemplate>@context.CreatedAt.FormatSaudi("dd-MM-yyyy hh:mm tt")</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Bookings.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>
