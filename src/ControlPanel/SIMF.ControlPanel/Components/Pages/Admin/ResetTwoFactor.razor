@* Control Panel — admin-driven 2FA reset. The caller must
   hold the Administrator role. Wipes the target's authenticator, recovery
   codes and active sessions, and emails the target out of band. Layout
   follows the CP form-card convention. *@
@page "/admin/reset-2fa"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Admins.ResetTwoFactor)]

<PageTitle>@L["Admin.ResetTwoFactor.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.ResetTwoFactor.Title"]" />

<section class="simf-card simf-page-card">
    <p>@L["Admin.ResetTwoFactor.Supporting"]</p>

    @if (_success)
    {
        <SimfAlert Variant="success">@L["Admin.ResetTwoFactor.Success"]</SimfAlert>
    }
    @if (_error is not null)
    {
        <SimfAlert Variant="error">@_error</SimfAlert>
    }

    <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
        <div class="simf-form__fields">
            <SimfTextField Label="@L["Admin.ResetTwoFactor.Email"]"
                           @bind-Value="_model.Email"
                           Type="email" Icon="mail" InputMode="email"
                           Autocomplete="off" Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ResetTwoFactor.Reason"]"
                           @bind-Value="_model.Reason"
                           Helper="@L["Admin.ResetTwoFactor.ReasonHint"]"
                           Autocomplete="off" Disabled="_busy" />
        </div>
        <div class="simf-form__actions">
            <SimfButton Loading="_busy"
                        LoadingLabel="@L["Admin.ResetTwoFactor.Submitting"]">
                @L["Admin.ResetTwoFactor.Submit"]
            </SimfButton>
        </div>
    </EditForm>
</section>
