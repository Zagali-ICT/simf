@* P5.1d — D-244 (FDS-003 §5.4): the hall-door arrival console. An operator picks
   an active session, then scans/enters an attendee's badge QR to record a
   QrScan hall arrival. Gated by HallArrivals.* . *@
@page "/admin/hall-arrivals"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.HallArrivals.View)]

<PageTitle>@L["Admin.HallArrivals.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.HallArrivals.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        @if (_loading)
        {
            <p>@L["Admin.HallArrivals.Loading"]</p>
        }
        else if (_sessions.Count == 0)
        {
            <SimfEmptyState Title="@L["Admin.HallArrivals.NoSessions"]" />
        }
        else
        {
            <SimfSelect TValue="AdminSessionSummary"
                        Label="@L["Admin.HallArrivals.SelectSession"]"
                        Placeholder="@L["Admin.HallArrivals.SelectSession"]"
                        Items="_sessions"
                        ValueFor="@(s => s.Id.ToString())"
                        LabelFor="@(s => $"{s.Title} · {s.Code}")"
                        Value="_selected"
                        ValueChanged="@(s => _selected = s)"
                        Disabled="_busy" />

            <AuthorizedAction Permission="@PermissionCatalog.HallArrivals.Record">
                <SimfTextField Label="@L["Admin.HallArrivals.Field.Qr"]"
                               Helper="@L["Admin.HallArrivals.Field.QrHint"]"
                               MaxLength="64"
                               @bind-Value="_qrId" Disabled="_busy" />
                <div class="simf-form__actions">
                    <SimfButton Type="button" Loading="_busy" OnClick="RecordAsync" LoadingLabel="@L["Grid.Working"]">
                        @L["Admin.HallArrivals.Action.Record"]
                    </SimfButton>
                    <SimfButton Type="button" Loading="_busy" OnClick="DepartAsync" LoadingLabel="@L["Grid.Working"]">
                        @L["Admin.HallArrivals.Action.CheckOut"]
                    </SimfButton>
                </div>
            </AuthorizedAction>
        }
    </div>
</div>
