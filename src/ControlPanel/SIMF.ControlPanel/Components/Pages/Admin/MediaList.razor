@* D-199 (CP UI for D-199 Media gallery, Mockup page 30) â€” admin CRUD
   over the public media gallery. An item is either an Image (its bitmap
   is uploaded out-of-row via POST /admin/media/{id}/image) or a Video
   (an external playback Url). Image bytes can only be attached once the
   item row exists, so the upload control lives in the Edit form.
   D-256 â€” migrated from the raw <table> to the owner-mandated
   SimfDataGrid (server-paged, sortable + filterable, full pager).
   D-353 â€” centralized dialog/full-page framing: Add / Edit / View / Delete
   are hosted by CrudShell, which frames the reusable MediaAddEdit and
   MediaViewDelete forms as a popup or a full page per the admin's toolbar
   choice (persisted in localStorage via CpPreferences). The inline SimfModal
   form + native confirm() delete it used to carry are gone. *@
@page "/admin/media"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Media.View)]
@using SIMF.Common.Enums
@using SIMF.Contracts.Media
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject CpPreferences Prefs

<PageTitle>@L["Admin.Media.Title"] Â· SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Media.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminMediaSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => RowLabel(r))"
                          Caption="@L["Admin.Media.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Media.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="kind"
                                        Header="@L["Admin.Media.Col.Kind"]"
                                        Sortable="true">
                        <CellTemplate>@KindLabel(context.Kind)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="title"
                                        Header="@L["Admin.Media.Col.TitleEn"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.Title) ? "â€”" : context.Title)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="titlearabic"
                                        Header="@L["Admin.Media.Col.TitleAr"]"
                                        Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.TitleArabic) ? "â€”" : context.TitleArabic)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="album"
                                        Header="@L["Admin.Media.Col.AlbumEn"]"
                                        Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.Album) ? "â€”" : context.Album)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="albumarabic"
                                        Header="@L["Admin.Media.Col.AlbumAr"]"
                                        Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.AlbumArabic) ? "â€”" : context.AlbumArabic)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="hasImage"
                                        Header="@L["Admin.Media.Col.HasImage"]">
                        <CellTemplate>
                            @if (context.HasImage)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="displayOrder"
                                        Header="@L["Admin.Media.Col.DisplayOrder"]"
                                        Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="isActive"
                                        Header="@L["Admin.Media.Col.Active"]"
                                        Sortable="true">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Media.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Media.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <MediaAddEdit IsEdit="_isEdit" Initial="_target"
                          OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <MediaViewDelete IsDelete="_isDelete" Initial="_target"
                             OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@code {
    private record Toast(string Variant, string Message);

    private enum FormKind { None, AddEdit, ViewDelete }

    private const string PageKey = "media";

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminMediaSummary> _page = new();
    private bool _loading;
    private Toast? _toast;

    private CrudPresentation _presentation = CrudPresentation.Dialog;
    private FormKind _form = FormKind.None;
    private bool _isEdit;
    private bool _isDelete;
    private AdminMediaDetail? _target;

    private bool FormOpen => _form != FormKind.None;
    private bool GridHidden => FormOpen && _presentation == CrudPresentation.Page;

    private string FormTitle => _form switch
    {
        FormKind.AddEdit => _isEdit
            ? L["Admin.Media.Edit.Title"]
            : L["Admin.Media.Add.Title"],
        FormKind.ViewDelete => _isDelete
            ? L["Admin.Media.Delete.Title"]
            : L["Admin.Media.Details.Title"],
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _presentation = await Prefs.GetPresentationAsync(PageKey);
        await LoadAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Admin.Media.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminMediaSummary>>>(
                "simfAccount.postJson",
                "/account/api/admin/media/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Media.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _toast = null;
        _form = FormKind.AddEdit;
        _isEdit = false;
        _target = null;
        return Task.CompletedTask;
    }

    private async Task OnEditAsync(AdminMediaSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.AddEdit;
        _isEdit = true;
        _target = detail;
    }

    private async Task OnDetailsAsync(AdminMediaSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = false;
        _target = detail;
    }

    private async Task OnDeleteAsync(AdminMediaSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = true;
        _target = detail;
    }

    // Edit / View / Delete all work against the full detail so the form opens
    // with the latest image state (HasImage) + metadata, not just the grid
    // summary. Returns null and surfaces a toast on failure.
    private async Task<AdminMediaDetail?> LoadDetailAsync(Guid id)
    {
        _toast = null;
        var env = await JS.InvokeAsync<ApiResult<AdminMediaDetail>>(
            "simfAccount.getJson", $"/account/api/admin/media/{id}");
        if (env is { Success: true, Data: not null })
        {
            return env.Data;
        }
        _toast = new Toast("error",
            env?.Error?.MessageForCurrentCulture()
            ?? L["Admin.Media.LoadFailed"]);
        return null;
    }

    private void CloseForm()
    {
        _form = FormKind.None;
        _target = null;
    }

    private async Task OnSavedAsync(AdminMediaDetail saved)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.Media.Saved"]);
        await LoadAsync();
    }

    private async Task OnDeletedAsync(AdminMediaDetail deleted)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.Media.Deleted"]);
        await LoadAsync();
    }

    private string KindLabel(MediaKind kind) => kind switch
    {
        MediaKind.Image => L["Admin.Media.Kind.Image"],
        MediaKind.Video => L["Admin.Media.Kind.Video"],
        _ => kind.ToString(),
    };

    // Per-row accessible label for the selection checkbox â€” the English title,
    // else the Arabic title, else the kind so a screen reader gets something.
    private string RowLabel(AdminMediaSummary row) =>
        !string.IsNullOrWhiteSpace(row.Title) ? row.Title!
        : !string.IsNullOrWhiteSpace(row.TitleArabic) ? row.TitleArabic!
        : KindLabel(row.Kind);
}
