@* D-199 (CP UI for D-199 Media gallery, Mockup page 30) — admin CRUD
   over the public media gallery. An item is either an Image (its bitmap
   is uploaded out-of-row via POST /admin/media/{id}/image) or a Video
   (an external playback Url). Image bytes can only be attached once the
   item row exists, so the upload control lives in the Edit form.
   D-256 — migrated from the raw <table> to the owner-mandated
   SimfDataGrid (server-paged, sortable + filterable, full pager).
   D-353 — centralized dialog/full-page framing: Add / Edit / View / Delete
   are hosted by CrudShell, which frames the reusable MediaAddEdit and
   MediaViewDelete forms as a popup or a full page per the admin's toolbar
   choice (persisted in localStorage via CpPreferences). The inline SimfModal
   form + native confirm() delete it used to carry are gone. *@
@page "/admin/media"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Media.View)]
@using SIMF.Common.Enums
@using SIMF.Contracts.Media

<PageTitle>@L["Admin.Media.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Media.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <div class="simf-toast">
                    <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
                </div>
            }

            <SimfDataGrid TItem="AdminMediaSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => RowLabel(r))"
                          Caption="@L["Admin.Media.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Media.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary"
                          AddPermission="@PermissionCatalog.Media.Create"
                          EditPermission="@PermissionCatalog.Media.Edit"
                          DeletePermission="@PermissionCatalog.Media.Delete"
                          ImportPermission="@PermissionCatalog.Media.Import"
                          ExportPermission="@PermissionCatalog.Media.Export">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="kind"
                                        Header="@L["Admin.Media.Col.Kind"]"
                                        Sortable="true">
                        <CellTemplate>@KindLabel(context.Kind)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="title"
                                        Header="@L["Admin.Media.Col.TitleEn"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.Title) ? "—" : context.Title)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="titlearabic"
                                        Header="@L["Admin.Media.Col.TitleAr"]"
                                        Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.TitleArabic) ? "—" : context.TitleArabic)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="album"
                                        Header="@L["Admin.Media.Col.AlbumEn"]"
                                        Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.Album) ? "—" : context.Album)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="albumarabic"
                                        Header="@L["Admin.Media.Col.AlbumAr"]"
                                        Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.AlbumArabic) ? "—" : context.AlbumArabic)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="hasImage"
                                        Header="@L["Admin.Media.Col.HasImage"]">
                        <CellTemplate>
                            @if (context.HasImage)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="displayOrder"
                                        Header="@L["Admin.Media.Col.DisplayOrder"]"
                                        Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaSummary" Key="isActive"
                                        Header="@L["Admin.Media.Col.Active"]"
                                        Sortable="true">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Media.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="media"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Media.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <MediaAddEdit IsEdit="_isEdit" Initial="_target"
                          OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <MediaViewDelete IsDelete="_isDelete" Initial="_target"
                             OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
