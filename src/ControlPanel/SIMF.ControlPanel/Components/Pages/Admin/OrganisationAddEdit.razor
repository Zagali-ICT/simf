@* D-353 — reusable Organisation Add/Edit form, hosted by CrudShell (as a
   popup or a full page) from OrganisationsList.razor. Inherits
   CrudAddEditFormBase so it exposes the standard CRUD-form parameter surface
   (IsEdit / Initial / OnSuccess / OnCancel). IsEdit=false runs Create (POST);
   IsEdit=true runs Edit (PUT against Initial) and shows the IsActive checkbox.
   Supersedes the inline SimfModal form that lived in OrganisationsList. The
   bilingual lookup carries no contact columns in the grid summary, so the list
   page fetches the full detail before opening this form in Edit mode. *@
@inherits CrudAddEditFormBase<AdminOrganisationDetail>
@using SIMF.Contracts.Organisations

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.Organisations.Field.NameAr"]"
                       MaxLength="150"
                       @bind-Value="_model.NameAr" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Organisations.Field.NameEn"]"
                       MaxLength="150"
                       @bind-Value="_model.NameEn" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Organisations.Field.CommercialRegistration"]"
                       MaxLength="32"
                       @bind-Value="_model.CommercialRegistration" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Organisations.Field.Sector"]"
                       MaxLength="128"
                       @bind-Value="_model.Sector" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Organisations.Field.City"]"
                       MaxLength="128"
                       @bind-Value="_model.City" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Organisations.Field.Phone"]"
                       MaxLength="32"
                       @bind-Value="_model.Phone" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Organisations.Field.Email"]"
                       MaxLength="320"
                       @bind-Value="_model.Email" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Organisations.Field.Website"]"
                       MaxLength="512"
                       @bind-Value="_model.Website" Disabled="_busy" />

        @if (IsEdit)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.Organisations.Field.IsActive"]
            </SimfCheckbox>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.Organisations.Save"]">
            @L["Admin.Organisations.Save"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Organisations.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
