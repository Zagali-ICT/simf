@* D-166 (gap doc G4) — admin page for the two operations singletons:
   the registration gate (PDF §2.3) and the archive visibility switch
   (PDF §2.4). Both expose a single state row + a save button. *@
@page "/admin/operations"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Operations.View)]

<PageTitle>@L["Admin.Operations.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Operations.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <h2 class="simf-section-h2">@L["Admin.Operations.RegistrationGate.Heading"]</h2>
        <p class="simf-section-desc">@L["Admin.Operations.RegistrationGate.Desc"]</p>

        @* §6.16 (F-U5-007) — "Loading…" used to key off `_gate is null`, so a
           FAILED load left this section reading "Loading…" for as long as the
           admin cared to wait. The three states are now distinct. *@
        @if (_loading)
        {
            <p>@L["Admin.Operations.Loading"]</p>
        }
        else if (_gate is null)
        {
            <SimfAlert Variant="error">@(_gateError ?? L["Admin.Operations.LoadFailed"].Value)</SimfAlert>
            <div class="simf-form__actions">
                <SimfButton Type="button" Variant="secondary" OnClick="LoadAsync">
                    @L["Common.Retry"]
                </SimfButton>
            </div>
        }
        else
        {
            <div class="simf-form__fields">
                <SimfCheckbox @bind-Value="_gateIsOpen" Disabled="_busy">
                    @L["Admin.Operations.RegistrationGate.IsOpen"]
                </SimfCheckbox>
                <SimfTextField Label="@L["Admin.Operations.RegistrationGate.AutoClose"]"
                               Helper="@L["Admin.Operations.RegistrationGate.AutoCloseHint"]"
                               Type="datetime-local"
                               Value="@_gateAutoCloseInput"
                               ValueChanged="@(v => _gateAutoCloseInput = v)"
                               ValueExpression="@(() => _gateAutoCloseInput)"
                               Disabled="_busy" />
                <dl class="simf-dl">
                    <dt>@L["Admin.Operations.RegistrationGate.LastChangedAt"]</dt>
                    <dd>@_gate.LastChangedAt.FormatSaudi("dd-MM-yyyy hh:mm tt")</dd>
                </dl>
            </div>
            <div class="simf-form__actions">
                <SimfButton Type="button" OnClick="SaveGateAsync"
                            Loading="_busy"
                            LoadingLabel="@L["Admin.Operations.Saving"]">
                    @L["Admin.Operations.Save"]
                </SimfButton>
            </div>
        }

        <hr class="simf-divider" />

        <h2 class="simf-section-h2">@L["Admin.Operations.Archive.Heading"]</h2>
        <p class="simf-section-desc">@L["Admin.Operations.Archive.Desc"]</p>

        @if (_loading)
        {
            <p>@L["Admin.Operations.Loading"]</p>
        }
        else if (_archive is null)
        {
            <SimfAlert Variant="error">@(_archiveError ?? L["Admin.Operations.LoadFailed"].Value)</SimfAlert>
            <div class="simf-form__actions">
                <SimfButton Type="button" Variant="secondary" OnClick="LoadAsync">
                    @L["Common.Retry"]
                </SimfButton>
            </div>
        }
        else
        {
            <div class="simf-form__fields">
                <SimfCheckbox @bind-Value="_archiveIsVisible" Disabled="_busy">
                    @L["Admin.Operations.Archive.IsVisible"]
                </SimfCheckbox>
                <dl class="simf-dl">
                    <dt>@L["Admin.Operations.Archive.LastChangedAt"]</dt>
                    <dd>@_archive.LastChangedAt.FormatSaudi("dd-MM-yyyy hh:mm tt")</dd>
                </dl>
            </div>
            <div class="simf-form__actions">
                <SimfButton Type="button" OnClick="SaveArchiveAsync"
                            Loading="_busy"
                            LoadingLabel="@L["Admin.Operations.Saving"]">
                    @L["Admin.Operations.Save"]
                </SimfButton>
            </div>
        }
    </div>
</div>
