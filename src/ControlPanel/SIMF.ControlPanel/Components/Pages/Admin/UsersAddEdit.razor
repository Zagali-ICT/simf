@* D-353 — reusable Admin-user Add/Edit form, hosted by CrudShell (popup or full
   page) from UsersList. Inherits CrudAddEditFormBase<AdminUserSummary> so it
   exposes the standard CRUD-form surface (IsEdit / Initial / OnSuccess /
   OnCancel). This is an account/security page: the two modes call the EXACT same
   routes + DTOs the inline SimfModal forms used, byte-for-byte —
     • IsEdit=false → Add a new Control-Panel admin via the existing reusable
       CreateAdminForm (POST /account/api/admin/admins through CreateAdminForm).
       Its OnSuccess(AdminCreateUserResponse) is bridged to this form's OnSuccess
       carrying the Initial row (null in Add mode) so the host reloads the grid.
     • IsEdit=true → Edit the user's RBAC roles (Issue-1): load the assignable
       roles + the user's current roles, then PUT /account/api/admin/admins/{id}/roles
       with the complete set. Identical load/save logic, identical routes. *@
@inherits CrudAddEditFormBase<AdminUserSummary>

@if (!IsEdit)
{
    @* Add — host the same reusable CreateAdminForm the inline Add modal used.
       It owns its own validation, EditForm, alerts and POST. *@
    <CreateAdminForm OnSuccess="OnCreatedAsync"
                     OnCancel="OnCancel"
                     CancelLabel="@L["Admin.Users.Add.Close"]" />
}
else
{
    @* Edit roles — the exact RBAC-roles editor lifted from the inline modal. *@
    @if (_editError is not null)
    {
        <SimfAlert Variant="error">@_editError</SimfAlert>
    }
    @if (_editLoading)
    {
        <p>@L["Admin.Users.EditRoles.Loading"]</p>
    }
    else if (_availableRoles.Count == 0)
    {
        <p>@L["Admin.Users.EditRoles.NoRoles"]</p>
    }
    else
    {
        <p>@L["Admin.Users.EditRoles.Intro"]</p>
        @foreach (var roleName in _availableRoles)
        {
            <SimfCheckbox Value="_editSelectedRoles.Contains(roleName)"
                          ValueChanged="@((bool on) => ToggleEditRole(roleName, on))"
                          Disabled="_editBusy">
                @roleName
            </SimfCheckbox>
        }
    }

    <div class="simf-form__actions">
        <SimfButton Type="button" Variant="primary" Loading="_editBusy"
                    LoadingLabel="@L["Admin.Users.EditRoles.Saving"]"
                    Disabled="@(_editLoading || _availableRoles.Count == 0)"
                    OnClick="SaveRolesAsync">
            @L["Admin.Users.EditRoles.Save"]
        </SimfButton>
        <SimfButton Type="button" Variant="secondary" Disabled="_editBusy" OnClick="OnCancel">
            @L["Admin.Users.EditRoles.Cancel"]
        </SimfButton>
    </div>
}
