@* D-169 (gap doc G6) — moderator's live Q&A desk for one session.
   Routed by session id; the API enforces the per-session permission
   grant (or Administrator bypass). *@
@page "/sessions/{SessionId:guid}/moderate"
@layout CpShellLayout
@* M6 (security) — per-page permission gate (was [Authorize] only). The API also
   enforces the per-session moderator / Administrator check; this keeps the CP
   convention (only Questions.Moderate holders reach the desk + see the actions). *@
@attribute [RequirePermission(PermissionCatalog.Questions.Moderate)]

<PageTitle>@L["Admin.SessionModeration.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.SessionModeration.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <div class="simf-form__actions">
            <SimfButton Type="button" OnClick="LoadAsync" Disabled="_loading">
                @L["Admin.SessionModeration.Refresh"]
            </SimfButton>
        </div>

        @if (_loading)
        {
            <p>@L["Admin.SessionModeration.Loading"]</p>
        }
        else if (_rows.Count == 0)
        {
            <SimfEmptyState Title="@L["Admin.SessionModeration.None"]" />
        }
        else
        {
            <table class="simf-table">
                <thead>
                    <tr>
                        <th>@L["Admin.SessionModeration.Col.Order"]</th>
                        <th>@L["Admin.SessionModeration.Col.Submitter"]</th>
                        <th>@L["Admin.SessionModeration.Col.Question"]</th>
                        <th>@L["Admin.SessionModeration.Col.State"]</th>
                        <th>@L["Admin.SessionModeration.Col.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Order</td>
                            <td>@row.SubmittedByDisplayName <small>(@(row.SubmittedByEmail ?? "—"))</small></td>
                            <td>@row.QuestionText</td>
                            <td>
                                @if (row.IsHidden)
                                {
                                    <span>@L["Admin.SessionModeration.State.Hidden"]</span>
                                }
                                else if (row.IsPushed)
                                {
                                    <span>@L["Admin.SessionModeration.Pushed"]</span>
                                }
                                else
                                {
                                    <span>@L["Admin.SessionModeration.State.Queued"]</span>
                                }
                            </td>
                            <td>
                                <AuthorizedAction Permission="@PermissionCatalog.Questions.Moderate">
                                    @if (!row.IsHidden)
                                    {
                                        <SimfButton Type="button"
                                                    OnClick="@(() => SetHiddenAsync(row, true))">
                                            @L["Admin.SessionModeration.Hide"]
                                        </SimfButton>
                                    }
                                    else
                                    {
                                        <SimfButton Type="button"
                                                    OnClick="@(() => SetHiddenAsync(row, false))">
                                            @L["Admin.SessionModeration.Unhide"]
                                        </SimfButton>
                                    }
                                    @if (!row.IsPushed && !row.IsHidden)
                                    {
                                        <SimfButton Type="button"
                                                    OnClick="@(() => PushAsync(row))">
                                            @L["Admin.SessionModeration.Push"]
                                        </SimfButton>
                                    }
                                </AuthorizedAction>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
