@* D-176 (gap doc G12) — AI prompt catalogue: create / edit / view /
   deactivate, plus a per-row dry-run test. The owner ask was "manage all AI in
   one place, dynamically" — this is that one place. Centralized dialog/full-page
   framing D-353: Add / Edit / View / Delete are hosted by CrudShell, which
   frames the reusable AiPromptsAddEdit and AiPromptsViewDelete forms as a popup
   or a full page per the admin's toolbar choice (persisted in localStorage via
   CpPreferences). The inline SimfModal Add/Edit form + one-click delete it used
   to carry are gone; the standalone Test modal stays (it is not a CRUD step). *@
@page "/admin/ai/prompts"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.AiPrompts.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject CpPreferences Prefs

<PageTitle>@L["Admin.AiPrompts.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.AiPrompts.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminAiPromptSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Key)"
                          Caption="@L["Admin.AiPrompts.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.AiPrompts.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="key"
                                        Header="@L["Admin.AiPrompts.Col.Key"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate><code>@context.Key</code></CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="feature"
                                        Header="@L["Admin.AiPrompts.Col.Feature"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Feature</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="displayName"
                                        Header="@L["Admin.AiPrompts.Col.DisplayName"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.DisplayName</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="provider"
                                        Header="@L["Admin.AiPrompts.Col.Provider"]"
                                        Sortable="true">
                        <CellTemplate>@context.Provider</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="model"
                                        Header="@L["Admin.AiPrompts.Col.Model"]">
                        <CellTemplate>@context.Model</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="version"
                                        Header="@L["Admin.AiPrompts.Col.Version"]"
                                        Sortable="true">
                        <CellTemplate>v@(context.Version)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="isActive"
                                        Header="@L["Admin.AiPrompts.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Admin.AiPrompts.Active.Yes"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Admin.AiPrompts.Active.No"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <RowActions>
                    @* Page-specific quiet action: run the prompt against test inputs. *@
                    <AuthorizedAction Permission="@PermissionCatalog.AiPrompts.Test">
                        <SimfToolbarButton Icon="flask" Title="@L["Admin.AiPrompts.Test"]"
                                           OnClick="@(() => OnTestAsync(context))" />
                    </AuthorizedAction>
                </RowActions>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.AiPrompts.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.AiPrompts.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <AiPromptsAddEdit IsEdit="_isEdit" Initial="_target"
                              OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <AiPromptsViewDelete IsDelete="_isDelete" Initial="_target"
                                 OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@if (_testOpen)
{
    <SimfModal Open="true" Title="@L["Admin.AiPrompts.Test.Title"]"
               OnClose="OnTestModalClose">
        <ChildContent>
            <div class="simf-form__fields">
                <p><code>@_testTargetKey</code></p>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.AiPrompts.Test.InputsLabel"]</span>
                    <textarea class="simf-field__input" rows="5"
                              value="@_testInputsRaw"
                              @onchange="OnTestInputsChanged"
                              disabled="@_busy"></textarea>
                </label>
                @if (_testResult is not null)
                {
                    <dl class="simf-dl">
                        <dt>@L["Admin.AiPrompts.Test.Output"]</dt>
                        <dd><pre class="simf-pre--wrap">@_testResult.OutputText</pre></dd>
                        <dt>@L["Admin.AiPrompts.Test.Latency"]</dt>
                        <dd>@(_testResult.LatencyMs)ms</dd>
                        <dt>@L["Admin.AiPrompts.Test.Tokens"]</dt>
                        <dd>@(_testResult.TokensInput?.ToString() ?? "—") / @(_testResult.TokensOutput?.ToString() ?? "—")</dd>
                    </dl>
                }
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="OnTestModalClose">
                @L["Admin.AiPrompts.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="RunTestAsync" Loading="_busy">
                @L["Admin.AiPrompts.Test.Action"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private enum FormKind { None, AddEdit, ViewDelete }

    private const string PageKey = "ai-prompts";

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminAiPromptSummary> _page = new();
    private bool _loading;
    private bool _busy;
    private Toast? _toast;

    private CrudPresentation _presentation = CrudPresentation.Dialog;
    private FormKind _form = FormKind.None;
    private bool _isEdit;
    private bool _isDelete;
    private AdminAiPromptDetail? _target;

    private bool FormOpen => _form != FormKind.None;
    private bool GridHidden => FormOpen && _presentation == CrudPresentation.Page;

    private bool _testOpen;
    private Guid _testTargetId;
    private string _testTargetKey = string.Empty;
    private string _testInputsRaw = string.Empty;
    private AiCallResult? _testResult;

    private string FormTitle => _form switch
    {
        FormKind.AddEdit => _isEdit
            ? L["Admin.AiPrompts.Edit.Title"]
            : L["Admin.AiPrompts.Add.Title"],
        FormKind.ViewDelete => _isDelete
            ? L["Admin.AiPrompts.Delete.Title"]
            : L["Admin.AiPrompts.Details.Title"],
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _presentation = await Prefs.GetPresentationAsync(PageKey);
        await LoadAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminAiPromptSummary>>>(
                "simfAccount.postJson", "/account/api/admin/ai/prompts/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.AiPrompts.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _toast = null;
        _form = FormKind.AddEdit;
        _isEdit = false;
        _target = null;
        return Task.CompletedTask;
    }

    private async Task OnEditAsync(AdminAiPromptSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.AddEdit;
        _isEdit = true;
        _target = detail;
    }

    private async Task OnDetailsAsync(AdminAiPromptSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = false;
        _target = detail;
    }

    private async Task OnDeleteAsync(AdminAiPromptSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = true;
        _target = detail;
    }

    // Edit / View / Delete all work against the full detail (the grid carries a
    // summary that lacks SystemPrompt / UserPromptTemplate / Description).
    // Returns null and surfaces a toast on failure.
    private async Task<AdminAiPromptDetail?> LoadDetailAsync(Guid id)
    {
        _toast = null;
        var env = await JS.InvokeAsync<ApiResult<AdminAiPromptDetail>>(
            "simfAccount.getJson", $"/account/api/admin/ai/prompts/{id}");
        if (env is { Success: true, Data: not null })
        {
            return env.Data;
        }
        _toast = new Toast("error",
            env?.Error?.MessageForCurrentCulture()
            ?? L["Admin.AiPrompts.LoadFailed"]);
        return null;
    }

    private void CloseForm()
    {
        _form = FormKind.None;
        _target = null;
    }

    private async Task OnSavedAsync(AdminAiPromptDetail saved)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.AiPrompts.Saved"]);
        await LoadAsync();
    }

    private async Task OnDeletedAsync(AdminAiPromptDetail deleted)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.AiPrompts.Deleted"]);
        await LoadAsync();
    }

    private void OnTestAsync(AdminAiPromptSummary row)
    {
        _testOpen = true;
        _testTargetId = row.Id;
        _testTargetKey = row.Key;
        _testInputsRaw = string.Empty;
        _testResult = null;
    }

    private void OnTestModalClose()
    {
        _testOpen = false;
        _testTargetId = Guid.Empty;
        _testTargetKey = string.Empty;
        _testInputsRaw = string.Empty;
        _testResult = null;
    }

    private async Task RunTestAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var inputs = new Dictionary<string, string>();
            foreach (var line in (_testInputsRaw ?? string.Empty)
                .Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                var eq = line.IndexOf('=');
                if (eq <= 0) continue;
                inputs[line[..eq].Trim()] = line[(eq + 1)..].Trim();
            }
            var env = await JS.InvokeAsync<ApiResult<AiCallResult>>(
                "simfAccount.postJson",
                $"/account/api/admin/ai/prompts/{_testTargetId}/test",
                new TestAiPromptRequest { Inputs = inputs });
            if (env is { Success: true, Data: not null })
            {
                _testResult = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.AiPrompts.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private void OnTestInputsChanged(ChangeEventArgs e) =>
        _testInputsRaw = e.Value?.ToString() ?? string.Empty;
}
