@* D-176 (gap doc G12) — AI prompt catalogue: create / edit / view /
   deactivate, plus a per-row dry-run test. The owner ask was "manage all AI in
   one place, dynamically" — this is that one place. Centralized dialog/full-page
   framing D-353: Add / Edit / View / Delete are hosted by CrudShell, which
   frames the reusable AiPromptsAddEdit and AiPromptsViewDelete forms as a popup
   or a full page per the admin's toolbar choice (persisted in localStorage via
   CpPreferences). The inline SimfModal Add/Edit form + one-click delete it used
   to carry are gone; the standalone Test modal stays (it is not a CRUD step). *@
@page "/admin/ai/prompts"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.AiPrompts.View)]

<PageTitle>@L["Admin.AiPrompts.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.AiPrompts.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminAiPromptSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Key)"
                          Caption="@L["Admin.AiPrompts.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.AiPrompts.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="key"
                                        Header="@L["Admin.AiPrompts.Col.Key"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate><code>@context.Key</code></CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="feature"
                                        Header="@L["Admin.AiPrompts.Col.Feature"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Feature</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="displayName"
                                        Header="@L["Admin.AiPrompts.Col.DisplayName"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.DisplayName</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="provider"
                                        Header="@L["Admin.AiPrompts.Col.Provider"]"
                                        Sortable="true">
                        <CellTemplate>@context.Provider</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="model"
                                        Header="@L["Admin.AiPrompts.Col.Model"]">
                        <CellTemplate>@context.Model</CellTemplate>
                    </SimfDataGridColumn>
                    @* Hybrid visibility: where this service runs (cloud / on-prem /
                       offline) + a residency warning when a sensitive feature routes
                       to a definitely-cloud provider. Derived CP-side; no schema. *@
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="hosting"
                                        Header="@L["Admin.AiPrompts.Col.Hosting"]">
                        <CellTemplate>
                            <SimfPill Variant="@AiHosting.Variant(context.Provider)">
                                @L[AiHosting.LabelKey(context.Provider)]
                            </SimfPill>
                            @if (AiHosting.IsResidencyRisk(context.Feature, context.Provider))
                            {
                                <SimfPill Variant="danger">@L["Admin.AiPrompts.Hosting.Risk"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="version"
                                        Header="@L["Admin.AiPrompts.Col.Version"]"
                                        Sortable="true">
                        <CellTemplate>v@(context.Version)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminAiPromptSummary" Key="isActive"
                                        Header="@L["Admin.AiPrompts.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Admin.AiPrompts.Active.Yes"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Admin.AiPrompts.Active.No"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <RowActions>
                    @* Page-specific quiet action: run the prompt against test inputs. *@
                    <AuthorizedAction Permission="@PermissionCatalog.AiPrompts.Test">
                        <SimfToolbarButton Icon="flask" Title="@L["Admin.AiPrompts.Test"]"
                                           OnClick="@(() => OnTestAsync(context))" />
                    </AuthorizedAction>
                    @* Surface the append-only version history (D-188). The endpoint
                       gates on AiPrompts.View, so the action does too. *@
                    <AuthorizedAction Permission="@PermissionCatalog.AiPrompts.View">
                        <SimfToolbarButton Icon="clock" Title="@L["Admin.AiPrompts.History"]"
                                           OnClick="@(() => OnHistoryAsync(context))" />
                    </AuthorizedAction>
                </RowActions>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.AiPrompts.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="ai/prompts"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.AiPrompts.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <AiPromptsAddEdit IsEdit="_isEdit" Initial="_target"
                              OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <AiPromptsViewDelete IsDelete="_isDelete" Initial="_target"
                                 OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@if (_testOpen)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.AiPrompts.Test.Title"]"
               OnClose="OnTestModalClose">
        <ChildContent>
            <div class="simf-form__fields">
                <p><code>@_testTargetKey</code></p>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.AiPrompts.Test.InputsLabel"]</span>
                    <textarea class="simf-field__input" rows="5"
                              value="@_testInputsRaw"
                              @onchange="OnTestInputsChanged"
                              disabled="@_busy"></textarea>
                </label>
                @if (_testResult is not null)
                {
                    <dl class="simf-dl">
                        <dt>@L["Admin.AiPrompts.Test.Output"]</dt>
                        <dd><pre class="simf-pre--wrap">@_testResult.OutputText</pre></dd>
                        <dt>@L["Admin.AiPrompts.Test.Latency"]</dt>
                        <dd>@(_testResult.LatencyMs)ms</dd>
                        <dt>@L["Admin.AiPrompts.Test.Tokens"]</dt>
                        <dd>@(_testResult.TokensInput?.ToString() ?? "—") / @(_testResult.TokensOutput?.ToString() ?? "—")</dd>
                    </dl>
                }
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="OnTestModalClose">
                @L["Admin.AiPrompts.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="RunTestAsync" Loading="_busy">
                @L["Admin.AiPrompts.Test.Action"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_historyOpen)
{
    <SimfModal Open="true" Title="@L["Admin.AiPrompts.History.Title"]" OnClose="CloseHistory">
        <ChildContent>
            <p><code>@_historyKey</code></p>
            @if (_history.Count == 0)
            {
                <SimfEmptyState Title="@L["Admin.AiPrompts.History.Empty"]" />
            }
            else
            {
                <table class="simf-table">
                    <thead>
                        <tr>
                            <th>@L["Admin.AiPrompts.Col.Version"]</th>
                            <th>@L["Admin.AiPrompts.Col.Provider"]</th>
                            <th>@L["Admin.AiPrompts.Col.Model"]</th>
                            <th>@L["Admin.AiPrompts.Col.Active"]</th>
                            <th>@L["Admin.AiPrompts.History.Col.Authored"]</th>
                            <th>@L["Admin.AiPrompts.History.Col.Hash"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in _history)
                        {
                            <tr>
                                <td>v@(h.Version)</td>
                                <td>@h.Provider</td>
                                <td>@h.Model</td>
                                <td>@(h.IsActive ? "✓" : "—")</td>
                                <td>@h.CapturedFromUpdatedAt.FormatSaudi("yyyy-MM-dd HH:mm")</td>
                                <td><code>@ShortHash(h.ContentHash)</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="CloseHistory">
                @L["Admin.AiPrompts.Details.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
