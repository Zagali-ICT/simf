@* Reusable Archive (Past Editions) Add/Edit form, hosted by CrudShell
   (as a popup or a full page) from ArchiveList.razor. Inherits
   CrudAddEditFormBase so it exposes the standard CRUD-form parameter surface
   (IsEdit / Initial / OnSuccess / OnCancel). IsEdit=false runs Create (POST);
   IsEdit=true runs Edit (PUT against Initial) and shows the IsActive checkbox.
   Supersedes the inline SimfModal form that lived in ArchiveList. Each edition
   carries a year, bilingual title + summary, the headline attendees / sessions
   / speakers counts, an optional cover-image relative path, place + date label,
   and the active flag that gates public visibility. *@
@inherits CrudAddEditFormBase<AdminArchiveEditionSummary>
@using SIMF.Contracts.Archive

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Archive.Field.Year"]</span>
            <input class="simf-field__input" type="number" min="2000" max="2100"
                   value="@_model.Year"
                   @onchange="OnYearChanged"
                   disabled="@_busy" />
        </label>
        <SimfTextField Label="@L["Admin.Archive.Field.TitleEn"]"
                       @bind-Value="_model.TitleEn" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Archive.Field.TitleAr"]"
                       @bind-Value="_model.TitleAr" Disabled="_busy" />
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Archive.Field.SummaryEn"]</span>
            <textarea class="simf-field__input" rows="4"
                      value="@_model.SummaryEn"
                      @onchange="OnSummaryEnChanged"
                      disabled="@_busy"></textarea>
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Archive.Field.SummaryAr"]</span>
            <textarea class="simf-field__input" rows="4"
                      value="@_model.SummaryAr"
                      @onchange="OnSummaryArChanged"
                      disabled="@_busy"></textarea>
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Archive.Field.Attendees"]</span>
            <input class="simf-field__input" type="number" min="0" max="1000000"
                   value="@_model.Attendees"
                   @onchange="OnAttendeesChanged"
                   disabled="@_busy" />
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Archive.Field.Sessions"]</span>
            <input class="simf-field__input" type="number" min="0" max="1000000"
                   value="@_model.Sessions"
                   @onchange="OnSessionsChanged"
                   disabled="@_busy" />
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Archive.Field.Speakers"]</span>
            <input class="simf-field__input" type="number" min="0" max="1000000"
                   value="@_model.Speakers"
                   @onchange="OnSpeakersChanged"
                   disabled="@_busy" />
        </label>
        @* Place + date label for the edition detail.
           MaxLength mirrors EF HasMaxLength + FluentValidation (256/128). *@
        <SimfTextField Label="@L["Admin.Archive.Field.LocationEn"]"
                       MaxLength="256"
                       @bind-Value="_model.LocationEn" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Archive.Field.LocationAr"]"
                       MaxLength="256"
                       @bind-Value="_model.LocationAr" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Archive.Field.DateLabelEn"]"
                       MaxLength="128"
                       @bind-Value="_model.DateLabelEn" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Archive.Field.DateLabelAr"]"
                       MaxLength="128"
                       @bind-Value="_model.DateLabelAr" Disabled="_busy" />
        @* Gallery and past speakers are per-row editors, not free text. Each row
           owns its picture as an uploaded file, and a file needs a row id to
           belong to - which a line of text cannot carry. Session titles carry no
           media, so they remain line-delimited "arabic | english". *@
        <SimfRepeater TItem="ArchiveMediaItemInput" Items="_model.Gallery"
                      IndexLabel="@L["Admin.Archive.Gallery.IndexLabel"]"
                      EmptyText="@L["Admin.Archive.Gallery.Empty"]"
                      AddLabel="@L["Admin.Archive.Gallery.Add"]" Disabled="_busy"
                      MoveUpLabel="@L["Grid.MoveUp"]"
                      MoveDownLabel="@L["Grid.MoveDown"]"
                      RemoveLabel="@L["Grid.Remove"]"
                      OnAdd="AddGalleryRow" OnRemove="RemoveGalleryRow"
                      OnMove="@(m => MoveGalleryRow(m.Item, m.Delta))">
            <RowTemplate Context="row">
                <div class="simf-form__grid">
                    <label class="simf-field">
                        <span class="simf-field__label">@L["Admin.Archive.Gallery.Kind"]</span>
                        <select class="simf-field__input" disabled="@_busy"
                                value="@row.Kind"
                                @onchange="@(e => row.Kind = e.Value?.ToString() == "1" ? 1 : 0)">
                            <option value="0">@L["Admin.Archive.Gallery.KindImage"]</option>
                            <option value="1">@L["Admin.Archive.Gallery.KindVideo"]</option>
                        </select>
                    </label>
                    <SimfTextField Label="@L["Admin.Archive.Gallery.Caption"]" MaxLength="256"
                                   @bind-Value="row.CaptionAr" Disabled="_busy" />
                    @if (row.Kind == 1)
                    {
                        @* A video is hosted elsewhere, so the admin supplies its
                           link; the store validates it against the same rule the
                           players apply. *@
                        <div class="simf-form__grid-item--full">
                            <SimfTextField Label="@L["Admin.Archive.Gallery.VideoUrl"]" MaxLength="1024"
                                           @bind-Value="row.Url" Disabled="_busy" />
                        </div>
                    }
                    else if (row.Id is { } galleryId)
                    {
                        <div class="simf-form__grid-item--full">
                            <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
                            <SimfImageUpload Category="ArchiveGalleryImage" OwnerId="@galleryId"
                                             Alt="@row.CaptionAr" />
                        </div>
                    }
                    else
                    {
                        <div class="simf-form__grid-item--full">
                            <p class="simf-field__hint">@L["Admin.Asset.SaveFirst"]</p>
                        </div>
                    }
                </div>
            </RowTemplate>
        </SimfRepeater>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Archive.Field.SessionTitles"]</span>
            <textarea class="simf-field__input" rows="4"
                      placeholder="أمن الموانئ | Port security"
                      value="@_model.SessionTitlesText"
                      @onchange="@(e => _model.SessionTitlesText = e.Value?.ToString() ?? string.Empty)"
                      disabled="@_busy"></textarea>
        </label>
        <SimfRepeater TItem="ArchivePastSpeakerInput" Items="_model.PastSpeakers"
                      IndexLabel="@L["Admin.Archive.PastSpeaker.IndexLabel"]"
                      EmptyText="@L["Admin.Archive.PastSpeaker.Empty"]"
                      AddLabel="@L["Admin.Archive.PastSpeaker.Add"]" Disabled="_busy"
                      MoveUpLabel="@L["Grid.MoveUp"]"
                      MoveDownLabel="@L["Grid.MoveDown"]"
                      RemoveLabel="@L["Grid.Remove"]"
                      OnAdd="AddPastSpeakerRow" OnRemove="RemovePastSpeakerRow"
                      OnMove="@(m => MovePastSpeakerRow(m.Item, m.Delta))">
            <RowTemplate Context="row">
                <div class="simf-form__grid">
                    <SimfTextField Label="@L["Admin.Archive.PastSpeaker.NameAr"]" MaxLength="128"
                                   @bind-Value="row.NameAr" Disabled="_busy" />
                    <SimfTextField Label="@L["Admin.Archive.PastSpeaker.NameEn"]" MaxLength="128"
                                   @bind-Value="row.NameEn" Disabled="_busy" />
                    @* ISO 3166-1 numeric (682 = Saudi Arabia), driving the app's
                       corner flag. An unknown code is dropped to null server-side
                       rather than failing the save. *@
                    <label class="simf-field">
                        <span class="simf-field__label">@L["Admin.Archive.PastSpeaker.CountryId"]</span>
                        <input class="simf-field__input" type="number" disabled="@_busy"
                               value="@(row.CountryId?.ToString() ?? string.Empty)"
                               @onchange="@(e => row.CountryId =
                                   int.TryParse(e.Value?.ToString(), out var c) ? c : null)" />
                    </label>
                    @if (row.Id is { } speakerId)
                    {
                        <div class="simf-form__grid-item--full">
                            <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
                            <SimfImageUpload Category="ArchivePastSpeakerPhoto" OwnerId="@speakerId"
                                             Alt="@row.NameEn" />
                        </div>
                    }
                    else
                    {
                        <div class="simf-form__grid-item--full">
                            <p class="simf-field__hint">@L["Admin.Asset.SaveFirst"]</p>
                        </div>
                    }
                </div>
            </RowTemplate>
        </SimfRepeater>
        @if (IsEdit)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.Archive.Field.IsActive"]
            </SimfCheckbox>
        }
        @* Cover image via the unified media-asset pipeline (edit only; the
           row must exist before bytes can be attached). *@
        @if (IsEdit && Initial is not null)
        {
            <div class="simf-field">
                <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
                <SimfImageUpload Category="ArchiveCover" OwnerId="@Initial.Id" Alt="@_model.TitleEn" />
            </div>
        }
        else
        {
            @* Create mode: the row must exist before bytes can be attached, so
               show the slot and say so rather than nothing at all. Matches
               SpeakersAddEdit. *@
            <div class="simf-photo-empty">
                <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
                <SimfImageThumb Class="simf-img-thumb--lg" Alt="@_model.TitleEn" />
                <span class="simf-field__helper">@L["Admin.Asset.SaveFirst"]</span>
            </div>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.Archive.Save"]">
            @L["Admin.Archive.Save"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Archive.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
