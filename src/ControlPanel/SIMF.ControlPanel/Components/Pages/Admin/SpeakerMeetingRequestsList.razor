@* D-269 (Mockup page 20 "Speaker profile") — admin queue for meeting requests
   submitted TO a speaker (gated by Speaker.AllowsMeetingRequests). Distinct from
   the session-scoped /admin/meeting-requests queue. Respond modal accepts /
   rejects with an optional note; Pending → Pending is rejected server-side
   (SPEAKER_MEETING_REQUEST_STATUS_INVALID). SimfDataGrid (server-paged, sortable
   + filterable, full pager); the Respond action is a quiet reply button shown
   only for Pending rows. Mirrors MeetingRequestsList.razor. *@
@page "/admin/speaker-meeting-requests"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.SpeakerMeetingRequests.View)]
@using SIMF.Contracts.Programme
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.SpeakerMeetingRequests.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.SpeakerMeetingRequests.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminSpeakerMeetingRequestRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.RequesterName)"
                      Caption="@L["Admin.SpeakerMeetingRequests.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      OnExport="OnExportAsync"
                      ExportLabel="@L["Grid.Export"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.SpeakerMeetingRequests.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="speaker"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.Speaker"]">
                    <CellTemplate>@context.SpeakerName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="requesterName"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.Requester"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.RequesterName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="subject"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.Subject"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Subject</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="status"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.Status"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>
                        @switch (context.Status)
                        {
                            case MeetingRequestStatus.Pending:
                                <SimfPill Variant="warn">@L["Admin.SpeakerMeetingRequests.Filter.Pending"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Accepted:
                                <SimfPill Variant="on">@L["Admin.SpeakerMeetingRequests.Filter.Accepted"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Rejected:
                                <SimfPill Variant="off">@L["Admin.SpeakerMeetingRequests.Filter.Rejected"]</SimfPill>
                                break;
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="createdAt"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.CreatedAt"]"
                                    Sortable="true">
                    <CellTemplate>@context.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="respondedAt"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.RespondedAt"]"
                                    Sortable="true">
                    <CellTemplate>
                        @(context.RespondedAt is null ? "—"
                            : context.RespondedAt.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'"))
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @* Page-specific quiet action: respond (accept / reject) to a
                   Pending request. Only Pending rows can transition. *@
                @if (context.Status == MeetingRequestStatus.Pending)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.SpeakerMeetingRequests.Manage">
                        <SimfToolbarButton Icon="reply" Title="@L["Admin.SpeakerMeetingRequests.Respond"]"
                                           OnClick="@(() => OnRespondAsync(context))" />
                    </AuthorizedAction>
                }
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.SpeakerMeetingRequests.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_respondOpen && _respondTarget is not null)
{
    <SimfModal Open="true" Title="@L["Admin.SpeakerMeetingRequests.Respond.Title"]"
               OnClose="@(() => _respondOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <dl class="simf-dl">
                    <dt>@L["Admin.SpeakerMeetingRequests.Col.Speaker"]</dt>
                    <dd>@_respondTarget.SpeakerName</dd>
                    <dt>@L["Admin.SpeakerMeetingRequests.Col.Requester"]</dt>
                    <dd>
                        <div>@_respondTarget.RequesterName</div>
                        @if (_loadingDetail)
                        {
                            <div class="simf-table__sub">@L["Admin.SpeakerMeetingRequests.LoadingDetail"]</div>
                        }
                        else if (!string.IsNullOrEmpty(_respondTarget.RequesterEmail))
                        {
                            <div class="simf-table__sub">@_respondTarget.RequesterEmail</div>
                        }
                    </dd>
                    <dt>@L["Admin.SpeakerMeetingRequests.Col.Subject"]</dt>
                    <dd>@_respondTarget.Subject</dd>
                </dl>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.SpeakerMeetingRequests.Respond.Status"]</span>
                    <select class="simf-field__input" value="@((int)_respondStatus)"
                            @onchange="OnRespondStatusChanged" disabled="@_busy">
                        <option value="@((int)MeetingRequestStatus.Accepted)">
                            @L["Admin.SpeakerMeetingRequests.Respond.Accept"]
                        </option>
                        <option value="@((int)MeetingRequestStatus.Rejected)">
                            @L["Admin.SpeakerMeetingRequests.Respond.Reject"]
                        </option>
                    </select>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.SpeakerMeetingRequests.Respond.Note"]</span>
                    <textarea class="simf-field__input" rows="4"
                              value="@_respondNote"
                              @onchange="OnRespondNoteChanged"
                              disabled="@_busy"></textarea>
                </label>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                        OnClick="@(() => _respondOpen = false)">
                @L["Admin.SpeakerMeetingRequests.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SendResponseAsync" Loading="_busy">
                @L["Admin.SpeakerMeetingRequests.Respond.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminSpeakerMeetingRequestRow> _page = new();
    private bool _loading;
    private bool _busy;
    private Toast? _toast;

    private bool _respondOpen;
    // PII (requester email) is fetched on demand into the detail shape; list
    // rows do not carry email (the D-185 pattern).
    private AdminSpeakerMeetingRequestDetail? _respondTarget;
    private bool _loadingDetail;
    private MeetingRequestStatus _respondStatus = MeetingRequestStatus.Accepted;
    private string _respondNote = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminSpeakerMeetingRequestRow>>>(
                "simfAccount.postJson",
                "/account/api/admin/speaker-meeting-requests/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.SpeakerMeetingRequests.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    // D-356 — Excel export (selected rows, or the current filtered set). Direct
    // download via the generic /export proxy. Export only — speaker meeting
    // requests are created from the app + responded to in the CP, so there is
    // no import path.
    private Task OnExportAsync(IReadOnlyList<AdminSpeakerMeetingRequestRow> selected) =>
        JS.InvokeVoidAsync("simfAccount.downloadXlsx",
            "/account/api/admin/speaker-meeting-requests/export",
            new AdminGridExportRequest
            {
                Ids = selected.Select(row => row.Id).ToList(),
                Query = selected.Count == 0 ? _query : null,
            }).AsTask();

    private async Task OnRespondAsync(AdminSpeakerMeetingRequestRow row)
    {
        // Open the modal with what the row carries (no email yet), then fetch
        // the detail (with email) in the background — one audited Viewed event
        // per click (D-185 pattern).
        _respondTarget = new AdminSpeakerMeetingRequestDetail(
            row.Id, row.SpeakerId, row.SpeakerName, row.SpeakerNameArabic,
            row.RequestedByUserId, row.RequesterName, RequesterEmail: null,
            row.Subject, row.Status, row.ResponseNote,
            row.CreatedAt, row.RespondedAt);
        _respondStatus = MeetingRequestStatus.Accepted;
        _respondNote = string.Empty;
        _respondOpen = true;
        _loadingDetail = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminSpeakerMeetingRequestDetail>>(
                "simfAccount.getJson",
                $"/account/api/admin/speaker-meeting-requests/{row.Id}");
            if (env is { Success: true, Data: not null } && _respondOpen
                && _respondTarget?.Id == row.Id)
            {
                _respondTarget = env.Data;
            }
        }
        finally { _loadingDetail = false; }
    }

    private void OnRespondStatusChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            _respondStatus = (MeetingRequestStatus)v;
        }
    }

    private void OnRespondNoteChanged(ChangeEventArgs e) =>
        _respondNote = e.Value?.ToString() ?? string.Empty;

    private async Task SendResponseAsync()
    {
        if (_respondTarget is null || _busy) return;
        _busy = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminSpeakerMeetingRequestDetail>>(
                "simfAccount.putJson",
                $"/account/api/admin/speaker-meeting-requests/{_respondTarget.Id}/respond",
                new RespondToSpeakerMeetingRequestRequest
                {
                    Status = _respondStatus,
                    ResponseNote = string.IsNullOrWhiteSpace(_respondNote)
                        ? null : _respondNote.Trim(),
                });
            if (env is { Success: true })
            {
                _respondOpen = false;
                _toast = new Toast("success", L["Admin.SpeakerMeetingRequests.Respond.Done"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.SpeakerMeetingRequests.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }
}
