@* D-269 (Mockup page 20 "Speaker profile") — admin queue for meeting requests
   submitted TO a speaker (gated by Speaker.AllowsMeetingRequests). Distinct from
   the session-scoped /admin/meeting-requests queue. Respond modal accepts /
   rejects with an optional note; Pending → Pending is rejected server-side
   (SPEAKER_MEETING_REQUEST_STATUS_INVALID). SimfDataGrid (server-paged, sortable
   + filterable, full pager); the Respond action is a quiet reply button shown
   only for Pending rows. Mirrors MeetingRequestsList.razor. *@
@page "/admin/speaker-meeting-requests"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.SpeakerMeetingRequests.View)]
@using SIMF.Contracts.Programme

<PageTitle>@L["Admin.SpeakerMeetingRequests.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.SpeakerMeetingRequests.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <div class="simf-toast">
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            </div>
        }

        <SimfDataGrid TItem="AdminSpeakerMeetingRequestRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.RequesterName)"
                      Caption="@L["Admin.SpeakerMeetingRequests.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      OnExport="OnExportAsync"
                      ExportLabel="@L["Grid.Export"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.SpeakerMeetingRequests.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="speaker"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.Speaker"]">
                    <CellTemplate>@context.SpeakerName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="requesterName"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.Requester"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.RequesterName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="subject"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.Subject"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Subject</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="status"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.Status"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>
                        <MeetingStatusPill Status="context.Status" />
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="createdAt"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.CreatedAt"]"
                                    Sortable="true">
                    <CellTemplate>@context.CreatedAt.FormatSaudi("dd-MM-yyyy hh:mm tt")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSpeakerMeetingRequestRow" Key="respondedAt"
                                    Header="@L["Admin.SpeakerMeetingRequests.Col.RespondedAt"]"
                                    Sortable="true">
                    <CellTemplate>
                        @(context.RespondedAt.FormatSaudi("dd-MM-yyyy hh:mm tt", "—"))
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @* Page-specific quiet action: respond (accept / reject) to a
                   Pending request. Only Pending rows can transition. *@
                @if (context.Status == MeetingRequestStatus.Pending)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.SpeakerMeetingRequests.Manage">
                        <SimfToolbarButton Icon="reply" Title="@L["Admin.SpeakerMeetingRequests.Respond"]"
                                           OnClick="@(() => OnRespondAsync(context))" />
                    </AuthorizedAction>
                }
                @* R-1 — an AwaitingSpeaker row is not a dead-end: the admin can re-send
                   the speaker's Approve/Reject confirmation email (fresh 72h links). *@
                else if (context.Status == MeetingRequestStatus.AwaitingSpeaker)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.SpeakerMeetingRequests.Manage">
                        <SimfToolbarButton Icon="send" Title="@L["Admin.SpeakerMeetingRequests.Resend"]"
                                           OnClick="@(() => ConfirmResend(context))" />
                    </AuthorizedAction>
                }
                @* Bi-Meeting rework — a confirmed (Accepted) meeting can be checked in
                   at the hall by an operator, flipping it to Done. *@
                else if (context.Status == MeetingRequestStatus.Accepted)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.SpeakerMeetingRequests.Manage">
                        <SimfToolbarButton Icon="log-in" Title="@L["Admin.Meetings.CheckIn"]"
                                           Disabled="_busy"
                                           OnClick="@(() => ConfirmCheckIn(context))" />
                    </AuthorizedAction>
                }
                @* QA B20 — a Rejected / Cancelled row used to carry no actions at all, so a
                   mistaken decline or a requester's cancel was unrecoverable. Reopen puts it
                   back to a clean Pending for a fresh decision (audited). *@
                else if (context.Status is MeetingRequestStatus.Rejected
                    or MeetingRequestStatus.Cancelled)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.SpeakerMeetingRequests.Manage">
                        <SimfToolbarButton Icon="rotate" Title="@L["Admin.SpeakerMeetingRequests.Reopen"]"
                                           Disabled="_busy"
                                           OnClick="@(() => ConfirmReopen(context))" />
                    </AuthorizedAction>
                }
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.SpeakerMeetingRequests.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_respondOpen && _respondTarget is not null)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.SpeakerMeetingRequests.Respond.Title"]"
               OnClose="@(() => _respondOpen = false)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <div class="simf-form__fields">
                <dl class="simf-dl">
                    <dt>@L["Admin.SpeakerMeetingRequests.Col.Speaker"]</dt>
                    <dd>@_respondTarget.SpeakerName</dd>
                    <dt>@L["Admin.SpeakerMeetingRequests.Col.Requester"]</dt>
                    <dd>
                        <div>@_respondTarget.RequesterName</div>
                        @if (_loadingDetail)
                        {
                            <div class="simf-table__sub">@L["Admin.SpeakerMeetingRequests.LoadingDetail"]</div>
                        }
                        else if (!string.IsNullOrEmpty(_respondTarget.RequesterEmail))
                        {
                            <div class="simf-table__sub">@_respondTarget.RequesterEmail</div>
                        }
                    </dd>
                    <dt>@L["Admin.SpeakerMeetingRequests.Col.Subject"]</dt>
                    <dd>@_respondTarget.Subject</dd>
                </dl>

                @* Bi-Meeting rework — the unified 3-button model. Approve / Confirm both
                   bind the meeting to a free hall slot (Approve → the speaker's own
                   confirmation link is emailed; Confirm → the admin already has the
                   speaker's verbal confirmation, so it is booked straight away).
                   Decline needs a justification. *@
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Meetings.Bind.Hall"]</span>
                    <select class="simf-field__input" value="@(_bindHallId?.ToString() ?? string.Empty)"
                            @onchange="OnBindHallChangedAsync" disabled="@_busy">
                        <option value="">@L["Admin.Meetings.Bind.PickHall"]</option>
                        @foreach (var hall in _halls)
                        {
                            <option value="@hall.Id">@hall.Name</option>
                        }
                    </select>
                </label>
                @if (_bindHallId is not null)
                {
                    <label class="simf-field">
                        <span class="simf-field__label">@L["Admin.Meetings.Bind.Slot"]</span>
                        @if (_loadingSlots)
                        {
                            <div class="simf-table__sub">@L["Admin.Meetings.Bind.LoadingSlots"]</div>
                        }
                        else if (_hallSlots.Count == 0)
                        {
                            <div class="simf-table__sub">@L["Admin.Meetings.Bind.NoSlots"]</div>
                        }
                        else
                        {
                            <select class="simf-field__input" value="@_bindSlotIndex"
                                    @onchange="OnBindSlotChanged" disabled="@_busy">
                                <option value="-1">@L["Admin.Meetings.Bind.SelectSlot"]</option>
                                @for (var i = 0; i < _hallSlots.Count; i++)
                                {
                                    <option value="@i">@FormatSlot(_hallSlots[i])</option>
                                }
                            </select>
                        }
                    </label>
                    @if (_hallTables.Count > 0)
                    {
                        <label class="simf-field">
                            <span class="simf-field__label">@L["Admin.Meetings.Bind.Table"]</span>
                            <select class="simf-field__input" value="@(_bindTableId?.ToString() ?? string.Empty)"
                                    @onchange="OnBindTableChanged" disabled="@_busy">
                                <option value="">@L["Admin.Meetings.Bind.NoTable"]</option>
                                @foreach (var table in _hallTables)
                                {
                                    <option value="@table.Id">@table.Code</option>
                                }
                            </select>
                        </label>
                    }
                }
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Meetings.Note"]</span>
                    <textarea class="simf-field__input" rows="4"
                              value="@_respondNote"
                              @onchange="OnRespondNoteChanged"
                              disabled="@_busy"></textarea>
                </label>
                <p class="simf-form__secondary">@L["Admin.Meetings.RespondHelp"]</p>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                        OnClick="@(() => _respondOpen = false)">
                @L["Admin.Meetings.Close"]
            </SimfButton>
            <SimfButton Type="button" Variant="danger" Disabled="_busy"
                        OnClick="DeclineAsync">
                @L["Admin.Meetings.Decline"]
            </SimfButton>
            @* QA B19 — Approve and Confirm both require a free hall slot, so with no hall
               availability configured Decline was the only usable action. Accepting with
               no room booked is a path the service already supports; surface it. *@
            <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                        OnClick="AcceptWithoutHallAsync">
                @L["Admin.Meetings.AcceptNoHall"]
            </SimfButton>
            <SimfButton Type="button" OnClick="ApproveAsync" Loading="_busy" LoadingLabel="@L["Grid.Working"]">
                @L["Admin.Meetings.Approve"]
            </SimfButton>
            <SimfButton Type="button" OnClick="ConfirmAsync" Loading="_busy" LoadingLabel="@L["Grid.Working"]">
                @L["Admin.Meetings.Confirm"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@* R10 (D-767) — must-decide guard for the one-click Check-in / Resend row actions. *@
<SimfConfirm Open="_confirmOpen" Title="@_confirmTitle" Message="@_confirmMessage"
             ConfirmLabel="@_confirmLabel" CancelLabel="@L["Admin.Meetings.Close"]"
             Busy="_busy" OnConfirm="RunConfirmAsync" OnCancel="CancelConfirm" />
