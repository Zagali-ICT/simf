@* D-353 — reusable News Add/Edit form, hosted by CrudShell (as a popup or a
   full page) from NewsList.razor. Inherits CrudAddEditFormBase so it exposes
   the standard CRUD-form parameter surface (IsEdit / Initial / OnSuccess /
   OnCancel). IsEdit=false runs Create (POST); IsEdit=true runs Edit (PUT
   against Initial) and shows the IsActive checkbox. Supersedes the inline
   SimfModal form that lived in NewsList. The image is a plain relative-path
   string (no upload widget here), so it round-trips as a text field. *@
@inherits CrudAddEditFormBase<AdminNewsDetail>
@using SIMF.Contracts.PublicRelations

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<div class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.News.Field.TitleEn"]"
                       Value="@_model.Title"
                       ValueChanged="@(v => _model.Title = v)"
                       ValueExpression="@(() => _model.Title)"
                       MaxLength="200"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.News.Field.TitleAr"]"
                       Value="@_model.TitleArabic"
                       ValueChanged="@(v => _model.TitleArabic = v)"
                       ValueExpression="@(() => _model.TitleArabic)"
                       MaxLength="200"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.News.Field.CategoryEn"]"
                       Value="@_model.Category"
                       ValueChanged="@(v => _model.Category = v)"
                       ValueExpression="@(() => _model.Category)"
                       MaxLength="100"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.News.Field.CategoryAr"]"
                       Value="@_model.CategoryArabic"
                       ValueChanged="@(v => _model.CategoryArabic = v)"
                       ValueExpression="@(() => _model.CategoryArabic)"
                       MaxLength="100"
                       Disabled="_busy" />
        <SimfTextarea Label="@L["Admin.News.Field.ExcerptEn"]"
                      Value="@_model.Excerpt"
                      ValueChanged="@(v => _model.Excerpt = v)"
                      Rows="2"
                      MaxLength="500"
                      Disabled="_busy" />
        <SimfTextarea Label="@L["Admin.News.Field.ExcerptAr"]"
                      Value="@_model.ExcerptArabic"
                      ValueChanged="@(v => _model.ExcerptArabic = v)"
                      Rows="2"
                      MaxLength="500"
                      Disabled="_busy" />
        <SimfTextarea Label="@L["Admin.News.Field.BodyEn"]"
                      Value="@_model.Body"
                      ValueChanged="@(v => _model.Body = v)"
                      Rows="6"
                      MaxLength="8000"
                      Disabled="_busy" />
        <SimfTextarea Label="@L["Admin.News.Field.BodyAr"]"
                      Value="@_model.BodyArabic"
                      ValueChanged="@(v => _model.BodyArabic = v)"
                      Rows="6"
                      MaxLength="8000"
                      Disabled="_busy" />
        <SimfTextField Label="@L["Admin.News.Field.ImageRelativePath"]"
                       Value="@_model.ImageRelativePath"
                       ValueChanged="@(v => _model.ImageRelativePath = v)"
                       ValueExpression="@(() => _model.ImageRelativePath)"
                       MaxLength="512"
                       Disabled="_busy" />
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.News.Field.PublishedAt"]</span>
            <input class="simf-field__input" type="date"
                   value="@_publishedAtText"
                   @onchange="OnPublishedAtChanged"
                   disabled="@_busy" />
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.News.Field.DisplayOrder"]</span>
            <input class="simf-field__input" type="number" min="0" max="99999"
                   value="@_model.DisplayOrder"
                   @onchange="OnDisplayOrderChanged"
                   disabled="@_busy" />
        </label>
        @if (IsEdit)
        {
            <SimfCheckbox Value="_model.IsActive"
                          ValueChanged="@(v => _model.IsActive = v)"
                          Disabled="_busy">
                @L["Admin.News.Field.IsActive"]
            </SimfCheckbox>
        }
        @* D-357 — image via the unified media-asset pipeline (edit only; the row
           must exist before bytes can be attached). *@
        @if (IsEdit && Initial is not null)
        {
            <div class="simf-field">
                <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
                <SimfImageUpload Category="NewsImage" OwnerId="@Initial.Id" Alt="@_model.Title" />
            </div>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Type="button" OnClick="HandleSubmitAsync"
                    Loading="_busy" LoadingLabel="@L["Admin.News.Save"]">
            @L["Admin.News.Save"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.News.Cancel"]
            </SimfButton>
        }
    </div>
</div>
