@* Reusable Theme Add/Edit form, hosted by CrudShell (popup or full
   page) from ThemesList. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel). Branch
   Create vs Update on IsEdit (POST when !IsEdit, PUT against Initial!.Id when
   IsEdit). Supersedes ThemeForm.razor, which keyed off Initial==null. *@
@inherits CrudAddEditFormBase<AdminThemeDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.Themes.Field.Code"]"
                       Helper="@L["Admin.Themes.Field.CodeHint"]"
                       MaxLength="16"
                       @bind-Value="_model.Code" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Themes.Field.Name"]"
                       Helper="@L["Admin.Themes.Field.NameHint"]"
                       MaxLength="128"
                       @bind-Value="_model.Name" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Themes.Field.NameArabic"]"
                       Helper="@L["Admin.Themes.Field.NameArabicHint"]"
                       MaxLength="128"
                       @bind-Value="_model.NameArabic" Disabled="_busy" />
        <SimfTextarea Label="@L["Admin.Themes.Field.Description"]"
                      Helper="@L["Admin.Themes.Field.DescriptionHint"]"
                      Rows="3" MaxLength="1024"
                      Value="@_model.Description"
                      ValueChanged="@(v => _model.Description = v)" />
        <SimfTextarea Label="@L["Admin.Themes.Field.DescriptionArabic"]"
                      Rows="3" MaxLength="1024"
                      Value="@_model.DescriptionArabic"
                      ValueChanged="@(v => _model.DescriptionArabic = v)" />
        <SimfTextField Label="@L["Admin.Themes.Field.DisplayOrder"]"
                       Helper="@L["Admin.Themes.Field.DisplayOrderHint"]"
                       Type="number"
                       Value="@_displayOrderInput"
                       ValueChanged="@(v => _displayOrderInput = v)"
                       ValueExpression="@(() => _displayOrderInput)"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Themes.Field.PageColor"]"
                       Helper="@L["Admin.Themes.Field.PageColorHint"]"
                       MaxLength="32"
                       @bind-Value="_model.PageColor" Disabled="_busy" />
        @if (IsEdit)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.Themes.Field.IsActive"]
            </SimfCheckbox>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy"
                    LoadingLabel="@(IsEdit ? L["Admin.Themes.Edit.Submitting"] : L["Admin.Themes.New.Submitting"])">
            @(IsEdit ? L["Admin.Themes.Edit.Submit"] : L["Admin.Themes.New.Submit"])
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Themes.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
