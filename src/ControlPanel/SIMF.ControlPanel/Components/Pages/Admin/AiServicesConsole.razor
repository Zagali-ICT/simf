@* CP Phase-1 — the centralized "AI services" view: one row per AI service
   (AiFeature), aggregated CP-side from the prompt catalogue (no new endpoint).
   Surfaces, per service, its active prompt + provider + model + hosting so an
   admin can answer "what runs the Translation AI, and where?" from one place.
   Read-only; routing/prompt edits stay on the prompt catalogue. Gated by the
   same AiPrompts.View that gates the /ai/prompts/list endpoint it reads. *@
@page "/admin/ai/services"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.AiPrompts.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.AiServices.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.AiServices.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="ServiceRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      RowKey="@(r => r.Feature.ToString())"
                      Caption="@L["Admin.AiServices.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.AiServices.Loading"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="ServiceRow" Key="service"
                                    Header="@L["Admin.AiServices.Col.Service"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>
                        <div>@context.DisplayName</div>
                        <code class="simf-table__sub">@context.Feature</code>
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ServiceRow" Key="activePrompt"
                                    Header="@L["Admin.AiServices.Col.ActivePrompt"]">
                    <CellTemplate>
                        @if (context.ActiveKey is not null)
                        {
                            <code>@context.ActiveKey</code> <span>v@(context.Version)</span>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Admin.AiServices.NoActive"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ServiceRow" Key="provider"
                                    Header="@L["Admin.AiPrompts.Col.Provider"]"
                                    Sortable="true">
                    <CellTemplate>@context.Provider</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ServiceRow" Key="model"
                                    Header="@L["Admin.AiPrompts.Col.Model"]">
                    <CellTemplate>@context.Model</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ServiceRow" Key="hosting"
                                    Header="@L["Admin.AiPrompts.Col.Hosting"]">
                    <CellTemplate>
                        <SimfPill Variant="@AiHosting.Variant(context.Provider)">
                            @L[AiHosting.LabelKey(context.Provider)]
                        </SimfPill>
                        @if (AiHosting.IsResidencyRisk(context.Feature, context.Provider))
                        {
                            <SimfPill Variant="danger">@L["Admin.AiPrompts.Hosting.Risk"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ServiceRow" Key="prompts"
                                    Header="@L["Admin.AiServices.Col.Prompts"]"
                                    Sortable="true">
                    <CellTemplate>@context.PromptCount</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @* Set this service's provider/model on its active prompt (reuses the
                   prompt PUT, gated by AiPrompts.Edit). Shown only when the service
                   has an active prompt to retarget. *@
                <AuthorizedAction Permission="@PermissionCatalog.AiPrompts.Edit">
                    @if (context.ActivePromptId is not null)
                    {
                        <SimfToolbarButton Icon="edit" Title="@L["Admin.AiServices.Routing"]"
                                           OnClick="@(() => OpenRoutingAsync(context.ActivePromptId.Value))" />
                    }
                </AuthorizedAction>
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.AiServices.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_routing is not null)
{
    <SimfModal Open="true" Title="@L["Admin.AiServices.Routing.Title"]" OnClose="CloseRouting">
        <ChildContent>
            @if (_routingError is not null)
            {
                <SimfAlert Variant="error">@_routingError</SimfAlert>
            }
            <p><code>@_routing.Key</code></p>
            <div class="simf-form__fields">
                <SimfSelect TValue="string"
                            Label="@L["Admin.AiPrompts.Field.Provider"]"
                            Items="AiEnumOptions.Providers"
                            ValueFor="@(id => id)"
                            LabelFor="@(id => AiEnumOptions.ProviderLabel(id))"
                            Value="@_routingProvider"
                            ValueChanged="@(v => _routingProvider = v ?? string.Empty)"
                            Disabled="_routingBusy" />
                <SimfTextField Label="@L["Admin.AiPrompts.Field.Model"]"
                               @bind-Value="_routingModel" Disabled="_routingBusy" />
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.AiPrompts.Field.Temperature"]</span>
                    <input class="simf-field__input" type="number" step="0.1" min="0" max="2"
                           value="@_routingTemp.ToString(CultureInfo.InvariantCulture)"
                           @onchange="OnRoutingTempChanged" disabled="@_routingBusy" />
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.AiPrompts.Field.MaxOutputTokens"]</span>
                    <input class="simf-field__input" type="number" min="1" max="8000"
                           value="@_routingMax"
                           @onchange="OnRoutingMaxChanged" disabled="@_routingBusy" />
                </label>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" OnClick="SaveRoutingAsync" Loading="_routingBusy">
                @L["Admin.AiServices.Routing.Save"]
            </SimfButton>
            <SimfButton Type="button" Variant="secondary" Disabled="_routingBusy" OnClick="CloseRouting">
                @L["Admin.AiServices.Routing.Cancel"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    // One AI service (feature) with its active prompt's routing, aggregated from
    // the prompt catalogue. ActiveKey is null when the feature has prompts but
    // none active.
    private sealed record ServiceRow(
        AiFeature Feature, string DisplayName, string? ActiveKey, Guid? ActivePromptId,
        AiProvider Provider, string Model, int Version, int PromptCount);

    private List<ServiceRow> _rows = new();
    private GridQuery _query = new() { Top = 20 };
    private GridPage<ServiceRow> _page = new();
    private bool _loading;
    private Toast? _toast;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        BuildPage();
        return Task.CompletedTask;
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            // Read the whole prompt catalogue once and group it CP-side — no new
            // endpoint. The catalogue is small (one prompt per feature, a few for
            // A/B), so Top covers it comfortably.
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminAiPromptSummary>>>(
                "simfAccount.postJson", "/account/api/admin/ai/prompts/list",
                new GridQuery { Top = 500 });
            if (env is { Success: true, Data: not null })
            {
                _rows = Aggregate(env.Data.Items);
                BuildPage();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.AiServices.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    // Group prompts by feature → one ServiceRow each. The "active prompt" is the
    // first active one (the routing the service actually uses); if none is active
    // the most recent prompt supplies the display info but ActiveKey stays null.
    private static List<ServiceRow> Aggregate(IReadOnlyList<AdminAiPromptSummary> prompts)
    {
        var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
        return prompts
            .GroupBy(p => p.Feature)
            .Select(g =>
            {
                var ordered = g.OrderByDescending(p => p.IsActive)
                    .ThenByDescending(p => p.Version)
                    .ToList();
                var lead = ordered[0];
                var active = ordered.FirstOrDefault(p => p.IsActive);
                var name = isArabic ? lead.DisplayNameArabic : lead.DisplayName;
                return new ServiceRow(
                    lead.Feature,
                    string.IsNullOrWhiteSpace(name) ? lead.DisplayName : name,
                    active?.Key,
                    active?.Id,
                    lead.Provider,
                    lead.Model,
                    lead.Version,
                    g.Count());
            })
            .OrderBy(r => r.Feature)
            .ToList();
    }

    // Filter / sort / page over the in-memory rows (the desk loads them all once).
    private void BuildPage()
    {
        IEnumerable<ServiceRow> q = _rows;
        if (_query.Filters.TryGetValue("service", out var f) && !string.IsNullOrWhiteSpace(f))
        {
            q = q.Where(r => r.DisplayName.Contains(f, StringComparison.OrdinalIgnoreCase)
                || r.Feature.ToString().Contains(f, StringComparison.OrdinalIgnoreCase));
        }
        q = (_query.Sort, _query.SortDescending) switch
        {
            ("provider", false) => q.OrderBy(r => r.Provider),
            ("provider", true) => q.OrderByDescending(r => r.Provider),
            ("prompts", false) => q.OrderBy(r => r.PromptCount),
            ("prompts", true) => q.OrderByDescending(r => r.PromptCount),
            ("service", true) => q.OrderByDescending(r => r.DisplayName),
            ("service", false) => q.OrderBy(r => r.DisplayName),
            _ => q,
        };
        var filtered = q.ToList();
        var items = filtered.Skip(_query.Skip).Take(_query.Top).ToList();
        _page = GridPage<ServiceRow>.Of(items, filtered.Count, _query);
    }

    // CP Phase-1 — set a service's provider/model from the console: load its
    // active prompt (GET), edit only the routing fields, PUT it back. Reuses the
    // prompt endpoints; the action is gated by AiPrompts.Edit (the PUT's gate).
    private AdminAiPromptDetail? _routing;
    private string _routingProvider = string.Empty;
    private string _routingModel = string.Empty;
    private double _routingTemp;
    private int _routingMax;
    private bool _routingBusy;
    private string? _routingError;

    private async Task OpenRoutingAsync(Guid promptId)
    {
        _toast = null;
        _routingError = null;
        var env = await JS.InvokeAsync<ApiResult<AdminAiPromptDetail>>(
            "simfAccount.getJson", $"/account/api/admin/ai/prompts/{promptId}");
        if (env is { Success: true, Data: not null })
        {
            _routing = env.Data;
            _routingProvider = AiEnumOptions.Id(_routing.Provider);
            _routingModel = _routing.Model;
            _routingTemp = _routing.Temperature;
            _routingMax = _routing.MaxOutputTokens;
        }
        else
        {
            _toast = new Toast("error",
                env?.Error?.MessageForCurrentCulture() ?? L["Admin.AiServices.LoadFailed"]);
        }
    }

    private void OnRoutingTempChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float,
            CultureInfo.InvariantCulture, out var d)) _routingTemp = d;
    }

    private void OnRoutingMaxChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n)) _routingMax = n;
    }

    private async Task SaveRoutingAsync()
    {
        if (_routing is null || _routingBusy) return;
        _routingBusy = true;
        _routingError = null;
        try
        {
            // PUT the whole prompt back with only the routing fields changed — the
            // update endpoint takes the full prompt, so the unedited fields are
            // echoed from the loaded detail.
            var env = await JS.InvokeAsync<ApiResult<AdminAiPromptDetail>>(
                "simfAccount.putJson", $"/account/api/admin/ai/prompts/{_routing.Id}",
                new UpdateAiPromptRequest
                {
                    Feature = _routing.Feature,
                    DisplayName = _routing.DisplayName,
                    DisplayNameArabic = _routing.DisplayNameArabic,
                    Description = _routing.Description,
                    DescriptionArabic = _routing.DescriptionArabic,
                    Provider = AiEnumOptions.ParseProvider(_routingProvider),
                    Model = _routingModel,
                    SystemPrompt = _routing.SystemPrompt,
                    UserPromptTemplate = _routing.UserPromptTemplate,
                    Temperature = _routingTemp,
                    MaxOutputTokens = _routingMax,
                    IsActive = _routing.IsActive,
                });
            if (env is { Success: true })
            {
                _routing = null;
                _toast = new Toast("success", L["Admin.AiServices.Routing.Saved"]);
                await LoadAsync();
            }
            else
            {
                _routingError = env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.AiServices.LoadFailed"];
            }
        }
        finally { _routingBusy = false; }
    }

    private void CloseRouting()
    {
        _routing = null;
        _routingError = null;
    }
}
