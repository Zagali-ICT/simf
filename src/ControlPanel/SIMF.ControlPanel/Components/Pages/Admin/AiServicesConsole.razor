@* CP Phase-1 — the centralized "AI services" view: one row per AI service
   (AiFeature), aggregated CP-side from the prompt catalogue (no new endpoint).
   Surfaces, per service, its active prompt + provider + model + hosting so an
   admin can answer "what runs the Translation AI, and where?" from one place.
   Read-only; routing/prompt edits stay on the prompt catalogue. Gated by the
   same AiPrompts.View that gates the /ai/prompts/list endpoint it reads. *@
@page "/admin/ai/services"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.AiPrompts.View)]

<PageTitle>@L["Admin.AiServices.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.AiServices.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="ServiceRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      RowKey="@(r => r.Feature.ToString())"
                      Caption="@L["Admin.AiServices.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.AiServices.Loading"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="ServiceRow" Key="service"
                                    Header="@L["Admin.AiServices.Col.Service"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>
                        <div>@context.DisplayName</div>
                        <code class="simf-table__sub">@context.Feature</code>
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ServiceRow" Key="activePrompt"
                                    Header="@L["Admin.AiServices.Col.ActivePrompt"]">
                    <CellTemplate>
                        @if (context.ActiveKey is not null)
                        {
                            <code>@context.ActiveKey</code> <span>v@(context.Version)</span>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Admin.AiServices.NoActive"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ServiceRow" Key="provider"
                                    Header="@L["Admin.AiPrompts.Col.Provider"]"
                                    Sortable="true">
                    <CellTemplate>@context.Provider</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ServiceRow" Key="model"
                                    Header="@L["Admin.AiPrompts.Col.Model"]">
                    <CellTemplate>@context.Model</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ServiceRow" Key="hosting"
                                    Header="@L["Admin.AiPrompts.Col.Hosting"]">
                    <CellTemplate>
                        <SimfPill Variant="@AiHosting.Variant(context.Provider)">
                            @L[AiHosting.LabelKey(context.Provider)]
                        </SimfPill>
                        @if (AiHosting.IsResidencyRisk(context.Feature, context.Provider))
                        {
                            <SimfPill Variant="danger">@L["Admin.AiPrompts.Hosting.Risk"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="ServiceRow" Key="prompts"
                                    Header="@L["Admin.AiServices.Col.Prompts"]"
                                    Sortable="true">
                    <CellTemplate>@context.PromptCount</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @* Open the per-service detail (Routing / Prompts / Analytics tabs).
                   Same AiPrompts.View gate as this page + the detail page. *@
                <SimfToolbarButton Icon="eye" Title="@L["Admin.AiServices.OpenDetail"]"
                                   OnClick="@(() => Nav.NavigateTo($"/admin/ai/services/{context.Feature}"))" />
                @* Set this service's provider/model on its active prompt (reuses the
                   prompt PUT, gated by AiPrompts.Edit). Shown only when the service
                   has an active prompt to retarget. *@
                <AuthorizedAction Permission="@PermissionCatalog.AiPrompts.Edit">
                    @if (context.ActivePromptId is not null)
                    {
                        <SimfToolbarButton Icon="edit" Title="@L["Admin.AiServices.Routing"]"
                                           OnClick="@(() => OpenRouting(context.ActivePromptId.Value))" />
                    }
                </AuthorizedAction>
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.AiServices.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_routingPromptId is not null)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.AiServices.Routing.Title"]" OnClose="CloseRouting">
        <ChildContent>
            <AiRoutingEditor PromptId="_routingPromptId.Value"
                             OnSaved="OnRoutingSavedAsync" OnCancel="CloseRouting" />
        </ChildContent>
    </SimfModal>
}
