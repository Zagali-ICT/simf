@* P3.3 — D-234 (Completion Programme §5.3): the Scientific-Committee central
   Q&A queue (stage 2). Lists Pending questions across sessions; approve / hide /
   escalate-to-a-role. Gated by Questions.* — the approved set then flows to the
   per-session moderator desk (stage 3).

   D-261 — migrated from the raw <table> to the canonical SimfDataGrid. The
   backend list endpoint (GET /admin/questions/queue) is a non-paged read that
   returns the full Pending queue (capped at 200 oldest-first), so the grid is
   paged / filtered / sorted client-side over the already-fetched list — the
   data-source contract and the three moderation actions are unchanged. *@
@page "/admin/question-queue"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Questions.View)]

<PageTitle>@L["Admin.QuestionQueue.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.QuestionQueue.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="SessionQuestionQueueRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.QuestionText)"
                      OnExport="OnExportAsync"
                      ExportLabel="@L["Grid.Export"]"
                      Caption="@L["Admin.QuestionQueue.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.QuestionQueue.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="SessionQuestionQueueRow" Key="session"
                                    Header="@L["Admin.QuestionQueue.Col.Session"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.SessionTitle</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="SessionQuestionQueueRow" Key="question"
                                    Header="@L["Admin.QuestionQueue.Col.Question"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.QuestionText</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="SessionQuestionQueueRow" Key="submitter"
                                    Header="@L["Admin.QuestionQueue.Col.Submitter"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.SubmittedByDisplayName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="SessionQuestionQueueRow" Key="phase"
                                    Header="@L["Admin.QuestionQueue.Col.Phase"]"
                                    Sortable="true">
                    <CellTemplate>
                        @if (context.Phase == QuestionPhase.Pre)
                        {
                            <SimfPill Variant="off">@L["Admin.QuestionQueue.Phase.Pre"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="on">@L["Admin.QuestionQueue.Phase.Live"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="SessionQuestionQueueRow" Key="ai"
                                    Header="@L["Admin.QuestionQueue.Col.Ai"]"
                                    Filterable="true">
                    <CellTemplate>@(context.AiFilterVerdict ?? "—")</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions Context="row">
                <AuthorizedAction Permission="@PermissionCatalog.Questions.Moderate">
                    <SimfToolbarButton Icon="check-circle"
                                       Title="@L["Admin.QuestionQueue.Action.Approve"]"
                                       Disabled="_busy"
                                       OnClick="@(() => ApproveAsync(row.Id))" />
                    <SimfToolbarButton Icon="eye-off"
                                       Title="@L["Admin.QuestionQueue.Action.Hide"]"
                                       Disabled="_busy"
                                       OnClick="@(() => HideAsync(row.Id))" />
                </AuthorizedAction>
                <AuthorizedAction Permission="@PermissionCatalog.Questions.Escalate">
                    <SimfToolbarButton Icon="share"
                                       Title="@L["Admin.QuestionQueue.Action.Escalate"]"
                                       Disabled="_busy"
                                       OnClick="@(() => OpenEscalate(row.Id))" />
                </AuthorizedAction>
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.QuestionQueue.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_escalateId is not null)
{
    <SimfModal Open="true" Title="@L["Admin.QuestionQueue.Escalate.Title"]"
               OnClose="@(() => _escalateId = null)">
        <ChildContent>
            <SimfTextField Label="@L["Admin.QuestionQueue.Escalate.Role"]"
                           @bind-Value="_escalateRole" Disabled="_busy" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Loading="_busy" OnClick="EscalateAsync">
                @L["Admin.QuestionQueue.Escalate.Submit"]
            </SimfButton>
            <SimfButton Type="button" Variant="secondary" OnClick="@(() => _escalateId = null)">
                @L["Admin.QuestionQueue.Escalate.Cancel"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
