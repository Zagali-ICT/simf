@* D-130 — Print-bag station. Standalone page for badge re-printing.
   Staff at the printing desk scans (or hand-types) a 12-character QR id
   into the input; the page calls the D-130 lookup endpoint and renders
   the same badge markup the walk-in success modal uses. A Print button
   triggers window.print() with the existing @media print CSS that
   isolates the badge. A Reset button clears + refocuses for the next
   scan. *@
@page "/admin/print-bag"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Attendees.PrintBag)]

<PageTitle>@L["Admin.PrintBag.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.PrintBag.Title"]" Subtitle="@L["Admin.PrintBag.Supporting"]" />

<div class="simf-page-wide">
    <div class="simf-surface simf-print-bag">
        <form class="simf-form" @onsubmit="OnSearchAsync" @onsubmit:preventDefault="true">
            <div class="simf-print-bag__search">
                <SimfTextField Label="@L["Admin.PrintBag.Field.QrId"]"
                               Helper="@L["Admin.PrintBag.Field.QrId.Hint"]"
                               MaxLength="32"
                               Autocomplete="off"
                               @bind-Value="_qrId" />
                <SimfButton Loading="_busy" LoadingLabel="@L["Admin.PrintBag.Searching"]">
                    @L["Admin.PrintBag.Search"]
                </SimfButton>
                @if (_result is not null)
                {
                    <SimfButton Type="button" Variant="secondary" OnClick="OnResetAsync">
                        @L["Admin.PrintBag.Reset"]
                    </SimfButton>
                }
            </div>
        </form>

        @if (_error is not null)
        {
            <SimfAlert Variant="error">@_error</SimfAlert>
        }

        @if (_result is not null)
        {
            <div class="simf-walkin-badge"
                 style="@($"--simf-badge-color: {_result.ProfileTypeColor}")">
                <div class="simf-walkin-badge__header">
                    <span class="simf-walkin-badge__type">@TypeLabel</span>
                </div>
                <div class="simf-walkin-badge__name">@_result.DisplayName</div>
                <div class="simf-walkin-badge__email">@EmailLabel</div>
                <div class="simf-walkin-badge__qr">@((MarkupString)_qrSvg)</div>
                <div class="simf-walkin-badge__qrid">@_result.QrId</div>
            </div>
            <div class="simf-form__actions">
                <SimfButton Type="button" Variant="primary" OnClick="OnPrintAsync">
                    @L["Admin.WalkIn.Success.Print"]
                </SimfButton>
            </div>
        }
    </div>
</div>
