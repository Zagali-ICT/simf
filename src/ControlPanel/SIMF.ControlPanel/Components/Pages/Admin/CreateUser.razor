@* Control Panel — admin creates a new CP user (decision D-042; refactored in
   D-112 to host the reusable CreateAdminForm so the admins list page can show
   the same form inside an Add modal). The URL /admin/admins/new stays as a
   deep-link fallback per Q-D — bookmarks and direct links keep working. *@
@page "/admin/admins/new"
@layout CpShellLayout
@attribute [Authorize(Roles = "Administrator")]
@inject IStringLocalizer<Strings> L
@inject NavigationManager Nav

<PageTitle>@L["Admin.CreateUser.Title"] · SIMF</PageTitle>

<SimfPageHeader Title="@L["Admin.CreateUser.Title"]" />

<section class="simf-card simf-page-card">
    <p>@L["Admin.CreateUser.Supporting"]</p>

    <CreateAdminForm OnSuccess="OnCreatedAsync"
                     OnCancel="OnBackToListAsync" />
</section>

@code {
    private Task OnCreatedAsync(AdminCreateUserResponse _)
    {
        // The child form shows its own success banner; the page leaves
        // navigation to the admin. (D-042 behaviour preserved.)
        return Task.CompletedTask;
    }

    private Task OnBackToListAsync()
    {
        Nav.NavigateTo("/admin/admins");
        return Task.CompletedTask;
    }
}
