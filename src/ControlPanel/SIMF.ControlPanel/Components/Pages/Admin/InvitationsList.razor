@* D-168 (gap doc G5, PDF §2.7.3) — public-relations: invitation desk.
   Lists invitations with state filter; the Add/Edit modals collect the
   recipient (by UserProfile id) + free-text notes; the Edit modal also
   allows admin override of State. Gated by Administrator OR
   PublicRelations role (the BFF forwards the JWT, the API policy
   enforces the role). *@
@page "/admin/invitations"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Invitations.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.Invitations.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Invitations.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <div class="simf-form__actions">
            <SimfButton Type="button" OnClick="OnAdd">
                @L["Admin.Invitations.New"]
            </SimfButton>
        </div>

        @if (_loading)
        {
            <p>@L["Admin.Invitations.Loading"]</p>
        }
        else if (_page.Items.Count == 0)
        {
            <SimfEmptyState Title="@L["Admin.Invitations.None"]" />
        }
        else
        {
            <table class="simf-table">
                <thead>
                    <tr>
                        <th>@L["Admin.Invitations.Col.Recipient"]</th>
                        <th>@L["Admin.Invitations.Col.ProfileType"]</th>
                        <th>@L["Admin.Invitations.Col.State"]</th>
                        <th>@L["Admin.Invitations.Col.CreatedAt"]</th>
                        <th>@L["Admin.Invitations.Col.SentBy"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _page.Items)
                    {
                        <tr>
                            <td>@RecipientLabel(row)</td>
                            <td>@(row.RecipientProfileTypeName ?? "—")</td>
                            <td>@row.State</td>
                            <td>@row.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                            <td>@row.SentByDisplayName</td>
                            <td>
                                <SimfButton Type="button"
                                            OnClick="@(() => OnEditAsync(row))">
                                    @L["Admin.Invitations.Edit.Title"]
                                </SimfButton>
                                @if (row.IsActive)
                                {
                                    <SimfButton Type="button"
                                                OnClick="@(() => OnDeactivateAsync(row))">
                                        @L["Admin.Invitations.Deactivate"]
                                    </SimfButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="simf-table__summary">
                @(string.Format(L["Admin.Invitations.Summary"],
                    _page.Skip + 1, _page.Skip + _page.Items.Count, _page.Total))
            </p>
        }
    </div>
</div>

@if (_addOpen)
{
    <SimfModal Open="true" Title="@L["Admin.Invitations.Add.Title"]"
               OnClose="@(() => _addOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <SimfTextField Label="@L["Admin.Invitations.Field.Recipient"]"
                               Value="@_newRecipientId"
                               ValueChanged="@(v => _newRecipientId = v)"
                               ValueExpression="@(() => _newRecipientId)"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Invitations.Field.Notes"]"
                               Value="@_newNotes"
                               ValueChanged="@(v => _newNotes = v)"
                               ValueExpression="@(() => _newNotes)"
                               Disabled="_busy" />
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="@(() => _addOpen = false)">
                @L["Admin.Invitations.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SubmitCreateAsync"
                        Loading="_busy">
                @L["Admin.Invitations.Submit.Create"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_editTarget is not null)
{
    <SimfModal Open="true" Title="@L["Admin.Invitations.Edit.Title"]"
               OnClose="@(() => _editTarget = null)">
        <ChildContent>
            <div class="simf-form__fields">
                <SimfSelect TValue="InvitationState"
                            Label="@L["Admin.Invitations.Field.State"]"
                            Items="_invitationStates"
                            Value="_editState"
                            ValueChanged="@((InvitationState v) => _editState = v)"
                            ValueExpression="@(() => _editState)"
                            Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Invitations.Field.Notes"]"
                               Value="@_editNotes"
                               ValueChanged="@(v => _editNotes = v)"
                               ValueExpression="@(() => _editNotes)"
                               Disabled="_busy" />
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="@(() => _editTarget = null)">
                @L["Admin.Invitations.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SubmitUpdateAsync"
                        Loading="_busy">
                @L["Admin.Invitations.Submit.Update"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminInvitationSummary> _page = new();
    private bool _loading;
    private bool _busy;
    private Toast? _toast;

    private bool _addOpen;
    private string _newRecipientId = string.Empty;
    private string _newNotes = string.Empty;

    private AdminInvitationDetail? _editTarget;
    private InvitationState _editState = InvitationState.Pending;
    private string _editNotes = string.Empty;

    private static readonly InvitationState[] _invitationStates =
        Enum.GetValues<InvitationState>();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<GridPage<AdminInvitationSummary>>>(
                "simfAccount.postJson", "/account/api/admin/invitations/list", _query);
            if (envelope is { Success: true, Data: not null })
            {
                _page = envelope.Data;
            }
            else
            {
                _toast = new Toast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Invitations.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private void OnAdd()
    {
        _addOpen = true;
        _newRecipientId = string.Empty;
        _newNotes = string.Empty;
    }

    private async Task SubmitCreateAsync()
    {
        if (_busy) return;
        if (!Guid.TryParse(_newRecipientId, out var recipientId))
        {
            _toast = new Toast("error", L["Admin.Invitations.LoadFailed"]);
            return;
        }
        _busy = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminInvitationDetail>>(
                "simfAccount.postJson", "/account/api/admin/invitations",
                new AdminCreateInvitationRequest
                {
                    SentToUserProfileId = recipientId,
                    Notes = string.IsNullOrWhiteSpace(_newNotes) ? null : _newNotes,
                });
            if (env is { Success: true, Data: not null })
            {
                _addOpen = false;
                _toast = new Toast("success", L["Admin.Invitations.Created"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Invitations.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private async Task OnEditAsync(AdminInvitationSummary row)
    {
        var env = await JS.InvokeAsync<ApiResult<AdminInvitationDetail>>(
            "simfAccount.getJson", $"/account/api/admin/invitations/{row.Id}");
        if (env is { Success: true, Data: not null })
        {
            _editTarget = env.Data;
            _editState = env.Data.State;
            _editNotes = env.Data.Notes ?? string.Empty;
        }
    }

    private async Task SubmitUpdateAsync()
    {
        if (_busy || _editTarget is null) return;
        _busy = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminInvitationDetail>>(
                "simfAccount.putJson", $"/account/api/admin/invitations/{_editTarget.Id}",
                new AdminUpdateInvitationRequest
                {
                    State = _editState,
                    Notes = string.IsNullOrWhiteSpace(_editNotes) ? null : _editNotes,
                });
            if (env is { Success: true })
            {
                _editTarget = null;
                _toast = new Toast("success", L["Admin.Invitations.Updated"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Invitations.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private async Task OnDeactivateAsync(AdminInvitationSummary row)
    {
        if (_busy) return;
        _busy = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.deleteJson", $"/account/api/admin/invitations/{row.Id}");
            if (env is { Success: true })
            {
                _toast = new Toast("success", L["Admin.Invitations.Deactivated"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Invitations.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private static string RecipientLabel(AdminInvitationSummary row) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
            ? row.RecipientArabicName
            : row.RecipientEnglishName;
}
