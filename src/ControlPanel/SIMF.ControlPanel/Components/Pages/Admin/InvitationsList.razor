@* D-168 (gap doc G5, PDF §2.7.3) — public-relations: invitation desk. Lists
   invitations with a state filter. Centralized dialog/full-page framing D-353:
   Add / Edit / View / Delete are hosted by CrudShell, which frames the reusable
   InvitationsAddEdit and InvitationsViewDelete forms as a popup or a full page per
   the admin's toolbar choice (persisted in localStorage via CpPreferences). The
   two inline SimfModals (Send + Edit) it used to carry are gone. Gated by
   Administrator OR PublicRelations (the BFF forwards the JWT, the API policy
   enforces the permission). D-356: Excel EXPORT only (invitations are
   created/edited from the forms — no import). *@
@page "/admin/invitations"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Invitations.View)]

<PageTitle>@L["Admin.Invitations.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Invitations.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminInvitationSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => RecipientLabel(r))"
                          Caption="@L["Admin.Invitations.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Invitations.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Admin.Invitations.New"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Admin.Invitations.Deactivate"]"
                          ExportLabel="@L["Grid.Export"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminInvitationSummary" Key="recipient"
                                        Header="@L["Admin.Invitations.Col.Recipient"]">
                        <CellTemplate>@RecipientLabel(context)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminInvitationSummary" Key="profileType"
                                        Header="@L["Admin.Invitations.Col.ProfileType"]">
                        <CellTemplate>@(context.RecipientProfileTypeName ?? "—")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminInvitationSummary" Key="state"
                                        Header="@L["Admin.Invitations.Col.State"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>
                            <SimfPill Variant="@StatePillVariant(context.State)">@StateLabel(context.State)</SimfPill>
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminInvitationSummary" Key="createdat"
                                        Header="@L["Admin.Invitations.Col.CreatedAt"]"
                                        Sortable="true">
                        <CellTemplate>@context.CreatedAt.FormatSaudi("yyyy-MM-dd HH:mm")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminInvitationSummary" Key="sentBy"
                                        Header="@L["Admin.Invitations.Col.SentBy"]">
                        <CellTemplate>@context.SentByDisplayName</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminInvitationSummary" Key="active"
                                        Header="@L["Grid.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Invitations.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Invitations.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <InvitationsAddEdit IsEdit="_isEdit" Initial="_target"
                                OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <InvitationsViewDelete IsDelete="_isDelete" Initial="_target"
                                   OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
