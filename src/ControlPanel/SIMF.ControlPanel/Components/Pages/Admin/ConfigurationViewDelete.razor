@* D-353 — reusable System Configuration View/Delete form, hosted by CrudShell
   (popup or full page) from ConfigurationList. Inherits CrudViewDeleteFormBase
   so it exposes the standard surface (IsDelete / Initial / OnDeleted /
   OnCancel). Read-only details always show; when IsDelete=true a Delete button
   appears and a SimfConfirm gates the soft-delete (DeactivateAsync). *@
@inherits CrudViewDeleteFormBase<AdminSystemSettingDetail>
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.Configuration.Field.Key"]</dt>
        <dd><code>@Initial.Key</code></dd>
        <dt>@L["Admin.Configuration.Field.Value"]</dt>
        <dd>@Initial.Value</dd>
        <dt>@L["Admin.Configuration.Field.Description"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.Description) ? "—" : Initial.Description)</dd>
        <dt>@L["Admin.Configuration.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.Configuration.Delete"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Configuration.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.Configuration.Delete.Title"]"
                 Message="@string.Format(L["Admin.Configuration.Delete.Message"], Initial.Key)"
                 ConfirmLabel="@L["Admin.Configuration.Delete"]"
                 CancelLabel="@L["Admin.Configuration.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" />
}

@code {
    private bool _busy;
    private bool _confirming;
    private string? _error;

    private async Task ConfirmDeleteAsync()
    {
        if (_busy || Initial is null) return;
        _busy = true;
        _error = null;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.deleteJson", $"/account/api/admin/system-settings/{Initial.Id}");
            if (envelope is { Success: true })
            {
                _confirming = false;
                await OnDeleted.InvokeAsync(Initial);
            }
            else
            {
                _confirming = false;
                _error = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Configuration.Fallback"];
            }
        }
        catch (Exception)
        {
            _confirming = false;
            _error = L["Admin.Configuration.Fallback"];
        }
        finally { _busy = false; }
    }
}
