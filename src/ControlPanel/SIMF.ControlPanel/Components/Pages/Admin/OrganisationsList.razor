@* Organisation lookup (CP UI) — admin CRUD over the bilingual Saudi-companies
   lookup. Rows can be created/edited by hand or bulk-loaded from a government
   Excel sheet via "Import Excel" (POST /admin/organisations/import returns an
   OrganisationImportResult with the rows-read / inserted / updated / skipped
   counts). A search box reloads the grid server-side via GridQuery.Search.
   Migrated from the raw <table> to the owner-mandated SimfDataGrid
   (server-paged, sortable + filterable, full pager). Centralized dialog/full-
   page framing D-353: Add / Edit / View / Delete are hosted by CrudShell, which
   frames the reusable OrganisationAddEdit and OrganisationViewDelete forms as a
   popup or a full page per the admin's toolbar choice (persisted in
   localStorage via CpPreferences). The inline SimfModal edit form + native
   confirm() delete it used to carry are gone; the Excel-import modal stays. *@
@page "/admin/organisations"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Organisations.View)]
@using SIMF.Contracts.Admin
@using SIMF.Contracts.Organisations

<PageTitle>@L["Admin.Organisations.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Organisations.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <div class="simf-toolbar">
                <div class="simf-toolbar__search">
                    <SimfTextField Label="@L["Admin.Organisations.Search"]"
                                   Placeholder="@L["Admin.Organisations.Search.Placeholder"]"
                                   Value="@_search"
                                   ValueChanged="@(v => _search = v)"
                                   ValueExpression="@(() => _search)"
                                   Disabled="_loading" />
                    <SimfButton Type="button" Disabled="_loading" OnClick="ApplySearchAsync">
                        @L["Admin.Organisations.Search.Apply"]
                    </SimfButton>
                </div>
            </div>

            <SimfDataGrid TItem="AdminOrganisationSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.NameAr)"
                          Caption="@L["Admin.Organisations.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAdd"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OpenImport"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Admin.Organisations.Import"]"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Organisations.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminOrganisationSummary" Key="name"
                                        Header="@L["Admin.Organisations.Col.NameAr"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.NameAr</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminOrganisationSummary" Key="nameEn"
                                        Header="@L["Admin.Organisations.Col.NameEn"]"
                                        Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.NameEn) ? "—" : context.NameEn)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminOrganisationSummary" Key="commercialRegistration"
                                        Header="@L["Admin.Organisations.Col.CommercialRegistration"]"
                                        Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.CommercialRegistration) ? "—" : context.CommercialRegistration)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminOrganisationSummary" Key="sector"
                                        Header="@L["Admin.Organisations.Col.Sector"]"
                                        Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.Sector) ? "—" : context.Sector)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminOrganisationSummary" Key="city"
                                        Header="@L["Admin.Organisations.Col.City"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.City) ? "—" : context.City)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminOrganisationSummary" Key="isActive"
                                        Header="@L["Admin.Organisations.Col.Active"]"
                                        Sortable="true">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Organisations.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Organisations.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <OrganisationAddEdit IsEdit="_isEdit" Initial="_target"
                                 OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <OrganisationViewDelete IsDelete="_isDelete" Initial="_target"
                                    OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@if (_importOpen)
{
    <SimfModal Open="true"
               RequireExplicitClose="true"
               Title="@L["Admin.Organisations.Import.Title"]"
               OnClose="@(() => _importOpen = false)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <div class="simf-form__fields">
                <p class="simf-walkin__hint">@L["Admin.Organisations.Import.Hint"]</p>
                <div class="simf-field">
                    <span class="simf-field__label">@L["Admin.Organisations.Import.File"]</span>
                    <input id="organisations-import-input" type="file" class="simf-field__input"
                           accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                           @onchange="OnImportFileSelected"
                           disabled="@_importing" />
                    @if (!string.IsNullOrEmpty(_importFileName))
                    {
                        <p class="simf-walkin__hint">@_importFileName</p>
                    }
                </div>

                @if (_importResult is not null)
                {
                    <div class="simf-import-result">
                        <p>@(string.Format(L["Admin.Organisations.Import.Result"],
                            _importResult.RowsRead, _importResult.Inserted,
                            _importResult.Updated, _importResult.Skipped))</p>
                        @if (_importResult.Errors.Count > 0)
                        {
                            <ul class="simf-import-result__errors">
                                @foreach (var err in _importResult.Errors)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_importing" OnClick="@(() => _importOpen = false)">
                @L["Admin.Organisations.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="UploadImportAsync" Loading="_importing"
                        Disabled="@(string.IsNullOrEmpty(_importFileName))"
                        LoadingLabel="@L["Grid.Working"]">
                @L["Admin.Organisations.Import.Upload"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
