@* D-168 (gap doc G5, PDF §2.7.3) — VIP list + bulk-notify modal. The
   VIP list is the subset of UserProfiles whose ProfileType.Name is in
   {VVIP, VIP, Gold}; the notify modal collects a bilingual message and
   fans it out via the API. *@
@page "/admin/vips"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Vips.View)]

<PageTitle>@L["Admin.Vips.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Vips.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminVipSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.UserProfileId.ToString())"
                      RowLabel="@(r => RecipientLabel(r))"
                      OnSelectionChanged="OnSelectionChanged"
                      OnExport="OnExportAsync"
                      ExportLabel="@L["Grid.Export"]"
                      Caption="@L["Admin.Vips.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.Vips.Loading"]"
                      SummaryFormatter="@FormatSummary">
            <CustomToolbar>
                @* Bulk action: notify the selected VIPs (opens the bilingual message modal). *@
                <SimfToolbarButton Icon="send"
                                   Title="@(string.Format(L["Admin.Vips.NotifySelected"], _selected.Count))"
                                   Disabled="@(_selected.Count == 0)"
                                   OnClick="OnNotifySelected">
                    @(string.Format(L["Admin.Vips.NotifySelected"], _selected.Count))
                </SimfToolbarButton>
            </CustomToolbar>
            <Columns>
                <SimfDataGridColumn TItem="AdminVipSummary" Key="name" Header="@L["Admin.Vips.Col.Name"]">
                    <CellTemplate>@RecipientLabel(context)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminVipSummary" Key="jobTitle" Header="@L["Admin.Vips.Col.JobTitle"]">
                    <CellTemplate>@(context.JobTitle ?? "—")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminVipSummary" Key="profileType" Header="@L["Admin.Vips.Col.ProfileType"]">
                    <CellTemplate>@TypeLabel(context)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminVipSummary" Key="email" Header="@L["Admin.Vips.Col.Email"]">
                    <CellTemplate>@(context.Email ?? "—")</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Vips.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_notifyOpen)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.Vips.Notify.Title"]"
               OnClose="@(() => _notifyOpen = false)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <div class="simf-form__fields">
                <SimfTextField Label="@L["Admin.Vips.Notify.TitleField"]"
                               Value="@_msgTitle"
                               ValueChanged="@(v => _msgTitle = v)"
                               ValueExpression="@(() => _msgTitle)"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Vips.Notify.TitleArabicField"]"
                               Value="@_msgTitleArabic"
                               ValueChanged="@(v => _msgTitleArabic = v)"
                               ValueExpression="@(() => _msgTitleArabic)"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Vips.Notify.BodyField"]"
                               Value="@_msgBody"
                               ValueChanged="@(v => _msgBody = v)"
                               ValueExpression="@(() => _msgBody)"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Vips.Notify.BodyArabicField"]"
                               Value="@_msgBodyArabic"
                               ValueChanged="@(v => _msgBodyArabic = v)"
                               ValueExpression="@(() => _msgBodyArabic)"
                               Disabled="_busy" />
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="@(() => _notifyOpen = false)">
                @L["Admin.Vips.Notify.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SubmitNotifyAsync"
                        Loading="_busy"
                        LoadingLabel="@L["Grid.Working"]">
                @L["Admin.Vips.Notify.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
