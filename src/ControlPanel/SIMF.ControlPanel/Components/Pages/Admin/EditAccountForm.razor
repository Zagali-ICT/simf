@* P1.3 (D-214) — shared admin edit form for a Visitor or Other account.
   Loads the current account (email, display name, tier) + the active
   profile-type options for the scope, then PUTs the edit. An email change
   signs the account out (security stamp roll on the server); the helper note
   makes that explicit. Used by VisitorsList and OthersList so the two desks
   share one form. *@
@using SIMF.Contracts.Authentication
@using SIMF.Contracts.UserProfile

@if (_loading)
{
    <p>@L["Admin.Edit.Loading"]</p>
}
else if (_loadError is not null)
{
    <SimfAlert Variant="error">@_loadError</SimfAlert>
}
else
{
    <EditForm Model="this" OnValidSubmit="SaveAsync" class="simf-form">
        @if (_saveError is not null)
        {
            <SimfAlert Variant="error">@_saveError</SimfAlert>
        }

        <SimfTextField Label="@L["Admin.Edit.Email"]"
                       Type="email" Icon="mail"
                       Value="@_email"
                       ValueChanged="@(v => _email = v)"
                       ValueExpression="@(() => _email)" />

        <SimfTextField Label="@L["Admin.Edit.DisplayName"]"
                       Value="@_displayName"
                       ValueChanged="@(v => _displayName = v)"
                       ValueExpression="@(() => _displayName)" />

        <SimfSelect TValue="AdminProfileTypeSummary"
                    Label="@L["Admin.Edit.ProfileType"]"
                    Items="_profileTypes"
                    ValueFor="@(p => p.Id.ToString())"
                    LabelFor="@(p => p.Name)"
                    Value="@_selectedProfileType"
                    ValueChanged="OnProfileTypeChanged"
                    Placeholder="@(IsVisitorScope ? L["Admin.Edit.ProfileType.None"].Value : L["Admin.Edit.ProfileType.Choose"].Value)" />

        @* B22 — nationality. It gates delegation-meeting confirm eligibility, yet it
           was only ever written by the self-service sign-up, so an admin could not fix
           a delegate blocked by a wrong nationality. Leaving the picker empty sends no
           nationality and leaves the stored value untouched. *@
        <SimfSelect TValue="CountryDto"
                    Label="@L["Admin.Edit.Nationality"]"
                    Placeholder="@L["Admin.Edit.Nationality.Keep"]"
                    Items="_countries"
                    ValueFor="@(c => c.Code)"
                    LabelFor="@(c => CountryLabel(c))"
                    Value="@_selectedCountry"
                    ValueChanged="OnNationalityPicked" />
        <p class="simf-form__hint">@L["Admin.Edit.Nationality.Hint"]</p>

        @* FR-PHN-002 — the mobile numbers. Every other admin surface shows them
           read-only and only the walk-in CREATE desk had an editable field, so a
           wrong number could never be corrected. Leaving a field empty sends
           nothing and leaves the stored number untouched. Same shapes as the
           self-service rule; the same SimfTextField/tel pattern the walk-in desk
           uses (not SimfPhoneInput, whose "+dial-local" output is exactly the
           second spelling DEF-PHN-003 canonicalises away). *@
        <SimfTextField Label="@L["Admin.Edit.SaudiMobile"]"
                       Helper="@L["Admin.Edit.Mobile.Hint"]"
                       Type="tel" InputMode="tel" Autocomplete="off" MaxLength="32"
                       Value="@_saudiMobile"
                       ValueChanged="@(v => _saudiMobile = v)"
                       ValueExpression="@(() => _saudiMobile)" />

        <SimfTextField Label="@L["Admin.Edit.InternationalMobile"]"
                       Helper="@L["Admin.Edit.Mobile.Hint"]"
                       Type="tel" InputMode="tel" Autocomplete="off" MaxLength="32"
                       Value="@_internationalMobile"
                       ValueChanged="@(v => _internationalMobile = v)"
                       ValueExpression="@(() => _internationalMobile)" />

        <p class="simf-form__hint">@L["Admin.Edit.EmailChangeNote"]</p>

        @* Bi-Meeting rework — the two admin-assigned per-user meeting-eligibility flags.
           When on, the account sees the matching Bi-Meeting request button in the app
           (speaker meetings / delegation meetings) regardless of its tier. *@
        <fieldset class="simf-form__section" disabled="@(_busy ? "disabled" : null)">
            <legend>@L["Admin.Edit.Meetings.Section"]</legend>
            <SimfCheckbox @bind-Value="_allowsSpeakerMeeting" Disabled="_busy">
                @L["Admin.Edit.Meetings.AllowsSpeaker"]
            </SimfCheckbox>
            <SimfCheckbox @bind-Value="_allowsDelegationMeeting" Disabled="_busy">
                @L["Admin.Edit.Meetings.AllowsDelegation"]
            </SimfCheckbox>
        </fieldset>

        @* VIP edit — change the account's photo, ID image, and (VIP page only)
           the VVIP/VIP welcome photo. Each is optional: pick a file to replace
           the current image; leave empty to keep it. Uploads run on Save via the
           same account-id-keyed admin endpoints the walk-in desk uses. *@
        <fieldset class="simf-form__section" disabled="@(_busy ? "disabled" : null)">
            <legend>@L["Admin.Edit.Photo.Section"]</legend>

            <div class="simf-field">
                <label class="simf-field__label" for="@AvatarInputId">@L["Admin.Edit.Photo.Avatar"]</label>
                @if (_hasAvatar)
                {
                    <AdminProfilePhotoBlock Heading="@L["Admin.Edit.Photo.Current"]" Src="@AvatarPreviewUrl" />
                }
                <input id="@AvatarInputId" type="file" class="simf-field__input"
                       accept="image/png,image/jpeg,image/webp"
                       @onchange="OnAvatarPickedAsync" />
                <div class="simf-field__helper">@L["Admin.Edit.Photo.Avatar.Hint"]</div>
            </div>

            <div class="simf-field">
                <label class="simf-field__label" for="@IdDocumentInputId">@L["Admin.Edit.Photo.IdDocument"]</label>
                @if (_hasIdImage)
                {
                    <div class="simf-walkin__id-image">
                        <h4>@L["Admin.Edit.Photo.Current"]</h4>
                        <img src="@IdImagePreviewUrl" alt="@L["Admin.Edit.Photo.IdDocument"]" />
                    </div>
                }
                <input id="@IdDocumentInputId" type="file" class="simf-field__input"
                       accept="image/png,image/jpeg,image/webp"
                       @onchange="OnIdDocumentPickedAsync" />
                <div class="simf-field__helper">@L["Admin.Edit.Photo.IdDocument.Hint"]</div>
            </div>

            @if (VipPhotoEnabled)
            {
                <div class="simf-field">
                    <label class="simf-field__label" for="@VipPhotoInputId">@L["Admin.Edit.Photo.VipPhoto"]</label>
                    <input id="@VipPhotoInputId" type="file" class="simf-field__input"
                           accept="image/png,image/jpeg,image/webp"
                           @onchange="OnVipPhotoPickedAsync" />
                    <div class="simf-field__helper">@L["Admin.Edit.Photo.VipPhoto.Hint"]</div>
                </div>
            }
        </fieldset>

        <div class="simf-form__actions">
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Edit.Cancel"]
            </SimfButton>
            <SimfButton Loading="_busy" LoadingLabel="@L["Admin.Edit.Saving"]"
                        Disabled="@(!CanSave)">
                @L["Admin.Edit.Save"]
            </SimfButton>
        </div>
    </EditForm>
}
