@* D-353 — reusable Media Add/Edit form, hosted by CrudShell (popup or full
   page) from MediaList.razor. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel).
   IsEdit=false runs Create (POST); IsEdit=true runs Edit (PUT against Initial).
   Supersedes the inline SimfModal form that lived in MediaList (D-199 / D-256).

   Image upload is preserved exactly (D-90 out-of-row): bytes can only be
   attached once the row exists, so the upload control shows only in Edit mode
   for an Image item. Creating an Image therefore does NOT close the shell — it
   flips the same form into Edit mode in place so the admin can attach the
   bitmap next; OnSuccess (which closes the shell + reloads the grid) fires for
   a Video create and for every Edit-mode save. *@
@inherits CrudAddEditFormBase<AdminMediaDetail>
@using SIMF.Contracts.Media

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<div class="simf-form__fields">
    <label class="simf-field">
        <span class="simf-field__label">@L["Admin.Media.Field.Kind"]</span>
        <select class="simf-field__input"
                value="@_model.Kind.ToString()"
                @onchange="OnKindChanged"
                disabled="@(_busy || _isEditing)">
            <option value="@nameof(MediaKind.Image)">@L["Admin.Media.Kind.Image"]</option>
            <option value="@nameof(MediaKind.Video)">@L["Admin.Media.Kind.Video"]</option>
        </select>
    </label>
    <SimfTextField Label="@L["Admin.Media.Field.TitleEn"]"
                   Value="@_model.Title"
                   ValueChanged="@(v => _model.Title = v)"
                   ValueExpression="@(() => _model.Title)"
                   Disabled="_busy" />
    <SimfTextField Label="@L["Admin.Media.Field.TitleAr"]"
                   Value="@_model.TitleArabic"
                   ValueChanged="@(v => _model.TitleArabic = v)"
                   ValueExpression="@(() => _model.TitleArabic)"
                   Disabled="_busy" />
    <SimfTextField Label="@L["Admin.Media.Field.AlbumEn"]"
                   Value="@_model.Album"
                   ValueChanged="@(v => _model.Album = v)"
                   ValueExpression="@(() => _model.Album)"
                   Disabled="_busy" />
    <SimfTextField Label="@L["Admin.Media.Field.AlbumAr"]"
                   Value="@_model.AlbumArabic"
                   ValueChanged="@(v => _model.AlbumArabic = v)"
                   ValueExpression="@(() => _model.AlbumArabic)"
                   Disabled="_busy" />
    @if (_model.Kind == MediaKind.Video)
    {
        <SimfTextField Label="@L["Admin.Media.Field.VideoUrl"]"
                       Value="@_model.Url"
                       ValueChanged="@(v => _model.Url = v)"
                       ValueExpression="@(() => _model.Url)"
                       Disabled="_busy" />
    }
    <label class="simf-field">
        <span class="simf-field__label">@L["Admin.Media.Field.DisplayOrder"]</span>
        <input class="simf-field__input" type="number" min="0" max="99999"
               value="@_model.DisplayOrder"
               @onchange="OnDisplayOrderChanged"
               disabled="@_busy" />
    </label>
    <SimfCheckbox Value="_model.IsActive"
                  ValueChanged="@(v => _model.IsActive = v)"
                  Disabled="_busy">
        @L["Admin.Media.Field.IsActive"]
    </SimfCheckbox>

    @if (_isEditing && _model.Kind == MediaKind.Image)
    {
        <div class="simf-field">
            <span class="simf-field__label">@L["Admin.Media.Field.Image"]</span>
            <p class="simf-walkin__hint">
                @(_hasImage ? L["Admin.Media.Image.Present"] : L["Admin.Media.Image.None"])
            </p>
            <input id="media-image-input" type="file" class="simf-field__input"
                   accept="image/png,image/jpeg,image/webp"
                   @onchange="OnImageSelected"
                   disabled="@_busy" />
            @if (!string.IsNullOrEmpty(_imageName))
            {
                <p class="simf-walkin__hint">@_imageName</p>
            }
            <div class="simf-form__actions">
                <SimfButton Type="button" Loading="_uploadingImage"
                            Disabled="@(_busy || string.IsNullOrEmpty(_imageName))"
                            OnClick="UploadImageAsync">
                    @L["Admin.Media.Image.Upload"]
                </SimfButton>
            </div>
        </div>
    }
    else if (!_isEditing && _model.Kind == MediaKind.Image)
    {
        <p class="simf-walkin__hint">@L["Admin.Media.Image.SaveFirst"]</p>
    }
</div>

<div class="simf-form__actions">
    <SimfButton Type="button" Loading="_busy"
                LoadingLabel="@L["Admin.Media.Save"]"
                Disabled="_busy" OnClick="SaveAsync">
        @L["Admin.Media.Save"]
    </SimfButton>
    @if (OnCancel.HasDelegate)
    {
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Media.Cancel"]
        </SimfButton>
    }
</div>
