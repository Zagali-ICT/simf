@* Control Panel — admin creates a new Other-typed user (P7e — D-055).
   A ProfileType picker (Staff / Exhibitor / Sponsor / Media — sourced
   from /admin/profile-types?userType=Other) is the only required pick
   beyond email + display name. The new user lands in PendingApproval
   per the standard flow. *@
@page "/admin/others/new"
@layout CpShellLayout
@attribute [Authorize(Roles = "Administrator")]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@L["Admin.Others.New.Title"] · SIMF</PageTitle>

<SimfPageHeader Title="@L["Admin.Others.New.Title"]" />

<section class="simf-card simf-page-card">
    <p>@L["Admin.Others.New.Supporting"]</p>

    @if (_success is not null)
    {
        <SimfAlert Variant="success">@_success</SimfAlert>
    }
    @if (_error is not null)
    {
        <SimfAlert Variant="error">@_error</SimfAlert>
    }

    <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
        <div class="simf-form__fields">
            <SimfTextField Label="@L["Admin.CreateUser.Email"]"
                           @bind-Value="_model.Email"
                           Type="email" Icon="mail" InputMode="email"
                           Autocomplete="off" Disabled="_busy" />
            <SimfTextField Label="@L["Admin.CreateUser.DisplayName"]"
                           @bind-Value="_model.DisplayName"
                           Autocomplete="off" Disabled="_busy" />
            <SimfSelect TValue="Guid"
                        Label="@L["Admin.Others.ProfileType"]"
                        Placeholder="@L["Admin.Others.ProfileType.Placeholder"]"
                        Items="_profileTypeIds"
                        ValueFor="@(id => id.ToString())"
                        LabelFor="@(id => LabelFor(id))"
                        Value="@_model.ProfileTypeId"
                        ValueChanged="@(id => _model.ProfileTypeId = id)"
                        Disabled="_busy" />
        </div>
        <div class="simf-form__actions">
            <SimfButton Loading="_busy" LoadingLabel="@L["Admin.CreateUser.Submitting"]">
                @L["Admin.Others.New.Submit"]
            </SimfButton>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => Nav.NavigateTo("/admin/others"))">
                @L["Admin.CreateUser.BackToList"]
            </SimfButton>
        </div>
    </EditForm>
</section>

@code {
    private readonly Model _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private bool _busy;
    private string? _success;
    private string? _error;
    private Guid[] _profileTypeIds = Array.Empty<Guid>();
    private Dictionary<Guid, AdminProfileTypeSummary> _profileTypesById = new();

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_model);
        _messages = new ValidationMessageStore(_editContext);

        var envelope = await JS.InvokeAsync<ApiResult<IReadOnlyList<AdminProfileTypeSummary>>>(
            "simfAccount.getJson",
            "/account/api/admin/profile-types?userType=Other");
        if (envelope is { Success: true, Data: not null })
        {
            _profileTypesById = envelope.Data.ToDictionary(p => p.Id);
            _profileTypeIds = envelope.Data.Select(p => p.Id).ToArray();
        }
    }

    private string LabelFor(Guid id)
    {
        if (!_profileTypesById.TryGetValue(id, out var p)) return id.ToString();
        var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
        return isArabic ? p.NameArabic : p.Name;
    }

    private async Task HandleSubmitAsync()
    {
        if (_busy) return;
        _success = null; _error = null;

        if (string.IsNullOrWhiteSpace(_model.Email) || !_model.Email.Contains('@', StringComparison.Ordinal))
        {
            _error = L["Admin.CreateUser.EmailInvalid"]; return;
        }
        if (_model.DisplayName.Length is < 2 or > 128)
        {
            _error = L["Admin.CreateUser.DisplayNameRequired"]; return;
        }
        if (_model.ProfileTypeId == Guid.Empty)
        {
            _error = L["Admin.Others.New.ProfileTypeRequired"]; return;
        }

        _busy = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<AdminCreateUserResponse>>(
                "simfAccount.postJson", "/account/api/admin/others",
                new AdminCreateOtherRequest
                {
                    Email = _model.Email,
                    DisplayName = _model.DisplayName,
                    ProfileTypeId = _model.ProfileTypeId,
                });
            if (envelope is { Success: true, Data: not null })
            {
                _success = string.Format(L["Admin.CreateUser.Success"], envelope.Data.Email);
                _model.Email = string.Empty;
                _model.DisplayName = string.Empty;
                _model.ProfileTypeId = Guid.Empty;
            }
            else
            {
                _error = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.CreateUser.Fallback"];
            }
        }
        finally { _busy = false; }
    }

    private sealed class Model
    {
        public string Email { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public Guid ProfileTypeId { get; set; }
    }
}
