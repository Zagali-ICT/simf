@* D-148 â€” Gate Module CRUD list. SIMF-FDS-003 Â§5.6 / SIMF-API-GATES-001 Â§6.
   Mirrors HallsList; adds DirectionMode column + operator-count + allow-count.
   Centralized dialog/full-page framing D-353: Add / Edit / View / Delete are
   hosted by CrudShell, which frames the reusable GatesAddEdit and
   GatesViewDelete forms as a popup or a full page per the admin's toolbar
   choice (persisted in localStorage via CpPreferences). *@
@page "/admin/gates"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Gates.Manage)]

<PageTitle>@L["Admin.Gates.Title"] Â· SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Gates.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminGateSummary"
                          Query="_query" Page="_page" Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Name)"
                          Caption="@L["Admin.Gates.Title"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Admin.Gates.Prev"]"
                          NextLabel="@L["Admin.Gates.Next"]"
                          FirstLabel="@L["Admin.Gates.Pager.First"]"
                          LastLabel="@L["Admin.Gates.Pager.Last"]"
                          PageSizeLabel="@L["Admin.Gates.Pager.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Gates.Loading"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Admin.Gates.Column.Actions"]"
                          SelectAllLabel="@L["Admin.Gates.Action.SelectAll"]"
                          SelectRowLabel="@L["Admin.Gates.Action.SelectRow"]"
                          AddLabel="@L["Admin.Gates.Action.Add"]"
                          EditLabel="@L["Admin.Gates.Action.Edit"]"
                          DetailsLabel="@L["Admin.Gates.Action.Details"]"
                          DeleteLabel="@L["Admin.Gates.Action.Deactivate"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminGateSummary" Key="code"
                                        Header="@L["Admin.Gates.Column.Code"]" Sortable="true" Filterable="true">
                        <CellTemplate>@context.Code</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminGateSummary" Key="name"
                                        Header="@L["Admin.Gates.Column.Name"]" Sortable="true" Filterable="true">
                        <CellTemplate>@context.Name</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminGateSummary" Key="nameArabic"
                                        Header="@L["Admin.Gates.Column.NameArabic"]" Sortable="true" Filterable="true">
                        <CellTemplate>@context.NameArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminGateSummary" Key="directionMode"
                                        Header="@L["Admin.Gates.Column.DirectionMode"]" Sortable="true">
                        <CellTemplate>@context.DirectionMode</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminGateSummary" Key="allowCount"
                                        Header="@L["Admin.Gates.Column.AllowCount"]">
                        <CellTemplate>@(context.AllowedProfileTypeCount == 0 ? L["Admin.Gates.AllowAll"] : context.AllowedProfileTypeCount.ToString())</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminGateSummary" Key="operatorCount"
                                        Header="@L["Admin.Gates.Column.OperatorCount"]">
                        <CellTemplate>@context.AssignedOperatorCount</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminGateSummary" Key="isActive"
                                        Header="@L["Admin.Gates.Column.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            { <SimfPill Variant="on">@L["Admin.Gates.Active.Yes"]</SimfPill> }
                            else
                            { <SimfPill Variant="off">@L["Admin.Gates.Active.No"]</SimfPill> }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Gates.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="gates"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Gates.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <GatesAddEdit IsEdit="_isEdit" Initial="_target"
                          OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <GatesViewDelete IsDelete="_isDelete" Initial="_target"
                             OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
