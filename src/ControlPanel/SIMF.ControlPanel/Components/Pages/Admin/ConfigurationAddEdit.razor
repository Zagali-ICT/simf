@* Reusable System Configuration Add/Edit form, hosted by CrudShell
   (popup or full page) from ConfigurationList. Inherits CrudAddEditFormBase so
   it exposes the standard CRUD-form surface (IsEdit / Initial / OnSuccess /
   OnCancel). The Key is the setting's stable identifier: required and editable
   on Add, read-only on Edit (the API fixes the key once created). *@
@inherits CrudAddEditFormBase<AdminSystemSettingDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.Configuration.Field.Key"]"
                       Helper="@(IsEdit ? L["Admin.Configuration.Field.KeyReadOnly"] : L["Admin.Configuration.Field.KeyHint"])"
                       MaxLength="128"
                       @bind-Value="_model.Key"
                       Disabled="@(_busy || IsEdit)" />
        <SimfTextField Label="@L["Admin.Configuration.Field.Value"]"
                       MaxLength="1024"
                       @bind-Value="_model.Value" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Configuration.Field.Description"]"
                       Helper="@L["Admin.Configuration.Field.DescriptionHint"]"
                       MaxLength="512"
                       @bind-Value="_model.Description" Disabled="_busy" />

        @if (IsEdit)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.Configuration.Field.IsActive"]
            </SimfCheckbox>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy"
                    LoadingLabel="@(IsEdit ? L["Admin.Configuration.Edit.Submitting"] : L["Admin.Configuration.New.Submitting"])">
            @(IsEdit ? L["Admin.Configuration.Edit.Submit"] : L["Admin.Configuration.New.Submit"])
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Configuration.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
