@* D-155 — Countries CRUD (lookup table joined by UserProfile.NationalityId
   and Speaker.CountryId). Centralized dialog/full-page framing D-353: Add /
   Edit / View / Delete are hosted by CrudShell, which frames the reusable
   CountryAddEdit and CountryViewDelete forms as a popup or a full page per the
   admin's toolbar choice (persisted in localStorage via CpPreferences). *@
@page "/admin/countries"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Countries.View)]

<PageTitle>@L["Admin.Countries.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Countries.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminCountrySummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Name)"
                          Caption="@L["Admin.Countries.Title"]"
                          FilterColumnLabel="@L["Admin.Countries.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Admin.Countries.Prev"]"
                          NextLabel="@L["Admin.Countries.Next"]"
                          FirstLabel="@L["Admin.Countries.Pager.First"]"
                          LastLabel="@L["Admin.Countries.Pager.Last"]"
                          PageSizeLabel="@L["Admin.Countries.Pager.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Countries.Loading"]"
                          FilterPlaceholder="@L["Admin.Countries.FilterPlaceholder"]"
                          ActionsHeader="@L["Admin.Countries.Column.Actions"]"
                          SelectAllLabel="@L["Admin.Countries.Action.SelectAll"]"
                          SelectRowLabel="@L["Admin.Countries.Action.SelectRow"]"
                          AddLabel="@L["Admin.Countries.Action.Add"]"
                          EditLabel="@L["Admin.Countries.Action.Edit"]"
                          DetailsLabel="@L["Admin.Countries.Action.Details"]"
                          DeleteLabel="@L["Admin.Countries.Action.Deactivate"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminCountrySummary" Key="id"
                                        Header="@L["Admin.Countries.Column.Id"]"
                                        Sortable="true">
                        <CellTemplate>@context.Id</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminCountrySummary" Key="code"
                                        Header="@L["Admin.Countries.Column.Code"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Code</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminCountrySummary" Key="name"
                                        Header="@L["Admin.Countries.Column.NameEn"]"
                                        Sortable="true">
                        <CellTemplate>@context.Name</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminCountrySummary" Key="namearabic"
                                        Header="@L["Admin.Countries.Column.NameAr"]">
                        <CellTemplate>@context.NameArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminCountrySummary" Key="phonePrefix"
                                        Header="@L["Admin.Countries.Column.PhonePrefix"]">
                        <CellTemplate>@(context.PhonePrefix ?? "—")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminCountrySummary" Key="displayOrder"
                                        Header="@L["Admin.Countries.Column.DisplayOrder"]"
                                        Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminCountrySummary" Key="isActive"
                                        Header="@L["Admin.Countries.Column.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Admin.Countries.Active.Yes"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Admin.Countries.Active.No"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Countries.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="countries"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Countries.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <CountryAddEdit IsEdit="_isEdit" Initial="_target"
                            OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <CountryViewDelete IsDelete="_isDelete" Initial="_target"
                               OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
