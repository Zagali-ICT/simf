@* D-155 — Countries CRUD. D-151 reference data, the lookup table that
   D-152 (UserProfile.NationalityId) and D-153 (Speaker.CountryId) both
   join against. Mirrors the ThemesList canonical pattern. *@
@page "/admin/countries"
@layout CpShellLayout
@attribute [Authorize(Roles = "Administrator")]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.Countries.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Countries.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminCountrySummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.NameEn)"
                      Caption="@L["Admin.Countries.Title"]"
                      FilterColumnLabel="@L["Admin.Countries.FilterColumn"]"
                      OnAdd="OnAddAsync"
                      OnEditOne="OnEditAsync"
                      OnDetailsOne="OnDetailsAsync"
                      OnDeleteOne="OnDeactivateAsync"
                      PrevLabel="@L["Admin.Countries.Prev"]"
                      NextLabel="@L["Admin.Countries.Next"]"
                      FirstLabel="@L["Admin.Countries.Pager.First"]"
                      LastLabel="@L["Admin.Countries.Pager.Last"]"
                      PageSizeLabel="@L["Admin.Countries.Pager.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.Countries.Loading"]"
                      FilterPlaceholder="@L["Admin.Countries.FilterPlaceholder"]"
                      ActionsHeader="@L["Admin.Countries.Column.Actions"]"
                      SelectAllLabel="@L["Admin.Countries.Action.SelectAll"]"
                      SelectRowLabel="@L["Admin.Countries.Action.SelectRow"]"
                      AddLabel="@L["Admin.Countries.Action.Add"]"
                      EditLabel="@L["Admin.Countries.Action.Edit"]"
                      DetailsLabel="@L["Admin.Countries.Action.Details"]"
                      DeleteLabel="@L["Admin.Countries.Action.Deactivate"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminCountrySummary" Key="id"
                                    Header="@L["Admin.Countries.Column.Id"]"
                                    Sortable="true">
                    <CellTemplate>@context.Id</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminCountrySummary" Key="code"
                                    Header="@L["Admin.Countries.Column.Code"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Code</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminCountrySummary" Key="nameEn"
                                    Header="@L["Admin.Countries.Column.NameEn"]"
                                    Sortable="true">
                    <CellTemplate>@context.NameEn</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminCountrySummary" Key="nameAr"
                                    Header="@L["Admin.Countries.Column.NameAr"]">
                    <CellTemplate>@context.NameAr</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminCountrySummary" Key="phonePrefix"
                                    Header="@L["Admin.Countries.Column.PhonePrefix"]">
                    <CellTemplate>@(context.PhonePrefix ?? "—")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminCountrySummary" Key="displayOrder"
                                    Header="@L["Admin.Countries.Column.DisplayOrder"]"
                                    Sortable="true">
                    <CellTemplate>@context.DisplayOrder</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminCountrySummary" Key="isActive"
                                    Header="@L["Admin.Countries.Column.Active"]">
                    <CellTemplate>
                        @if (context.IsActive)
                        {
                            <SimfPill Variant="on">@L["Admin.Countries.Active.Yes"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Admin.Countries.Active.No"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Countries.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_addOpen)
{
    <SimfModal Open="true" Title="@L["Admin.Countries.Add.Title"]"
               OnClose="@(() => _addOpen = false)">
        <ChildContent>
            <CountryForm OnSuccess="OnAddSucceededAsync"
                         OnCancel="@(() => _addOpen = false)" />
        </ChildContent>
    </SimfModal>
}

@if (_editTarget is not null)
{
    <SimfModal Open="true" Title="@L["Admin.Countries.Edit.Title"]"
               OnClose="@(() => _editTarget = null)">
        <ChildContent>
            <CountryForm Initial="_editTarget"
                         OnSuccess="OnEditSucceededAsync"
                         OnCancel="@(() => _editTarget = null)" />
        </ChildContent>
    </SimfModal>
}

@if (_detailsTarget is not null)
{
    <SimfModal Open="true" Title="@L["Admin.Countries.Details.Title"]"
               OnClose="@(() => _detailsTarget = null)">
        <ChildContent>
            <dl class="simf-dl">
                <dt>@L["Admin.Countries.Column.Id"]</dt>
                <dd>@_detailsTarget.Id</dd>
                <dt>@L["Admin.Countries.Column.Code"]</dt>
                <dd>@_detailsTarget.Code</dd>
                <dt>@L["Admin.Countries.Column.NameEn"]</dt>
                <dd>@_detailsTarget.NameEn</dd>
                <dt>@L["Admin.Countries.Column.NameAr"]</dt>
                <dd>@_detailsTarget.NameAr</dd>
                <dt>@L["Admin.Countries.Column.PhonePrefix"]</dt>
                <dd>@(_detailsTarget.PhonePrefix ?? "—")</dd>
                <dt>@L["Admin.Countries.Column.DisplayOrder"]</dt>
                <dd>@_detailsTarget.DisplayOrder</dd>
                <dt>@L["Admin.Countries.Column.Active"]</dt>
                <dd>@(_detailsTarget.IsActive ? L["Admin.Countries.Active.Yes"] : L["Admin.Countries.Active.No"])</dd>
            </dl>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" OnClick="@(() => _detailsTarget = null)">
                @L["Admin.Countries.Details.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private GridQuery _query = new() { Top = 50 };
    private GridPage<AdminCountrySummary> _page = new();
    private bool _loading;
    private Toast? _toast;

    private bool _addOpen;
    private AdminCountryDetail? _editTarget;
    private AdminCountryDetail? _detailsTarget;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<GridPage<AdminCountrySummary>>>(
                "simfAccount.postJson", "/account/api/admin/countries/list", _query);
            if (envelope is { Success: true, Data: not null })
            {
                _page = envelope.Data;
            }
            else
            {
                _toast = new Toast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Countries.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _addOpen = true;
        return Task.CompletedTask;
    }

    private async Task OnAddSucceededAsync(AdminCountryDetail created)
    {
        _addOpen = false;
        _toast = new Toast("success", string.Format(L["Admin.Countries.Created"], created.NameEn));
        await LoadAsync();
    }

    private async Task OnEditAsync(AdminCountrySummary row)
    {
        var envelope = await JS.InvokeAsync<ApiResult<AdminCountryDetail>>(
            "simfAccount.getJson", $"/account/api/admin/countries/{row.Id}");
        if (envelope is { Success: true, Data: not null })
        {
            _editTarget = envelope.Data;
        }
        else
        {
            _toast = new Toast("error",
                envelope?.Error?.MessageForCurrentCulture()
                ?? L["Admin.Countries.LoadFailed"]);
        }
    }

    private async Task OnEditSucceededAsync(AdminCountryDetail updated)
    {
        _editTarget = null;
        _toast = new Toast("success", string.Format(L["Admin.Countries.Updated"], updated.NameEn));
        await LoadAsync();
    }

    private async Task OnDetailsAsync(AdminCountrySummary row)
    {
        var envelope = await JS.InvokeAsync<ApiResult<AdminCountryDetail>>(
            "simfAccount.getJson", $"/account/api/admin/countries/{row.Id}");
        if (envelope is { Success: true, Data: not null })
        {
            _detailsTarget = envelope.Data;
        }
    }

    private async Task OnDeactivateAsync(AdminCountrySummary row)
    {
        _toast = null;
        var envelope = await JS.InvokeAsync<ApiResult<bool>>(
            "simfAccount.deleteJson", $"/account/api/admin/countries/{row.Id}");
        if (envelope is { Success: true })
        {
            _toast = new Toast("success",
                string.Format(L["Admin.Countries.Deactivated"], row.NameEn));
            await LoadAsync();
        }
        else
        {
            _toast = new Toast("error",
                envelope?.Error?.MessageForCurrentCulture()
                ?? L["Admin.Countries.Fallback"]);
        }
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Admin.Countries.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Admin.Countries.Pager.Page"], current, total);
}
