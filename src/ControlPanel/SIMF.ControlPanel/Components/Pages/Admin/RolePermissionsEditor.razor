@* Issue-1 — per-role permission editor. Lists the full catalogue grouped by
   page (from PermissionCatalog.All) with a checkbox per action, pre-checked
   from the role's current grants, and saves the selected set. Baseline roles
   are read-only (Administrator is the wildcard; GateOperator / PublicRelations
   are seeded). Gated by Roles.AssignPermissions. *@
@page "/admin/roles/{RoleId:guid}/permissions"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Roles.AssignPermissions)]

<PageTitle>@_pageTitle · SIMF</PageTitle>

<SimfPageHeader Title="@_pageTitle" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        @if (_loading)
        {
            <p>@L["Admin.RolePermissions.Loading"]</p>
        }
        else if (_role is not null)
        {
            @if (_role.IsBaseline)
            {
                <SimfAlert Variant="info">@L["Admin.RolePermissions.BaselineNotice"]</SimfAlert>
            }
            else
            {
                <p>@L["Admin.RolePermissions.Intro"]</p>
            }

            <EditForm OnValidSubmit="SaveAsync" Model="_selected" class="simf-form">
                @foreach (var group in _groups)
                {
                    <section class="simf-card">
                        <h3>@group.Key</h3>
                        @foreach (var permission in group)
                        {
                            <SimfCheckbox Value="_selected.Contains(permission.Code)"
                                          ValueChanged="@((bool on) => Toggle(permission.Code, on))"
                                          Disabled="_role.IsBaseline || _busy">
                                @permission.DisplayName
                            </SimfCheckbox>
                        }
                    </section>
                }

                <div class="simf-form__actions">
                    @if (!_role.IsBaseline)
                    {
                        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.RolePermissions.Saving"]">
                            @L["Admin.RolePermissions.Save"]
                        </SimfButton>
                    }
                    <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                                OnClick="BackToList">
                        @L["Admin.RolePermissions.Back"]
                    </SimfButton>
                </div>
            </EditForm>
        }
    </div>
</div>
