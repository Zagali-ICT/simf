@* D-148 — operator console for scanning. SIMF-FDS-003 §5.6 / API-GATES-001 §7.
   Role-adaptive: auto-selects on a single assignment, picker on multi. *@
@page "/admin/gates/operator"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Gates.Operate)]

<PageTitle>@L["Admin.Gates.Operator.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Gates.Operator.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_assignments.Count == 0)
        {
            <SimfEmptyState Title="@L["Admin.Gates.Operator.NoAssignments"]" />
        }
        else
        {
            <label class="simf-field">
                <span class="simf-field__label">@L["Admin.Gates.Operator.PickGate"]</span>
                <select class="simf-select" @bind="_selectedGateId" disabled="@_busy">
                    @foreach (var a in _assignments.Where(a => a.IsActive))
                    {
                        <option value="@a.GateId">@a.Code — @a.Name (@a.DirectionMode)</option>
                    }
                </select>
            </label>

            <div class="simf-form__actions simf-form__actions--tight">
                <SimfTextField Label="@L["Admin.Gates.Operator.QrLabel"]"
                               Helper="@L["Admin.Gates.Operator.QrHint"]"
                               MaxLength="32"
                               @bind-Value="_qrInput" Disabled="_busy" />
                <SimfButton Loading="_busy"
                            LoadingLabel="@L["Admin.Gates.Operator.Scanning"]"
                            OnClick="OnScanAsync">
                    @L["Admin.Gates.Operator.ScanButton"]
                </SimfButton>
            </div>

            @if (_last is not null)
            {
                if (_last.Outcome == ScanOutcome.Allowed)
                {
                    <SimfAlert Variant="success">
                        <strong>@L["Admin.Gates.Operator.Allowed"]</strong>
                        — @(_last.UserProfile?.DisplayName ?? "?")
                        (@(_last.UserProfile?.ProfileTypeName ?? "?")) — @_last.Direction
                    </SimfAlert>
                }
                else
                {
                    <SimfAlert Variant="error">
                        <strong>@L["Admin.Gates.Operator.Denied"]</strong>
                        — @_last.DenialReasonCode
                        — @_last.DenialMessage
                        @if (_last.UserProfile is not null)
                        {
                            <span>(@(_last.UserProfile.DisplayName) / @(_last.UserProfile.ProfileTypeName))</span>
                        }
                    </SimfAlert>
                }
            }

            <hr />

            <h3>@L["Admin.Gates.Operator.MyReportTitle"]</h3>
            @if (_report is null)
            {
                <p>@L["Admin.Gates.Operator.MyReportLoading"]</p>
            }
            else
            {
                <p>
                    @string.Format(L["Admin.Gates.Operator.MyReportSummary"],
                        _report.Totals.Allowed, _report.Totals.Denied)
                </p>
                @if (_report.Rows.Count > 0)
                {
                    <table class="simf-table">
                        <thead>
                            <tr>
                                <th>@L["Admin.Gates.Operator.Report.At"]</th>
                                <th>@L["Admin.Gates.Operator.Report.Outcome"]</th>
                                <th>@L["Admin.Gates.Operator.Report.Direction"]</th>
                                <th>@L["Admin.Gates.Operator.Report.Visitor"]</th>
                                <th>@L["Admin.Gates.Operator.Report.Reason"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _report.Rows.Take(50))
                            {
                                <tr>
                                    <td>@row.ScannedAt.FormatSaudi("hh:mm:ss tt")</td>
                                    <td>@row.Outcome</td>
                                    <td>@row.Direction</td>
                                    <td>@(row.VisitorDisplayName ?? "—")</td>
                                    <td>@(row.DenialReasonCode?.ToString() ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        }
    </div>
</div>
