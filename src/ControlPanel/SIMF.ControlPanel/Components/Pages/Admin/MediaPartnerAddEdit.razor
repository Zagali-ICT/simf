@* D-353 â€” reusable Media-Partner Add/Edit form, hosted by CrudShell (popup or
   full page) from MediaPartnersList.razor. Inherits CrudAddEditFormBase so it
   exposes the standard CRUD-form surface (IsEdit / Initial / OnSuccess /
   OnCancel). IsEdit=false runs Create (POST); IsEdit=true runs Edit (PUT against
   Initial) and shows the IsActive checkbox. Preserves the logo-path field and
   the optional shared-Contact link (SIMF-FDS-014 / D-283). Supersedes the inline
   SimfModal form that lived in MediaPartnersList. *@
@inherits CrudAddEditFormBase<AdminMediaPartnerDetail>
@using SIMF.Contracts.PublicRelations

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.MediaPartners.Field.NameEn"]"
                       MaxLength="256"
                       @bind-Value="_model.Name" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.MediaPartners.Field.NameAr"]"
                       MaxLength="256"
                       @bind-Value="_model.NameArabic" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.MediaPartners.Field.Logo"]"
                       MaxLength="512"
                       @bind-Value="_model.LogoRelativePath" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.MediaPartners.Field.Url"]"
                       MaxLength="512"
                       @bind-Value="_model.Url" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.MediaPartners.Field.DisplayOrder"]"
                       Type="number"
                       Value="@_displayOrderInput"
                       ValueChanged="@(v => _displayOrderInput = v)"
                       ValueExpression="@(() => _displayOrderInput)"
                       Disabled="_busy" />
        @if (IsEdit)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.MediaPartners.Field.IsActive"]
            </SimfCheckbox>
        }
        @* D-357 — logo via the unified media-asset pipeline (edit only; the row
           must exist before bytes can be attached). *@
        @if (IsEdit && Initial is not null)
        {
            <div class="simf-field">
                <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
                <SimfImageUpload Category="MediaPartnerLogo" OwnerId="@Initial.Id" Alt="@_model.Name" />
            </div>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.MediaPartners.Save"]">
            @L["Admin.MediaPartners.Save"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.MediaPartners.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
