@* D-127 — Walk-in visitor registration host. Hosts the shared
   WalkInRegistrationForm with Kind=Visitor and renders the
   WalkInSuccessModal with the minted QR after a successful submit. *@
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<WalkInRegistrationForm @ref="_form"
                        Kind="Visitor"
                        OnSuccess="OnRegistrationSuccessAsync"
                        OnCancel="OnCancelInternal"
                        @key="_formKey" />

<WalkInSuccessModal Response="_lastResponse"
                    OnClose="OnSuccessModalClose"
                    OnPrint="OnPrintAsync"
                    OnRegisterAnother="OnRegisterAnother" />

@code {
    private WalkInRegistrationForm? _form;
    private AdminWalkInRegistrationResponse? _lastResponse;
    private Guid _formKey = Guid.NewGuid();

    /// <summary>Fires after a successful walk-in registration so the host
    /// list page can refresh the grid. The parent receives the response so
    /// it can render its own follow-up if needed.</summary>
    [Parameter] public EventCallback<AdminCreateUserResponse> OnSuccess { get; set; }

    /// <summary>Raised when the user clicks Cancel. If unset, no Cancel button renders.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>The cancel button label (kept for the legacy host page).</summary>
    [Parameter] public string? CancelLabel { get; set; }

    private async Task OnRegistrationSuccessAsync(AdminWalkInRegistrationResponse response)
    {
        _lastResponse = response;
        // Bubble a list-friendly summary up to the host grid so it can
        // reload and toast — the host pages still expect AdminCreateUserResponse.
        await OnSuccess.InvokeAsync(new AdminCreateUserResponse(
            response.UserId,
            response.Email,
            0));
    }

    private void OnSuccessModalClose() => _lastResponse = null;

    private async Task OnPrintAsync() =>
        await JS.InvokeVoidAsync("window.print");

    private void OnRegisterAnother()
    {
        _lastResponse = null;
        // Reset by recreating the form via @key — keeps the wizard simple.
        _formKey = Guid.NewGuid();
        StateHasChanged();
    }

    private Task OnCancelInternal() => OnCancel.InvokeAsync();
}
