@* D-353 — reusable Booth Add/Edit form, hosted by CrudShell (popup or full
   page) from BoothsList. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel). IsEdit
   =false runs Create (POST); IsEdit=true runs Edit (PUT against Initial) and
   shows the IsActive checkbox. Preserves the exhibitor + hall lookups, the
   booth-officer fields,
   the 2D map position, and the same create/update request DTOs + JS calls the
   inline SimfModal form used. *@
@inherits CrudAddEditFormBase<AdminBoothDetail>
@using SIMF.Contracts.Exhibition
@using SIMF.Contracts.Exhibitors

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.Booths.Field.Code"]"
                       Value="@_model.Code"
                       ValueChanged="@(v => _model.Code = v)"
                       ValueExpression="@(() => _model.Code)"
                       MaxLength="16"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Booths.Field.NameEn"]"
                       Value="@_model.Name"
                       ValueChanged="@(v => _model.Name = v)"
                       ValueExpression="@(() => _model.Name)"
                       MaxLength="128"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Booths.Field.NameAr"]"
                       Value="@_model.NameArabic"
                       ValueChanged="@(v => _model.NameArabic = v)"
                       ValueExpression="@(() => _model.NameArabic)"
                       MaxLength="128"
                       Disabled="_busy" />
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Booths.Field.Exhibitor"]</span>
            <select class="simf-field__input"
                    value="@(_model.ExhibitorId?.ToString() ?? string.Empty)"
                    @onchange="OnExhibitorIdChanged"
                    disabled="@_busy">
                <option value="">@L["Admin.Booths.Field.ExhibitorNone"]</option>
                @foreach (var exhibitor in _exhibitors)
                {
                    <option value="@exhibitor.Id">@exhibitor.NameEn — @exhibitor.NameAr</option>
                }
            </select>
        </label>
        <SimfTextField Label="@L["Admin.Booths.Field.OfficerName"]"
                       Value="@_model.OfficerName"
                       ValueChanged="@(v => _model.OfficerName = v)"
                       ValueExpression="@(() => _model.OfficerName)"
                       MaxLength="256"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Booths.Field.OfficerPhone"]"
                       Value="@_model.OfficerPhone"
                       ValueChanged="@(v => _model.OfficerPhone = v)"
                       ValueExpression="@(() => _model.OfficerPhone)"
                       MaxLength="32"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Booths.Field.OfficerEmail"]"
                       Value="@_model.OfficerEmail"
                       ValueChanged="@(v => _model.OfficerEmail = v)"
                       ValueExpression="@(() => _model.OfficerEmail)"
                       MaxLength="320"
                       Disabled="_busy" />
        @* NEW inline booth-officer identity-card fields (D-766). Most labels reuse
           the generic Admin.ContactField.* keys; the officer Arabic name uses the
           officer-scoped Admin.Booths.Field.OfficerNameAr key; nationality is the
           officer-country picker below. *@
        <SimfTextField Label="@L["Admin.Booths.Field.OfficerNameAr"]"
                       Value="@_model.OfficerNameArabic"
                       ValueChanged="@(v => _model.OfficerNameArabic = v)"
                       ValueExpression="@(() => _model.OfficerNameArabic)"
                       MaxLength="256"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.PhoneSecondary"]"
                       Value="@_model.OfficerPhoneSecondary"
                       ValueChanged="@(v => _model.OfficerPhoneSecondary = v)"
                       ValueExpression="@(() => _model.OfficerPhoneSecondary)"
                       MaxLength="32"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.City"]"
                       Value="@_model.OfficerCity"
                       ValueChanged="@(v => _model.OfficerCity = v)"
                       ValueExpression="@(() => _model.OfficerCity)"
                       MaxLength="128"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.CityArabic"]"
                       Value="@_model.OfficerCityArabic"
                       ValueChanged="@(v => _model.OfficerCityArabic = v)"
                       ValueExpression="@(() => _model.OfficerCityArabic)"
                       MaxLength="128"
                       Disabled="_busy" />
        <SimfSelect TValue="string"
                    Label="@L["Admin.ContactField.Country"]"
                    Placeholder="@L["Admin.ContactField.CountryNone"]"
                    Items="_countryIds"
                    ValueFor="@(id => id)"
                    LabelFor="@(id => CountryLabel(id))"
                    Value="@_officerCountryIdInput"
                    ValueChanged="@(v => _officerCountryIdInput = v ?? string.Empty)"
                    Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.Website"]"
                       Value="@_model.OfficerWebsite"
                       ValueChanged="@(v => _model.OfficerWebsite = v)"
                       ValueExpression="@(() => _model.OfficerWebsite)"
                       MaxLength="512"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.Facebook"]"
                       Value="@_model.OfficerFacebookUrl"
                       ValueChanged="@(v => _model.OfficerFacebookUrl = v)"
                       ValueExpression="@(() => _model.OfficerFacebookUrl)"
                       MaxLength="256"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.X"]"
                       Value="@_model.OfficerXUrl"
                       ValueChanged="@(v => _model.OfficerXUrl = v)"
                       ValueExpression="@(() => _model.OfficerXUrl)"
                       MaxLength="256"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.LinkedIn"]"
                       Value="@_model.OfficerLinkedInUrl"
                       ValueChanged="@(v => _model.OfficerLinkedInUrl = v)"
                       ValueExpression="@(() => _model.OfficerLinkedInUrl)"
                       MaxLength="256"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.Instagram"]"
                       Value="@_model.OfficerInstagramUrl"
                       ValueChanged="@(v => _model.OfficerInstagramUrl = v)"
                       ValueExpression="@(() => _model.OfficerInstagramUrl)"
                       MaxLength="256"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.Latitude"]"
                       Helper="@L["Admin.ContactField.LatLongHint"]"
                       Value="@_officerLatitudeInput"
                       ValueChanged="@(v => _officerLatitudeInput = v)"
                       ValueExpression="@(() => _officerLatitudeInput)"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.Longitude"]"
                       Value="@_officerLongitudeInput"
                       ValueChanged="@(v => _officerLongitudeInput = v)"
                       ValueExpression="@(() => _officerLongitudeInput)"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Booths.Field.SectorEn"]"
                       Value="@_model.Sector"
                       ValueChanged="@(v => _model.Sector = v)"
                       ValueExpression="@(() => _model.Sector)"
                       MaxLength="128"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Booths.Field.SectorAr"]"
                       Value="@_model.SectorArabic"
                       ValueChanged="@(v => _model.SectorArabic = v)"
                       ValueExpression="@(() => _model.SectorArabic)"
                       MaxLength="128"
                       Disabled="_busy" />
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Booths.Field.DescriptionEn"]</span>
            <textarea class="simf-field__input" rows="3" maxlength="2048"
                      value="@_model.Description"
                      @onchange="OnDescriptionEnChanged"
                      disabled="@_busy"></textarea>
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Booths.Field.DescriptionAr"]</span>
            <textarea class="simf-field__input" rows="3" maxlength="2048"
                      value="@_model.DescriptionArabic"
                      @onchange="OnDescriptionArChanged"
                      disabled="@_busy"></textarea>
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Booths.Field.HallId"]</span>
            <select class="simf-field__input"
                    value="@(_model.HallId?.ToString() ?? string.Empty)"
                    @onchange="OnHallIdChanged"
                    disabled="@_busy">
                <option value="">@L["Admin.Booths.Field.HallNone"]</option>
                @foreach (var hall in _halls)
                {
                    <option value="@hall.Id">@hall.Name — @hall.NameArabic</option>
                }
            </select>
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Booths.Field.MapX"]</span>
            <input class="simf-field__input" type="number" step="any"
                   value="@_model.MapX"
                   @onchange="OnMapXChanged"
                   disabled="@_busy" />
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Booths.Field.MapY"]</span>
            <input class="simf-field__input" type="number" step="any"
                   value="@_model.MapY"
                   @onchange="OnMapYChanged"
                   disabled="@_busy" />
        </label>
        @if (IsEdit)
        {
            <SimfCheckbox Value="_model.IsActive"
                          ValueChanged="@(v => _model.IsActive = v)"
                          Disabled="_busy">
                @L["Admin.Booths.Field.IsActive"]
            </SimfCheckbox>
        }
        @* Booth logo via the unified media-asset pipeline (edit only; the row
           must exist before bytes can be attached). Owner = the booth itself. *@
        @if (IsEdit && Initial is not null)
        {
            <div class="simf-field">
                <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
                <SimfImageUpload Category="BoothLogo" OwnerId="@Initial.Id" Alt="@_model.Name" />
            </div>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy"
                    LoadingLabel="@(IsEdit ? L["Admin.Booths.Edit.Submitting"] : L["Admin.Booths.New.Submitting"])">
            @(IsEdit ? L["Admin.Booths.Edit.Submit"] : L["Admin.Booths.New.Submit"])
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Booths.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
