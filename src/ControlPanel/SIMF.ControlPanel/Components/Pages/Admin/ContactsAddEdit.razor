@* D-353 — reusable Contact Add/Edit form, hosted by CrudShell (popup or full
   page) from ContactsList. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel).
   IsEdit=false runs Create (POST); IsEdit=true runs Edit (PUT against Initial)
   and shows the IsActive checkbox. The form owns its own country picker (loaded
   once, active rows only) and the lat/long pairing rule, mirroring the server's
   ContactInvalid validation. Supersedes the inline SimfModal form that lived in
   ContactsList. *@
@inherits CrudAddEditFormBase<AdminContactDetail>
@using SIMF.Contracts.Contacts

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.Contacts.Field.NameAr"]"
                       @bind-Value="_model.NameAr"
                       MaxLength="256" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.NameEn"]"
                       @bind-Value="_model.NameEn"
                       MaxLength="256" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.LogoRelativePath"]"
                       Helper="@L["Admin.Contacts.Field.LogoHint"]"
                       @bind-Value="_model.LogoRelativePath"
                       MaxLength="512" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.PhonePrimary"]"
                       @bind-Value="_model.PhonePrimary"
                       MaxLength="32" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.PhoneSecondary"]"
                       @bind-Value="_model.PhoneSecondary"
                       MaxLength="32" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.Email"]"
                       @bind-Value="_model.Email"
                       MaxLength="320" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.Website"]"
                       @bind-Value="_model.Website"
                       MaxLength="512" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.FacebookUrl"]"
                       @bind-Value="_model.FacebookUrl"
                       MaxLength="256" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.XUrl"]"
                       @bind-Value="_model.XUrl"
                       MaxLength="256" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.LinkedInUrl"]"
                       @bind-Value="_model.LinkedInUrl"
                       MaxLength="256" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.InstagramUrl"]"
                       @bind-Value="_model.InstagramUrl"
                       MaxLength="256" Disabled="_busy" />
        <SimfSelect TValue="string"
                    Label="@L["Admin.Contacts.Field.Country"]"
                    Placeholder="@L["Admin.Contacts.Field.CountryPlaceholder"]"
                    Items="_countryIds"
                    ValueFor="@(id => id)"
                    LabelFor="@(id => CountryLabel(id))"
                    Value="@_model.CountryId"
                    ValueChanged="@(v => _model.CountryId = v ?? string.Empty)"
                    Disabled="_busy" />
        @* Optional bilingual city. *@
        <SimfTextField Label="@L["Admin.Contacts.Field.CityAr"]"
                       @bind-Value="_model.CityArabic"
                       MaxLength="128" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.City"]"
                       @bind-Value="_model.City"
                       MaxLength="128" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.Latitude"]"
                       Helper="@L["Admin.Contacts.Field.LatLongHint"]"
                       Type="number"
                       @bind-Value="_model.Latitude"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Contacts.Field.Longitude"]"
                       Type="number"
                       @bind-Value="_model.Longitude"
                       Disabled="_busy" />
        @if (IsEdit)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.Contacts.Field.IsActive"]
            </SimfCheckbox>
        }
        @* D-357 — logo via the unified media-asset pipeline (edit only; the row
           must exist before bytes can be attached). *@
        @if (IsEdit && Initial is not null)
        {
            <div class="simf-field">
                <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
                <SimfImageUpload Category="CompanyLogo" OwnerId="@Initial.Id" Alt="@_model.NameEn" />
            </div>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.Contacts.Save"]">
            @L["Admin.Contacts.Save"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Contacts.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
