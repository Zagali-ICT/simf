@* Append-only AI invocations log. Read-only.
   Filterable by errors-only so SOC + product can spot regressions.
   Migrated to the canonical SimfDataGrid (owner-mandated): per-column
   sort/filter, full numbered pager. The page has no CRUD — the only
   action is the "Errors only" toggle, kept as a CustomToolbar control. *@
@page "/admin/ai/invocations"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.AiInvocations.View)]

<PageTitle>@L["Admin.AiInvocations.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.AiInvocations.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <div class="simf-toast">
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            </div>
        }

        <SimfDataGrid TItem="AdminAiInvocationRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="false"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.PromptKey)"
                      Caption="@L["Admin.AiInvocations.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.AiInvocations.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      AddLabel="@L["Grid.Add"]"
                      EditLabel="@L["Grid.Edit"]"
                      DeleteLabel="@L["Grid.Delete"]"
                      SummaryFormatter="@FormatSummary">
            <CustomToolbar>
                @* Existing "errors only" filter, preserved. Toggling rebuilds
                   the query with the errorOnly filter and reloads. *@
                <SimfCheckbox Value="_errorsOnly" ValueChanged="OnErrorsOnlyChangedAsync">
                    @L["Admin.AiInvocations.Filter.ErrorsOnly"]
                </SimfCheckbox>
            </CustomToolbar>
            <Columns>
                <SimfDataGridColumn TItem="AdminAiInvocationRow" Key="createdAt"
                                    Header="@L["Admin.AiInvocations.Col.Time"]"
                                    Sortable="true">
                    <CellTemplate>@context.CreatedAt.FormatSaudi("dd-MM-yyyy hh:mm:ss tt")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminAiInvocationRow" Key="promptKey"
                                    Header="@L["Admin.AiInvocations.Col.PromptKey"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate><code>@context.PromptKey</code></CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminAiInvocationRow" Key="feature"
                                    Header="@L["Admin.AiInvocations.Col.Feature"]"
                                    Sortable="true">
                    <CellTemplate>@context.Feature</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminAiInvocationRow" Key="provider"
                                    Header="@L["Admin.AiInvocations.Col.Provider"]"
                                    Sortable="true">
                    <CellTemplate>@context.Provider</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminAiInvocationRow" Key="callerKind"
                                    Header="@L["Admin.AiInvocations.Col.Caller"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.CallerKind</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminAiInvocationRow" Key="latencyMs"
                                    Header="@L["Admin.AiInvocations.Col.Latency"]"
                                    Sortable="true">
                    <CellTemplate>@(context.LatencyMs)ms</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminAiInvocationRow" Key="tokens"
                                    Header="@L["Admin.AiInvocations.Col.Tokens"]">
                    <CellTemplate>@(context.TokensInput?.ToString() ?? "—") / @(context.TokensOutput?.ToString() ?? "—")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminAiInvocationRow" Key="error"
                                    Header="@L["Admin.AiInvocations.Col.Error"]">
                    <CellTemplate>
                        @if (context.ErrorCode is not null)
                        {
                            <SimfPill Variant="off">@context.ErrorCode</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @* SOC drill-down: the full redacted payload for one row.
                   The endpoint gates on AiInvocations.View, so the action does too. *@
                <AuthorizedAction Permission="@PermissionCatalog.AiInvocations.View">
                    <SimfToolbarButton Icon="eye" Title="@L["Admin.AiInvocations.Detail"]"
                                       OnClick="@(() => OnDetailAsync(context))" />
                </AuthorizedAction>
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.AiInvocations.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_detail is not null)
{
    <SimfModal Open="true" Title="@L["Admin.AiInvocations.Detail.Title"]" OnClose="CloseDetail" CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <dl class="simf-dl">
                <dt>@L["Admin.AiInvocations.Col.PromptKey"]</dt>
                <dd><code>@_detail.PromptKey</code></dd>
                <dt>@L["Admin.AiInvocations.Col.Feature"]</dt>
                <dd>@_detail.Feature</dd>
                <dt>@L["Admin.AiInvocations.Col.Provider"]</dt>
                <dd>@_detail.Provider · @_detail.Model</dd>
                <dt>@L["Admin.AiInvocations.Col.Caller"]</dt>
                <dd>@_detail.CallerKind</dd>
                <dt>@L["Admin.AiInvocations.Col.Latency"]</dt>
                <dd>@(_detail.LatencyMs)ms</dd>
                <dt>@L["Admin.AiInvocations.Col.Tokens"]</dt>
                <dd>@(_detail.TokensInput?.ToString() ?? "—") / @(_detail.TokensOutput?.ToString() ?? "—")</dd>
                @if (_detail.ErrorCode is not null)
                {
                    <dt>@L["Admin.AiInvocations.Col.Error"]</dt>
                    <dd><SimfPill Variant="danger">@_detail.ErrorCode</SimfPill></dd>
                }
                <dt>@L["Admin.AiInvocations.Detail.Input"]</dt>
                <dd><pre class="simf-pre--wrap">@_detail.InputJson</pre></dd>
                <dt>@L["Admin.AiInvocations.Detail.Output"]</dt>
                <dd><pre class="simf-pre--wrap">@(_detail.OutputText ?? "—")</pre></dd>
            </dl>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="CloseDetail">
                @L["Admin.AiInvocations.Detail.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
