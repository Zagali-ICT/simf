@* D-353 — reusable Exhibitor Add/Edit form, hosted by CrudShell (popup or full
   page) from ExhibitorsList. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel). Branch
   Create vs Update on IsEdit (POST when !IsEdit, PUT against Initial!.Id when
   IsEdit). Re-uses the same field controls, the same client guards, the same
   Create/Update request DTOs and the same simfAccount.postJson/putJson calls
   the inline modal carried before (D-202). *@
@inherits CrudAddEditFormBase<AdminExhibitorDetail>
@using SIMF.Contracts.Exhibitors

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<div class="simf-form__fields">
    <SimfTextField Label="@L["Admin.Exhibitors.Field.NameEn"]"
                   Value="@_form.NameEn"
                   ValueChanged="@(v => _form.NameEn = v)"
                   ValueExpression="@(() => _form.NameEn)"
                   MaxLength="256"
                   Disabled="_busy" />
    <SimfTextField Label="@L["Admin.Exhibitors.Field.NameAr"]"
                   Value="@_form.NameAr"
                   ValueChanged="@(v => _form.NameAr = v)"
                   ValueExpression="@(() => _form.NameAr)"
                   MaxLength="256"
                   Disabled="_busy" />
    <SimfTextField Label="@L["Admin.Exhibitors.Field.ContactEmail"]"
                   Value="@_form.ContactEmail"
                   ValueChanged="@(v => _form.ContactEmail = v)"
                   ValueExpression="@(() => _form.ContactEmail)"
                   MaxLength="320"
                   Disabled="_busy" />
    <SimfTextField Label="@L["Admin.Exhibitors.Field.ContactPhone"]"
                   Value="@_form.ContactPhone"
                   ValueChanged="@(v => _form.ContactPhone = v)"
                   ValueExpression="@(() => _form.ContactPhone)"
                   MaxLength="32"
                   Disabled="_busy" />
    <SimfTextField Label="@L["Admin.Exhibitors.Field.Website"]"
                   Value="@_form.Website"
                   ValueChanged="@(v => _form.Website = v)"
                   ValueExpression="@(() => _form.Website)"
                   MaxLength="512"
                   Disabled="_busy" />
    @* Optional exhibitor tier — a blank option leaves the tier null. *@
    <label class="simf-field">
        <span class="simf-field__label">@L["Admin.Exhibitors.Field.Tier"]</span>
        <select class="simf-field__input"
                value="@(_form.Tier?.ToString() ?? string.Empty)"
                @onchange="OnTierChanged"
                disabled="@_busy">
            <option value="">@L["Admin.Exhibitors.Field.TierNone"]</option>
            @foreach (var tier in _tiers)
            {
                <option value="@tier.Value">@tier.Name</option>
            }
        </select>
    </label>
    @if (IsEdit)
    {
        <SimfCheckbox Value="_form.IsActive"
                      ValueChanged="@(v => _form.IsActive = v)"
                      Disabled="_busy">
            @L["Admin.Exhibitors.Field.IsActive"]
        </SimfCheckbox>
    }
    @* Exhibitor logo via the unified media-asset pipeline (edit only; the row
       must exist before bytes can be attached). Owner = the exhibitor itself,
       independent of the linked Contact's CompanyLogo. *@
    @if (IsEdit && Initial is not null)
    {
        <div class="simf-field">
            <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
            <SimfImageUpload Category="ExhibitorLogo" OwnerId="@Initial.Id" Alt="@_form.NameEn" />
        </div>
    }
</div>

@* Contact information (D-766: identity-card fields inlined from the removed
   shared Contact directory). The email + primary phone reuse the fields above;
   nationality is the country picker here. *@
<SimfFormSection Title="@L["Admin.ContactField.Heading"]">
    <div class="simf-form__grid">
        <SimfTextField Label="@L["Admin.ContactField.PhoneSecondary"]"
                       Value="@_form.PhoneSecondary"
                       ValueChanged="@(v => _form.PhoneSecondary = v)"
                       ValueExpression="@(() => _form.PhoneSecondary)"
                       MaxLength="32"
                       Disabled="_busy" />
        <SimfSelect TValue="string"
                    Label="@L["Admin.ContactField.Country"]"
                    Placeholder="@L["Admin.ContactField.CountryNone"]"
                    Items="_countryIds"
                    ValueFor="@(id => id)"
                    LabelFor="@(id => CountryLabel(id))"
                    Value="@_countryIdInput"
                    ValueChanged="@(v => _countryIdInput = v ?? string.Empty)"
                    Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.City"]"
                       Value="@_form.City"
                       ValueChanged="@(v => _form.City = v)"
                       ValueExpression="@(() => _form.City)"
                       MaxLength="128"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.CityArabic"]"
                       Value="@_form.CityArabic"
                       ValueChanged="@(v => _form.CityArabic = v)"
                       ValueExpression="@(() => _form.CityArabic)"
                       MaxLength="128"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.Facebook"]"
                       Value="@_form.FacebookUrl"
                       ValueChanged="@(v => _form.FacebookUrl = v)"
                       ValueExpression="@(() => _form.FacebookUrl)"
                       MaxLength="256"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.X"]"
                       Value="@_form.XUrl"
                       ValueChanged="@(v => _form.XUrl = v)"
                       ValueExpression="@(() => _form.XUrl)"
                       MaxLength="256"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.LinkedIn"]"
                       Value="@_form.LinkedInUrl"
                       ValueChanged="@(v => _form.LinkedInUrl = v)"
                       ValueExpression="@(() => _form.LinkedInUrl)"
                       MaxLength="256"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.Instagram"]"
                       Value="@_form.InstagramUrl"
                       ValueChanged="@(v => _form.InstagramUrl = v)"
                       ValueExpression="@(() => _form.InstagramUrl)"
                       MaxLength="256"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.Latitude"]"
                       Helper="@L["Admin.ContactField.LatLongHint"]"
                       Value="@_latitudeInput"
                       ValueChanged="@(v => _latitudeInput = v)"
                       ValueExpression="@(() => _latitudeInput)"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ContactField.Longitude"]"
                       Value="@_longitudeInput"
                       ValueChanged="@(v => _longitudeInput = v)"
                       ValueExpression="@(() => _longitudeInput)"
                       Disabled="_busy" />
    </div>
</SimfFormSection>

<div class="simf-form__actions">
    <SimfButton Type="button" OnClick="SaveAsync" Loading="_busy" LoadingLabel="@L["Grid.Working"]">
        @L["Admin.Exhibitors.Save"]
    </SimfButton>
    @if (OnCancel.HasDelegate)
    {
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Exhibitors.Cancel"]
        </SimfButton>
    }
</div>
