@* D-353 — reusable Exhibitor Add/Edit form, hosted by CrudShell (popup or full
   page) from ExhibitorsList. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel). Branch
   Create vs Update on IsEdit (POST when !IsEdit, PUT against Initial!.Id when
   IsEdit). Re-uses the same field controls, the same client guards, the same
   Create/Update request DTOs and the same simfAccount.postJson/putJson calls
   the inline modal carried before (D-202). *@
@inherits CrudAddEditFormBase<AdminExhibitorDetail>
@using SIMF.Contracts.Exhibitors

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<div class="simf-form__fields">
    <SimfTextField Label="@L["Admin.Exhibitors.Field.NameEn"]"
                   Value="@_form.NameEn"
                   ValueChanged="@(v => _form.NameEn = v)"
                   ValueExpression="@(() => _form.NameEn)"
                   MaxLength="256"
                   Disabled="_busy" />
    <SimfTextField Label="@L["Admin.Exhibitors.Field.NameAr"]"
                   Value="@_form.NameAr"
                   ValueChanged="@(v => _form.NameAr = v)"
                   ValueExpression="@(() => _form.NameAr)"
                   MaxLength="256"
                   Disabled="_busy" />
    <SimfTextField Label="@L["Admin.Exhibitors.Field.ContactEmail"]"
                   Value="@_form.ContactEmail"
                   ValueChanged="@(v => _form.ContactEmail = v)"
                   ValueExpression="@(() => _form.ContactEmail)"
                   MaxLength="320"
                   Disabled="_busy" />
    <SimfTextField Label="@L["Admin.Exhibitors.Field.ContactPhone"]"
                   Value="@_form.ContactPhone"
                   ValueChanged="@(v => _form.ContactPhone = v)"
                   ValueExpression="@(() => _form.ContactPhone)"
                   MaxLength="32"
                   Disabled="_busy" />
    <SimfTextField Label="@L["Admin.Exhibitors.Field.Website"]"
                   Value="@_form.Website"
                   ValueChanged="@(v => _form.Website = v)"
                   ValueExpression="@(() => _form.Website)"
                   MaxLength="512"
                   Disabled="_busy" />
    @* Optional exhibitor tier — a blank option leaves the tier null. *@
    <label class="simf-field">
        <span class="simf-field__label">@L["Admin.Exhibitors.Field.Tier"]</span>
        <select class="simf-field__input"
                value="@(_form.Tier?.ToString() ?? string.Empty)"
                @onchange="OnTierChanged"
                disabled="@_busy">
            <option value="">@L["Admin.Exhibitors.Field.TierNone"]</option>
            @foreach (var tier in _tiers)
            {
                <option value="@tier.Value">@tier.Name</option>
            }
        </select>
    </label>
    @* SIMF-FDS-014 (D-283) — optional link to a shared Contact directory record. *@
    <ContactPicker Value="_form.ContactId" ValueChanged="@(v => _form.ContactId = v)" Disabled="_busy" />
    @if (IsEdit)
    {
        <SimfCheckbox Value="_form.IsActive"
                      ValueChanged="@(v => _form.IsActive = v)"
                      Disabled="_busy">
            @L["Admin.Exhibitors.Field.IsActive"]
        </SimfCheckbox>
    }
</div>

<div class="simf-form__actions">
    <SimfButton Type="button" OnClick="SaveAsync" Loading="_busy">
        @L["Admin.Exhibitors.Save"]
    </SimfButton>
    @if (OnCancel.HasDelegate)
    {
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Exhibitors.Cancel"]
        </SimfButton>
    }
</div>
