@* D-353 â€” reusable Content-Block View/Delete form, hosted by CrudShell (popup
   or full page) from ContentBlocksList. Inherits CrudViewDeleteFormBase so it
   exposes the standard surface (IsDelete / Initial / OnDeleted / OnCancel).
   Read-only details always show; when IsDelete=true a Delete button appears and
   a SimfConfirm gates the soft-delete-by-Key (replaces the old one-click delete
   on the list). Adds the View path the inline form never had. *@
@inherits CrudViewDeleteFormBase<AdminContentBlockSummary>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.ContentBlocks.Col.Key"]</dt>
        <dd><code>@Initial.Key</code></dd>
        <dt>@L["Admin.ContentBlocks.Field.ContentEn"]</dt>
        <dd>@Initial.Content</dd>
        <dt>@L["Admin.ContentBlocks.Field.ContentAr"]</dt>
        <dd>@Initial.ContentArabic</dd>
        <dt>@L["Admin.ContentBlocks.Col.LastUpdatedAt"]</dt>
        <dd>@Initial.LastUpdatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</dd>
        <dt>@L["Admin.ContentBlocks.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.ContentBlocks.Action.Delete"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.ContentBlocks.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.ContentBlocks.Delete.Title"]"
                 Message="@string.Format(L["Admin.ContentBlocks.Delete.Message"], Initial.Key)"
                 ConfirmLabel="@L["Admin.ContentBlocks.Action.Delete"]"
                 CancelLabel="@L["Admin.ContentBlocks.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" />
}
