@* D-452 — CP management for the programme days that head the app's Sessions
   screen (Figma 883:2308 "تفاصيل اليوم"): a date, a bilingual title and a logo
   (the logo rides the unified D-357 asset pipeline — AssetCategory
   .ProgrammeDayImage — so it is attached from the Edit form, not this grid).
   Centralized dialog/full-page framing (D-353): Add / Edit / View / Delete are
   hosted by CrudShell. The list is a tiny lookup (a handful of rows) so it
   carries no Excel export/import. *@
@page "/admin/programme-days"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.ProgrammeDays.View)]
@using SIMF.Contracts.Admin

<PageTitle>@L["Admin.ProgrammeDays.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.ProgrammeDays.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminProgrammeDaySummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Title)"
                          Caption="@L["Admin.ProgrammeDays.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.ProgrammeDays.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminProgrammeDaySummary" Key="date"
                                        Header="@L["Admin.ProgrammeDays.Col.Date"]"
                                        Sortable="true">
                        <CellTemplate>@context.Date.ToString("yyyy-MM-dd")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminProgrammeDaySummary" Key="title"
                                        Header="@L["Admin.ProgrammeDays.Col.TitleEn"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Title</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminProgrammeDaySummary" Key="titlearabic"
                                        Header="@L["Admin.ProgrammeDays.Col.TitleAr"]"
                                        Filterable="true">
                        <CellTemplate>@context.TitleArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminProgrammeDaySummary" Key="order"
                                        Header="@L["Admin.ProgrammeDays.Col.Order"]"
                                        Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminProgrammeDaySummary" Key="image"
                                        Header="@L["Admin.ProgrammeDays.Col.Image"]">
                        <CellTemplate>
                            @if (context.HasImage)
                            {
                                <SimfPill Variant="on">@L["Admin.ProgrammeDays.Image.Set"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Admin.ProgrammeDays.Image.None"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminProgrammeDaySummary" Key="isActive"
                                        Header="@L["Admin.ProgrammeDays.Col.Active"]"
                                        Sortable="true">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.ProgrammeDays.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.ProgrammeDays.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <ProgrammeDaysAddEdit IsEdit="_isEdit" Initial="_target"
                                  OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <ProgrammeDaysViewDelete IsDelete="_isDelete" Initial="_target"
                                     OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
