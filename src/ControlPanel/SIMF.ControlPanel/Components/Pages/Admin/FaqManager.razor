@* P2.1 (D-211) — FAQ management. Two-level: a groups grid (top) and, when a
   group is selected via "Manage entries", its entries grid (below). Migrated
   from the custom raw <table> pair to the canonical SimfDataGrid (owner-mandated
   standard, D-338) — server-paged + numbered pager + select-all + per-row icon
   actions. Each grid sorts on the columns the FAQ service supports (name /
   question / display-order); per-column text filters are not enabled because
   the service filters only by global search + isActive. Page-level
   [RequirePermission(Faq.View)] gates the page; the Create/Edit/Delete
   permissions are enforced by the API (the canonical grid pattern moves the
   per-action gate to the API, as InterestsList/SessionCategoriesList do). *@
@page "/admin/faq"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Faq.View)]

<PageTitle>@L["Admin.Faq.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Faq.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <h2 class="simf-section__title">@L["Admin.Faq.Groups.Heading"]</h2>

        <SimfDataGrid TItem="AdminFaqGroupSummary"
                      Query="_groupQuery"
                      Page="_groupPage"
                      Loading="_groupLoading"
                      OnQueryChanged="OnGroupQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.NameEn)"
                      Caption="@L["Admin.Faq.Groups.Heading"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      OnAdd="OpenAddGroup"
                      OnEditOne="OpenEditGroup"
                      OnDeleteOne="DeactivateGroupAsync"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Grid.Loading"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      AddLabel="@L["Grid.Add"]"
                      EditLabel="@L["Grid.Edit"]"
                      DeleteLabel="@L["Grid.Delete"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminFaqGroupSummary" Key="nameen"
                                    Header="@L["Admin.Faq.Col.NameEn"]" Sortable="true">
                    <CellTemplate>@context.NameEn</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminFaqGroupSummary" Key="namear"
                                    Header="@L["Admin.Faq.Col.NameAr"]">
                    <CellTemplate>@context.NameAr</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminFaqGroupSummary" Key="displayorder"
                                    Header="@L["Admin.Faq.Col.Order"]" Sortable="true">
                    <CellTemplate>@context.DisplayOrder</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminFaqGroupSummary" Key="entryCount"
                                    Header="@L["Admin.Faq.Col.EntryCount"]">
                    <CellTemplate>@context.EntryCount</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminFaqGroupSummary" Key="isActive"
                                    Header="@L["Admin.Faq.Col.Active"]">
                    <CellTemplate>
                        @if (context.IsActive)
                        {
                            <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                <SimfToolbarButton Icon="list-tree" Title="@L["Admin.Faq.Action.ManageEntries"]"
                                   OnClick="@(() => SelectGroupAsync(context))" />
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Faq.Groups.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>

        @if (_selectedGroup is not null)
        {
            <h2 class="simf-section__title">
                @(string.Format(L["Admin.Faq.Entries.Heading"], _selectedGroup.NameEn))
            </h2>

            <SimfDataGrid TItem="AdminFaqEntrySummary"
                          Query="_entryQuery"
                          Page="_entryPage"
                          Loading="_entryLoading"
                          OnQueryChanged="OnEntryQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Question)"
                          Caption="@L["Admin.Faq.Entries.Heading"]"
                          OnAdd="OpenAddEntry"
                          OnEditOne="OpenEditEntry"
                          OnDeleteOne="DeactivateEntryAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Grid.Loading"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Admin.Faq.Action.AddEntry"]"
                          EditLabel="@L["Grid.Edit"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          SummaryFormatter="@FormatSummary">
                <Columns>
                    <SimfDataGridColumn TItem="AdminFaqEntrySummary" Key="question"
                                        Header="@L["Admin.Faq.Col.Question"]" Sortable="true">
                        <CellTemplate>@context.Question</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminFaqEntrySummary" Key="questionar"
                                        Header="@L["Admin.Faq.Col.NameAr"]">
                        <CellTemplate>@context.QuestionArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminFaqEntrySummary" Key="displayorder"
                                        Header="@L["Admin.Faq.Col.Order"]" Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminFaqEntrySummary" Key="isActive"
                                        Header="@L["Admin.Faq.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Faq.Entries.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        }
    </div>
</div>

@if (_groupModalOpen)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@(_groupEditId is null ? L["Admin.Faq.Group.Add.Title"] : L["Admin.Faq.Group.Edit.Title"])"
               OnClose="CloseGroupModal">
        <ChildContent>
            @* The page-level toast sits under the modal backdrop, so a rejected
               save must report inside the dialog or it reads as a dead button. *@
            @if (_error is not null)
            {
                <SimfAlert Variant="error">@_error</SimfAlert>
            }
            <div class="simf-form__fields">
                <SimfTextField Label="@L["Admin.Faq.Field.NameEn"]" MaxLength="128"
                               @bind-Value="_groupNameEn" Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Faq.Field.NameAr"]" MaxLength="128"
                               @bind-Value="_groupNameAr" Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Faq.Field.Order"]" Type="number"
                               Value="@_groupOrder" ValueChanged="@(v => _groupOrder = v)"
                               ValueExpression="@(() => _groupOrder)" Disabled="_busy" />
                @if (_groupEditId is not null)
                {
                    <SimfCheckbox @bind-Value="_groupActive" Disabled="_busy">
                        @L["Admin.Faq.Field.IsActive"]
                    </SimfCheckbox>
                }
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" OnClick="SaveGroupAsync" Loading="_busy">@L["Admin.Faq.Save"]</SimfButton>
            <SimfButton Type="button" Variant="secondary" OnClick="CloseGroupModal" Disabled="_busy">
                @L["Admin.Faq.Cancel"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_entryModalOpen)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@(_entryEditId is null ? L["Admin.Faq.Entry.Add.Title"] : L["Admin.Faq.Entry.Edit.Title"])"
               OnClose="CloseEntryModal">
        <ChildContent>
            @if (_error is not null)
            {
                <SimfAlert Variant="error">@_error</SimfAlert>
            }
            <div class="simf-form__fields">
                <SimfTextField Label="@L["Admin.Faq.Field.QuestionEn"]" MaxLength="512"
                               @bind-Value="_entryQuestionEn" Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Faq.Field.QuestionAr"]" MaxLength="512"
                               @bind-Value="_entryQuestionAr" Disabled="_busy" />
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Faq.Field.AnswerEn"]</span>
                    <textarea class="simf-field__input" rows="4" maxlength="4000"
                              @bind="_entryAnswerEn" disabled="@_busy"></textarea>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Faq.Field.AnswerAr"]</span>
                    <textarea class="simf-field__input" rows="4" maxlength="4000"
                              @bind="_entryAnswerAr" disabled="@_busy"></textarea>
                </label>
                <SimfTextField Label="@L["Admin.Faq.Field.Order"]" Type="number"
                               Value="@_entryOrder" ValueChanged="@(v => _entryOrder = v)"
                               ValueExpression="@(() => _entryOrder)" Disabled="_busy" />
                @if (_entryEditId is not null)
                {
                    <SimfCheckbox @bind-Value="_entryActive" Disabled="_busy">
                        @L["Admin.Faq.Field.IsActive"]
                    </SimfCheckbox>
                }
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" OnClick="SaveEntryAsync" Loading="_busy">@L["Admin.Faq.Save"]</SimfButton>
            <SimfButton Type="button" Variant="secondary" OnClick="CloseEntryModal" Disabled="_busy">
                @L["Admin.Faq.Cancel"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
