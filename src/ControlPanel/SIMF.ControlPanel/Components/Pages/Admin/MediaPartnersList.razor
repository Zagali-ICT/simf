@* D-199 (CP UI for D-199 media partners, Mockup page 31 â€” "Ø´Ø±ÙƒØ§Ø¡ Ø§Ù„Ù†Ø¬Ø§Ø­") â€”
   admin CRUD over the public list of media partners. The public list is
   ordered by DisplayOrder asc, NameArabic asc â€” admins control name (En/Ar),
   logo path, link, display order and the active flag here. Centralized
   dialog/full-page framing D-353: Add / Edit / View / Delete are hosted by
   CrudShell, which frames the reusable MediaPartnerAddEdit and
   MediaPartnerViewDelete forms as a popup or a full page per the admin's
   toolbar choice (persisted in localStorage via CpPreferences). The inline
   SimfModal form + native confirm() delete it used to carry are gone. *@
@page "/admin/media-partners"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.MediaPartners.View)]
@using SIMF.Contracts.PublicRelations
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject CpPreferences Prefs

<PageTitle>@L["Admin.MediaPartners.Title"] Â· SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.MediaPartners.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminMediaPartnerSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Name)"
                          Caption="@L["Admin.MediaPartners.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.MediaPartners.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminMediaPartnerSummary" Key="name"
                                        Header="@L["Admin.MediaPartners.Col.NameEn"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Name</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaPartnerSummary" Key="namearabic"
                                        Header="@L["Admin.MediaPartners.Col.NameAr"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.NameArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaPartnerSummary" Key="logo"
                                        Header="@L["Admin.MediaPartners.Col.Logo"]">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.LogoRelativePath) ? "â€”" : context.LogoRelativePath)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaPartnerSummary" Key="url"
                                        Header="@L["Admin.MediaPartners.Col.Url"]">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.Url) ? "â€”" : context.Url)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaPartnerSummary" Key="displayorder"
                                        Header="@L["Admin.MediaPartners.Col.DisplayOrder"]"
                                        Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaPartnerSummary" Key="isActive"
                                        Header="@L["Admin.MediaPartners.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.MediaPartners.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.MediaPartners.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <MediaPartnerAddEdit IsEdit="_isEdit" Initial="_target"
                                 OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <MediaPartnerViewDelete IsDelete="_isDelete" Initial="_target"
                                    OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@code {
    private record Toast(string Variant, string Message);

    private enum FormKind { None, AddEdit, ViewDelete }

    private const string PageKey = "media-partners";

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminMediaPartnerSummary> _page = new();
    private bool _loading;
    private Toast? _toast;

    private CrudPresentation _presentation = CrudPresentation.Dialog;
    private FormKind _form = FormKind.None;
    private bool _isEdit;
    private bool _isDelete;
    private AdminMediaPartnerDetail? _target;

    private bool FormOpen => _form != FormKind.None;
    private bool GridHidden => FormOpen && _presentation == CrudPresentation.Page;

    private string FormTitle => _form switch
    {
        FormKind.AddEdit => _isEdit
            ? L["Admin.MediaPartners.Edit.Title"]
            : L["Admin.MediaPartners.Add.Title"],
        FormKind.ViewDelete => _isDelete
            ? L["Admin.MediaPartners.Delete.Title"]
            : L["Admin.MediaPartners.Details.Title"],
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _presentation = await Prefs.GetPresentationAsync(PageKey);
        await LoadAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Admin.MediaPartners.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminMediaPartnerSummary>>>(
                "simfAccount.postJson",
                "/account/api/admin/media-partners/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.MediaPartners.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _toast = null;
        _form = FormKind.AddEdit;
        _isEdit = false;
        _target = null;
        return Task.CompletedTask;
    }

    private async Task OnEditAsync(AdminMediaPartnerSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.AddEdit;
        _isEdit = true;
        _target = detail;
    }

    private async Task OnDetailsAsync(AdminMediaPartnerSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = false;
        _target = detail;
    }

    private async Task OnDeleteAsync(AdminMediaPartnerSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = true;
        _target = detail;
    }

    // Edit / View / Delete all work against the full detail â€” the grid summary
    // omits ContactId (SIMF-FDS-014 / D-283), so editing from a summary-only
    // form would wipe an existing link. Returns null and surfaces a toast on
    // failure.
    private async Task<AdminMediaPartnerDetail?> LoadDetailAsync(Guid id)
    {
        _toast = null;
        var env = await JS.InvokeAsync<ApiResult<AdminMediaPartnerDetail>>(
            "simfAccount.getJson", $"/account/api/admin/media-partners/{id}");
        if (env is { Success: true, Data: not null })
        {
            return env.Data;
        }
        _toast = new Toast("error",
            env?.Error?.MessageForCurrentCulture()
            ?? L["Admin.MediaPartners.LoadFailed"]);
        return null;
    }

    private void CloseForm()
    {
        _form = FormKind.None;
        _target = null;
    }

    private async Task OnSavedAsync(AdminMediaPartnerDetail saved)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.MediaPartners.Saved"]);
        await LoadAsync();
    }

    private async Task OnDeletedAsync(AdminMediaPartnerDetail deleted)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.MediaPartners.Deleted"]);
        await LoadAsync();
    }
}
