@* D-199 (CP UI for D-199 media partners, Mockup page 31 - "Success Partners") -
   admin CRUD over the public list of media partners. The public list is
   ordered by DisplayOrder asc, NameArabic asc - admins control name (En/Ar),
   logo, link, display order and the active flag here. Centralized dialog/full-
   page framing D-353: Add / Edit / View / Delete are hosted by CrudShell, which
   frames the reusable MediaPartnerAddEdit and MediaPartnerViewDelete forms as a
   popup or a full page per the admin's toolbar choice (persisted in localStorage
   via CpPreferences). D-740: the raw logo-path text column becomes a real logo
   thumbnail (or initials tile) inside a shared SimfIdentityCell. *@
@page "/admin/media-partners"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.MediaPartners.View)]
@using SIMF.Contracts.PublicRelations

<PageTitle>@L["Admin.MediaPartners.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.MediaPartners.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminMediaPartnerSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Name)"
                          Caption="@L["Admin.MediaPartners.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.MediaPartners.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminMediaPartnerSummary" Key="name" Width="42%"
                                        Header="@L["Admin.MediaPartners.Col.NameEn"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>
                            <SimfIdentityCell ImageUrl="@LogoImageUrl(context)"
                                              Name="@context.Name"
                                              NameSecondary="@context.NameArabic" />
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaPartnerSummary" Key="url"
                                        Header="@L["Admin.MediaPartners.Col.Url"]">
                        <CellTemplate>
                            @if (string.IsNullOrWhiteSpace(context.Url))
                            {
                                <span>—</span>
                            }
                            else
                            {
                                <a href="@context.Url" target="_blank" rel="noopener noreferrer">@context.Url</a>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaPartnerSummary" Key="displayorder"
                                        Header="@L["Admin.MediaPartners.Col.DisplayOrder"]"
                                        Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminMediaPartnerSummary" Key="isActive"
                                        Header="@L["Admin.MediaPartners.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.MediaPartners.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="media-partners"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.MediaPartners.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <MediaPartnerAddEdit IsEdit="_isEdit" Initial="_target"
                                 OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <MediaPartnerViewDelete IsDelete="_isDelete" Initial="_target"
                                    OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
