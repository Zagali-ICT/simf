@* Reusable Archive (Past Editions) View/Delete form, hosted by
   CrudShell (as a popup or a full page) from ArchiveList.razor. Inherits
   CrudViewDeleteFormBase so it exposes the standard parameter surface
   (IsDelete / Initial / OnDeleted / OnCancel). Read-only details always show
   (including a cover-image preview when present); when IsDelete=true a
   Deactivate button appears and a SimfConfirm gates the destructive call
   (replaces the old native JS confirm() on the list). The DELETE endpoint
   soft-deletes (DeactivateAsync), pulling the edition from the public archive. *@
@inherits CrudViewDeleteFormBase<AdminArchiveEditionSummary>
@using SIMF.Contracts.Archive

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    @* Cover image from the unified media-asset pipeline. *@
    <div class="simf-image-upload__preview">
        <SimfImageThumb Src="@($"/account/api/admin/assets/ArchiveCover/{Initial.Id}/image")"
                        Alt="@Initial.TitleEn" Class="simf-img-thumb--lg" />
    </div>

    <dl class="simf-dl">
        <dt>@L["Admin.Archive.Col.Year"]</dt>
        <dd>@Initial.Year</dd>
        <dt>@L["Admin.Archive.Col.TitleEn"]</dt>
        <dd>@Initial.TitleEn</dd>
        <dt>@L["Admin.Archive.Col.TitleAr"]</dt>
        <dd>@Initial.TitleAr</dd>
        <dt>@L["Admin.Archive.Field.SummaryEn"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.SummaryEn) ? "—" : Initial.SummaryEn)</dd>
        <dt>@L["Admin.Archive.Field.SummaryAr"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.SummaryAr) ? "—" : Initial.SummaryAr)</dd>
        <dt>@L["Admin.Archive.Col.Attendees"]</dt>
        <dd>@Initial.Attendees</dd>
        <dt>@L["Admin.Archive.Col.Sessions"]</dt>
        <dd>@Initial.Sessions</dd>
        <dt>@L["Admin.Archive.Col.Speakers"]</dt>
        <dd>@Initial.Speakers</dd>
        <dt>@L["Admin.Archive.Field.LocationEn"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.LocationEn) ? "—" : Initial.LocationEn)</dd>
        <dt>@L["Admin.Archive.Field.LocationAr"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.LocationAr) ? "—" : Initial.LocationAr)</dd>
        <dt>@L["Admin.Archive.Field.DateLabelEn"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.DateLabelEn) ? "—" : Initial.DateLabelEn)</dd>
        <dt>@L["Admin.Archive.Field.DateLabelAr"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.DateLabelAr) ? "—" : Initial.DateLabelAr)</dd>
        @* Resolved by row id from the one file store, like every other asset
           preview, rather than rendering a string an admin typed. *@
        <dt>@L["Admin.Asset.Heading"]</dt>
        <dd>
            <SimfImageThumb Class="simf-img-thumb--lg"
                            Src="@CpAssetUrls.AdminImage(nameof(AssetCategory.ArchiveCover), Initial.Id)"
                            Alt="@Initial.TitleEn" />
        </dd>
        <dt>@L["Admin.Archive.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.Archive.Action.Deactivate"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Archive.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.Archive.Delete.Title"]"
                 Message="@string.Format(L["Admin.Archive.Delete.Message"], Initial.TitleEn)"
                 ConfirmLabel="@L["Admin.Archive.Action.Deactivate"]"
                 CancelLabel="@L["Admin.Archive.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" 
                 Permission="@PermissionCatalog.Archive.Delete"/>
}
