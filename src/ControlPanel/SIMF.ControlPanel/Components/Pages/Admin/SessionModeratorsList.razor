@* D-169 (gap doc G6, PDF §2.7.2) — admin desk for per-session moderator
   grants. Lists existing grants, supports assign (by SessionId +
   UserId) and revoke. Distinct from MobileAppRole.Moderator (PDF §4.2
   naming-collision rule). *@
@page "/admin/session-moderators"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.SessionModerators.View)]

<PageTitle>@L["Admin.SessionModerators.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.SessionModerators.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <div class="simf-toast">
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            </div>
        }

        <SimfDataGrid TItem="AdminSessionModeratorRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => $"{r.SessionId}/{r.UserId}")"
                      RowLabel="@(r => r.ModeratorDisplayName)"
                      OnExport="OnExportAsync"
                      ExportLabel="@L["Grid.Export"]"
                      Caption="@L["Admin.SessionModerators.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      OnAdd="OnAddAsync"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.SessionModerators.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      AddLabel="@L["Grid.Add"]"
                      EditLabel="@L["Grid.Edit"]"
                      DeleteLabel="@L["Grid.Delete"]"
                      SummaryFormatter="@FormatSummary"
                      AddPermission="@PermissionCatalog.SessionModerators.Assign"
                      ExportPermission="@PermissionCatalog.SessionModerators.Export">
            <Columns>
                <SimfDataGridColumn TItem="AdminSessionModeratorRow" Key="session"
                                    Header="@L["Admin.SessionModerators.Col.Session"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@SessionLabel(context)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSessionModeratorRow" Key="moderator"
                                    Header="@L["Admin.SessionModerators.Col.Moderator"]">
                    <CellTemplate>
                        @context.ModeratorDisplayName <small>(@(context.ModeratorEmail ?? "—"))</small>
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSessionModeratorRow" Key="assignedBy"
                                    Header="@L["Admin.SessionModerators.Col.AssignedBy"]">
                    <CellTemplate>@context.AssignedByDisplayName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSessionModeratorRow" Key="assignedAt"
                                    Header="@L["Admin.SessionModerators.Col.AssignedAt"]"
                                    Sortable="true">
                    <CellTemplate>@context.AssignedAt.FormatSaudi("dd-MM-yyyy hh:mm tt")</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @* Page-specific quiet action: revoke this moderator grant. *@
                <AuthorizedAction Permission="@PermissionCatalog.SessionModerators.Revoke">
                    <SimfToolbarButton Icon="link-off" Title="@L["Admin.SessionModerators.Revoke"]"
                                       OnClick="@(() => AskRevoke(context))" />
                </AuthorizedAction>
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.SessionModerators.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_addOpen)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.SessionModerators.Add.Title"]"
               OnClose="@(() => _addOpen = false)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            @* The page-level toast sits under the modal backdrop, so a rejected
               submit must report inside the dialog or it reads as a dead button. *@
            @if (_error is not null)
            {
                <SimfAlert Variant="error">@_error</SimfAlert>
            }
            @* DEF-MOD-005 — real pickers, not free-text GUIDs: the session list is
               the active sessions and the moderator list is the accounts eligible
               to moderate (approved + a profile type whose app role is Moderator).
               The server re-checks both on assign. *@
            <div class="simf-form__fields">
                @if (_optionsError)
                {
                    <SimfAlert Variant="error">@L["Admin.SessionModerators.OptionsFailed"]</SimfAlert>
                }
                <SimfSelect TValue="SessionModeratorSessionOption"
                            Label="@L["Admin.SessionModerators.Field.Session"]"
                            Placeholder="@L["Admin.SessionModerators.Field.Session"]"
                            Items="_sessionOptions"
                            ValueFor="@(s => s.Id.ToString())"
                            LabelFor="@(s => SessionOptionLabel(s))"
                            Value="_newSession"
                            ValueChanged="@(s => _newSession = s)"
                            Disabled="_busy || _optionsLoading" />
                @if (_candidates.Count == 0 && !_optionsLoading && !_optionsError)
                {
                    <SimfAlert Variant="info">@L["Admin.SessionModerators.NoCandidates"]</SimfAlert>
                }
                <SimfSelect TValue="SessionModeratorCandidate"
                            Label="@L["Admin.SessionModerators.Field.Moderator"]"
                            Placeholder="@L["Admin.SessionModerators.Field.Moderator"]"
                            Items="_candidates"
                            ValueFor="@(c => c.UserId.ToString())"
                            LabelFor="@(c => CandidateLabel(c))"
                            Value="_newCandidate"
                            ValueChanged="@(c => _newCandidate = c)"
                            Disabled="_busy || _optionsLoading || _candidates.Count == 0" />
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="@(() => _addOpen = false)">
                @L["Admin.SessionModerators.Cancel"]
            </SimfButton>
            @* D-828 (second pass) - the page gates on SessionModerators.View; assigning is .Assign. The page-level ratchet missed this
               because the page already used <AuthorizedAction> elsewhere; the
               guard is now per-button. *@
            <AuthorizedAction Permission="@PermissionCatalog.SessionModerators.Assign">
                <SimfButton Type="button" OnClick="SubmitAssignAsync" Loading="_busy" LoadingLabel="@L["Grid.Working"]">
                    @L["Admin.SessionModerators.Submit"]
                </SimfButton>
            </AuthorizedAction>
        </Footer>
    </SimfModal>
}

@* §6.16 (F-U5-010) — Revoke is destructive and used to fire on the first click. *@
<SimfConfirm Open="@(_revokeTarget is not null)"
             Danger="true"
             Busy="_busy"
             Title="@L["Admin.SessionModerators.Revoke.Confirm.Title"]"
             Message="@(_revokeTarget is null ? string.Empty : string.Format(L["Admin.SessionModerators.Revoke.Confirm.Message"], _revokeTarget.ModeratorDisplayName, _revokeTarget.SessionTitle))"
             ConfirmLabel="@L["Admin.SessionModerators.Revoke"]"
             CancelLabel="@L["Common.Cancel"]"
             OnConfirm="ConfirmRevokeAsync"
             OnCancel="CancelRevoke" 
             Permission="@PermissionCatalog.SessionModerators.Revoke"/>
