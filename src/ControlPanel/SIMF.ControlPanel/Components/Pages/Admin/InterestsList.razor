@* Control Panel — Interests lookup CRUD (P9 — D-050; popup-CRUD D-132;
   centralized dialog/full-page framing D-353). Administrator-only. SimfBanner
   page-top, SimfDataGrid with Multiselect + numbered pager. Add / Edit / View /
   Delete are hosted by CrudShell, which frames the reusable InterestAddEdit and
   InterestViewDelete forms either as a popup or a full page per the admin's
   toolbar choice (persisted in localStorage via CpPreferences). *@
@page "/admin/interests"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Interests.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject CpPreferences Prefs

<PageTitle>@L["Admin.Interests.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Interests.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminInterestSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Name)"
                          Caption="@L["Admin.Interests.Title"]"
                          FilterColumnLabel="@L["Admin.Interests.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          PrevLabel="@L["Admin.Interests.Prev"]"
                          NextLabel="@L["Admin.Interests.Next"]"
                          FirstLabel="@L["Admin.Interests.Pager.First"]"
                          LastLabel="@L["Admin.Interests.Pager.Last"]"
                          PageSizeLabel="@L["Admin.Interests.Pager.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Interests.Loading"]"
                          FilterPlaceholder="@L["Admin.Interests.FilterPlaceholder"]"
                          ActionsHeader="@L["Admin.Interests.Column.Actions"]"
                          SelectAllLabel="@L["Admin.Interests.Action.SelectAll"]"
                          SelectRowLabel="@L["Admin.Interests.Action.SelectRow"]"
                          AddLabel="@L["Admin.Interests.Action.Add"]"
                          EditLabel="@L["Admin.Interests.Action.Edit"]"
                          DetailsLabel="@L["Admin.Interests.Action.Details"]"
                          DeleteLabel="@L["Admin.Interests.Action.Deactivate"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminInterestSummary" Key="name"
                                        Header="@L["Admin.Interests.Column.Name"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Name</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminInterestSummary" Key="nameArabic"
                                        Header="@L["Admin.Interests.Column.NameArabic"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.NameArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminInterestSummary" Key="displayOrder"
                                        Header="@L["Admin.Interests.Column.DisplayOrder"]"
                                        Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminInterestSummary" Key="isActive"
                                        Header="@L["Admin.Interests.Column.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Admin.Interests.Active.Yes"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Admin.Interests.Active.No"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Interests.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Interests.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <InterestAddEdit IsEdit="_isEdit" Initial="_target"
                             OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <InterestViewDelete IsDelete="_isDelete" Initial="_target"
                                OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@code {
    private record Toast(string Variant, string Message);

    private enum FormKind { None, AddEdit, ViewDelete }

    private const string PageKey = "interests";

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminInterestSummary> _page = new();
    private bool _loading;
    private Toast? _toast;

    private CrudPresentation _presentation = CrudPresentation.Dialog;
    private FormKind _form = FormKind.None;
    private bool _isEdit;
    private bool _isDelete;
    private AdminInterestSummary? _target;

    private bool FormOpen => _form != FormKind.None;
    private bool GridHidden => FormOpen && _presentation == CrudPresentation.Page;

    private string FormTitle => _form switch
    {
        FormKind.AddEdit => _isEdit
            ? L["Admin.Interests.Edit.Title"]
            : L["Admin.Interests.Add.Title"],
        FormKind.ViewDelete => _isDelete
            ? L["Admin.Interests.Delete.Title"]
            : L["Admin.Interests.Details.Title"],
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _presentation = await Prefs.GetPresentationAsync(PageKey);
        await LoadAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<GridPage<AdminInterestSummary>>>(
                "simfAccount.postJson", "/account/api/admin/interests/list", _query);
            if (envelope is { Success: true, Data: not null })
            {
                _page = envelope.Data;
            }
            else
            {
                _toast = new Toast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Interests.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _toast = null;
        _form = FormKind.AddEdit;
        _isEdit = false;
        _target = null;
        return Task.CompletedTask;
    }

    private Task OnEditAsync(AdminInterestSummary row)
    {
        _toast = null;
        _form = FormKind.AddEdit;
        _isEdit = true;
        _target = row;
        return Task.CompletedTask;
    }

    private Task OnDetailsAsync(AdminInterestSummary row)
    {
        _toast = null;
        _form = FormKind.ViewDelete;
        _isDelete = false;
        _target = row;
        return Task.CompletedTask;
    }

    private Task OnDeleteAsync(AdminInterestSummary row)
    {
        _toast = null;
        _form = FormKind.ViewDelete;
        _isDelete = true;
        _target = row;
        return Task.CompletedTask;
    }

    private void CloseForm()
    {
        _form = FormKind.None;
        _target = null;
    }

    private async Task OnSavedAsync(AdminInterestSummary saved)
    {
        var wasEdit = _isEdit;
        CloseForm();
        _toast = new Toast("success",
            string.Format(wasEdit ? L["Admin.Interests.Updated"] : L["Admin.Interests.Created"], saved.Name));
        await LoadAsync();
    }

    private async Task OnDeletedAsync(AdminInterestSummary deleted)
    {
        CloseForm();
        _toast = new Toast("success",
            string.Format(L["Admin.Interests.Deactivated"], deleted.Name));
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Admin.Interests.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Admin.Interests.Pager.Page"], current, total);
}
