@* Control Panel — Interests lookup CRUD (P9 — D-050, migrated to the
   canonical D-117 popup-CRUD pattern in D-132). Administrator-only.
   SimfBanner page-top, SimfDataGrid with Multiselect + full numbered
   pager, modal-based Add / Edit / Details / Delete. The reusable
   InterestForm.razor is hosted in both the Add and Edit modals. *@
@page "/admin/interests"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Interests.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.Interests.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Interests.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminInterestSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.Name)"
                      Caption="@L["Admin.Interests.Title"]"
                      FilterColumnLabel="@L["Admin.Interests.FilterColumn"]"
                      OnAdd="OnAddAsync"
                      OnEditOne="OnEditAsync"
                      OnDetailsOne="OnDetailsAsync"
                      OnDeleteOne="OnDeactivateAsync"
                      PrevLabel="@L["Admin.Interests.Prev"]"
                      NextLabel="@L["Admin.Interests.Next"]"
                      FirstLabel="@L["Admin.Interests.Pager.First"]"
                      LastLabel="@L["Admin.Interests.Pager.Last"]"
                      PageSizeLabel="@L["Admin.Interests.Pager.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.Interests.Loading"]"
                      FilterPlaceholder="@L["Admin.Interests.FilterPlaceholder"]"
                      ActionsHeader="@L["Admin.Interests.Column.Actions"]"
                      SelectAllLabel="@L["Admin.Interests.Action.SelectAll"]"
                      SelectRowLabel="@L["Admin.Interests.Action.SelectRow"]"
                      AddLabel="@L["Admin.Interests.Action.Add"]"
                      EditLabel="@L["Admin.Interests.Action.Edit"]"
                      DetailsLabel="@L["Admin.Interests.Action.Details"]"
                      DeleteLabel="@L["Admin.Interests.Action.Deactivate"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminInterestSummary" Key="name"
                                    Header="@L["Admin.Interests.Column.Name"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Name</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminInterestSummary" Key="nameArabic"
                                    Header="@L["Admin.Interests.Column.NameArabic"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.NameArabic</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminInterestSummary" Key="displayOrder"
                                    Header="@L["Admin.Interests.Column.DisplayOrder"]"
                                    Sortable="true">
                    <CellTemplate>@context.DisplayOrder</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminInterestSummary" Key="isActive"
                                    Header="@L["Admin.Interests.Column.Active"]">
                    <CellTemplate>
                        @if (context.IsActive)
                        {
                            <SimfPill Variant="on">@L["Admin.Interests.Active.Yes"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Admin.Interests.Active.No"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Interests.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_addOpen)
{
    <SimfModal Open="true" Title="@L["Admin.Interests.Add.Title"]"
               OnClose="@(() => _addOpen = false)">
        <ChildContent>
            <InterestForm OnSuccess="OnAddSucceededAsync"
                          OnCancel="@(() => _addOpen = false)" />
        </ChildContent>
    </SimfModal>
}

@if (_editTarget is not null)
{
    <SimfModal Open="true" Title="@L["Admin.Interests.Edit.Title"]"
               OnClose="@(() => _editTarget = null)">
        <ChildContent>
            <InterestForm Initial="_editTarget"
                          OnSuccess="OnEditSucceededAsync"
                          OnCancel="@(() => _editTarget = null)" />
        </ChildContent>
    </SimfModal>
}

@if (_detailsTarget is not null)
{
    <SimfModal Open="true" Title="@L["Admin.Interests.Details.Title"]"
               OnClose="@(() => _detailsTarget = null)">
        <ChildContent>
            <dl class="simf-dl">
                <dt>@L["Admin.Interests.Column.Name"]</dt>
                <dd>@_detailsTarget.Name</dd>
                <dt>@L["Admin.Interests.Column.NameArabic"]</dt>
                <dd>@_detailsTarget.NameArabic</dd>
                <dt>@L["Admin.Interests.Column.DisplayOrder"]</dt>
                <dd>@_detailsTarget.DisplayOrder</dd>
                <dt>@L["Admin.Interests.Column.Active"]</dt>
                <dd>@(_detailsTarget.IsActive
                    ? L["Admin.Interests.Active.Yes"]
                    : L["Admin.Interests.Active.No"])</dd>
            </dl>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" OnClick="@(() => _detailsTarget = null)">
                @L["Admin.Interests.Details.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminInterestSummary> _page = new();
    private bool _loading;
    private Toast? _toast;

    private bool _addOpen;
    private AdminInterestSummary? _editTarget;
    private AdminInterestSummary? _detailsTarget;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<GridPage<AdminInterestSummary>>>(
                "simfAccount.postJson", "/account/api/admin/interests/list", _query);
            if (envelope is { Success: true, Data: not null })
            {
                _page = envelope.Data;
            }
            else
            {
                _toast = new Toast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Interests.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _addOpen = true;
        return Task.CompletedTask;
    }

    private async Task OnAddSucceededAsync(AdminInterestSummary created)
    {
        _addOpen = false;
        _toast = new Toast("success", string.Format(L["Admin.Interests.Created"], created.Name));
        await LoadAsync();
    }

    private Task OnEditAsync(AdminInterestSummary row)
    {
        _editTarget = row;
        return Task.CompletedTask;
    }

    private async Task OnEditSucceededAsync(AdminInterestSummary updated)
    {
        _editTarget = null;
        _toast = new Toast("success", string.Format(L["Admin.Interests.Updated"], updated.Name));
        await LoadAsync();
    }

    private Task OnDetailsAsync(AdminInterestSummary row)
    {
        _detailsTarget = row;
        return Task.CompletedTask;
    }

    private async Task OnDeactivateAsync(AdminInterestSummary row)
    {
        _toast = null;
        var envelope = await JS.InvokeAsync<ApiResult<bool>>(
            "simfAccount.deleteJson", $"/account/api/admin/interests/{row.Id}");
        if (envelope is { Success: true })
        {
            _toast = new Toast("success",
                string.Format(L["Admin.Interests.Deactivated"], row.Name));
            await LoadAsync();
        }
        else
        {
            _toast = new Toast("error",
                envelope?.Error?.MessageForCurrentCulture()
                ?? L["Admin.Interests.Fallback"]);
        }
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Admin.Interests.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Admin.Interests.Pager.Page"], current, total);
}
