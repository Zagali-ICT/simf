@* Reusable Theme View/Delete form, hosted by CrudShell (popup or full
   page) from ThemesList. Inherits CrudViewDeleteFormBase so it exposes the
   standard surface (IsDelete / Initial / OnDeleted / OnCancel). Read-only
   details always show; when IsDelete=true a Deactivate button appears and a
   SimfConfirm gates the soft-delete (was a one-click delete on the list). *@
@inherits CrudViewDeleteFormBase<AdminThemeDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.Themes.Column.Code"]</dt>
        <dd>@Initial.Code</dd>
        <dt>@L["Admin.Themes.Column.Name"]</dt>
        <dd>@Initial.Name</dd>
        <dt>@L["Admin.Themes.Column.NameArabic"]</dt>
        <dd>@Initial.NameArabic</dd>
        <dt>@L["Admin.Themes.Field.Description"]</dt>
        <dd>@(Initial.Description ?? "—")</dd>
        <dt>@L["Admin.Themes.Field.DescriptionArabic"]</dt>
        <dd>@(Initial.DescriptionArabic ?? "—")</dd>
        <dt>@L["Admin.Themes.Column.DisplayOrder"]</dt>
        <dd>@Initial.DisplayOrder</dd>
        <dt>@L["Admin.Themes.Column.PageColor"]</dt>
        <dd>@Initial.PageColor</dd>
        <dt>@L["Admin.Themes.Column.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Admin.Themes.Active.Yes"] : L["Admin.Themes.Active.No"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.Themes.Action.Deactivate"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Themes.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.Themes.Delete.Title"]"
                 Message="@string.Format(L["Admin.Themes.Delete.Message"], Initial.Name)"
                 ConfirmLabel="@L["Admin.Themes.Action.Deactivate"]"
                 CancelLabel="@L["Admin.Themes.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" 
                 Permission="@PermissionCatalog.Themes.Delete"/>
}
