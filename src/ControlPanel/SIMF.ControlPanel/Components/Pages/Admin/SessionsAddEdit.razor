@* D-353 — reusable Session Add/Edit form, hosted by CrudShell (popup or full
   page) from SessionsList. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel). IsEdit
   =false runs Create (POST); IsEdit=true runs Edit (PUT against Initial) and
   shows the IsActive checkbox. Extracted verbatim from the former inline
   SessionForm: the Hall + Category pickers, the reorderable Speaker roster (with
   the speaker/host role, D-225), the Theme multi-picker, the StartUtc/EndUtc
   window, the live-feed URLs (§8 / D-349) and the same create/update request
   DTOs + JS calls the inline SimfModal form used. *@
@inherits CrudAddEditFormBase<AdminSessionDetail>
@using SIMF.Common.Enums

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.Sessions.Field.Code"]"
                       Helper="@L["Admin.Sessions.Field.CodeHint"]"
                       MaxLength="16"
                       @bind-Value="_model.Code" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Sessions.Field.Title"]"
                       MaxLength="256"
                       @bind-Value="_model.Title" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Sessions.Field.TitleArabic"]"
                       MaxLength="256"
                       @bind-Value="_model.TitleArabic" Disabled="_busy" />

        <SimfTextarea Label="@L["Admin.Sessions.Field.Description"]"
                      Rows="3" MaxLength="2048"
                      Value="@_model.Description"
                      ValueChanged="@(v => _model.Description = v)" />
        <SimfTextarea Label="@L["Admin.Sessions.Field.DescriptionArabic"]"
                      Rows="3" MaxLength="2048"
                      Value="@_model.DescriptionArabic"
                      ValueChanged="@(v => _model.DescriptionArabic = v)" />

        @* Website Session-detail "at a glance" language label (Figma 5991-85840). *@
        <SimfTextField Label="@L["Admin.Sessions.Field.Language"]"
                       Helper="@L["Admin.Sessions.Field.LanguageHint"]"
                       MaxLength="64"
                       @bind-Value="_model.Language" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Sessions.Field.LanguageArabic"]"
                       MaxLength="64"
                       @bind-Value="_model.LanguageArabic" Disabled="_busy" />

        @* §8 / D-349 — live broadcast feed URLs (YouTube POC + HLS fallback). *@
        <SimfTextField Label="@L["Admin.Sessions.Field.LiveStreamUrl"]"
                       Helper="@L["Admin.Sessions.Field.LiveStreamUrlHint"]"
                       MaxLength="1024"
                       @bind-Value="_model.LiveStreamUrl" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Sessions.Field.LiveSignLanguageUrl"]"
                       Helper="@L["Admin.Sessions.Field.LiveSignLanguageUrlHint"]"
                       MaxLength="1024"
                       @bind-Value="_model.LiveSignLanguageUrl" Disabled="_busy" />

        @* P5 / D-439 — AI live-caption text shown under the player (manual stub
           provider; the app renders this when present, else a placeholder hint). *@
        <SimfTextarea Label="@L["Admin.Sessions.Field.LiveCaptions"]"
                      Helper="@L["Admin.Sessions.Field.LiveCaptionsHint"]"
                      Rows="2" MaxLength="2048"
                      Value="@_model.LiveCaptions"
                      ValueChanged="@(v => _model.LiveCaptions = v)" />
        <SimfTextarea Label="@L["Admin.Sessions.Field.LiveCaptionsArabic"]"
                      Rows="2" MaxLength="2048"
                      Value="@_model.LiveCaptionsArabic"
                      ValueChanged="@(v => _model.LiveCaptionsArabic = v)" />

        @* D-578 — get the subtitle without typing it: import an .srt/.vtt file
           (parsed on the server) or fetch it straight from the LiveStreamUrl video
           (YouTube). Either fills the caption field above (Arabic vs English by the
           detected language); the AI session-summary drafter then reads it. *@
        <div class="simf-form__field">
            <label>@L["Admin.Sessions.Subtitle.ImportLabel"]</label>
            <InputFile OnChange="OnSubtitleFileAsync" accept=".srt,.vtt,.txt" disabled="@_busy" />
        </div>
        <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                    OnClick="FetchSubtitleAsync">
            @L["Admin.Sessions.Subtitle.FetchFromVideo"]
        </SimfButton>
        @if (_subtitleMessage is not null)
        {
            <SimfAlert Variant="@_subtitleVariant">@_subtitleMessage</SimfAlert>
        }

        <SimfSelect TValue="string"
                    Label="@L["Admin.Sessions.Field.Hall"]"
                    Placeholder="@L["Admin.Sessions.Field.HallPlaceholder"]"
                    Items="_hallIds"
                    ValueFor="@(id => id)"
                    LabelFor="@(id => HallLabel(id))"
                    Value="@_hallIdInput"
                    ValueChanged="@(v => _hallIdInput = v ?? string.Empty)"
                    Disabled="_busy" />

        @* B9b (D-226) — optional session category (dynamic lookup). *@
        <SimfSelect TValue="string"
                    Label="@L["Admin.Sessions.Field.Category"]"
                    Placeholder="@L["Admin.Sessions.Field.CategoryNone"]"
                    Items="_categoryIds"
                    ValueFor="@(id => id)"
                    LabelFor="@(id => CategoryLabel(id))"
                    Value="@_categoryIdInput"
                    ValueChanged="@(v => _categoryIdInput = v ?? string.Empty)"
                    Disabled="_busy" />

        @* D-452 — optional session type (Workshop / Session / Event) that drives
           the app's Sessions type tabs; empty selection = unset. *@
        <SimfSelect TValue="string"
                    Label="@RequiredLabel("Admin.Sessions.Field.Type")"
                    Placeholder="@L["Admin.Sessions.Field.TypeNone"]"
                    Items="_typeOptions"
                    ValueFor="@(id => id)"
                    LabelFor="@(id => TypeLabel(id))"
                    Value="@_typeInput"
                    ValueChanged="@(v => _typeInput = v ?? string.Empty)"
                    Disabled="_busy" />

        @* D-485 — per-session override of the hall's seat-selection mode; an
           empty selection inherits the hall's mode. *@
        <SimfSelect TValue="string"
                    Label="@L["Admin.Sessions.Field.SeatMode"]"
                    Placeholder="@L["Admin.Sessions.SeatMode.Inherit"]"
                    Items="_seatModeOptions"
                    ValueFor="@(id => id)"
                    LabelFor="@(id => SeatModeLabel(id))"
                    Value="@_seatModeInput"
                    ValueChanged="@(v => _seatModeInput = v ?? string.Empty)"
                    Disabled="_busy" />

        <SimfTextField Label="@L["Admin.Sessions.Field.StartUtc"]"
                       Type="datetime-local"
                       Value="@_startInput"
                       ValueChanged="@(v => _startInput = v)"
                       ValueExpression="@(() => _startInput)"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Sessions.Field.EndUtc"]"
                       Type="datetime-local"
                       Value="@_endInput"
                       ValueChanged="@(v => _endInput = v)"
                       ValueExpression="@(() => _endInput)"
                       Disabled="_busy" />

        <SimfTextField Label="@L["Admin.Sessions.Field.CapacityOverride"]"
                       Helper="@L["Admin.Sessions.Field.CapacityHint"]"
                       Type="number"
                       Value="@_capacityInput"
                       ValueChanged="@(v => _capacityInput = v)"
                       ValueExpression="@(() => _capacityInput)"
                       Disabled="_busy" />

        @if (_speakerOptions.Length > 0)
        {
            <SimfSelect TValue="string"
                        Label="@RequiredLabel("Admin.Sessions.Field.AddSpeaker")"
                        Placeholder="@L["Admin.Sessions.Field.AddSpeakerPlaceholder"]"
                        Items="_speakerOptions"
                        ValueFor="@(id => id)"
                        LabelFor="@(id => SpeakerLabel(id))"
                        Value="@_speakerPickInput"
                        ValueChanged="@OnAddSpeakerAsync"
                        Disabled="_busy" />
        }

        @if (_selectedSpeakers.Count > 0)
        {
            <ul class="simf-form__chips">
                @for (var i = 0; i < _selectedSpeakers.Count; i++)
                {
                    var ix = i;
                    var entry = _selectedSpeakers[ix];
                    <li class="simf-form__chip">
                        <span>@(ix + 1). @SpeakerLabel(entry.SpeakerId.ToString())</span>
                        <select class="simf-field__input"
                                value="@((int)entry.Role)"
                                @onchange="@(e => OnSpeakerRoleChanged(ix, e))"
                                disabled="@_busy">
                            <option value="0">@L["Admin.Sessions.Role.Speaker"]</option>
                            <option value="1">@L["Admin.Sessions.Role.Host"]</option>
                        </select>
                        <SimfButton Type="button" Variant="ghost"
                                    Disabled="@(_busy || ix == 0)"
                                    OnClick="@(() => MoveSpeakerUp(ix))">
                            @L["Admin.Sessions.Action.Up"]
                        </SimfButton>
                        <SimfButton Type="button" Variant="ghost"
                                    Disabled="@(_busy || ix == _selectedSpeakers.Count - 1)"
                                    OnClick="@(() => MoveSpeakerDown(ix))">
                            @L["Admin.Sessions.Action.Down"]
                        </SimfButton>
                        <SimfButton Type="button" Variant="ghost"
                                    Disabled="_busy"
                                    OnClick="@(() => RemoveSpeaker(ix))">
                            @L["Admin.Sessions.Action.Remove"]
                        </SimfButton>
                    </li>
                }
            </ul>
        }

        @if (_themeOptions.Length > 0)
        {
            <SimfSelect TValue="string"
                        Label="@L["Admin.Sessions.Field.AddTheme"]"
                        Placeholder="@L["Admin.Sessions.Field.AddThemePlaceholder"]"
                        Items="_themeOptions"
                        ValueFor="@(id => id)"
                        LabelFor="@(id => ThemeLabel(id))"
                        Value="@_themePickInput"
                        ValueChanged="@OnAddThemeAsync"
                        Disabled="_busy" />
        }

        @if (_selectedThemes.Count > 0)
        {
            <ul class="simf-form__chips">
                @foreach (var themeId in _selectedThemes)
                {
                    var snap = themeId;
                    <li class="simf-form__chip">
                        <span>@ThemeLabel(snap.ToString())</span>
                        <SimfButton Type="button" Variant="ghost"
                                    Disabled="_busy"
                                    OnClick="@(() => RemoveTheme(snap))">
                            @L["Admin.Sessions.Action.Remove"]
                        </SimfButton>
                    </li>
                }
            </ul>
        }

        @* Website Session-detail "أبرز المخرجات" — the session's key-outcome
           bullets (Figma 5991-85840): a free-text repeatable bilingual list. *@
        <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                    OnClick="AddOutcome">
            @L["Admin.Sessions.Action.AddOutcome"]
        </SimfButton>
        @if (_outcomes.Count > 0)
        {
            <ul class="simf-form__chips">
                @for (var i = 0; i < _outcomes.Count; i++)
                {
                    var ix = i;
                    <li class="simf-form__chip">
                        <span>@(ix + 1).</span>
                        <SimfTextField Label="@L["Admin.Sessions.Field.OutcomeText"]"
                                       MaxLength="512"
                                       @bind-Value="_outcomes[ix].Text" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.Sessions.Field.OutcomeTextArabic"]"
                                       MaxLength="512"
                                       @bind-Value="_outcomes[ix].TextArabic" Disabled="_busy" />
                        <SimfButton Type="button" Variant="ghost"
                                    Disabled="@(_busy || ix == 0)"
                                    OnClick="@(() => MoveOutcomeUp(ix))">
                            @L["Admin.Sessions.Action.Up"]
                        </SimfButton>
                        <SimfButton Type="button" Variant="ghost"
                                    Disabled="@(_busy || ix == _outcomes.Count - 1)"
                                    OnClick="@(() => MoveOutcomeDown(ix))">
                            @L["Admin.Sessions.Action.Down"]
                        </SimfButton>
                        <SimfButton Type="button" Variant="ghost"
                                    Disabled="_busy"
                                    OnClick="@(() => RemoveOutcome(ix))">
                            @L["Admin.Sessions.Action.Remove"]
                        </SimfButton>
                    </li>
                }
            </ul>
        }

        @if (IsEdit)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.Sessions.Field.IsActive"]
            </SimfCheckbox>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy"
                    LoadingLabel="@(IsEdit ? L["Admin.Sessions.Edit.Submitting"] : L["Admin.Sessions.New.Submitting"])">
            @(IsEdit ? L["Admin.Sessions.Edit.Submit"] : L["Admin.Sessions.New.Submit"])
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Sessions.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
