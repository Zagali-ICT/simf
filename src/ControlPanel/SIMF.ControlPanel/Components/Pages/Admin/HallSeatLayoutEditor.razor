@* D-182 (CP UI for D-175 seat reservations) — admin edits the seat
   layout for one hall at a time. The layout drives the seat picker
   visitors see during sign-up and for session seat reservations.
   Backend constraints validated server-side: 1–26 unique row labels
   each 1–8 chars, 1–80 seats-per-row, rows × seats ≤ Hall.Capacity.
   *@
@page "/admin/halls/seat-layouts"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.SeatLayouts.View)]

<PageTitle>@L["Admin.HallSeatLayouts.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.HallSeatLayouts.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }
        <p class="simf-hint">@L["Admin.HallSeatLayouts.Hint"]</p>

        @if (_halls.Count == 0 && !_loading)
        {
            <SimfEmptyState Title="@L["Admin.HallSeatLayouts.None"]" />
        }
        else
        {
            <label class="simf-field simf-field--inline">
                <span class="simf-field__label">@L["Admin.HallSeatLayouts.Pick"]</span>
                <select class="simf-field__input" value="@(_selectedHallId?.ToString() ?? string.Empty)"
                        @onchange="OnHallChangedAsync" disabled="@_loading">
                    <option value=""></option>
                    @foreach (var hall in _halls)
                    {
                        <option value="@hall.Id">@hall.Code — @hall.Name (cap @hall.Capacity)</option>
                    }
                </select>
            </label>
        }

        @if (_loading)
        {
            <p>@L["Admin.HallSeatLayouts.Loading"]</p>
        }
        else if (_selectedHallId is not null && _snapshot is not null)
        {
            <div class="simf-form__fields">
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.HallSeatLayouts.Field.RowLabels"]</span>
                    @* A40 — maxlength mirrors HallSeatLayoutConfiguration's
                       RowLabels.HasMaxLength(256) exactly (UI = EF = service). *@
                    <input class="simf-field__input" type="text"
                           maxlength="256"
                           value="@_rowLabelsCsv"
                           @onchange="OnRowLabelsChanged"
                           disabled="@_busy" />
                </label>

                @* D-767 — one seat-count input per parsed row (raw input, NOT
                   SimfTextField: a SimfTextField without ValueExpression freezes the
                   page, D-648). Renaming a label keeps that position's count.
                   D-771 — each row also carries its TIER (Normal / VIP / VVIP); a
                   NEWLY added row defaults to VVIP-reserved per the owner rule. *@
                @if (_rows.Count > 0)
                {
                    <div class="simf-form__fields">
                        <span class="simf-field__label">@L["Admin.HallSeatLayouts.Field.RowSeats"]</span>
                        @for (var i = 0; i < _rows.Count; i++)
                        {
                            var idx = i;
                            <label class="simf-field simf-field--inline">
                                <span class="simf-field__label">@_rows[idx].Label</span>
                                <input class="simf-field__input" type="number" min="1" max="80"
                                       value="@_rows[idx].Count"
                                       @onchange="@(e => OnRowCountChanged(idx, e))"
                                       disabled="@_busy" />
                            </label>
                        }
                    </div>

                    <div class="simf-form__fields">
                        <span class="simf-field__label">@L["Admin.HallSeatLayouts.Field.RowTiers"]</span>
                        <p class="simf-hint">@L["Admin.HallSeatLayouts.TierHint"]</p>
                        @for (var i = 0; i < _rows.Count; i++)
                        {
                            var idx = i;
                            <label class="simf-field simf-field--inline">
                                <span class="simf-field__label">@_rows[idx].Label</span>
                                <select class="simf-field__input"
                                        value="@((int)_rows[idx].Tier)"
                                        @onchange="@(e => OnRowTierChanged(idx, e))"
                                        disabled="@_busy">
                                    <option value="@((int)SeatTier.Normal)">@L["Admin.HallSeatLayouts.Tier.Normal"]</option>
                                    <option value="@((int)SeatTier.Vip)">@L["Admin.HallSeatLayouts.Tier.Vip"]</option>
                                    <option value="@((int)SeatTier.Vvip)">@L["Admin.HallSeatLayouts.Tier.Vvip"]</option>
                                </select>
                            </label>
                        }
                    </div>
                }

                @* A40 — every client-side rule violation, mirroring the server's own
                   checks so the admin is refused while typing rather than by a 400.
                   The server still re-validates; this only saves the round-trip. *@
                @if (_showErrors)
                {
                    <SimfAlert Variant="error">
                        <ul class="hsl-errors">
                            @foreach (var error in _errors)
                            {
                                <li class="hsl-errors__item">@error</li>
                            }
                        </ul>
                    </SimfAlert>
                }

                @* Capacity summary — Hall vs Layout (total seats) with a utilisation
                   meter. It turns amber the moment the layout outgrows the hall or a
                   row leaves 1–80; the same conditions block Save (A40). *@
                <section class="hsl-capacity @((_isOverCapacity || _anyOutOfRange) ? "hsl-capacity--over" : null)">
                    <dl class="hsl-capacity__stats">
                        <div class="hsl-capacity__stat">
                            <dt class="hsl-capacity__term">@L["Admin.HallSeatLayouts.HallCapacity"]</dt>
                            <dd class="hsl-capacity__value">@_hallCapacity</dd>
                        </div>
                        <div class="hsl-capacity__stat">
                            <dt class="hsl-capacity__term">@L["Admin.HallSeatLayouts.LayoutCapacity"]</dt>
                            <dd class="hsl-capacity__value">@_totalSeats</dd>
                        </div>
                    </dl>
                    <progress class="hsl-capacity__meter"
                              aria-label="@L["Admin.HallSeatLayouts.LayoutCapacity"]"
                              max="@(_hallCapacity > 0 ? _hallCapacity : 1)"
                              value="@_totalSeats"></progress>
                    @if (_isOverCapacity || _anyOutOfRange)
                    {
                        <p class="hsl-capacity__warning" role="alert">
                            @L["Admin.HallSeatLayouts.CapacityExceeded"]
                        </p>
                    }
                </section>
            </div>

            @* Live seat-map preview — mirrors the seat picker visitors will see.
               Every seat is "available" here; this page defines the map, it does
               not show reservations (that is /admin/sessions/seat-plans). *@
            <section class="hsl-preview">
                <h2 class="hsl-preview__title">@L["Admin.HallSeatLayouts.Preview.Title"]</h2>
                @if (_rows.Count > 0)
                {
                    <div class="hsl-preview__stage">@L["Admin.HallSeatLayouts.Preview.Front"]</div>
                    @* Decorative confirmation of the layout — the capacity panel
                       and the admin's own inputs already convey the numbers, so it
                       is hidden from assistive tech to avoid a seat-by-seat readout.
                       D-767: each row renders its OWN seat count. *@
                    <div class="hsl-preview__grid" aria-hidden="true">
                        @foreach (var row in _rows)
                        {
                            var seatsToRender = Math.Clamp(row.Count, 0, 80);
                            <div class="hsl-preview__row hsl-preview__row--@TierModifier(row.Tier)">
                                <span class="hsl-preview__row-label">@row.Label</span>
                                @for (var seat = 1; seat <= seatsToRender; seat++)
                                {
                                    <span class="hsl-preview__seat">@seat</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="hsl-preview__empty">@L["Admin.HallSeatLayouts.Preview.Empty"]</p>
                }
            </section>

            <div class="simf-form__actions">
                <AuthorizedAction Permission="@PermissionCatalog.SeatLayouts.Edit">
                    <SimfButton Type="button" OnClick="SaveAsync"
                                Loading="_busy" Disabled="@(!_canSave)">
                        @L["Admin.HallSeatLayouts.Save"]
                    </SimfButton>
                </AuthorizedAction>
                @* B15 — remove the whole grid so the hall goes back to general
                   admission. Only offered once a layout actually exists. *@
                @if (_hasStoredLayout)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.SeatLayouts.Delete">
                        <SimfButton Type="button" Variant="danger"
                                    OnClick="OpenDeleteConfirm" Disabled="@_busy">
                            @L["Admin.HallSeatLayouts.Delete"]
                        </SimfButton>
                    </AuthorizedAction>
                }
            </div>

            <SimfConfirm Open="_confirmingDelete"
                         Title="@L["Admin.HallSeatLayouts.Delete.Title"]"
                         Message="@L["Admin.HallSeatLayouts.Delete.Confirm"]"
                         ConfirmLabel="@L["Admin.HallSeatLayouts.Delete"]"
                         CancelLabel="@L["Admin.HallSeatLayouts.Delete.Cancel"]"
                         Danger="true" Busy="_busy"
                         OnConfirm="DeleteAsync" OnCancel="CancelDeleteConfirm" />
        }
    </div>
</div>
