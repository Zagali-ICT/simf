@* Shared per-service routing editor: loads a prompt (GET), lets an admin change
   Provider / Model / Temperature / Max-tokens, and PUTs the whole prompt back
   with only those routing fields changed (the rest echoed from the loaded
   detail — the update endpoint takes the full prompt). Used by the AI services
   console (in a modal) and the service-detail Routing tab. The host gates it
   behind AiPrompts.Edit (the PUT's own permission). *@

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}
@if (_detail is null)
{
    <p>@L["Admin.AiServices.Loading"]</p>
}
else
{
    <p><code>@_detail.Key</code></p>
    <div class="simf-form__fields">
        <SimfSelect TValue="string"
                    Label="@L["Admin.AiPrompts.Field.Provider"]"
                    Items="AiEnumOptions.Providers"
                    ValueFor="@(id => id)"
                    LabelFor="@(id => AiEnumOptions.ProviderLabel(id))"
                    Value="@_provider"
                    ValueChanged="@(v => _provider = v ?? string.Empty)"
                    Disabled="_busy" />
        <SimfTextField Label="@L["Admin.AiPrompts.Field.Model"]"
                       @bind-Value="_model" Disabled="_busy" />
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.AiPrompts.Field.Temperature"]</span>
            <input class="simf-field__input" type="number" step="0.1" min="0" max="2"
                   value="@_temp.ToString(CultureInfo.InvariantCulture)"
                   @onchange="OnTempChanged" disabled="@_busy" />
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.AiPrompts.Field.MaxOutputTokens"]</span>
            <input class="simf-field__input" type="number" min="1" max="8000"
                   value="@_max" @onchange="OnMaxChanged" disabled="@_busy" />
        </label>
    </div>
    <div class="simf-form__actions">
        <SimfButton Type="button" OnClick="SaveAsync" Loading="_busy" LoadingLabel="@L["Grid.Working"]">
            @L["Admin.AiServices.Routing.Save"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="OnCancel">
                @L["Admin.AiServices.Routing.Cancel"]
            </SimfButton>
        }
    </div>
}
