@* Control Panel — list every account (decisions D-042, D-044). Administrator
   only. Uses SimfDataGrid with the full myComment #16 spec: server-paged,
   sortable headers, per-column filter inputs, row checkboxes, top action
   toolbar (Add / Edit / Delete / Copy / Paste / Duplicate / Import /
   Export), per-row context menu (Edit / Copy / Duplicate / Delete) and
   per-row action buttons. Excel I/O runs through the CP proxy. *@
@page "/admin/users"
@layout CpShellLayout
@attribute [Authorize(Roles = "Administrator")]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@L["Admin.Users.Title"] · SIMF</PageTitle>

<SimfPageHeader Title="@L["Admin.Users.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        <SimfDataGrid TItem="AdminUserSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(user => user.Id.ToString())"
                      OnAdd="OnAddAsync"
                      OnEditOne="OnEditAsync"
                      OnDeleteSelected="OnBulkDeleteAsync"
                      OnDeleteOne="OnRowDeleteAsync"
                      OnDuplicateOne="OnDuplicateAsync"
                      OnExport="OnExportAsync"
                      OnImport="OnImportAsync"
                      PrevLabel="@L["Admin.Users.Prev"]"
                      NextLabel="@L["Admin.Users.Next"]"
                      LoadingLabel="@L["Admin.Users.Loading"]"
                      FilterPlaceholder="@L["Admin.Users.FilterPlaceholder"]"
                      ActionsHeader="@L["Admin.Users.Column.Actions"]"
                      SelectAllLabel="@L["Admin.Users.Action.SelectAll"]"
                      SelectRowLabel="@L["Admin.Users.Action.SelectRow"]"
                      AddLabel="@L["Admin.Users.Action.Add"]"
                      EditLabel="@L["Admin.Users.Action.Edit"]"
                      DeleteLabel="@L["Admin.Users.Action.Delete"]"
                      DuplicateLabel="@L["Admin.Users.Action.Duplicate"]"
                      ImportLabel="@L["Admin.Users.Action.Import"]"
                      ExportLabel="@L["Admin.Users.Action.Export"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminUserSummary" Key="email"
                                    Header="@L["Admin.Users.Column.Email"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Email</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminUserSummary" Key="displayName"
                                    Header="@L["Admin.Users.Column.DisplayName"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.DisplayName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminUserSummary" Key="state"
                                    Header="@L["Admin.Users.Column.State"]"
                                    Sortable="true">
                    <CellTemplate>@context.AccountState</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminUserSummary" Key="role"
                                    Header="@L["Admin.Users.Column.Role"]">
                    <CellTemplate>
                        @if (context.IsAdministrator)
                        {
                            <SimfPill Variant="admin">@L["Admin.Users.Role.Administrator"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill>@L["Admin.Users.Role.User"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminUserSummary" Key="twoFactor"
                                    Header="@L["Admin.Users.Column.TwoFactor"]">
                    <CellTemplate>
                        @if (context.TwoFactorEnabled)
                        {
                            <SimfPill Variant="on">@L["Admin.Users.TwoFactor.On"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Admin.Users.TwoFactor.Off"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions Context="user">
                @if (!user.IsAdministrator && user.TwoFactorEnabled)
                {
                    <SimfLink Href="@($"/admin/reset-2fa?email={Uri.EscapeDataString(user.Email)}")">
                        @L["Admin.Users.Action.Reset2FA"]
                    </SimfLink>
                }
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Users.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@* Hidden file input — the SimfDataGrid Import button triggers a click on this. *@
<input type="file" id="users-import-input" accept=".xlsx"
       style="display: none"
       @onchange="OnImportFileSelectedAsync" />

@if (_bulkDeleteOpen)
{
    <SimfModal Open="true" Title="@L["Admin.Users.BulkDelete.Title"]" OnClose="@(() => _bulkDeleteOpen = false)">
        <ChildContent>
            <p>@string.Format(L["Admin.Users.BulkDelete.Confirm"], _bulkDeleteTargets.Count)</p>
            <SimfTextarea Label="@L["Admin.Users.BulkDelete.Reason"]"
                          Helper="@L["Admin.Users.BulkDelete.ReasonHint"]"
                          Rows="3" MaxLength="500"
                          Value="@_bulkDeleteReason" ValueChanged="@(v => _bulkDeleteReason = v)" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _bulkDeleteOpen = false)">
                @L["Admin.Users.BulkDelete.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="primary"
                        Loading="_busy"
                        OnClick="ConfirmBulkDeleteAsync">
                @L["Admin.Users.BulkDelete.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_importResult is not null)
{
    <SimfModal Open="true" Title="@L["Admin.Users.Import.ResultTitle"]" OnClose="@(() => _importResult = null)">
        <ChildContent>
            <p>@string.Format(L["Admin.Users.Import.ResultBody"], _importResult.Created, _importResult.Skipped)</p>
            @if (_importResult.Errors.Count > 0)
            {
                <ul class="simf-import-errors">
                    @foreach (var error in _importResult.Errors)
                    {
                        <li>@($"Row {error.Row} ({error.Email}): {error.Reason}")</li>
                    }
                </ul>
            }
        </ChildContent>
        <Footer>
            <SimfButton Type="button" OnClick="@(() => _importResult = null)">
                @L["Admin.Users.Import.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminUserSummary>? _page;
    private bool _loading;
    private bool _busy;

    // Bulk-delete modal state
    private bool _bulkDeleteOpen;
    private IReadOnlyList<AdminUserSummary> _bulkDeleteTargets = Array.Empty<AdminUserSummary>();
    private string _bulkDeleteReason = string.Empty;

    // Import result modal state
    private AdminImportUsersResponse? _importResult;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<GridPage<AdminUserSummary>>>(
                "simfAccount.postJson", "/account/api/admin/users/list", _query);
            _page = envelope is { Success: true, Data: not null }
                ? envelope.Data
                : GridPage<AdminUserSummary>.Of(
                    Array.Empty<AdminUserSummary>(), 0, _query);
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        Nav.NavigateTo("/admin/users/new");
        return Task.CompletedTask;
    }

    private Task OnEditAsync(AdminUserSummary user)
    {
        // Edit is deferred until the wider User Management module ships.
        // For now the only edit action available is "reset 2FA"; route there.
        Nav.NavigateTo($"/admin/reset-2fa?email={Uri.EscapeDataString(user.Email)}");
        return Task.CompletedTask;
    }

    private Task OnRowDeleteAsync(AdminUserSummary user)
    {
        _bulkDeleteTargets = new[] { user };
        _bulkDeleteReason = string.Empty;
        _bulkDeleteOpen = true;
        return Task.CompletedTask;
    }

    private Task OnBulkDeleteAsync(IReadOnlyList<AdminUserSummary> users)
    {
        _bulkDeleteTargets = users;
        _bulkDeleteReason = string.Empty;
        _bulkDeleteOpen = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmBulkDeleteAsync()
    {
        if (_bulkDeleteReason.Length is < 10 or > 500 || _bulkDeleteTargets.Count == 0) return;
        _busy = true;
        try
        {
            await JS.InvokeAsync<ApiResult<AdminBulkDeleteResponse>>(
                "simfAccount.postJson", "/account/api/admin/users/bulk-delete",
                new AdminBulkDeleteRequest
                {
                    Ids = _bulkDeleteTargets.Select(u => u.Id).ToList(),
                    Reason = _bulkDeleteReason,
                });
            _bulkDeleteOpen = false;
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private async Task OnDuplicateAsync(AdminUserSummary user)
    {
        var newEmail = $"{Guid.NewGuid():N}@simf.local";
        await JS.InvokeAsync<ApiResult<AdminCreateUserResponse>>(
            "simfAccount.postJson", "/account/api/admin/users/duplicate",
            new AdminDuplicateUserRequest { SourceId = user.Id, NewEmail = newEmail });
        await LoadAsync();
    }

    private async Task OnExportAsync(IReadOnlyList<AdminUserSummary> selected)
    {
        var ids = selected.Select(u => u.Id).ToList();
        await JS.InvokeVoidAsync("simfAccount.downloadXlsx",
            "/account/api/admin/users/export",
            new AdminExportUsersRequest { Ids = ids, Query = ids.Count == 0 ? _query : null });
    }

    private async Task OnImportAsync() =>
        await JS.InvokeVoidAsync("simfAccount.triggerFileInput", "users-import-input");

    private async Task OnImportFileSelectedAsync()
    {
        _busy = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<AdminImportUsersResponse>>(
                "simfAccount.uploadFile", "/account/api/admin/users/import", "users-import-input");
            _importResult = envelope?.Data;
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private string FormatSummary(int from, int to, int total) =>
        string.Format(L["Admin.Users.Pager.Summary"], from, to, total);
}
