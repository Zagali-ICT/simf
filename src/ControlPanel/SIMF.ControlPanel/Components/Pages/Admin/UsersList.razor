@* Control Panel — list every account (decisions D-042, D-044, hardened in
   D-045 H1, promoted to canonical CRUD pattern in D-117). Administrator
   only. Uses SimfDataGrid with the full myComment #16 spec, the new
   correct icon set, the full pager (First/Prev/numbered/Next/Last +
   page-size), and the SimfBanner page-top. /admin/admins/new still
   resolves to the create-user page as a deep-link fallback (Q-D).
   Centralized dialog/full-page framing D-353: Add / Edit (roles) / Details
   are hosted by CrudShell, which frames the reusable UsersAddEdit and
   UsersViewDelete forms as a popup or a full page per the admin's toolbar
   choice (persisted in localStorage via CpPreferences). The inline SimfModal
   Add / Edit-roles / Details dialogs it used to carry are gone; the
   reason-gated bulk-delete, the duplicate dialog, the Excel import-result
   modal, copy/paste, the Excel export/import wiring and the Reset-2FA row
   action are all preserved unchanged. *@
@page "/admin/admins"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Admins.View)]

<PageTitle>@L["Admin.Users.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Users.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            <SimfDataGrid TItem="AdminUserSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(user => user.Id.ToString())"
                          RowLabel="@(user => user.Email)"
                          Caption="@L["Admin.Users.Title"]"
                          FilterColumnLabel="@L["Admin.Users.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteSelected="OnBulkDeleteAsync"
                          OnDeleteOne="OnRowDeleteAsync"
                          OnDuplicateOne="OnDuplicateAsync"
                          OnCopySelected="OnCopySelectedAsync"
                          OnCopyOne="OnCopyOneAsync"
                          OnPaste="OnPasteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Admin.Users.Prev"]"
                          NextLabel="@L["Admin.Users.Next"]"
                          FirstLabel="@L["Admin.Users.Pager.First"]"
                          LastLabel="@L["Admin.Users.Pager.Last"]"
                          PageSizeLabel="@L["Admin.Users.Pager.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Users.Loading"]"
                          FilterPlaceholder="@L["Admin.Users.FilterPlaceholder"]"
                          ActionsHeader="@L["Admin.Users.Column.Actions"]"
                          SelectAllLabel="@L["Admin.Users.Action.SelectAll"]"
                          SelectRowLabel="@L["Admin.Users.Action.SelectRow"]"
                          AddLabel="@L["Admin.Users.Action.Add"]"
                          EditLabel="@L["Admin.Users.Action.Edit"]"
                          DetailsLabel="@L["Admin.Users.Action.Details"]"
                          DeleteLabel="@L["Admin.Users.Action.Delete"]"
                          CopyLabel="@L["Admin.Users.Action.Copy"]"
                          PasteLabel="@L["Admin.Users.Action.Paste"]"
                          DuplicateLabel="@L["Admin.Users.Action.Duplicate"]"
                          ImportLabel="@L["Admin.Users.Action.Import"]"
                          ExportLabel="@L["Admin.Users.Action.Export"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminUserSummary" Key="email"
                                        Header="@L["Admin.Users.Column.Email"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Email</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminUserSummary" Key="displayName"
                                        Header="@L["Admin.Users.Column.DisplayName"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>
                            <SimfIdentityCell ImageUrl="@AvatarImageUrl(context)" Name="@context.DisplayName" />
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminUserSummary" Key="state"
                                        Header="@L["Admin.Users.Column.State"]"
                                        Sortable="true">
                        <CellTemplate>@context.AccountState</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminUserSummary" Key="role"
                                        Header="@L["Admin.Users.Column.Role"]">
                        <CellTemplate>
                            @if (context.IsAdministrator)
                            {
                                <SimfPill Variant="admin">@L["Admin.Users.Role.Administrator"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill>@L["Admin.Users.Role.User"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminUserSummary" Key="twoFactor"
                                        Header="@L["Admin.Users.Column.TwoFactor"]">
                        <CellTemplate>
                            @if (context.TwoFactorEnabled)
                            {
                                <SimfPill Variant="on">@L["Admin.Users.TwoFactor.On"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Admin.Users.TwoFactor.Off"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <RowActions Context="user">
                    @if (!user.IsAdministrator && user.TwoFactorEnabled)
                    {
                        <SimfLink Href="@($"/admin/reset-2fa?email={Uri.EscapeDataString(user.Email)}")">
                            @L["Admin.Users.Action.Reset2FA"]
                        </SimfLink>
                    }
                </RowActions>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Users.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (_toast is not null)
{
    <div class="simf-toast">
        <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
    </div>
}

@* H13 — D-068: this picker is visually hidden (triggered by the
   Import button via JS), but assistive tech that surfaces hidden inputs
   still needs an accessible name. *@
<input type="file" id="users-import-input" accept=".xlsx"
       class="simf-hidden-input"
       aria-label="@L["Admin.Users.Import.Picker"]"
       @onchange="OnImportFileSelectedAsync" />

@* D-353 — Add (CreateAdminForm) / Edit (roles) / Details hosted by CrudShell. *@
@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Users.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <UsersAddEdit IsEdit="_isEdit" Initial="_target"
                          OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <UsersViewDelete IsDelete="_isDelete" Initial="_target"
                             OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@if (_bulkDeleteOpen)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.Users.BulkDelete.Title"]" OnClose="@(() => _bulkDeleteOpen = false)" CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <p>@string.Format(L["Admin.Users.BulkDelete.Confirm"], _bulkDeleteTargets.Count)</p>
            <SimfTextarea Label="@L["Admin.Users.BulkDelete.Reason"]"
                          Helper="@L["Admin.Users.BulkDelete.ReasonHint"]"
                          Rows="3" MaxLength="500"
                          Value="@_bulkDeleteReason" ValueChanged="@(v => _bulkDeleteReason = v)" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _bulkDeleteOpen = false)">
                @L["Admin.Users.BulkDelete.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="primary"
                        Loading="_busy"
                        Disabled="@(_bulkDeleteReason.Length is < 10 or > 500)"
                        OnClick="ConfirmBulkDeleteAsync"
                        LoadingLabel="@L["Grid.Working"]">
                @L["Admin.Users.BulkDelete.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_duplicateOpen)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.Users.Duplicate.Title"]" OnClose="@(() => _duplicateOpen = false)" CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <p>@string.Format(L["Admin.Users.Duplicate.Confirm"], _duplicateSource?.Email)</p>
            <SimfTextField Label="@L["Admin.Users.Duplicate.NewEmail"]"
                           Helper="@L["Admin.Users.Duplicate.NewEmailHint"]"
                           Type="email" Icon="mail"
                           Value="@_duplicateEmail"
                           ValueChanged="@(v => _duplicateEmail = v)"
                           ValueExpression="@(() => _duplicateEmail)" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _duplicateOpen = false)">
                @L["Admin.Users.Duplicate.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="primary"
                        Loading="_busy"
                        Disabled="@(!IsLikelyEmail(_duplicateEmail))"
                        OnClick="ConfirmDuplicateAsync"
                        LoadingLabel="@L["Grid.Working"]">
                @L["Admin.Users.Duplicate.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_importResult is not null)
{
    <SimfModal Open="true" Title="@L["Admin.Users.Import.ResultTitle"]" OnClose="@(() => _importResult = null)" CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <p>@string.Format(L["Admin.Users.Import.ResultBody"], _importResult.Created, _importResult.Skipped)</p>
            @if (_importResult.Errors.Count > 0)
            {
                <ul class="simf-import-errors">
                    @foreach (var error in _importResult.Errors)
                    {
                        <li>@($"Row {error.Row} ({error.Email}): {error.Reason}")</li>
                    }
                </ul>
            }
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="@(() => _importResult = null)">
                @L["Admin.Users.Import.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
