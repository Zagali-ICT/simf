@* D-183 (CP UI for D-174 meeting requests, Mockup page 27) — admin
   queue for in-session meeting / interview requests submitted by the
   audience. Respond modal accepts / rejects with an optional note.
   Pending → Pending transitions are rejected server-side
   (MEETING_REQUEST_STATUS_INVALID). D-256 — migrated from the raw
   <table> to the owner-mandated SimfDataGrid (server-paged, sortable +
   filterable, full pager). The page-specific Respond action lives in
   <RowActions> as a quiet reply button, shown only for Pending rows. *@
@page "/admin/meeting-requests"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.MeetingRequests.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.MeetingRequests.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.MeetingRequests.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminMeetingRequestRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.RequesterName)"
                      Caption="@L["Admin.MeetingRequests.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.MeetingRequests.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminMeetingRequestRow" Key="session"
                                    Header="@L["Admin.MeetingRequests.Col.Session"]">
                    <CellTemplate>@context.SessionCode — @context.SessionTitle</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminMeetingRequestRow" Key="requesterName"
                                    Header="@L["Admin.MeetingRequests.Col.Requester"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.RequesterName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminMeetingRequestRow" Key="subject"
                                    Header="@L["Admin.MeetingRequests.Col.Subject"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Subject</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminMeetingRequestRow" Key="status"
                                    Header="@L["Admin.MeetingRequests.Col.Status"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>
                        @switch (context.Status)
                        {
                            case MeetingRequestStatus.Pending:
                                <SimfPill Variant="warn">@L["Admin.MeetingRequests.Filter.Pending"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Accepted:
                                <SimfPill Variant="on">@L["Admin.MeetingRequests.Filter.Accepted"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Rejected:
                                <SimfPill Variant="off">@L["Admin.MeetingRequests.Filter.Rejected"]</SimfPill>
                                break;
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminMeetingRequestRow" Key="createdAt"
                                    Header="@L["Admin.MeetingRequests.Col.CreatedAt"]"
                                    Sortable="true">
                    <CellTemplate>@context.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminMeetingRequestRow" Key="respondedAt"
                                    Header="@L["Admin.MeetingRequests.Col.RespondedAt"]"
                                    Sortable="true">
                    <CellTemplate>
                        @(context.RespondedAt is null ? "—"
                            : context.RespondedAt.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'"))
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @* Page-specific quiet action: respond (accept / reject) to a
                   Pending request. Only Pending rows can transition. *@
                @if (context.Status == MeetingRequestStatus.Pending)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.MeetingRequests.Manage">
                        <SimfToolbarButton Icon="reply" Title="@L["Admin.MeetingRequests.Respond"]"
                                           OnClick="@(() => OnRespondAsync(context))" />
                    </AuthorizedAction>
                }
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.MeetingRequests.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_respondOpen && _respondTarget is not null)
{
    <SimfModal Open="true" Title="@L["Admin.MeetingRequests.Respond.Title"]"
               OnClose="@(() => _respondOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <dl class="simf-dl">
                    <dt>@L["Admin.MeetingRequests.Col.Session"]</dt>
                    <dd>@_respondTarget.SessionCode — @_respondTarget.SessionTitle</dd>
                    <dt>@L["Admin.MeetingRequests.Col.Requester"]</dt>
                    <dd>
                        <div>@_respondTarget.RequesterName</div>
                        @if (_loadingDetail)
                        {
                            <div class="simf-table__sub">@L["Admin.MeetingRequests.LoadingDetail"]</div>
                        }
                        else if (!string.IsNullOrEmpty(_respondTarget.RequesterEmail))
                        {
                            <div class="simf-table__sub">@_respondTarget.RequesterEmail</div>
                        }
                    </dd>
                    <dt>@L["Admin.MeetingRequests.Col.Subject"]</dt>
                    <dd>@_respondTarget.Subject</dd>
                </dl>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.MeetingRequests.Respond.Status"]</span>
                    <select class="simf-field__input" value="@((int)_respondStatus)"
                            @onchange="OnRespondStatusChanged" disabled="@_busy">
                        <option value="@((int)MeetingRequestStatus.Accepted)">
                            @L["Admin.MeetingRequests.Respond.Accept"]
                        </option>
                        <option value="@((int)MeetingRequestStatus.Rejected)">
                            @L["Admin.MeetingRequests.Respond.Reject"]
                        </option>
                    </select>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.MeetingRequests.Respond.Note"]</span>
                    <textarea class="simf-field__input" rows="4"
                              value="@_respondNote"
                              @onchange="OnRespondNoteChanged"
                              disabled="@_busy"></textarea>
                </label>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                        OnClick="@(() => _respondOpen = false)">
                @L["Admin.MeetingRequests.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SendResponseAsync" Loading="_busy">
                @L["Admin.MeetingRequests.Respond.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminMeetingRequestRow> _page = new();
    private bool _loading;
    private bool _busy;
    private Toast? _toast;

    private bool _respondOpen;
    // D-185: detail-shaped so the modal can display the requester
    // email fetched on demand. List rows don't carry email anymore.
    private AdminMeetingRequestDetail? _respondTarget;
    private bool _loadingDetail;
    private MeetingRequestStatus _respondStatus = MeetingRequestStatus.Accepted;
    private string _respondNote = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminMeetingRequestRow>>>(
                "simfAccount.postJson",
                "/account/api/admin/meeting-requests/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.MeetingRequests.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private async Task OnRespondAsync(AdminMeetingRequestRow row)
    {
        // D-185: open the modal with whatever the row already carries
        // (no email yet), then fetch the detail (with email) in the
        // background. The Loading state shows in the modal until the
        // detail arrives. Fetching is a separate audited call so SOC
        // sees one MeetingRequest.Viewed event per click.
        _respondTarget = new AdminMeetingRequestDetail(
            row.Id, row.SessionId, row.SessionCode, row.SessionTitle,
            row.RequestedByUserId, row.RequesterName, RequesterEmail: null,
            row.Subject, row.Status, row.ResponseNote,
            row.CreatedAt, row.RespondedAt);
        _respondStatus = MeetingRequestStatus.Accepted;
        _respondNote = string.Empty;
        _respondOpen = true;
        _loadingDetail = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminMeetingRequestDetail>>(
                "simfAccount.getJson",
                $"/account/api/admin/meeting-requests/{row.Id}");
            if (env is { Success: true, Data: not null } && _respondOpen
                && _respondTarget?.Id == row.Id)
            {
                _respondTarget = env.Data;
            }
        }
        finally { _loadingDetail = false; }
    }

    private void OnRespondStatusChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            _respondStatus = (MeetingRequestStatus)v;
        }
    }

    private void OnRespondNoteChanged(ChangeEventArgs e) =>
        _respondNote = e.Value?.ToString() ?? string.Empty;

    private async Task SendResponseAsync()
    {
        if (_respondTarget is null || _busy) return;
        _busy = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminMeetingRequestDetail>>(
                "simfAccount.putJson",
                $"/account/api/admin/meeting-requests/{_respondTarget.Id}/respond",
                new RespondToMeetingRequestRequest
                {
                    Status = _respondStatus,
                    ResponseNote = string.IsNullOrWhiteSpace(_respondNote)
                        ? null : _respondNote.Trim(),
                });
            if (env is { Success: true })
            {
                _respondOpen = false;
                _toast = new Toast("success", L["Admin.MeetingRequests.Respond.Done"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.MeetingRequests.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }
}
