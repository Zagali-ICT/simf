@* D-353 â€” reusable Gate View/Delete form, hosted by CrudShell (popup or full
   page) from GatesList. Inherits CrudViewDeleteFormBase so it exposes the
   standard surface (IsDelete / Initial / OnDeleted / OnCancel). Read-only
   details always show; when IsDelete=true a Deactivate button appears and a
   SimfConfirm gates the soft-delete (was a one-click delete on the list). *@
@inherits CrudViewDeleteFormBase<AdminGateDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.Gates.Column.Code"]</dt>
        <dd>@Initial.Code</dd>
        <dt>@L["Admin.Gates.Column.Name"]</dt>
        <dd>@Initial.Name</dd>
        <dt>@L["Admin.Gates.Column.NameArabic"]</dt>
        <dd>@Initial.NameArabic</dd>
        <dt>@L["Admin.Gates.Column.DirectionMode"]</dt>
        <dd>@Initial.DirectionMode</dd>
        <dt>@L["Admin.Gates.Column.AllowCount"]</dt>
        <dd>@(Initial.AllowedProfileTypeIds.Count == 0 ? L["Admin.Gates.AllowAll"] : Initial.AllowedProfileTypeIds.Count.ToString())</dd>
        <dt>@L["Admin.Gates.Column.OperatorCount"]</dt>
        <dd>@Initial.AssignedOperatorUserIds.Count</dd>
        <dt>@L["Admin.Gates.Column.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Admin.Gates.Active.Yes"] : L["Admin.Gates.Active.No"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.Gates.Action.Deactivate"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Gates.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.Gates.Delete.Title"]"
                 Message="@string.Format(L["Admin.Gates.Delete.Message"], Initial.Name)"
                 ConfirmLabel="@L["Admin.Gates.Action.Deactivate"]"
                 CancelLabel="@L["Admin.Gates.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" />
}
