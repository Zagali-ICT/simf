@* Halls CRUD. Centralized dialog/full-page
   framing: Add / Edit / View / Delete are hosted by CrudShell, which frames
   the reusable HallsAddEdit and HallsViewDelete forms as a popup or a full page per
   the admin's toolbar choice (persisted in localStorage via CpPreferences). *@
@page "/admin/halls"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Halls.View)]

<PageTitle>@L["Admin.Halls.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Halls.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <div class="simf-toast">
                    <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
                </div>
            }

            <SimfDataGrid TItem="AdminHallSummary"
                          Query="_query" Page="_page" Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Name)"
                          Caption="@L["Admin.Halls.Title"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Admin.Halls.Prev"]"
                          NextLabel="@L["Admin.Halls.Next"]"
                          FirstLabel="@L["Admin.Halls.Pager.First"]"
                          LastLabel="@L["Admin.Halls.Pager.Last"]"
                          PageSizeLabel="@L["Admin.Halls.Pager.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Halls.Loading"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Admin.Halls.Column.Actions"]"
                          SelectAllLabel="@L["Admin.Halls.Action.SelectAll"]"
                          SelectRowLabel="@L["Admin.Halls.Action.SelectRow"]"
                          AddLabel="@L["Admin.Halls.Action.Add"]"
                          EditLabel="@L["Admin.Halls.Action.Edit"]"
                          DetailsLabel="@L["Admin.Halls.Action.Details"]"
                          DeleteLabel="@L["Admin.Halls.Action.Deactivate"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary"
                          AddPermission="@PermissionCatalog.Halls.Create"
                          EditPermission="@PermissionCatalog.Halls.Edit"
                          DeletePermission="@PermissionCatalog.Halls.Delete"
                          ImportPermission="@PermissionCatalog.Halls.Import"
                          ExportPermission="@PermissionCatalog.Halls.Export">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminHallSummary" Key="code"
                                        Header="@L["Admin.Halls.Column.Code"]" Sortable="true" Filterable="true">
                        <CellTemplate>@context.Code</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminHallSummary" Key="name"
                                        Header="@L["Admin.Halls.Column.Name"]" Sortable="true" Filterable="true">
                        <CellTemplate>@context.Name</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminHallSummary" Key="nameArabic"
                                        Header="@L["Admin.Halls.Column.NameArabic"]" Sortable="true" Filterable="true">
                        <CellTemplate>@context.NameArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminHallSummary" Key="capacity"
                                        Header="@L["Admin.Halls.Column.Capacity"]" Sortable="true">
                        <CellTemplate>@context.Capacity</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminHallSummary" Key="floor"
                                        Header="@L["Admin.Halls.Column.Floor"]" Filterable="true">
                        <CellTemplate>@(context.Floor ?? "—")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminHallSummary" Key="isActive"
                                        Header="@L["Admin.Halls.Column.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            { <SimfPill Variant="on">@L["Admin.Halls.Active.Yes"]</SimfPill> }
                            else
                            { <SimfPill Variant="off">@L["Admin.Halls.Active.No"]</SimfPill> }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <RowActions>
                    @* A40 — the seat-layout editor had no way in from this grid, so an
                       admin looking at a hall could not reach its seat map. Quiet icon
                       action, same convention as the grid's built-in row buttons. *@
                    <AuthorizedAction Permission="@PermissionCatalog.SeatLayouts.View">
                        <SimfToolbarButton Icon="grid"
                                           Title="@L["Admin.Halls.Action.SeatLayout"]"
                                           OnClick="@(() => OpenSeatLayout(context))" />
                    </AuthorizedAction>
                </RowActions>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Halls.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="halls"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Halls.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <HallsAddEdit IsEdit="_isEdit" Initial="_target"
                          OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <HallsViewDelete IsDelete="_isDelete" Initial="_target"
                             OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
