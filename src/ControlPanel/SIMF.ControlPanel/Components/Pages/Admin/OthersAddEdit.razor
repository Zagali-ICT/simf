@* Reusable Other (partner / event-team account) Add/Edit form, hosted
   by CrudShell (popup or full page) from OthersList. Inherits
   CrudAddEditFormBase<AdminUserProfileView> so it exposes the standard CRUD-form
   surface (IsEdit / Initial / OnSuccess / OnCancel). This is an account/security
   page: the form does NOT reimplement the account create/edit logic — it hosts
   the EXACT same components the inline SimfModal Add / Edit used:
   IsEdit=false → the walk-in CreateOtherForm wizard (Kind=Other; POST + auto-QR);
   IsEdit=true  → the shared EditAccountForm (Scope="others"; PUT). Same fields,
   same validation, same routes, same email-change security note. Both hosted
   components render their own action row + Cancel, so this form adds none. *@
@inherits CrudAddEditFormBase<AdminUserProfileView>

@if (!IsEdit)
{
    @* Add — the walk-in Other registration wizard (POST
       /account/api/admin/others/register-onsite, auto-approved + QR minted).
       Identical to the component the inline Add SimfModal hosted. *@
    <CreateOtherForm OnSuccess="OnCreatedAsync"
                     OnCancel="OnCancel"
                     CancelLabel="@L["Admin.Others.Add.Close"]" />
}
else if (Initial is not null)
{
    @* Edit — the shared partner-account edit form (PUT
       /account/api/admin/others/{id}). Identical to the component the inline
       Edit SimfModal hosted. Loads its own profile by AccountId. *@
    <EditAccountForm AccountId="Initial.Id" Scope="others" IsVisitorScope="false"
                     OnSaved="OnSavedInternalAsync"
                     OnCancel="OnCancel" />
}
