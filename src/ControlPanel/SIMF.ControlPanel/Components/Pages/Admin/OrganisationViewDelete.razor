@* Reusable Organisation View/Delete form, hosted by CrudShell (as a
   popup or a full page) from OrganisationsList.razor. Inherits
   CrudViewDeleteFormBase so it exposes the standard parameter surface
   (IsDelete / Initial / OnDeleted / OnCancel). Read-only details always show
   (including the contact columns the grid summary omits — phone / email /
   website); when IsDelete=true a Deactivate button appears and a SimfConfirm
   gates the destructive call (replaces the old native JS confirm() on the
   list). Adds the View path the inline form never had. *@
@inherits CrudViewDeleteFormBase<AdminOrganisationDetail>
@using SIMF.Contracts.Organisations

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.Organisations.Col.NameAr"]</dt>
        <dd>@Initial.NameAr</dd>
        <dt>@L["Admin.Organisations.Col.NameEn"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.NameEn) ? "—" : Initial.NameEn)</dd>
        <dt>@L["Admin.Organisations.Col.CommercialRegistration"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.CommercialRegistration) ? "—" : Initial.CommercialRegistration)</dd>
        <dt>@L["Admin.Organisations.Col.Sector"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.Sector) ? "—" : Initial.Sector)</dd>
        <dt>@L["Admin.Organisations.Col.City"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.City) ? "—" : Initial.City)</dd>
        <dt>@L["Admin.Organisations.Field.Phone"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.Phone) ? "—" : Initial.Phone)</dd>
        <dt>@L["Admin.Organisations.Field.Email"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.Email) ? "—" : Initial.Email)</dd>
        <dt>@L["Admin.Organisations.Field.Website"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.Website) ? "—" : Initial.Website)</dd>
        <dt>@L["Admin.Organisations.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.Organisations.Action.Deactivate"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Organisations.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.Organisations.Delete.Title"]"
                 Message="@string.Format(L["Admin.Organisations.Delete.Message"], Initial.NameAr)"
                 ConfirmLabel="@L["Admin.Organisations.Action.Deactivate"]"
                 CancelLabel="@L["Admin.Organisations.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" 
                 Permission="@PermissionCatalog.Organisations.Delete"/>
}
