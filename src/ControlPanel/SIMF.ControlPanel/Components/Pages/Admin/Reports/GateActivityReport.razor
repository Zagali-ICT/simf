@* Gate-activity report — recorded scans, allowed and denied, over a Saudi date
   range. The visitor name and profile type are the scan's own audit snapshots,
   not a live lookup, so a historic row still reads correctly after the account
   is renamed. *@
@page "/admin/reports/gates"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Reports.Gates)]
@inherits ReportPageBase<GateActivityReportRow>
@using SIMF.Contracts.Reporting

<PageTitle>@L["Admin.Reports.Gates.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Reports.Gates.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        <ReportToolbar From="From"
                       FromChanged="@(v => From = v)"
                       To="To"
                       ToChanged="@(v => To = v)"
                       Totals="Totals"
                       Error="@Error"
                       OnApply="OnRangeAppliedAsync"
                       OnClear="OnRangeAppliedAsync"
                       OnExport="ExportAsync"
                       TotalLabelResolver="TotalLabel" />

        <SimfDataGrid TItem="GateActivityReportRow"
                      Query="Query.Grid"
                      Page="Page"
                      Loading="Loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Caption="@L["Admin.Reports.Gates.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.Reports.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="GateActivityReportRow" Key="gate"
                                    Header="@L["Admin.Reports.Col.Gate"]"
                                    Sortable="true">
                    <CellTemplate>@context.GateName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="GateActivityReportRow" Key="scanned"
                                    Header="@L["Admin.Reports.Col.Scanned"]"
                                    Sortable="true">
                    <CellTemplate>@context.ScannedDisplay</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="GateActivityReportRow" Key="visitor"
                                    Header="@L["Admin.Reports.Col.Visitor"]"
                                    Sortable="true">
                    <CellTemplate>@context.VisitorName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="GateActivityReportRow" Key="profileType"
                                    Header="@L["Admin.Reports.Col.ProfileType"]">
                    <CellTemplate>@context.ProfileTypeName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="GateActivityReportRow" Key="direction"
                                    Header="@L["Admin.Reports.Col.Direction"]">
                    <CellTemplate>@context.Direction</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="GateActivityReportRow" Key="outcome"
                                    Header="@L["Admin.Reports.Col.Outcome"]"
                                    Sortable="true">
                    <CellTemplate>
                        @if (context.Outcome == "Denied")
                        {
                            <SimfPill Variant="off">@context.Outcome</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="on">@context.Outcome</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="GateActivityReportRow" Key="denial"
                                    Header="@L["Admin.Reports.Col.DenialReason"]">
                    <CellTemplate>@DenialReasonText(context.DenialReason)</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Reports.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@code {
    protected override string Slug => "gates";

    /// <summary>
    /// Turns the API's raw <c>DenialReasonCode</c> name into a readable, localised
    /// label.
    ///
    /// <para>The report row carries <c>p.DenialReason?.ToString()</c> — the
    /// PascalCase enum member — so before this the grid showed an operator
    /// "HolderNotApproved" in a column headed "Denial reason". The API stays as
    /// it is on purpose: a stable code is the right thing on the wire and in the
    /// XLSX export, which is a data file for analysis rather than prose. Only
    /// the on-screen cell is turned into words, in the reader's language.</para>
    ///
    /// <para>An unrecognised code renders AS ITSELF rather than as a missing
    /// resource key. A new <c>DenialReasonCode</c> member would otherwise print
    /// "Admin.Reports.DenialReason.Whatever" in the grid, which is worse than
    /// the bare name this replaces. <c>GateActivityReportDenialReasonTests</c>
    /// asserts every enum member has a string in both resx files, so the
    /// fallback is a safety net, not the plan.</para>
    /// </summary>
    private string DenialReasonText(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            return string.Empty;
        }

        var label = L[$"Admin.Reports.DenialReason.{code}"];
        return label.ResourceNotFound ? code : label.Value;
    }
}
