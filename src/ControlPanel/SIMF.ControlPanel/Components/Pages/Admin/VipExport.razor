@* V-1 (D-429) — Control Panel: VVIP/VIP welcome export (موج). Read-only roster
   of the VVIP / VIP visitors with their موج welcome data, shared with the
   technical teams. Canonical SimfDataGrid (owner-mandated) for the on-screen
   roster; the CSV / Excel downloads + the JSON API are served by the dedicated
   export endpoints (toolbar). Gated by the VIP-export permission. *@
@page "/admin/visitors/vip/export"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Visitors.ExportVip)]
@using SIMF.Components.Forms

<PageTitle>@L["Admin.VipExport.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.VipExport.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        <p>@L["Admin.VipExport.Supporting"]</p>

        <SimfDataGrid TItem="VipRosterRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="false"
                      RowKey="@(r => r.UserId.ToString())"
                      RowLabel="@(r => r.DisplayName)"
                      Caption="@L["Admin.VipExport.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.VipExport.Title"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      AddLabel="@L["Grid.Add"]"
                      EditLabel="@L["Grid.Edit"]"
                      DeleteLabel="@L["Grid.Delete"]"
                      SummaryFormatter="@FormatSummary">
            <CustomToolbar>
                @* The actual export surface: CSV / Excel files + the JSON API. *@
                <a class="simf-button simf-button--secondary"
                   href="/account/api/admin/visitors/vip/roster/export?format=csv" download>
                    @L["Admin.VipExport.Download"] CSV
                </a>
                <a class="simf-button simf-button--secondary"
                   href="/account/api/admin/visitors/vip/roster/export?format=xlsx" download>
                    @L["Admin.VipExport.Download"] Excel
                </a>
                <a class="simf-button simf-button--secondary"
                   href="/account/api/admin/visitors/vip/roster" target="_blank">
                    API (JSON)
                </a>
            </CustomToolbar>
            <Columns>
                <SimfDataGridColumn TItem="VipRosterRow" Key="photo"
                                    Header="@L["Admin.VipExport.Photo"]">
                    <CellTemplate>
                        @if (context.HasVipPhoto)
                        {
                            <a href="@PhotoUrl(context.UserId)" target="_blank"
                               download="@($"vip-{context.UserId}")">
                                <SimfImageThumb Src="@PhotoUrl(context.UserId)"
                                                Alt="@context.DisplayName" />
                            </a>
                        }
                        else
                        {
                            <SimfImageThumb Src="" Alt="@context.DisplayName" />
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="VipRosterRow" Key="tier"
                                    Header="@L["Admin.VipExport.Title"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>
                        <SimfPill Variant="@(context.TierName == "VVIP" ? "on" : "neutral")">
                            @(IsArabic ? context.TierNameArabic : context.TierName)
                        </SimfPill>
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="VipRosterRow" Key="name"
                                    Header="@L["Admin.WalkIn.Field.EnglishName"]"
                                    Sortable="true">
                    <CellTemplate>
                        @(IsArabic ? context.ArabicName : context.EnglishName)
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="VipRosterRow" Key="honorific"
                                    Header="@L["Admin.WalkIn.Field.Honorific"]">
                    <CellTemplate>@(string.IsNullOrEmpty(context.Honorific) ? "—" : context.Honorific)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="VipRosterRow" Key="jobTitle"
                                    Header="@L["Admin.WalkIn.Field.JobTitle"]">
                    <CellTemplate>@(string.IsNullOrEmpty(context.JobTitle) ? "—" : context.JobTitle)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="VipRosterRow" Key="mawjId"
                                    Header="@L["Admin.WalkIn.Field.MawjId"]">
                    <CellTemplate><code>@(string.IsNullOrEmpty(context.MawjId) ? "—" : context.MawjId)</code></CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="VipRosterRow" Key="prefLang"
                                    Header="@L["Admin.WalkIn.Field.PreferredLanguage"]">
                    <CellTemplate>@(string.IsNullOrEmpty(context.PreferredLanguage) ? "—" : context.PreferredLanguage)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="VipRosterRow" Key="email"
                                    Header="@L["Admin.WalkIn.Field.Email"]">
                    <CellTemplate>@context.Email</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="VipRosterRow" Key="mobile"
                                    Header="@L["Admin.WalkIn.Field.SaudiMobile"]">
                    <CellTemplate>@(string.IsNullOrEmpty(context.Mobile) ? "—" : context.Mobile)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="VipRosterRow" Key="reference"
                                    Header="@L["Admin.Pending.View.Field.ReferenceNumber"]">
                    <CellTemplate><code>@(string.IsNullOrEmpty(context.ReferenceNumber) ? "—" : context.ReferenceNumber)</code></CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.VipExport.Empty"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>
