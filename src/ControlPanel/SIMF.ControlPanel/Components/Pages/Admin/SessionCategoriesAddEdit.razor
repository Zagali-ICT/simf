@* Reusable Session-Category Add/Edit form, hosted by CrudShell (as a
   popup or a full page) from SessionCategoriesList.razor. Inherits
   CrudAddEditFormBase so it exposes the standard CRUD-form parameter surface
   (IsEdit / Initial / OnSuccess / OnCancel). IsEdit=false runs Create (POST);
   IsEdit=true runs Edit (PUT against Initial) and shows the IsActive checkbox.
   Supersedes the inline SimfModal form that lived in SessionCategoriesList. *@
@inherits CrudAddEditFormBase<AdminSessionCategoryDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.SessionCategories.Field.NameEn"]"
                       MaxLength="128"
                       @bind-Value="_model.Name" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.SessionCategories.Field.NameAr"]"
                       MaxLength="128"
                       @bind-Value="_model.NameArabic" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.SessionCategories.Field.DisplayOrder"]"
                       Type="number"
                       Value="@_displayOrderInput"
                       ValueChanged="@(v => _displayOrderInput = v)"
                       ValueExpression="@(() => _displayOrderInput)"
                       Disabled="_busy" />
        @if (IsEdit)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.SessionCategories.Field.IsActive"]
            </SimfCheckbox>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.SessionCategories.Save"]">
            @L["Admin.SessionCategories.Save"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.SessionCategories.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
