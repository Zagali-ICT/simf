@* Control Panel — pending visitor approval queue. Reaching the page needs
   Visitors.View; Approve and Reject each need their own permission. Approve
   mints the QR id so the visitor's QR badge becomes available. Reject opens a
   reason modal (10–500 chars). *@
@page "/admin/visitors/pending"
@using SIMF.ControlPanel.Components.Pages.Admin.ProfileTypes
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Visitors.View)]
@inherits PendingApprovalPageBase

<PageTitle>@L["Admin.Pending.Visitors.Title"] · SIMF</PageTitle>

@* Hide the grid while the review "View" takes over the full page. *@
@if (!ViewFullPage)
{
<SimfBanner Title="@L["Admin.Pending.Visitors.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        <p>@L["Admin.Pending.Supporting"]</p>

        <SimfDataGrid TItem="AdminPendingUserSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      OnApproveSelected="OnBulkApproveAsync"
                      ApproveSelectedLabel="@L["Admin.Pending.Action.BulkApprove"]"
                      OnRejectSelected="OnBulkRejectAsync"
                      RejectSelectedLabel="@L["Admin.Pending.Action.BulkReject"]"
                      RowKey="@(u => u.Id.ToString())"
                      RowLabel="@(u => u.Email)"
                      Caption="@L["Admin.Pending.Visitors.Title"]"
                      SelectAllLabel="@L["Admin.Pending.Action.SelectAll"]"
                      SelectRowLabel="@L["Admin.Pending.Action.SelectRow"]"
                      PrevLabel="@L["Admin.Users.Prev"]"
                      NextLabel="@L["Admin.Users.Next"]"
                      FirstLabel="@L["Admin.Pending.Pager.First"]"
                      LastLabel="@L["Admin.Pending.Pager.Last"]"
                      PageSizeLabel="@L["Admin.Pending.Pager.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.Users.Loading"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SummaryFormatter="@FormatSummary"
                      ApprovePermission="@PermissionCatalog.Visitors.Approve"
                      RejectPermission="@PermissionCatalog.Visitors.Reject">
            <CustomToolbar>
                <CrudPresentationToggle PageKey="@(PresentationPageKey!)" @bind-Value="_presentation" />
            </CustomToolbar>
            <Columns>
                <SimfDataGridColumn TItem="AdminPendingUserSummary" Key="email"
                                    Header="@L["Admin.Users.Column.Email"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Email</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminPendingUserSummary" Key="displayName"
                                    Header="@L["Admin.Users.Column.DisplayName"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>
                        <SimfIdentityCell ImageUrl="@AvatarImageUrl(context)"
                                          Name="@context.DisplayName" />
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminPendingUserSummary" Key="created"
                                    Header="@L["Admin.Pending.Column.Created"]">
                    <CellTemplate>@context.CreatedAt.FormatSaudi("dd-MM-yyyy hh:mm tt")</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions Context="user">
                @* Approve opens a review modal that loads the
                   full profile first. The admin must click "Confirm
                   and Approve" inside the modal to actually approve;
                   that removes the "approved without looking" hazard.
                   The View button stays for read-only inspection. *@
                <SimfButton Type="button" Variant="secondary"
                            Disabled="_busy"
                            OnClick="@(() => OpenViewAsync(user, approveMode: false))">
                    @L["Admin.Pending.Action.View"]
                </SimfButton>
                @* The row pair matches the bulk pair above it. The
                   read-only View above stays ungated: Visitors.View bought it. *@
                <AuthorizedAction Permission="@PermissionCatalog.Visitors.Approve">
                    <SimfButton Type="button" Variant="primary"
                                Disabled="_busy"
                                OnClick="@(() => OpenViewAsync(user, approveMode: true))">
                        @L["Admin.Pending.Action.Approve"]
                    </SimfButton>
                </AuthorizedAction>
                <AuthorizedAction Permission="@PermissionCatalog.Visitors.Reject">
                    <SimfButton Type="button" Variant="secondary"
                                Disabled="_busy"
                                OnClick="@(() => OpenReject(user))">
                        @L["Admin.Pending.Action.Reject"]
                    </SimfButton>
                </AuthorizedAction>
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Pending.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>
}

@* Toast lives outside the grid-hide guard (matches VisitorsList) so a
   success/error alert is never swallowed while the review is full-page. *@
@if (_toast is not null)
{
    <div class="simf-toast">
        <SimfAlert Variant="@_toastVariant">@_toast</SimfAlert>
    </div>
}

@if (_rejectTarget is not null)
{
    <SimfModal Open="true"
               RequireExplicitClose="true"
               Title="@L["Admin.Pending.Reject.Title"]"
               OnClose="@(() => _rejectTarget = null)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <p>@string.Format(L["Admin.Pending.Reject.Confirm"], _rejectTarget.Email)</p>
            <SimfTextarea Label="@L["Admin.Pending.Reject.Reason"]"
                          Helper="@L["Admin.Pending.Reject.ReasonHint"]"
                          Rows="3" MaxLength="500"
                          Value="@_rejectReason"
                          ValueChanged="@(v => _rejectReason = v)" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _rejectTarget = null)">
                @L["Admin.Pending.Reject.Cancel"]
            </SimfButton>
            @* The commit button of the modal this action opened. *@
            <AuthorizedAction Permission="@PermissionCatalog.Visitors.Reject">
            <SimfButton Type="button" Variant="primary"
                            Loading="_busy"
                            Disabled="@(_rejectReason.Length is < 10 or > 500)"
                            OnClick="ConfirmRejectAsync"
                            LoadingLabel="@L["Grid.Working"]">
                    @L["Admin.Pending.Reject.Submit"]
                </SimfButton>
            </AuthorizedAction>
        </Footer>
    </SimfModal>
}

@* Bulk approve commits many accounts at once; confirm the count first. *@
<SimfConfirm Open="@(_bulkApproveSelected is not null)"
             Title="@L["Admin.Pending.BulkApprove.Confirm.Title"]"
             Message="@(_bulkApproveSelected is null ? string.Empty
                        : string.Format(L["Admin.Pending.BulkApprove.Confirm.Message"],
                                        _bulkApproveSelected.Count))"
             ConfirmLabel="@L["Admin.Pending.ApproveReview.Confirm"]"
             CancelLabel="@L["Common.Cancel"]"
             OnConfirm="ConfirmBulkApproveAsync"
             OnCancel="CancelBulkApprove" 
             Permission="@PermissionCatalog.Visitors.Approve"/>

@* Bulk reject: shared-reason modal for the selected pending rows. *@
@if (_bulkRejectSelected is not null)
{
    <SimfModal Open="true"
               RequireExplicitClose="true"
               Title="@L["Admin.Pending.BulkReject.Title"]"
               OnClose="@(() => _bulkRejectSelected = null)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <p>@string.Format(L["Admin.Pending.BulkReject.Confirm"], _bulkRejectSelected.Count)</p>
            <SimfTextarea Label="@L["Admin.Pending.Reject.Reason"]"
                          Helper="@L["Admin.Pending.Reject.ReasonHint"]"
                          Rows="3" MaxLength="500"
                          Value="@_bulkRejectReason"
                          ValueChanged="@(v => _bulkRejectReason = v)" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _bulkRejectSelected = null)">
                @L["Admin.Pending.Reject.Cancel"]
            </SimfButton>
            @* The commit button of the modal this action opened. *@
            <AuthorizedAction Permission="@PermissionCatalog.Visitors.Reject">
            <SimfButton Type="button" Variant="primary"
                            Loading="_busy"
                            Disabled="@(_bulkRejectReason.Length is < 10 or > 500)"
                            OnClick="ConfirmBulkRejectAsync"
                            LoadingLabel="@L["Grid.Working"]">
                    @L["Admin.Pending.BulkReject.Submit"]
                </SimfButton>
            </AuthorizedAction>
        </Footer>
    </SimfModal>
}

@if (_viewTarget is not null)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@(_approveMode
                   ? string.Format(L["Admin.Pending.ApproveReview.Title"], _viewTarget.Email)
                   : string.Format(L["Admin.Pending.View.Title"], _viewTarget.Email))"
               CloseLabel="@L["Admin.Pending.View.Close"]"
               OnClose="CloseView">
            @if (_viewLoading)
            {
                <p>@L["Admin.Pending.View.Loading"]</p>
            }
            else if (_viewError is not null)
            {
                <SimfAlert Variant="error">@_viewError</SimfAlert>
            }
            else if (_viewProfile is not null)
            {
                <dl class="simf-dl">
                    <dt>@L["Admin.Pending.View.Field.Email"]</dt>
                    <dd>@_viewProfile.Email</dd>
                    <dt>@L["Admin.Pending.View.Field.DisplayName"]</dt>
                    <dd>@_viewProfile.DisplayName</dd>
                    <dt>@L["Admin.Pending.View.Field.UserType"]</dt>
                    <dd>@ProfileTypeLabels.LocaliseUserType(_viewProfile.UserType)</dd>
                    <dt>@L["Admin.Pending.View.Field.ProfileType"]</dt>
                    <dd>@(_viewProfile.ProfileTypeName ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                    <dt>@L["Admin.Pending.View.Field.Created"]</dt>
                    <dd>@_viewProfile.CreatedAt.FormatSaudi("dd-MM-yyyy hh:mm tt")</dd>
                </dl>

                @if (HasProfileForm(_viewProfile))
                {
                    <dl class="simf-dl">
                        <dt>@L["Admin.Pending.View.Field.ArabicName"]</dt>
                        <dd>@(_viewProfile.ArabicName ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                        <dt>@L["Admin.Pending.View.Field.EnglishName"]</dt>
                        <dd>@(_viewProfile.EnglishName ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                        <dt>@L["Admin.Pending.View.Field.JobTitle"]</dt>
                        <dd>@(_viewProfile.JobTitle ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                        <dt>@L["Admin.Pending.View.Field.Gender"]</dt>
                        <dd>@GenderLabel(_viewProfile)</dd>
                        <dt>@L["Admin.Pending.View.Field.Organisation"]</dt>
                        <dd>@OrganisationLabel(_viewProfile)</dd>
                        <dt>@L["Admin.Pending.View.Field.Nationality"]</dt>
                        <dd>@(_viewProfile.NationalityCode ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                        <dt>@L["Admin.Pending.View.Field.DateOfBirth"]</dt>
                        <dd>@(_viewProfile.DateOfBirth?.ToString("dd-MM-yyyy")
                                ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                        <dt>@L["Admin.Pending.View.Field.PlaceOfBirth"]</dt>
                        <dd>@(_viewProfile.PlaceOfBirth ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                        <dt>@L["Admin.Pending.View.Field.IdentityType"]</dt>
                        <dd>@IdentityTypeLabel(_viewProfile)</dd>
                        <dt>@L["Admin.Pending.View.Field.IdentityNumber"]</dt>
                        <dd>@(IdentityNumber(_viewProfile) ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                        <dt>@L["Admin.Pending.View.Field.SaudiMobile"]</dt>
                        <dd>@(_viewProfile.SaudiMobile ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                        <dt>@L["Admin.Pending.View.Field.InternationalMobile"]</dt>
                        <dd>@(_viewProfile.InternationalMobile ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                        <dt>@L["Admin.Pending.View.Field.HasIdImage"]</dt>
                        <dd>@(_viewProfile.HasIdImage
                                ? L["Admin.Pending.View.Yes"]
                                : L["Admin.Pending.View.No"])</dd>
                        <dt>@L["Admin.Pending.View.Field.PlateNumber"]</dt>
                        <dd>@(_viewProfile.PlateNumber ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                        <dt>@L["Admin.Pending.View.Field.ReferenceNumber"]</dt>
                        <dd>@(_viewProfile.ReferenceNumber ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                        <dt>@L["Admin.Pending.View.Field.Interests"]</dt>
                        <dd>@InterestsLabel(_viewProfile)</dd>
                    </dl>
                    @if (_viewProfile.HasIdImage)
                    {
                        @* The thumbnail is a button that opens a
                           full-size lightbox; a download link sits beneath it.
                           _imageUrl is captured once in OpenViewAsync so the
                           cache-buster doesn't re-fetch on every render. *@
                        <div class="simf-walkin__id-image">
                            <h4>@L["Admin.Pending.View.Field.IdImage"]</h4>
                            <button type="button" class="simf-walkin__id-image-trigger"
                                    aria-label="@L["Admin.Pending.View.Image.ViewFull"]"
                                    @onclick="@(() => _imageZoomOpen = true)">
                                <img src="@_imageUrl"
                                     alt="@L["Admin.Pending.View.Field.IdImage"]" />
                            </button>
                            <div class="simf-walkin__id-image-actions">
                                <a href="@_imageUrl" class="simf-walkin__id-image-download"
                                   download="@($"visitor-{_viewProfile.Id}-photo")">
                                    @L["Admin.Pending.View.Image.Download"]
                                </a>
                            </div>
                        </div>
                    }
                    @* Profile photo (avatar), shown alongside the ID image;
                       clickable to a full-size lightbox + downloadable. *@
                    @if (_viewProfile.HasAvatar)
                    {
                        <div class="simf-walkin__id-image">
                            <h4>@L["Admin.Pending.View.Field.Photo"]</h4>
                            <button type="button" class="simf-walkin__id-image-trigger"
                                    aria-label="@L["Admin.Pending.View.Image.ViewFull"]"
                                    @onclick="@(() => _avatarZoomOpen = true)">
                                <img src="@_avatarUrl"
                                     alt="@L["Admin.Pending.View.Field.Photo"]" />
                            </button>
                            <div class="simf-walkin__id-image-actions">
                                <a href="@_avatarUrl" class="simf-walkin__id-image-download"
                                   download="@($"visitor-{_viewProfile.Id}-avatar")">
                                    @L["Admin.Pending.View.Image.Download"]
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <SimfAlert Variant="info">@L["Admin.Pending.View.Empty"]</SimfAlert>
                }

                @* Optional tier picker, approve mode only.
                   Lists the active audience-side (IsVisitor=true) profile
                   types; the blank first option keeps the current tier. *@
                @if (_approveMode)
                {
                    <div class="simf-field">
                        <label class="simf-field__label" for="approve-profile-type">
                            @L["Admin.Pending.ApproveReview.ProfileType"]
                        </label>
                        <div class="simf-field__control">
                            <select id="approve-profile-type" class="simf-field__input"
                                    value="@(_approveProfileTypeId?.ToString() ?? string.Empty)"
                                    @onchange="OnApproveProfileTypeChanged">
                                <option value="">@L["Admin.Pending.ApproveReview.ProfileType.Keep"]</option>
                                @foreach (var pt in _approveProfileTypes)
                                {
                                    <option value="@pt.Id">@ProfileTypeLabel(pt)</option>
                                }
                            </select>
                        </div>
                    </div>
                }
            }
        <div class="simf-form__actions">
            @if (_approveMode)
            {
                <SimfButton Type="button" Variant="secondary" OnClick="CloseView">
                    @L["Admin.Pending.ApproveReview.Cancel"]
                </SimfButton>
                @* The commit button of the modal this action opened. *@
                <AuthorizedAction Permission="@PermissionCatalog.Visitors.Approve">
                <SimfButton Type="button" Variant="primary"
                                Loading="_busy"
                                Disabled="@(_viewLoading || _viewProfile is null)"
                                OnClick="ConfirmApproveFromReviewAsync"
                                LoadingLabel="@L["Grid.Working"]">
                        @L["Admin.Pending.ApproveReview.Confirm"]
                    </SimfButton>
                </AuthorizedAction>
            }
            else
            {
                <SimfButton Type="button" Variant="secondary" OnClick="CloseView">
                    @L["Admin.Pending.View.Close"]
                </SimfButton>
            }
        </div>
    </CrudShell>
}

@* Full-size lightbox for the captured face photo. Renders the
   same image at natural size; download link repeated in the footer. *@
@if (_imageZoomOpen && _viewProfile is not null)
{
    <SimfModal Open="true"
               Title="@L["Admin.Pending.View.Field.IdImage"]"
               CloseLabel="@L["Admin.Pending.View.Close"]"
               OnClose="@(() => _imageZoomOpen = false)">
        <ChildContent>
            <div class="simf-walkin__id-image-full">
                <img src="@_imageUrl"
                     alt="@L["Admin.Pending.View.Field.IdImage"]" />
            </div>
        </ChildContent>
        <Footer>
            <a href="@_imageUrl" class="simf-walkin__id-image-download"
               download="@($"visitor-{_viewProfile.Id}-photo")">
                @L["Admin.Pending.View.Image.Download"]
            </a>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _imageZoomOpen = false)">
                @L["Admin.Pending.View.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@* Full-size lightbox for the profile photo (avatar). *@
@if (_avatarZoomOpen && _viewProfile is not null)
{
    <SimfModal Open="true"
               Title="@L["Admin.Pending.View.Field.Photo"]"
               CloseLabel="@L["Admin.Pending.View.Close"]"
               OnClose="@(() => _avatarZoomOpen = false)">
        <ChildContent>
            <div class="simf-walkin__id-image-full">
                <img src="@_avatarUrl"
                     alt="@L["Admin.Pending.View.Field.Photo"]" />
            </div>
        </ChildContent>
        <Footer>
            <a href="@_avatarUrl" class="simf-walkin__id-image-download"
               download="@($"visitor-{_viewProfile.Id}-avatar")">
                @L["Admin.Pending.View.Image.Download"]
            </a>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _avatarZoomOpen = false)">
                @L["Admin.Pending.View.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
