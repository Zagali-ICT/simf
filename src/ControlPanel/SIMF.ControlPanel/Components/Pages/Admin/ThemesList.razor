@* D-134 Sprint B â€” Themes CRUD. SIMF-FDS-004 Â§5.1. Centralized dialog/full-page
   framing D-353: Add / Edit / View / Delete are hosted by CrudShell, which frames
   the reusable ThemesAddEdit and ThemesViewDelete forms as a popup or a full page
   per the admin's toolbar choice (persisted in localStorage via CpPreferences). *@
@page "/admin/themes"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Themes.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject CpPreferences Prefs

<PageTitle>@L["Admin.Themes.Title"] Â· SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Themes.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminThemeSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Name)"
                          Caption="@L["Admin.Themes.Title"]"
                          FilterColumnLabel="@L["Admin.Themes.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          PrevLabel="@L["Admin.Themes.Prev"]"
                          NextLabel="@L["Admin.Themes.Next"]"
                          FirstLabel="@L["Admin.Themes.Pager.First"]"
                          LastLabel="@L["Admin.Themes.Pager.Last"]"
                          PageSizeLabel="@L["Admin.Themes.Pager.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Themes.Loading"]"
                          FilterPlaceholder="@L["Admin.Themes.FilterPlaceholder"]"
                          ActionsHeader="@L["Admin.Themes.Column.Actions"]"
                          SelectAllLabel="@L["Admin.Themes.Action.SelectAll"]"
                          SelectRowLabel="@L["Admin.Themes.Action.SelectRow"]"
                          AddLabel="@L["Admin.Themes.Action.Add"]"
                          EditLabel="@L["Admin.Themes.Action.Edit"]"
                          DetailsLabel="@L["Admin.Themes.Action.Details"]"
                          DeleteLabel="@L["Admin.Themes.Action.Deactivate"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminThemeSummary" Key="code"
                                        Header="@L["Admin.Themes.Column.Code"]"
                                        Sortable="true">
                        <CellTemplate>@context.Code</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminThemeSummary" Key="name"
                                        Header="@L["Admin.Themes.Column.Name"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Name</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminThemeSummary" Key="nameArabic"
                                        Header="@L["Admin.Themes.Column.NameArabic"]">
                        <CellTemplate>@context.NameArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminThemeSummary" Key="displayOrder"
                                        Header="@L["Admin.Themes.Column.DisplayOrder"]"
                                        Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminThemeSummary" Key="pageColor"
                                        Header="@L["Admin.Themes.Column.PageColor"]">
                        <CellTemplate>
                            <span class="simf-walkin__swatch"
                                  style="@($"--simf-walkin-card-color: {context.PageColor}")"
                                  aria-hidden="true"></span>
                            @context.PageColor
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminThemeSummary" Key="isActive"
                                        Header="@L["Admin.Themes.Column.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Admin.Themes.Active.Yes"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Admin.Themes.Active.No"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Themes.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Themes.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <ThemesAddEdit IsEdit="_isEdit" Initial="_target"
                           OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <ThemesViewDelete IsDelete="_isDelete" Initial="_target"
                              OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@code {
    private record Toast(string Variant, string Message);

    private enum FormKind { None, AddEdit, ViewDelete }

    private const string PageKey = "themes";

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminThemeSummary> _page = new();
    private bool _loading;
    private Toast? _toast;

    private CrudPresentation _presentation = CrudPresentation.Dialog;
    private FormKind _form = FormKind.None;
    private bool _isEdit;
    private bool _isDelete;
    private AdminThemeDetail? _target;

    private bool FormOpen => _form != FormKind.None;
    private bool GridHidden => FormOpen && _presentation == CrudPresentation.Page;

    private string FormTitle => _form switch
    {
        FormKind.AddEdit => _isEdit
            ? L["Admin.Themes.Edit.Title"]
            : L["Admin.Themes.Add.Title"],
        FormKind.ViewDelete => _isDelete
            ? L["Admin.Themes.Delete.Title"]
            : L["Admin.Themes.Details.Title"],
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _presentation = await Prefs.GetPresentationAsync(PageKey);
        await LoadAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<GridPage<AdminThemeSummary>>>(
                "simfAccount.postJson", "/account/api/admin/themes/list", _query);
            if (envelope is { Success: true, Data: not null })
            {
                _page = envelope.Data;
            }
            else
            {
                _toast = new Toast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Themes.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _toast = null;
        _form = FormKind.AddEdit;
        _isEdit = false;
        _target = null;
        return Task.CompletedTask;
    }

    private async Task OnEditAsync(AdminThemeSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.AddEdit;
        _isEdit = true;
        _target = detail;
    }

    private async Task OnDetailsAsync(AdminThemeSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = false;
        _target = detail;
    }

    private async Task OnDeleteAsync(AdminThemeSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = true;
        _target = detail;
    }

    // Edit / View / Delete all work against the full detail (the grid carries
    // a summary that omits the bilingual descriptions). Returns null and
    // surfaces a toast on failure.
    private async Task<AdminThemeDetail?> LoadDetailAsync(Guid id)
    {
        _toast = null;
        var envelope = await JS.InvokeAsync<ApiResult<AdminThemeDetail>>(
            "simfAccount.getJson", $"/account/api/admin/themes/{id}");
        if (envelope is { Success: true, Data: not null })
        {
            return envelope.Data;
        }
        _toast = new Toast("error",
            envelope?.Error?.MessageForCurrentCulture()
            ?? L["Admin.Themes.LoadFailed"]);
        return null;
    }

    private void CloseForm()
    {
        _form = FormKind.None;
        _target = null;
    }

    private async Task OnSavedAsync(AdminThemeDetail saved)
    {
        var wasEdit = _isEdit;
        CloseForm();
        _toast = new Toast("success",
            string.Format(wasEdit ? L["Admin.Themes.Updated"] : L["Admin.Themes.Created"], saved.Name));
        await LoadAsync();
    }

    private async Task OnDeletedAsync(AdminThemeDetail deleted)
    {
        CloseForm();
        _toast = new Toast("success",
            string.Format(L["Admin.Themes.Deactivated"], deleted.Name));
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Admin.Themes.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Admin.Themes.Pager.Page"], current, total);
}
