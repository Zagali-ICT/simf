@* D-353 — reusable venue-map node View/Delete form, hosted by CrudShell (popup
   or full page) from VenueMapList. Inherits CrudViewDeleteFormBase so it exposes
   the standard surface (IsDelete / Initial / OnDeleted / OnCancel). Read-only
   details always show; when IsDelete=true a Delete button appears and a
   SimfConfirm gates the soft-delete (replaces the old native JS confirm() on the
   list). Adds the View path the inline modal never had. Loads the Hall + Booth
   lists at mount so the optional links display their names, not raw ids. *@
@inherits CrudViewDeleteFormBase<AdminVenueMapNodeDetail>
@using SIMF.Contracts.Admin
@using SIMF.Contracts.Exhibition

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.VenueMap.Field.Label"]</dt>
        <dd>@Initial.Label</dd>
        <dt>@L["Admin.VenueMap.Field.LabelArabic"]</dt>
        <dd>@Initial.LabelArabic</dd>
        <dt>@L["Admin.VenueMap.Col.Kind"]</dt>
        <dd>@Initial.Kind</dd>
        <dt>@L["Admin.VenueMap.Col.Position"]</dt>
        <dd>@Initial.X.ToString("0.#"), @Initial.Y.ToString("0.#")</dd>
        <dt>@L["Admin.VenueMap.Col.Hall"]</dt>
        <dd>@HallName</dd>
        <dt>@L["Admin.VenueMap.Col.Booth"]</dt>
        <dd>@BoothName</dd>
        <dt>@L["Admin.VenueMap.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.VenueMap.Delete"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.VenueMap.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.VenueMap.Delete.Title"]"
                 Message="@string.Format(L["Admin.VenueMap.Delete.Message"], Initial.Label)"
                 ConfirmLabel="@L["Admin.VenueMap.Delete"]"
                 CancelLabel="@L["Admin.VenueMap.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" />
}
