@* Control Panel — Visitor profile types CRUD (D-118; consumer of D-115).
   Lookup-table CRUD scoped to UserType=Visitor. Mirrors the canonical D-117
   pattern: SimfBanner page-top, SimfDataGrid with full toolbar + numbered
   pager, modal-based Add / Edit / Details / Delete. *@
@page "/admin/profile-types/visitor"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.ProfileTypes.View)]

<PageTitle>@L["Admin.ProfileTypes.Visitor.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.ProfileTypes.Visitor.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        <SimfDataGrid TItem="AdminProfileTypeSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(row => row.Id.ToString())"
                      RowLabel="@(row => row.Name)"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      Caption="@L["Admin.ProfileTypes.Visitor.Title"]"
                      FilterColumnLabel="@L["Admin.Users.FilterColumn"]"
                      OnAdd="OnAddAsync"
                      OnEditOne="OnEditAsync"
                      OnDetailsOne="OnDetailsAsync"
                      OnDeleteOne="OnDeleteAsync"
                      PrevLabel="@L["Admin.Users.Prev"]"
                      NextLabel="@L["Admin.Users.Next"]"
                      FirstLabel="@L["Admin.Users.Pager.First"]"
                      LastLabel="@L["Admin.Users.Pager.Last"]"
                      PageSizeLabel="@L["Admin.Users.Pager.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.Users.Loading"]"
                      FilterPlaceholder="@L["Admin.Users.FilterPlaceholder"]"
                      ActionsHeader="@L["Admin.ProfileTypes.Column.Actions"]"
                      AddLabel="@L["Admin.ProfileTypes.Add.Title"]"
                      EditLabel="@L["Admin.ProfileTypes.Edit.Title"]"
                      DetailsLabel="@L["Admin.Users.Action.Details"]"
                      DeleteLabel="@L["Admin.ProfileTypes.Delete.Title"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminProfileTypeSummary" Key="userType"
                                    Header="@L["Admin.ProfileTypes.Column.UserType"]">
                    <CellTemplate>@ProfileTypeLabels.LocaliseUserType(context.UserType)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminProfileTypeSummary" Key="name"
                                    Header="@L["Admin.ProfileTypes.Column.Name"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Name</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminProfileTypeSummary" Key="nameArabic"
                                    Header="@L["Admin.ProfileTypes.Column.NameArabic"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.NameArabic</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminProfileTypeSummary" Key="pageColor"
                                    Header="@L["Admin.ProfileTypes.Column.PageColor"]">
                    <CellTemplate>@context.PageColor</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminProfileTypeSummary" Key="isActive"
                                    Header="@L["Admin.ProfileTypes.Column.Active"]">
                    <CellTemplate>
                        @if (context.IsActive)
                        {
                            <SimfPill Variant="on">@L["Admin.ProfileTypes.Active.Yes"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Admin.ProfileTypes.Active.No"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.ProfileTypes.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_toast is not null)
{
    <div class="simf-toast">
        <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
    </div>
}

@if (_addOpen)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.ProfileTypes.Add.Title"]" OnClose="@(() => _addOpen = false)" CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            @* D-186: audience-side form — IsPartnerForm=false sends
               IsVisitor=true on Create. *@
            <ProfileTypeForm IsPartnerForm="false"
                             OnSuccess="OnSavedAsync"
                             OnCancel="@(() => _addOpen = false)" />
        </ChildContent>
    </SimfModal>
}

@if (_editTarget is not null)
{
    <SimfModal Open="true"
               RequireExplicitClose="true"
               Title="@string.Format(L["Admin.ProfileTypes.Edit.TitleFor"], _editTarget.Name)"
               OnClose="@(() => _editTarget = null)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <ProfileTypeForm Initial="_editTarget"
                             OnSuccess="OnSavedAsync"
                             OnCancel="@(() => _editTarget = null)" />
        </ChildContent>
    </SimfModal>
}

@if (_detailsTarget is not null)
{
    <SimfModal Open="true"
               Title="@string.Format(L["Admin.ProfileTypes.Details.Title"], _detailsTarget.Name)"
               OnClose="@(() => _detailsTarget = null)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <dl class="simf-dl">
                <dt>@L["Admin.ProfileTypes.Field.UserType"]</dt>
                <dd>@ProfileTypeLabels.LocaliseUserType(_detailsTarget.UserType)</dd>
                <dt>@L["Admin.ProfileTypes.Field.Name"]</dt>
                <dd>@_detailsTarget.Name</dd>
                <dt>@L["Admin.ProfileTypes.Field.NameArabic"]</dt>
                <dd>@_detailsTarget.NameArabic</dd>
                <dt>@L["Admin.ProfileTypes.Field.PageColor"]</dt>
                <dd>@_detailsTarget.PageColor</dd>
                <dt>@L["Admin.ProfileTypes.Field.IsActive"]</dt>
                <dd>
                    @(_detailsTarget.IsActive
                        ? L["Admin.ProfileTypes.Active.Yes"]
                        : L["Admin.ProfileTypes.Active.No"])
                </dd>
            </dl>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="@(() => _detailsTarget = null)">
                @L["Admin.ProfileTypes.Details.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_deleteTarget is not null)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.ProfileTypes.Delete.Title"]" OnClose="@(() => _deleteTarget = null)" CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <p>@string.Format(L["Admin.ProfileTypes.Delete.Confirm"], _deleteTarget.Name)</p>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _deleteTarget = null)">
                @L["Admin.ProfileTypes.Delete.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="primary"
                        Loading="_busy"
                        OnClick="ConfirmDeleteAsync"
                        LoadingLabel="@L["Grid.Working"]">
                @L["Admin.ProfileTypes.Delete.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
