@* Reusable ProfileType form. Hosted inside the Add modal and the
   Edit modal on the VisitorProfileTypesList / OtherProfileTypesList pages.
   The UserType field is shown read-only: the host page decides whether it
   reads audience or partner, and create always sends UserType=Visitor with
   the audience/partner split carried on IsVisitor. Edit cannot change it
   (the backend rejects it — UserType never appears in the PUT body). *@

@if (_success is not null)
{
    <SimfAlert Variant="success">@_success</SimfAlert>
}
@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        @* Display the UserType so the admin sees which account-type
           this profile-type belongs to. Edit mode is read-only because the
           backend rejects UserType changes (the field never appears in the
           PUT body); Create mode shows the UserType the host page passed in
           so an admin opening "Add" on the Visitor page can confirm. *@
        <div class="simf-field">
            <div class="simf-field__label">@L["Admin.ProfileTypes.Field.UserType"]</div>
            <div class="simf-field__value">@LocalisedUserType</div>
            @if (_isEdit)
            {
                <div class="simf-field__helper">@L["Admin.ProfileTypes.UserType.Hint"]</div>
            }
        </div>
        <SimfTextField Label="@L["Admin.ProfileTypes.Field.Name"]"
                       Helper="@L["Admin.ProfileTypes.Field.NameHint"]"
                       @bind-Value="_model.Name" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ProfileTypes.Field.NameArabic"]"
                       Helper="@L["Admin.ProfileTypes.Field.NameArabicHint"]"
                       @bind-Value="_model.NameArabic" Disabled="_busy" />
        @* PageColor pairs a text input (CSS variable / 3-digit hex friendly)
           with a native colour swatch. The text field stays the source of truth;
           the swatch only writes #rrggbb back into it. *@
        <div class="simf-field">
            <label class="simf-field__label" for="profile-type-page-color">@L["Admin.ProfileTypes.Field.PageColor"]</label>
            <div class="simf-field__control simf-field__control--with-swatch">
                <input id="profile-type-page-color" class="simf-field__input" type="text"
                       value="@_model.PageColor"
                       @oninput="OnPageColorTextInput"
                       disabled="@(_busy ? "disabled" : null)"
                       aria-describedby="profile-type-page-color-hint" />
                <input class="simf-field__color-swatch" type="color"
                       value="@PageColorAsHex"
                       @oninput="OnPageColorSwatchInput"
                       disabled="@(_busy ? "disabled" : null)"
                       aria-label="@L["Admin.ProfileTypes.Field.PageColorPicker"]" />
            </div>
            <div class="simf-field__helper" id="profile-type-page-color-hint">@L["Admin.ProfileTypes.Field.PageColorHint"]</div>
        </div>
        @* MobileAppRole picker. Only renders for partner profile types
           (IsVisitor=false): Visitor profile-types resolve to
           MobileAppRole.Visitor at JWT issue time regardless of this column,
           so the field is irrelevant on the Visitor list. *@
        @if (ShowMobileAppRolePicker)
        {
            <SimfSelect TValue="string"
                        Label="@L["Admin.ProfileTypes.Field.MobileAppRole"]"
                        Helper="@L["Admin.ProfileTypes.Field.MobileAppRoleHint"]"
                        Items="@MobileAppRoleOptions"
                        ValueFor="@(role => role)"
                        LabelFor="@(role => L[$"Admin.ProfileTypes.MobileAppRole.{role}"])"
                        Value="@_model.MobileAppRole"
                        ValueChanged="OnMobileAppRoleChanged"
                        Disabled="_busy" />
        }
        <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
            @L["Admin.ProfileTypes.Field.IsActive"]
        </SimfCheckbox>
        @* App sign-up picker visibility. Unchecked = a CP-only
           (admin-assigned) type, hidden from the mobile registration picker
           (e.g. Staff / Moderator). CP admin listings always show it. *@
        <SimfCheckbox @bind-Value="_model.IsAppRegisterable" Disabled="_busy">
            @L["Admin.ProfileTypes.Field.ShowInApp"]
        </SimfCheckbox>
        <div class="simf-field__helper">@L["Admin.ProfileTypes.Field.ShowInAppHint"]</div>
        @* "Meet People (same interests)" visibility.
           Only on the Others (partner) form: unchecked hides ALL accounts of
           this partner type from the networking directory + recommender,
           regardless of each user's own opt-in. *@
        @if (ShowPartnerDirectoryToggle)
        {
            <SimfCheckbox @bind-Value="_model.ShowInPartnerDirectory" Disabled="_busy">
                @L["Admin.ProfileTypes.Field.ShowInMeetPeople"]
            </SimfCheckbox>
            <div class="simf-field__helper">@L["Admin.ProfileTypes.Field.ShowInMeetPeopleHint"]</div>
        }
        @* VIP audience tier. Only on the Visitors (audience) form: ticked marks
           the type as VIP, which is what lets its holders self-reserve a
           VIP-tier SEAT and what the app reads as isVip. It does NOT grant a
           meeting — that is the per-user flag on the account itself. *@
        @if (ShowVipTierToggle)
        {
            <SimfCheckbox @bind-Value="_model.IsVipTier" Disabled="_busy">
                @L["Admin.ProfileTypes.Field.IsVipTier"]
            </SimfCheckbox>
            <div class="simf-field__helper">@L["Admin.ProfileTypes.Field.IsVipTierHint"]</div>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.ProfileTypes.Submitting"]">
            @SubmitLabel
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy"
                        OnClick="OnCancel">
                @L["Admin.ProfileTypes.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
