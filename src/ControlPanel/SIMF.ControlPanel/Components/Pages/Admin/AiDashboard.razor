@* CP Phase-1 — the AI Control Center landing dashboard. Read-only: a top-line of
   invocation-health tiles (calls / error rate / avg latency / tokens / active
   services) over the last 24h plus a per-service breakdown. Every value is an
   on-demand aggregate from GET /admin/ai/dashboard (one query, no new schema).
   Gated by AiDashboard.View — the same permission that gates that endpoint. *@
@page "/admin/ai"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.AiDashboard.View)]

<PageTitle>@L["Admin.AiDashboard.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.AiDashboard.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        @if (_loading && _dashboard is null)
        {
            <p>@L["Admin.AiDashboard.Loading"]</p>
        }
        else if (_dashboard is not null)
        {
            <p class="simf-field__helper">@L["Admin.AiDashboard.Window"]</p>

            @* Top-line health tiles — same stat-card layout as the other dashboards. *@
            <div class="simf-form__actions">
                <SimfStatCard Title="@L["Admin.AiDashboard.Calls"]"
                              Value="@_dashboard.TotalCalls.ToString("N0")" />
                <SimfStatCard Title="@L["Admin.AiDashboard.ErrorRate"]"
                              Value="@AiEnumOptions.Pct(_dashboard.ErrorRate)" />
                <SimfStatCard Title="@L["Admin.AiDashboard.Latency"]"
                              Value="@($"{_dashboard.AvgLatencyMs} ms")" />
                <SimfStatCard Title="@L["Admin.AiDashboard.Tokens"]"
                              Value="@_dashboard.TotalTokens.ToString("N0")" />
                <SimfStatCard Title="@L["Admin.AiDashboard.Services"]"
                              Value="@($"{_dashboard.ActiveServices} / {_dashboard.TotalServices}")" />
            </div>

            @if (_dashboard.Services.Count == 0)
            {
                <SimfEmptyState Title="@L["Admin.AiDashboard.NoActivity"]" />
            }
            else
            {
                @* Fixed ≤8-row enum summary (one row per AiFeature) — NOT a CRUD list
                   page, so SimfDataGrid is intentionally not used (no paging / filter /
                   sort / row actions). Mirrors AttendanceDashboard's split: a grid for
                   the unbounded server-paged breakdown, plain markup for a small fixed
                   summary. (Carve-out from the "never a raw table" list-page standard.) *@
                <table class="simf-table">
                    <thead>
                        <tr>
                            <th>@L["Admin.AiDashboard.Col.Service"]</th>
                            <th>@L["Admin.AiDashboard.Calls"]</th>
                            <th>@L["Admin.AiDashboard.Col.Errors"]</th>
                            <th>@L["Admin.AiDashboard.Latency"]</th>
                            <th>@L["Admin.AiDashboard.Tokens"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _dashboard.Services)
                        {
                            <tr>
                                <td>@s.Feature</td>
                                <td>@s.Calls.ToString("N0")</td>
                                <td>@s.ErrorCount (@AiEnumOptions.Pct(s.ErrorRate))</td>
                                <td>@(s.AvgLatencyMs) ms</td>
                                <td>@s.TotalTokens.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>
