@* P4.1 — D-238 (Completion Programme §6.4.1, Mockup screen 34): the Scientific-
   Committee AI session-summary / محضر desk. Lists every active session with its
   summary state; AI-draft (generate) or hand-write (edit), then publish for the
   app to read. Gated by SessionSummaries.* . *@
@page "/admin/session-summaries"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.SessionSummaries.View)]

<PageTitle>@L["Admin.SessionSummaries.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.SessionSummaries.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminSessionSummaryRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      RowKey="@(r => r.SessionId.ToString())"
                      Caption="@L["Admin.SessionSummaries.Title"]"
                      OnExport="OnExportAsync"
                      ExportLabel="@L["Grid.Export"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.SessionSummaries.Loading"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminSessionSummaryRow" Key="session"
                                    Header="@L["Admin.SessionSummaries.Col.Session"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.SessionTitle</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSessionSummaryRow" Key="status"
                                    Header="@L["Admin.SessionSummaries.Col.Status"]">
                    <CellTemplate>
                        @if (!context.HasSummary)
                        {
                            <SimfPill Variant="off">@L["Admin.SessionSummaries.Status.None"]</SimfPill>
                        }
                        else
                        {
                            @* D-472 — the review state (Draft / In review / Approved =
                               ready for المحاور), plus a Published pill for the public read. *@
                            @if (context.IsApproved)
                            {
                                <SimfPill Variant="on">@L["Admin.SessionSummaries.Status.Approved"]</SimfPill>
                            }
                            else if (context.IsInReview)
                            {
                                <SimfPill Variant="warn">@L["Admin.SessionSummaries.Status.InReview"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="warn">@L["Admin.SessionSummaries.Status.Draft"]</SimfPill>
                            }
                            @if (context.IsPublished)
                            {
                                <SimfPill Variant="on">@L["Admin.SessionSummaries.Status.Published"]</SimfPill>
                            }
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminSessionSummaryRow" Key="source"
                                    Header="@L["Admin.SessionSummaries.Col.Source"]">
                    <CellTemplate>@SourceLabel(context)</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @* Page-specific quiet actions: AI-generate / edit / publish-toggle. *@
                <AuthorizedAction Permission="@PermissionCatalog.SessionSummaries.Edit">
                    <SimfToolbarButton Icon="sparkle" Title="@L["Admin.SessionSummaries.Action.Generate"]"
                                       Disabled="_busy" OnClick="@(() => GenerateAsync(context.SessionId))" />
                    @if (context.HasSummary)
                    {
                        <SimfToolbarButton Icon="edit" Title="@L["Admin.SessionSummaries.Action.Edit"]"
                                           Disabled="_busy" OnClick="@(() => OpenEditorAsync(context.SessionId))" />
                        @* D-472 — submit the draft for the team's approval. *@
                        @if (!context.IsInReview && !context.IsApproved)
                        {
                            <SimfToolbarButton Icon="send" Title="@L["Admin.SessionSummaries.Action.SubmitReview"]"
                                               Disabled="_busy" OnClick="@(() => SubmitReviewAsync(context.SessionId))" />
                        }
                    }
                </AuthorizedAction>
                @if (context.HasSummary)
                {
                    @* D-472 — approve a submitted summary / send it back to draft. *@
                    <AuthorizedAction Permission="@PermissionCatalog.SessionSummaries.Approve">
                        @if (context.IsInReview)
                        {
                            <SimfToolbarButton Icon="check-circle" Title="@L["Admin.SessionSummaries.Action.Approve"]"
                                               Disabled="_busy" OnClick="@(() => ApproveSummaryAsync(context.SessionId))" />
                        }
                        @if (context.IsInReview || context.IsApproved)
                        {
                            <SimfToolbarButton Icon="reply" Title="@L["Admin.SessionSummaries.Action.ReturnToDraft"]"
                                               Disabled="_busy" OnClick="@(() => ReturnToDraftAsync(context.SessionId))" />
                        }
                    </AuthorizedAction>
                    <AuthorizedAction Permission="@PermissionCatalog.SessionSummaries.Publish">
                        @if (context.IsPublished)
                        {
                            <SimfToolbarButton Icon="power" Title="@L["Admin.SessionSummaries.Action.Unpublish"]"
                                               Disabled="_busy" OnClick="@(() => SetPublishedAsync(context.SessionId, false))" />
                        }
                        else
                        {
                            @* Owner 2026-07-19 — Publish is only allowed once the team has
                               approved the summary; keep the button visible but disabled with
                               an explanatory tooltip so the reviewer knows what unblocks it. *@
                            <SimfToolbarButton Icon="power"
                                               Title="@(context.IsApproved ? L["Admin.SessionSummaries.Action.Publish"] : L["Admin.SessionSummaries.Action.PublishNeedsApproval"])"
                                               Disabled="_busy || !context.IsApproved" OnClick="@(() => SetPublishedAsync(context.SessionId, true))" />
                        }
                    </AuthorizedAction>
                }
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.SessionSummaries.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_edit is not null)
{
    <SimfModal Open="true" Title="@_editTitle" OnClose="CloseEditor">
        <ChildContent>
            @if (_editAiModel is not null)
            {
                <SimfAlert Variant="info">@L["Admin.SessionSummaries.AiBanner"]</SimfAlert>
            }
            @* Slice D (2026-07-19) — AI-transparency read-only sources: the raw
               subtitle the AI drafted from and the pristine AI draft captured at
               generation (immutable across edits). Each renders only when present,
               so a hand-written summary shows none of them. *@
            @if (_editSubtitle.Length > 0)
            {
                <SimfTextarea Label="@L["Admin.SessionSummaries.Field.Subtitle"]" Rows="4"
                              Value="@_editSubtitle" Disabled="true" />
            }
            @if (_editSubtitleArabic.Length > 0)
            {
                <SimfTextarea Label="@L["Admin.SessionSummaries.Field.SubtitleArabic"]" Rows="4"
                              Value="@_editSubtitleArabic" Disabled="true" />
            }
            @if (_editAiDraftArabic.Length > 0)
            {
                <SimfTextarea Label="@AiDraftLabel" Rows="5"
                              Value="@_editAiDraftArabic" Disabled="true" />
            }
            <SimfTextarea Label="@L["Admin.SessionSummaries.Field.KeyPoints"]" Rows="3" MaxLength="4000"
                          @bind-Value="_edit.KeyPoints" Disabled="_busy" />
            <SimfTextarea Label="@L["Admin.SessionSummaries.Field.KeyPointsArabic"]" Rows="3" MaxLength="4000"
                          @bind-Value="_edit.KeyPointsArabic" Disabled="_busy" />
            <SimfTextarea Label="@L["Admin.SessionSummaries.Field.Recommendations"]" Rows="3" MaxLength="4000"
                          @bind-Value="_edit.Recommendations" Disabled="_busy" />
            <SimfTextarea Label="@L["Admin.SessionSummaries.Field.RecommendationsArabic"]" Rows="3" MaxLength="4000"
                          @bind-Value="_edit.RecommendationsArabic" Disabled="_busy" />
            <SimfTextarea Label="@L["Admin.SessionSummaries.Field.Speakers"]" Rows="2" MaxLength="1000"
                          @bind-Value="_edit.Speakers" Disabled="_busy" />
            <SimfTextarea Label="@L["Admin.SessionSummaries.Field.SpeakersArabic"]" Rows="2" MaxLength="1000"
                          @bind-Value="_edit.SpeakersArabic" Disabled="_busy" />
            <SimfTextarea Label="@L["Admin.SessionSummaries.Field.FullText"]" Rows="5" MaxLength="8000"
                          @bind-Value="_edit.FullText" Disabled="_busy" />
            <SimfTextarea Label="@L["Admin.SessionSummaries.Field.FullTextArabic"]" Rows="5" MaxLength="8000"
                          @bind-Value="_edit.FullTextArabic" Disabled="_busy" />
            @* Item #35 (2026-07-20) — the OPTIONAL team summary-video URL: the app's
               second player on screen 34, beside the full live recording. A YouTube
               or direct HLS/MP4 link; the server validates it with the same
               LiveStreamUrlPolicy as the session's live feed. *@
            <SimfTextField Label="@L["Admin.SessionSummaries.Field.SummaryVideoUrl"]"
                           Helper="@L["Admin.SessionSummaries.Field.SummaryVideoUrlHint"]"
                           MaxLength="1024"
                           @bind-Value="_edit.SummaryVideoUrl" Disabled="_busy" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Loading="_busy" OnClick="SaveAsync">
                @L["Admin.SessionSummaries.Editor.Save"]
            </SimfButton>
            <SimfButton Type="button" Variant="secondary" OnClick="CloseEditor">
                @L["Admin.SessionSummaries.Editor.Cancel"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
