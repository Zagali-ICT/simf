@* D-353 — reusable Banner View/Delete form, hosted by CrudShell (popup or
   full page) from BannersList. Inherits CrudViewDeleteFormBase so it exposes
   the standard surface (IsDelete / Initial / OnDeleted / OnCancel). Read-only
   details always show (including a preview of the optional image asset); when
   IsDelete=true a Deactivate button appears and a SimfConfirm gates the
   soft-delete (was a one-click delete on the list). Adds the View path the
   inline form never had. *@
@inherits CrudViewDeleteFormBase<AdminBannerDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.Banners.Field.TitleEn"]</dt>
        <dd>@Initial.Title</dd>
        <dt>@L["Admin.Banners.Field.TitleAr"]</dt>
        <dd>@Initial.TitleArabic</dd>
        <dt>@L["Admin.Banners.Field.BodyEn"]</dt>
        <dd>@Initial.Body</dd>
        <dt>@L["Admin.Banners.Field.BodyAr"]</dt>
        <dd>@Initial.BodyArabic</dd>
        <dt>@L["Admin.Banners.Field.ImageUrl"]</dt>
        <dd>
            @if (string.IsNullOrWhiteSpace(Initial.ImageUrl))
            {
                <span>—</span>
            }
            else
            {
                <img class="simf-dl__image" src="@Initial.ImageUrl" alt="@Initial.Title" />
            }
        </dd>
        <dt>@L["Admin.Banners.Field.LinkUrl"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.LinkUrl) ? "—" : Initial.LinkUrl)</dd>
        <dt>@L["Admin.Banners.Field.Start"]</dt>
        <dd>@Initial.Start.FormatSaudi("dd-MM-yyyy hh:mm tt")</dd>
        <dt>@L["Admin.Banners.Field.End"]</dt>
        <dd>@Initial.End.FormatSaudi("dd-MM-yyyy hh:mm tt")</dd>
        <dt>@L["Admin.Banners.Col.DisplayOrder"]</dt>
        <dd>@Initial.DisplayOrder</dd>
        <dt>@L["Admin.Banners.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.Banners.Action.Deactivate"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Banners.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.Banners.Delete.Title"]"
                 Message="@string.Format(L["Admin.Banners.Delete.Message"], TitleLabel(Initial))"
                 ConfirmLabel="@L["Admin.Banners.Action.Deactivate"]"
                 CancelLabel="@L["Admin.Banners.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" />
}
