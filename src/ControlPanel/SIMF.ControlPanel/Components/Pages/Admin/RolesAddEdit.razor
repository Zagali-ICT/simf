@* D-353 â€” reusable Role Add/Edit form, hosted by CrudShell (popup or full
   page) from RolesList. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel).
   IsEdit=false runs Create (POST); IsEdit=true runs Edit (PUT against
   Initial). Baseline roles cannot be renamed â€” in Edit mode against a
   built-in role the form shows the read-only notice instead of the field.
   Supersedes RoleForm.razor (D-134), which keyed off Initial==null. *@
@inherits CrudAddEditFormBase<AdminRoleSummary>
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (IsEdit && Initial is { IsBaseline: true })
{
    @* Built-in roles are seeded; their name is fixed (mirrors the old
       RolesList edit-modal baseline notice). *@
    <SimfAlert Variant="info">@L["Admin.Roles.Edit.BaselineNotice"]</SimfAlert>
    <div class="simf-form__actions">
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" OnClick="OnCancel">
                @L["Admin.Roles.Edit.Close"]
            </SimfButton>
        }
    </div>
}
else
{
    <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
        <div class="simf-form__fields">
            <SimfTextField Label="@L["Admin.Roles.Field.Name"]"
                           Helper="@L["Admin.Roles.Field.NameHint"]"
                           MaxLength="64"
                           @bind-Value="_model.Name" Disabled="_busy" />
        </div>
        <div class="simf-form__actions">
            <SimfButton Loading="_busy"
                        LoadingLabel="@(IsEdit ? L["Admin.Roles.Edit.Submitting"] : L["Admin.Roles.New.Submitting"])">
                @(IsEdit ? L["Admin.Roles.Edit.Submit"] : L["Admin.Roles.New.Submit"])
            </SimfButton>
            @if (OnCancel.HasDelegate)
            {
                <SimfButton Type="button" Variant="secondary"
                            Disabled="_busy" OnClick="OnCancel">
                    @L["Admin.Roles.Cancel"]
                </SimfButton>
            }
        </div>
    </EditForm>
}

@code {
    private readonly Model _model = new();
    private EditContext _editContext = default!;
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Initial is not null)
        {
            _model.Name = Initial.Name;
        }
        _editContext = new EditContext(_model);
    }

    private async Task HandleSubmitAsync()
    {
        if (_busy) return;
        _error = null;

        var name = (_model.Name ?? string.Empty).Trim();
        if (name.Length is < 1 or > 64)
        {
            _error = L["Admin.Roles.Field.NameInvalid"]; return;
        }

        _busy = true;
        try
        {
            ApiResult<AdminRoleSummary>? envelope;
            if (!IsEdit)
            {
                envelope = await JS.InvokeAsync<ApiResult<AdminRoleSummary>>(
                    "simfAccount.postJson", "/account/api/admin/roles",
                    new AdminCreateRoleRequest { Name = name });
            }
            else
            {
                envelope = await JS.InvokeAsync<ApiResult<AdminRoleSummary>>(
                    "simfAccount.putJson", $"/account/api/admin/roles/{Initial!.Id}",
                    new AdminUpdateRoleRequest { Name = name });
            }

            if (envelope is { Success: true, Data: not null })
            {
                await OnSuccess.InvokeAsync(envelope.Data);
            }
            else
            {
                _error = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Roles.Fallback"];
            }
        }
        catch (Exception)
        {
            _error = L["Admin.Roles.Fallback"];
        }
        finally { _busy = false; }
    }

    private sealed class Model
    {
        public string Name { get; set; } = string.Empty;
    }
}
