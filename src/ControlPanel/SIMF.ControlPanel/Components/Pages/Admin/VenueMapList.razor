@* P2.5 (D-230) — 2D venue-map editor (SIMF-FDS-006 §5.3, FR-605). Place nodes
   (a label + a 2D position + an optional Hall/Booth link). The app renders the
   nodes on its 2D canvas. Ships empty; the Logistics team places the nodes.
   Centralized dialog/full-page framing D-353: Add / Edit / View / Delete are
   hosted by CrudShell, which frames the reusable VenueMapAddEdit and
   VenueMapViewDelete forms as a popup or a full page per the admin's toolbar
   choice (persisted in localStorage via CpPreferences). The inline SimfModal
   form + native confirm() delete it used to carry are gone. D-356: Excel
   export/import wired through CrudGridExcel. *@
@page "/admin/venue-map"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.VenueMap.View)]
@using SIMF.Common.Enums
@using SIMF.Contracts.Admin

<PageTitle>@L["Admin.VenueMap.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.VenueMap.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminVenueMapNodeSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Label)"
                          Caption="@L["Admin.VenueMap.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.VenueMap.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminVenueMapNodeSummary" Key="label"
                                        Header="@L["Admin.VenueMap.Col.Label"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Label</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminVenueMapNodeSummary" Key="kind"
                                        Header="@L["Admin.VenueMap.Col.Kind"]"
                                        Sortable="true">
                        <CellTemplate>@context.Kind</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminVenueMapNodeSummary" Key="position"
                                        Header="@L["Admin.VenueMap.Col.Position"]">
                        <CellTemplate>@context.X.ToString("0.#"), @context.Y.ToString("0.#")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminVenueMapNodeSummary" Key="isActive"
                                        Header="@L["Admin.VenueMap.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.VenueMap.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="venue-map"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.VenueMap.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <VenueMapAddEdit IsEdit="_isEdit" Initial="_target"
                             OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <VenueMapViewDelete IsDelete="_isDelete" Initial="_target"
                                OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
