@* P2.5 (D-230) — 2D venue-map editor (SIMF-FDS-006 §5.3, FR-605). Place nodes
   (a label + a 2D position + an optional Hall/Booth link). The app renders the
   nodes on its 2D canvas. Ships empty; the Logistics team places the nodes.
   Centralized dialog/full-page framing D-353: Add / Edit / View / Delete are
   hosted by CrudShell, which frames the reusable VenueMapAddEdit and
   VenueMapViewDelete forms as a popup or a full page per the admin's toolbar
   choice (persisted in localStorage via CpPreferences). The inline SimfModal
   form + native confirm() delete it used to carry are gone. D-356: Excel
   export/import wired through CrudGridExcel. *@
@page "/admin/venue-map"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.VenueMap.View)]
@using SIMF.Common.Enums
@using SIMF.Contracts.Admin
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject CpPreferences Prefs

<PageTitle>@L["Admin.VenueMap.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.VenueMap.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminVenueMapNodeSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Label)"
                          Caption="@L["Admin.VenueMap.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.VenueMap.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminVenueMapNodeSummary" Key="label"
                                        Header="@L["Admin.VenueMap.Col.Label"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Label</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminVenueMapNodeSummary" Key="kind"
                                        Header="@L["Admin.VenueMap.Col.Kind"]"
                                        Sortable="true">
                        <CellTemplate>@context.Kind</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminVenueMapNodeSummary" Key="position"
                                        Header="@L["Admin.VenueMap.Col.Position"]">
                        <CellTemplate>@context.X.ToString("0.#"), @context.Y.ToString("0.#")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminVenueMapNodeSummary" Key="isActive"
                                        Header="@L["Admin.VenueMap.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.VenueMap.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="venue-map"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.VenueMap.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <VenueMapAddEdit IsEdit="_isEdit" Initial="_target"
                             OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <VenueMapViewDelete IsDelete="_isDelete" Initial="_target"
                                OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@code {
    private record Toast(string Variant, string Message);

    private enum FormKind { None, AddEdit, ViewDelete }

    private const string PageKey = "venue-map";

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminVenueMapNodeSummary> _page = new();
    private bool _loading;
    private Toast? _toast;

    private CrudPresentation _presentation = CrudPresentation.Dialog;
    private FormKind _form = FormKind.None;
    private bool _isEdit;
    private bool _isDelete;
    private AdminVenueMapNodeDetail? _target;
    private CrudGridExcel? _excel;

    private bool FormOpen => _form != FormKind.None;
    private bool GridHidden => FormOpen && _presentation == CrudPresentation.Page;

    private string FormTitle => _form switch
    {
        FormKind.AddEdit => _isEdit
            ? L["Admin.VenueMap.Edit.Title"]
            : L["Admin.VenueMap.Add.Title"],
        FormKind.ViewDelete => _isDelete
            ? L["Admin.VenueMap.Delete.Title"]
            : L["Admin.VenueMap.Details.Title"],
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _presentation = await Prefs.GetPresentationAsync(PageKey);
        await LoadAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminVenueMapNodeSummary>>>(
                "simfAccount.postJson",
                "/account/api/admin/venue-map/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.VenueMap.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _toast = null;
        _form = FormKind.AddEdit;
        _isEdit = false;
        _target = null;
        return Task.CompletedTask;
    }

    private async Task OnEditAsync(AdminVenueMapNodeSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.AddEdit;
        _isEdit = true;
        _target = detail;
    }

    private async Task OnDetailsAsync(AdminVenueMapNodeSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = false;
        _target = detail;
    }

    private async Task OnDeleteAsync(AdminVenueMapNodeSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = true;
        _target = detail;
    }

    // Edit / View / Delete all work against the full detail — the forms re-bind
    // every field, so editing from a summary-only model would be lossy. Returns
    // null and surfaces a toast on failure.
    private async Task<AdminVenueMapNodeDetail?> LoadDetailAsync(Guid id)
    {
        _toast = null;
        var env = await JS.InvokeAsync<ApiResult<AdminVenueMapNodeDetail>>(
            "simfAccount.getJson", $"/account/api/admin/venue-map/{id}");
        if (env is { Success: true, Data: not null })
        {
            return env.Data;
        }
        _toast = new Toast("error",
            env?.Error?.MessageForCurrentCulture()
            ?? L["Admin.VenueMap.LoadFailed"]);
        return null;
    }

    private void CloseForm()
    {
        _form = FormKind.None;
        _target = null;
    }

    // D-356 — Excel export/import wired to the reusable CrudGridExcel component.
    private Task OnExportAsync(IReadOnlyList<AdminVenueMapNodeSummary> selected) =>
        _excel!.ExportAsync(selected.Select(row => row.Id).ToList(), _query);

    private Task OnImportAsync() => _excel!.TriggerImportAsync();

    private async Task OnImportedAsync()
    {
        _toast = new Toast("success", L["Grid.Import.Done"]);
        await LoadAsync();
    }

    private void OnExcelError(string message) => _toast = new Toast("error", message);

    private async Task OnSavedAsync(AdminVenueMapNodeDetail saved)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.VenueMap.Saved"]);
        await LoadAsync();
    }

    private async Task OnDeletedAsync(AdminVenueMapNodeDetail deleted)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.VenueMap.Deleted"]);
        await LoadAsync();
    }
}
