@* D-132 — reusable Interest Add/Edit form. Hosted in the modal opened
   from InterestsList.razor. Mirrors the CreateVisitorForm/CreateAdminForm
   extraction pattern (D-114/D-117) so the modal and any deep-link
   fallback render the same form with one source of truth. When Initial
   is null the form runs in Create mode; otherwise Edit mode (with the
   IsActive checkbox shown). *@
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.Interests.Field.Name"]"
                       Helper="@L["Admin.Interests.Field.NameHint"]"
                       MaxLength="128"
                       @bind-Value="_model.Name" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Interests.Field.NameArabic"]"
                       Helper="@L["Admin.Interests.Field.NameArabicHint"]"
                       MaxLength="128"
                       @bind-Value="_model.NameArabic" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Interests.Field.DisplayOrder"]"
                       Helper="@L["Admin.Interests.Field.DisplayOrderHint"]"
                       Type="number"
                       Value="@_displayOrderInput"
                       ValueChanged="@(v => _displayOrderInput = v)"
                       ValueExpression="@(() => _displayOrderInput)"
                       Disabled="_busy" />
        @if (Initial is not null)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.Interests.Field.IsActive"]
            </SimfCheckbox>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy"
                    LoadingLabel="@(Initial is null ? L["Admin.Interests.New.Submitting"] : L["Admin.Interests.Edit.Submitting"])">
            @(Initial is null ? L["Admin.Interests.New.Submit"] : L["Admin.Interests.Edit.Submit"])
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Interests.Add.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>

@code {
    private readonly Model _model = new();
    private string _displayOrderInput = "0";
    private EditContext _editContext = default!;
    private bool _busy;
    private string? _error;

    /// <summary>When set, runs in Edit mode and PUTs to /admin/interests/{Initial.Id};
    /// otherwise runs in Create mode and POSTs to /admin/interests.</summary>
    [Parameter] public AdminInterestSummary? Initial { get; set; }

    /// <summary>Fires after a successful create or update. The host modal closes
    /// itself and reloads the grid in response.</summary>
    [Parameter] public EventCallback<AdminInterestSummary> OnSuccess { get; set; }

    /// <summary>Optional cancel callback (host modal close). When unset, no Cancel button.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    protected override void OnInitialized()
    {
        if (Initial is not null)
        {
            _model.Name = Initial.Name;
            _model.NameArabic = Initial.NameArabic;
            _model.IsActive = Initial.IsActive;
            _displayOrderInput = Initial.DisplayOrder.ToString();
        }
        _editContext = new EditContext(_model);
    }

    private async Task HandleSubmitAsync()
    {
        if (_busy) return;
        _error = null;

        if (string.IsNullOrWhiteSpace(_model.Name) || _model.Name.Length > 128)
        {
            _error = L["Admin.Interests.Field.NameInvalid"]; return;
        }
        if (string.IsNullOrWhiteSpace(_model.NameArabic) || _model.NameArabic.Length > 128)
        {
            _error = L["Admin.Interests.Field.NameArabicInvalid"]; return;
        }
        if (!int.TryParse(_displayOrderInput, out var order) || order < 0)
        {
            _error = L["Admin.Interests.Field.DisplayOrderInvalid"]; return;
        }

        _busy = true;
        try
        {
            ApiResult<AdminInterestSummary>? envelope;
            if (Initial is null)
            {
                envelope = await JS.InvokeAsync<ApiResult<AdminInterestSummary>>(
                    "simfAccount.postJson", "/account/api/admin/interests",
                    new AdminCreateInterestRequest
                    {
                        Name = _model.Name.Trim(),
                        NameArabic = _model.NameArabic.Trim(),
                        DisplayOrder = order,
                    });
            }
            else
            {
                envelope = await JS.InvokeAsync<ApiResult<AdminInterestSummary>>(
                    "simfAccount.putJson", $"/account/api/admin/interests/{Initial.Id}",
                    new AdminUpdateInterestRequest
                    {
                        Name = _model.Name.Trim(),
                        NameArabic = _model.NameArabic.Trim(),
                        DisplayOrder = order,
                        IsActive = _model.IsActive,
                    });
            }

            if (envelope is { Success: true, Data: not null })
            {
                await OnSuccess.InvokeAsync(envelope.Data);
            }
            else
            {
                _error = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Interests.Fallback"];
            }
        }
        catch (Exception)
        {
            _error = L["Admin.Interests.Fallback"];
        }
        finally { _busy = false; }
    }

    private sealed class Model
    {
        public string Name { get; set; } = string.Empty;
        public string NameArabic { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
    }
}
