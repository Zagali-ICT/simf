@* Control Panel — list visitor accounts (P3, promoted to the canonical
   D-117 CRUD pattern in D-114). Administrator-only. Uses SimfDataGrid with
   the full toolbar wired against the D-113 backend (/account/api/admin/visitors/*),
   SimfBanner page-top. Centralized dialog/full-page framing D-353: Add / Edit /
   Details are hosted by CrudShell, which frames the reusable VisitorsAddEdit and
   VisitorsViewDelete forms as a popup or a full page per the admin's toolbar
   choice (persisted in localStorage via CpPreferences). This is a
   security-sensitive ACCOUNT page — only the create/edit/details form
   presentation changed; the reason-gated bulk-delete dialog, the duplicate
   dialog, the Excel import-result modal, copy/paste, and the Excel export/import
   wiring are all preserved byte-for-byte. A row "delete" still opens the
   reason-gated bulk-delete dialog (there is no single-row hard delete), so the
   View/Delete form is details-only. *@
@page "/admin/visitors"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Visitors.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject CpPreferences Prefs

<PageTitle>@L["Admin.Visitors.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Visitors.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            <SimfDataGrid TItem="AdminUserSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(user => user.Id.ToString())"
                          RowLabel="@(user => user.Email)"
                          Caption="@L["Admin.Visitors.Title"]"
                          FilterColumnLabel="@L["Admin.Users.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteSelected="OnBulkDeleteAsync"
                          OnDeleteOne="OnRowDeleteAsync"
                          OnDuplicateOne="OnDuplicateAsync"
                          OnCopySelected="OnCopySelectedAsync"
                          OnCopyOne="OnCopyOneAsync"
                          OnPaste="OnPasteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Admin.Users.Prev"]"
                          NextLabel="@L["Admin.Users.Next"]"
                          FirstLabel="@L["Admin.Users.Pager.First"]"
                          LastLabel="@L["Admin.Users.Pager.Last"]"
                          PageSizeLabel="@L["Admin.Users.Pager.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Users.Loading"]"
                          FilterPlaceholder="@L["Admin.Users.FilterPlaceholder"]"
                          ActionsHeader="@L["Admin.Users.Column.Actions"]"
                          SelectAllLabel="@L["Admin.Users.Action.SelectAll"]"
                          SelectRowLabel="@L["Admin.Users.Action.SelectRow"]"
                          AddLabel="@L["Admin.Users.Action.Add"]"
                          EditLabel="@L["Admin.Users.Action.Edit"]"
                          DetailsLabel="@L["Admin.Users.Action.Details"]"
                          DeleteLabel="@L["Admin.Users.Action.Delete"]"
                          CopyLabel="@L["Admin.Users.Action.Copy"]"
                          PasteLabel="@L["Admin.Users.Action.Paste"]"
                          DuplicateLabel="@L["Admin.Users.Action.Duplicate"]"
                          ImportLabel="@L["Admin.Users.Action.Import"]"
                          ExportLabel="@L["Admin.Users.Action.Export"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminUserSummary" Key="email"
                                        Header="@L["Admin.Users.Column.Email"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Email</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminUserSummary" Key="displayName"
                                        Header="@L["Admin.Users.Column.DisplayName"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.DisplayName</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminUserSummary" Key="state"
                                        Header="@L["Admin.Users.Column.State"]"
                                        Sortable="true">
                        <CellTemplate>@context.AccountState</CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Visitors.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (_toast is not null)
{
    <div class="simf-toast">
        <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
    </div>
}

@* D-114 — hidden file input used by Import. *@
<input type="file" id="visitors-import-input" accept=".xlsx"
       class="simf-hidden-input"
       aria-label="@L["Admin.Users.Import.Picker"]"
       @onchange="OnImportFileSelectedAsync" />

@* D-353 — Add / Edit / Details hosted by the centralized CrudShell (popup or
   full page per the admin's toolbar choice). *@
@if (FormOpen)
{
    <CrudShell Open="true" Presentation="EffectivePresentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Visitors.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <VisitorsAddEdit IsEdit="_isEdit" Initial="_target"
                             OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <VisitorsViewDelete IsDelete="false" Initial="_target"
                                OnCancel="CloseForm" />
        }
    </CrudShell>
}

@if (_bulkDeleteOpen)
{
    <SimfModal Open="true" Title="@L["Admin.Visitors.BulkDelete.Title"]" OnClose="@(() => _bulkDeleteOpen = false)">
        <ChildContent>
            <p>@string.Format(L["Admin.Visitors.BulkDelete.Confirm"], _bulkDeleteTargets.Count)</p>
            <SimfTextarea Label="@L["Admin.Users.BulkDelete.Reason"]"
                          Helper="@L["Admin.Users.BulkDelete.ReasonHint"]"
                          Rows="3" MaxLength="500"
                          Value="@_bulkDeleteReason" ValueChanged="@(v => _bulkDeleteReason = v)" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _bulkDeleteOpen = false)">
                @L["Admin.Users.BulkDelete.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="primary"
                        Loading="_busy"
                        Disabled="@(_bulkDeleteReason.Length is < 10 or > 500)"
                        OnClick="ConfirmBulkDeleteAsync">
                @L["Admin.Users.BulkDelete.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_duplicateOpen)
{
    <SimfModal Open="true" Title="@L["Admin.Visitors.Duplicate.Title"]" OnClose="@(() => _duplicateOpen = false)">
        <ChildContent>
            <p>@string.Format(L["Admin.Users.Duplicate.Confirm"], _duplicateSource?.Email)</p>
            <SimfTextField Label="@L["Admin.Users.Duplicate.NewEmail"]"
                           Helper="@L["Admin.Users.Duplicate.NewEmailHint"]"
                           Type="email" Icon="mail"
                           Value="@_duplicateEmail"
                           ValueChanged="@(v => _duplicateEmail = v)"
                           ValueExpression="@(() => _duplicateEmail)" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _duplicateOpen = false)">
                @L["Admin.Users.Duplicate.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="primary"
                        Loading="_busy"
                        Disabled="@(!IsLikelyEmail(_duplicateEmail))"
                        OnClick="ConfirmDuplicateAsync">
                @L["Admin.Users.Duplicate.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_importResult is not null)
{
    <SimfModal Open="true" Title="@L["Admin.Users.Import.ResultTitle"]" OnClose="@(() => _importResult = null)">
        <ChildContent>
            <p>@string.Format(L["Admin.Users.Import.ResultBody"], _importResult.Created, _importResult.Skipped)</p>
            @if (_importResult.Errors.Count > 0)
            {
                <ul class="simf-import-errors">
                    @foreach (var error in _importResult.Errors)
                    {
                        <li>@($"Row {error.Row} ({error.Email}): {error.Reason}")</li>
                    }
                </ul>
            }
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="@(() => _importResult = null)">
                @L["Admin.Users.Import.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private enum FormKind { None, AddEdit, ViewDelete }

    private const string PageKey = "visitors";

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminUserSummary>? _page;
    private bool _loading;
    private bool _busy;

    private CrudPresentation _presentation = CrudPresentation.Dialog;
    private FormKind _form = FormKind.None;
    private bool _isEdit;
    private AdminUserSummary? _target;

    private bool _bulkDeleteOpen;
    private IReadOnlyList<AdminUserSummary> _bulkDeleteTargets = Array.Empty<AdminUserSummary>();
    private string _bulkDeleteReason = string.Empty;

    private bool _duplicateOpen;
    private AdminUserSummary? _duplicateSource;
    private string _duplicateEmail = string.Empty;

    private AdminImportUsersResponse? _importResult;
    private Toast? _toast;

    private bool FormOpen => _form != FormKind.None;
    // D-393 — the wide Add-visitor form opens full-page (it needs the room)
    // regardless of the admin's popup/page preference; Edit + Details keep the
    // preference.
    private CrudPresentation EffectivePresentation =>
        _form == FormKind.AddEdit && !_isEdit
            ? CrudPresentation.Page
            : _presentation;
    private bool GridHidden => FormOpen && EffectivePresentation == CrudPresentation.Page;

    private string FormTitle => _form switch
    {
        FormKind.AddEdit => _isEdit
            ? L["Admin.Visitors.Edit.Title"]
            : L["Admin.Visitors.Add.Title"],
        FormKind.ViewDelete => string.Format(
            L["Admin.Visitors.Details.Title"], _target?.Email),
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _presentation = await Prefs.GetPresentationAsync(PageKey);
        await LoadAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<GridPage<AdminUserSummary>>>(
                "simfAccount.postJson", "/account/api/admin/visitors/list", _query);
            _page = envelope is { Success: true, Data: not null }
                ? envelope.Data
                : GridPage<AdminUserSummary>.Of(
                    Array.Empty<AdminUserSummary>(), 0, _query);
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _form = FormKind.AddEdit;
        _isEdit = false;
        _target = null;
        return Task.CompletedTask;
    }

    private Task OnEditAsync(AdminUserSummary user)
    {
        _form = FormKind.AddEdit;
        _isEdit = true;
        _target = user;
        return Task.CompletedTask;
    }

    private Task OnDetailsAsync(AdminUserSummary user)
    {
        _form = FormKind.ViewDelete;
        _isEdit = false;
        _target = user;
        return Task.CompletedTask;
    }

    private void CloseForm()
    {
        _form = FormKind.None;
        _target = null;
    }

    private async Task OnSavedAsync(AdminUserSummary saved)
    {
        var wasEdit = _isEdit;
        CloseForm();
        ShowToast("success", wasEdit
            ? L["Admin.Edit.Saved"]
            : string.Format(L["Admin.CreateVisitor.Success"], saved.Email));
        await LoadAsync();
    }

    private Task OnRowDeleteAsync(AdminUserSummary user)
    {
        _bulkDeleteTargets = new[] { user };
        _bulkDeleteReason = string.Empty;
        _bulkDeleteOpen = true;
        return Task.CompletedTask;
    }

    private Task OnBulkDeleteAsync(IReadOnlyList<AdminUserSummary> users)
    {
        if (users.Count == 0)
        {
            ShowToast("error", L["Admin.Users.NoSelection"]);
            return Task.CompletedTask;
        }
        _bulkDeleteTargets = users;
        _bulkDeleteReason = string.Empty;
        _bulkDeleteOpen = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmBulkDeleteAsync()
    {
        if (_bulkDeleteReason.Length is < 10 or > 500 || _bulkDeleteTargets.Count == 0) return;
        _busy = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<AdminBulkDeleteResponse>>(
                "simfAccount.postJson", "/account/api/admin/visitors/bulk-delete",
                new AdminBulkDeleteRequest
                {
                    Ids = _bulkDeleteTargets.Select(u => u.Id).ToList(),
                    Reason = _bulkDeleteReason,
                });
            if (envelope is { Success: true, Data: not null })
            {
                _bulkDeleteOpen = false;
                ShowToast("success", string.Format(
                    L["Admin.Users.BulkDelete.Success"],
                    envelope.Data.Deleted, envelope.Data.Skipped));
                await LoadAsync();
            }
            else
            {
                ShowToast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Users.BulkDelete.Fallback"]);
            }
        }
        finally { _busy = false; }
    }

    private Task OnDuplicateAsync(AdminUserSummary user)
    {
        _duplicateSource = user;
        _duplicateEmail = string.Empty;
        _duplicateOpen = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmDuplicateAsync()
    {
        if (_duplicateSource is null || !IsLikelyEmail(_duplicateEmail)) return;
        _busy = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<AdminCreateUserResponse>>(
                "simfAccount.postJson", "/account/api/admin/visitors/duplicate",
                new AdminDuplicateUserRequest
                {
                    SourceId = _duplicateSource.Id,
                    NewEmail = _duplicateEmail,
                });
            if (envelope is { Success: true, Data: not null })
            {
                _duplicateOpen = false;
                ShowToast("success", string.Format(
                    L["Admin.Users.Duplicate.Success"], envelope.Data.Email));
                await LoadAsync();
            }
            else
            {
                ShowToast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Users.Duplicate.Fallback"]);
            }
        }
        finally { _busy = false; }
    }

    private Task OnCopySelectedAsync(IReadOnlyList<AdminUserSummary> users)
    {
        if (users.Count == 0) return Task.CompletedTask;
        ShowToast("info", string.Format(L["Admin.Users.Copy.Count"], users.Count));
        return Task.CompletedTask;
    }

    private Task OnCopyOneAsync(AdminUserSummary user)
    {
        ShowToast("info", string.Format(L["Admin.Users.Copy.One"], user.Email));
        return Task.CompletedTask;
    }

    private Task OnPasteAsync(string clipboard)
    {
        if (string.IsNullOrWhiteSpace(clipboard))
        {
            ShowToast("error", L["Admin.Users.Paste.Empty"]);
            return Task.CompletedTask;
        }
        ShowToast("info", L["Admin.Users.Paste.NotImplemented"]);
        return Task.CompletedTask;
    }

    private async Task OnExportAsync(IReadOnlyList<AdminUserSummary> selected)
    {
        var ids = selected.Select(u => u.Id).ToList();
        await JS.InvokeVoidAsync("simfAccount.downloadXlsx",
            "/account/api/admin/visitors/export",
            new AdminExportUsersRequest { Ids = ids, Query = ids.Count == 0 ? _query : null });
    }

    private async Task OnImportAsync() =>
        await JS.InvokeVoidAsync("simfAccount.triggerFileInput", "visitors-import-input");

    private async Task OnImportFileSelectedAsync()
    {
        _busy = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<AdminImportUsersResponse>>(
                "simfAccount.uploadFile", "/account/api/admin/visitors/import", "visitors-import-input");
            if (envelope is { Success: true, Data: not null })
            {
                _importResult = envelope.Data;
                await LoadAsync();
            }
            else
            {
                ShowToast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Users.Import.Fallback"]);
            }
        }
        finally { _busy = false; }
    }

    private string FormatSummary(int from, int to, int total) =>
        string.Format(L["Admin.Users.Pager.Summary"], from, to, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Admin.Users.Pager.Page"], current, total);

    private static bool IsLikelyEmail(string value) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains('@', StringComparison.Ordinal)
        && value.Length <= 256;

    private void ShowToast(string variant, string message)
    {
        _toast = new Toast(variant, message);
    }

    private sealed record Toast(string Variant, string Message);
}
