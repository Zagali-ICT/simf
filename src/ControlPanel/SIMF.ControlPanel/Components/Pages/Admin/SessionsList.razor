@* D-165 (gap doc G3) — Sessions CRUD. SIMF-FDS-004 §5.3 + PDF §2.9.
   Centralized dialog/full-page framing D-353: Add / Edit / View / Delete are
   hosted by CrudShell, which frames the reusable SessionsAddEdit and
   SessionsViewDelete forms as a popup or a full page per the admin's toolbar
   choice (persisted in localStorage via CpPreferences). The inline SimfModal
   forms + the in-modal lifecycle / recording panels are gone — the View form
   carries them now. D-356: Excel export/import wired through CrudGridExcel. *@
@page "/admin/sessions"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Sessions.View)]

<PageTitle>@L["Admin.Sessions.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Sessions.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            @if (SpeakerId.HasValue)
            {
                <SimfAlert Variant="info">
                    @L["Admin.Sessions.FilteredBySpeaker"]
                    <a href="/admin/sessions">@L["Admin.Sessions.ClearFilter"]</a>
                </SimfAlert>
            }

            <SimfDataGrid TItem="AdminSessionSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Title)"
                          Caption="@L["Admin.Sessions.Title"]"
                          FilterColumnLabel="@L["Admin.Sessions.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Admin.Sessions.Prev"]"
                          NextLabel="@L["Admin.Sessions.Next"]"
                          FirstLabel="@L["Admin.Sessions.Pager.First"]"
                          LastLabel="@L["Admin.Sessions.Pager.Last"]"
                          PageSizeLabel="@L["Admin.Sessions.Pager.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Sessions.Loading"]"
                          FilterPlaceholder="@L["Admin.Sessions.FilterPlaceholder"]"
                          ActionsHeader="@L["Admin.Sessions.Column.Actions"]"
                          SelectAllLabel="@L["Admin.Sessions.Action.SelectAll"]"
                          SelectRowLabel="@L["Admin.Sessions.Action.SelectRow"]"
                          AddLabel="@L["Admin.Sessions.Action.Add"]"
                          EditLabel="@L["Admin.Sessions.Action.Edit"]"
                          DetailsLabel="@L["Admin.Sessions.Action.Details"]"
                          DeleteLabel="@L["Admin.Sessions.Action.Deactivate"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminSessionSummary" Key="code"
                                        Header="@L["Admin.Sessions.Column.Code"]"
                                        Sortable="true">
                        <CellTemplate>@context.Code</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSessionSummary" Key="title"
                                        Header="@L["Admin.Sessions.Column.Title"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Title</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSessionSummary" Key="titleArabic"
                                        Header="@L["Admin.Sessions.Column.TitleArabic"]">
                        <CellTemplate>@context.TitleArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSessionSummary" Key="hall"
                                        Header="@L["Admin.Sessions.Column.Hall"]">
                        <CellTemplate>@HallLabel(context)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSessionSummary" Key="startUtc"
                                        Header="@L["Admin.Sessions.Column.StartUtc"]"
                                        Sortable="true">
                        <CellTemplate>@context.StartUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSessionSummary" Key="endUtc"
                                        Header="@L["Admin.Sessions.Column.EndUtc"]"
                                        Sortable="true">
                        <CellTemplate>@context.EndUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSessionSummary" Key="capacity"
                                        Header="@L["Admin.Sessions.Column.Capacity"]">
                        <CellTemplate>@context.Capacity</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSessionSummary" Key="isActive"
                                        Header="@L["Admin.Sessions.Column.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Admin.Sessions.Active.Yes"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Admin.Sessions.Active.No"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSessionSummary" Key="status"
                                        Header="@L["Admin.Sessions.Column.Status"]">
                        <CellTemplate>
                            <SimfPill Variant="@StatusPillVariant(context.Status)">@StatusLabel(context.Status)</SimfPill>
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <RowActions>
                    @* D-646 — the live Q&A moderation desk is per-session and is
                       reached from this grid, not the nav (CpNavigation notes the
                       same). Gated by the same Questions.Moderate permission the
                       desk page + API enforce, so only moderators see the action. *@
                    <AuthorizedAction Permission="@PermissionCatalog.Questions.Moderate">
                        <SimfToolbarButton Icon="gavel"
                                           Title="@L["Admin.Sessions.Action.Moderate"]"
                                           OnClick="@(() => OpenModeration(context))" />
                    </AuthorizedAction>
                </RowActions>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Sessions.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="sessions"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Sessions.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <SessionsAddEdit IsEdit="_isEdit" Initial="_target"
                             OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <SessionsViewDelete IsDelete="_isDelete" Initial="_target"
                                OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
