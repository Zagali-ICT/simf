@* P2.3 (D-228) — speaker presentation-file management (SIMF-FDS-004 §5.3,
   FR-407). Pick a speaker, see their presentation files (each linked to a
   session), upload a new file for a session, download or remove existing ones.
   Gated by Speakers.* (View to read, Edit to upload/delete). Mirrors the
   MediaList out-of-row upload via simfAccount.uploadFile.

   The list endpoint (GET /admin/speakers/{id}/presentations) returns the full,
   non-paged set for one speaker, so the SimfDataGrid is fed a client-side page:
   _allRows holds the full list and OnQueryChangedAsync slices/filters/sorts it
   in memory (the backend has no GridQuery contract for this master-detail GET). *@
@page "/admin/speaker-presentations"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Speakers.View)]
@using SIMF.Contracts.Admin
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.SpeakerPresentations.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.SpeakerPresentations.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <div class="simf-form__fields">
            <label class="simf-field">
                <span class="simf-field__label">@L["Admin.SpeakerPresentations.Speaker"]</span>
                <select class="simf-field__input" value="@_speakerId"
                        @onchange="OnSpeakerChanged" disabled="@_busy">
                    <option value="">@L["Admin.SpeakerPresentations.SelectSpeaker"]</option>
                    @foreach (var s in _speakers)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </label>
        </div>

        @if (!string.IsNullOrEmpty(_speakerId))
        {
            <AuthorizedAction Permission="@PermissionCatalog.Speakers.Edit">
                <div class="simf-form__fields">
                    <label class="simf-field">
                        <span class="simf-field__label">@L["Admin.SpeakerPresentations.Session"]</span>
                        <select class="simf-field__input" value="@_sessionId"
                                @onchange="OnSessionChanged" disabled="@_busy">
                            <option value="">@L["Admin.SpeakerPresentations.SelectSession"]</option>
                            @foreach (var s in _sessions)
                            {
                                <option value="@s.Id">@s.Title</option>
                            }
                        </select>
                    </label>
                    <label class="simf-field">
                        <span class="simf-field__label">@L["Admin.SpeakerPresentations.File"]</span>
                        <input class="simf-field__input" type="file" id="presentation-file-input"
                               disabled="@_busy" />
                    </label>
                    <SimfButton Type="button" Loading="_busy"
                                Disabled="@(string.IsNullOrEmpty(_sessionId))"
                                OnClick="UploadAsync">
                        @L["Admin.SpeakerPresentations.Upload"]
                    </SimfButton>
                </div>
            </AuthorizedAction>

            <SimfDataGrid TItem="AdminSpeakerPresentationRow"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.FileName)"
                          Caption="@L["Admin.SpeakerPresentations.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.SpeakerPresentations.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          SummaryFormatter="@FormatSummary">
                <Columns>
                    <SimfDataGridColumn TItem="AdminSpeakerPresentationRow" Key="fileName"
                                        Header="@L["Admin.SpeakerPresentations.Col.File"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.FileName</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSpeakerPresentationRow" Key="sessionTitle"
                                        Header="@L["Admin.SpeakerPresentations.Col.Session"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.SessionTitle</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSpeakerPresentationRow" Key="sizeBytes"
                                        Header="@L["Admin.SpeakerPresentations.Col.Size"]"
                                        Sortable="true">
                        <CellTemplate>@FormatSize(context.SizeBytes)</CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <RowActions>
                    @* Page-specific quiet action: download the stored file. The
                       download endpoint sends Content-Disposition: attachment, so
                       opening it triggers a save without leaving the page. *@
                    <AuthorizedAction Permission="@PermissionCatalog.Speakers.View">
                        <SimfToolbarButton Icon="download"
                                           Title="@L["Admin.SpeakerPresentations.Download"]"
                                           OnClick="@(() => DownloadAsync(context))" />
                    </AuthorizedAction>
                    <AuthorizedAction Permission="@PermissionCatalog.Speakers.Edit">
                        <SimfToolbarButton Icon="trash" Danger="true"
                                           Title="@L["Admin.SpeakerPresentations.Delete"]"
                                           Disabled="_busy"
                                           OnClick="@(() => DeleteAsync(context))" />
                    </AuthorizedAction>
                </RowActions>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.SpeakerPresentations.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        }
    </div>
</div>

@code {
    private record Toast(string Variant, string Message);

    private List<AdminSpeakerSummary> _speakers = new();
    private List<AdminSessionSummary> _sessions = new();

    // The full, non-paged set for the selected speaker (newest first, as the
    // endpoint returns it). The grid renders a client-side page of this.
    private List<AdminSpeakerPresentationRow> _allRows = new();

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminSpeakerPresentationRow> _page = new();

    private string _speakerId = string.Empty;
    private string _sessionId = string.Empty;
    private bool _loading;
    private bool _busy;
    private Toast? _toast;

    protected override async Task OnInitializedAsync()
    {
        await LoadSpeakersAsync();
        await LoadSessionsAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadSpeakersAsync()
    {
        var env = await JS.InvokeAsync<ApiResult<GridPage<AdminSpeakerSummary>>>(
            "simfAccount.postJson", "/account/api/admin/speakers/list",
            new GridQuery { Top = 500 });
        if (env is { Success: true, Data: not null })
        {
            _speakers = env.Data.Items.ToList();
        }
    }

    private async Task LoadSessionsAsync()
    {
        var env = await JS.InvokeAsync<ApiResult<GridPage<AdminSessionSummary>>>(
            "simfAccount.postJson", "/account/api/admin/sessions/list",
            new GridQuery { Top = 500 });
        if (env is { Success: true, Data: not null })
        {
            _sessions = env.Data.Items.Where(s => s.IsActive).ToList();
        }
    }

    private async Task OnSpeakerChanged(ChangeEventArgs e)
    {
        _speakerId = e.Value?.ToString() ?? string.Empty;
        _allRows = new();
        _query = new GridQuery { Top = 20 };
        _page = new();
        _toast = null;
        if (!string.IsNullOrEmpty(_speakerId))
        {
            await LoadPresentationsAsync();
        }
    }

    private void OnSessionChanged(ChangeEventArgs e) =>
        _sessionId = e.Value?.ToString() ?? string.Empty;

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        // No server round-trip: the full set is already in memory. Re-page it.
        BuildPage();
        await Task.CompletedTask;
    }

    private async Task LoadPresentationsAsync()
    {
        if (string.IsNullOrEmpty(_speakerId)) return;
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<List<AdminSpeakerPresentationRow>>>(
                "simfAccount.getJson",
                $"/account/api/admin/speakers/{_speakerId}/presentations");
            if (env is { Success: true, Data: not null })
            {
                _allRows = env.Data;
                BuildPage();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.SpeakerPresentations.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    // Applies the grid's current filter, sort and page window to the in-memory
    // set. The endpoint returns the rows newest-first, which is the default
    // order when no sort is chosen.
    private void BuildPage()
    {
        IEnumerable<AdminSpeakerPresentationRow> rows = _allRows;

        if (_query.Filters.TryGetValue("fileName", out var fileFilter)
            && !string.IsNullOrWhiteSpace(fileFilter))
        {
            rows = rows.Where(r => r.FileName.Contains(
                fileFilter, StringComparison.OrdinalIgnoreCase));
        }
        if (_query.Filters.TryGetValue("sessionTitle", out var sessionFilter)
            && !string.IsNullOrWhiteSpace(sessionFilter))
        {
            rows = rows.Where(r => r.SessionTitle.Contains(
                sessionFilter, StringComparison.OrdinalIgnoreCase));
        }

        rows = (_query.Sort?.ToLowerInvariant(), _query.SortDescending) switch
        {
            ("filename", false) => rows.OrderBy(r => r.FileName),
            ("filename", true) => rows.OrderByDescending(r => r.FileName),
            ("sessiontitle", false) => rows.OrderBy(r => r.SessionTitle),
            ("sessiontitle", true) => rows.OrderByDescending(r => r.SessionTitle),
            ("sizebytes", false) => rows.OrderBy(r => r.SizeBytes),
            ("sizebytes", true) => rows.OrderByDescending(r => r.SizeBytes),
            _ => rows.OrderByDescending(r => r.CreatedAt),
        };

        var filtered = rows.ToList();
        var window = filtered.Skip(_query.Skip).Take(_query.Top).ToList();
        _page = GridPage<AdminSpeakerPresentationRow>.Of(window, filtered.Count, _query);
    }

    private async Task DownloadAsync(AdminSpeakerPresentationRow row)
    {
        // The endpoint returns the bytes with an attachment disposition, so
        // opening the URL saves the file without navigating away.
        await JS.InvokeVoidAsync("window.open",
            $"/account/api/admin/speaker-presentations/{row.Id}/file", "_blank");
    }

    private async Task UploadAsync()
    {
        if (_busy || string.IsNullOrEmpty(_speakerId) || string.IsNullOrEmpty(_sessionId)) return;
        _busy = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminSpeakerPresentationRow>>(
                "simfAccount.uploadFile",
                $"/account/api/admin/speakers/{_speakerId}/presentations?sessionId={_sessionId}",
                "presentation-file-input");
            if (env is { Success: true })
            {
                _toast = new Toast("success", L["Admin.SpeakerPresentations.Uploaded"]);
                await LoadPresentationsAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.SpeakerPresentations.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(AdminSpeakerPresentationRow row)
    {
        if (_busy) return;
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm", L["Admin.SpeakerPresentations.Delete.Confirm"].Value);
        if (!confirmed) return;
        _busy = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.deleteJson",
                $"/account/api/admin/speaker-presentations/{row.Id}");
            if (env is { Success: true })
            {
                _toast = new Toast("success", L["Admin.SpeakerPresentations.Deleted"]);
                await LoadPresentationsAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.SpeakerPresentations.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):0.0} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:0.0} KB";
        return $"{bytes} B";
    }
}
