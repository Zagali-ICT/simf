@* D-199 (CP UI for the Exhibition booths, Mockup page 22) — admin CRUD
   over the public exhibition booth list + 2D venue map. Each booth carries
   a bilingual name / exhibitor / sector / description, an optional hall, and
   an optional MapX/MapY position used by the public 2D venue map. *@
@page "/admin/booths"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Booths.View)]
@using SIMF.Contracts.Exhibition
@using SIMF.Contracts.Exhibitors
@using SIMF.Common.Enums
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.Booths.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Booths.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminBoothSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => $"{r.Code} — {r.Name}")"
                      Caption="@L["Admin.Booths.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      OnAdd="OnAdd"
                      OnEditOne="OnEdit"
                      OnDeleteOne="OnDeleteAsync"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.Booths.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      AddLabel="@L["Grid.Add"]"
                      EditLabel="@L["Grid.Edit"]"
                      DeleteLabel="@L["Grid.Delete"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminBoothSummary" Key="code"
                                    Header="@L["Admin.Booths.Col.Code"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Code</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBoothSummary" Key="name"
                                    Header="@L["Admin.Booths.Col.NameEn"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Name</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBoothSummary" Key="nameArabic"
                                    Header="@L["Admin.Booths.Col.NameAr"]"
                                    Filterable="true">
                    <CellTemplate>@context.NameArabic</CellTemplate>
                </SimfDataGridColumn>
                @* Exhibitor is resolved client-side from the cached exhibitor
                   list (the summary carries only ExhibitorId), so this column
                   is neither server-sortable nor server-filterable. *@
                <SimfDataGridColumn TItem="AdminBoothSummary" Key="exhibitor"
                                    Header="@L["Admin.Booths.Col.Exhibitor"]">
                    <CellTemplate>@ExhibitorName(context.ExhibitorId)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBoothSummary" Key="sector"
                                    Header="@L["Admin.Booths.Col.SectorEn"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@(context.Sector ?? "—")</CellTemplate>
                </SimfDataGridColumn>
                @* Hall is resolved client-side from the cached hall list (the
                   summary carries only HallId), so this column is neither
                   server-sortable nor server-filterable. *@
                <SimfDataGridColumn TItem="AdminBoothSummary" Key="hall"
                                    Header="@L["Admin.Booths.Col.Hall"]">
                    <CellTemplate>@HallName(context.HallId)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBoothSummary" Key="isActive"
                                    Header="@L["Admin.Booths.Col.Active"]"
                                    Sortable="true">
                    <CellTemplate>
                        @if (context.IsActive)
                        {
                            <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Booths.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_editOpen)
{
    <SimfModal Open="true"
               Title="@(_isEdit ? L["Admin.Booths.Edit.Title"] : L["Admin.Booths.Add.Title"])"
               OnClose="@(() => _editOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <SimfTextField Label="@L["Admin.Booths.Field.Code"]"
                               Value="@_form.Code"
                               ValueChanged="@(v => _form.Code = v)"
                               ValueExpression="@(() => _form.Code)"
                               MaxLength="16"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Booths.Field.NameEn"]"
                               Value="@_form.Name"
                               ValueChanged="@(v => _form.Name = v)"
                               ValueExpression="@(() => _form.Name)"
                               MaxLength="128"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Booths.Field.NameAr"]"
                               Value="@_form.NameArabic"
                               ValueChanged="@(v => _form.NameArabic = v)"
                               ValueExpression="@(() => _form.NameArabic)"
                               MaxLength="128"
                               Disabled="_busy" />
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Booths.Field.Exhibitor"]</span>
                    <select class="simf-field__input"
                            value="@(_form.ExhibitorId?.ToString() ?? string.Empty)"
                            @onchange="OnExhibitorIdChanged"
                            disabled="@_busy">
                        <option value="">@L["Admin.Booths.Field.ExhibitorNone"]</option>
                        @foreach (var exhibitor in _exhibitors)
                        {
                            <option value="@exhibitor.Id">@exhibitor.NameEn — @exhibitor.NameAr</option>
                        }
                    </select>
                </label>
                <SimfTextField Label="@L["Admin.Booths.Field.OfficerName"]"
                               Value="@_form.OfficerName"
                               ValueChanged="@(v => _form.OfficerName = v)"
                               ValueExpression="@(() => _form.OfficerName)"
                               MaxLength="256"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Booths.Field.OfficerPhone"]"
                               Value="@_form.OfficerPhone"
                               ValueChanged="@(v => _form.OfficerPhone = v)"
                               ValueExpression="@(() => _form.OfficerPhone)"
                               MaxLength="32"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Booths.Field.OfficerEmail"]"
                               Value="@_form.OfficerEmail"
                               ValueChanged="@(v => _form.OfficerEmail = v)"
                               ValueExpression="@(() => _form.OfficerEmail)"
                               MaxLength="320"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Booths.Field.SectorEn"]"
                               Value="@_form.Sector"
                               ValueChanged="@(v => _form.Sector = v)"
                               ValueExpression="@(() => _form.Sector)"
                               MaxLength="128"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Booths.Field.SectorAr"]"
                               Value="@_form.SectorArabic"
                               ValueChanged="@(v => _form.SectorArabic = v)"
                               ValueExpression="@(() => _form.SectorArabic)"
                               MaxLength="128"
                               Disabled="_busy" />
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Booths.Field.DescriptionEn"]</span>
                    <textarea class="simf-field__input" rows="3" maxlength="2048"
                              value="@_form.Description"
                              @onchange="OnDescriptionEnChanged"
                              disabled="@_busy"></textarea>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Booths.Field.DescriptionAr"]</span>
                    <textarea class="simf-field__input" rows="3" maxlength="2048"
                              value="@_form.DescriptionArabic"
                              @onchange="OnDescriptionArChanged"
                              disabled="@_busy"></textarea>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Booths.Field.HallId"]</span>
                    <select class="simf-field__input"
                            value="@(_form.HallId?.ToString() ?? string.Empty)"
                            @onchange="OnHallIdChanged"
                            disabled="@_busy">
                        <option value="">@L["Admin.Booths.Field.HallNone"]</option>
                        @foreach (var hall in _halls)
                        {
                            <option value="@hall.Id">@hall.Name — @hall.NameArabic</option>
                        }
                    </select>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Booths.Field.MapX"]</span>
                    <input class="simf-field__input" type="number" step="any"
                           value="@_form.MapX"
                           @onchange="OnMapXChanged"
                           disabled="@_busy" />
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Booths.Field.MapY"]</span>
                    <input class="simf-field__input" type="number" step="any"
                           value="@_form.MapY"
                           @onchange="OnMapYChanged"
                           disabled="@_busy" />
                </label>
                <SimfCheckbox Value="_form.IsActive"
                              ValueChanged="@(v => _form.IsActive = v)"
                              Disabled="_busy">
                    @L["Admin.Booths.Field.IsActive"]
                </SimfCheckbox>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="@(() => _editOpen = false)">
                @L["Admin.Booths.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SaveAsync" Loading="_busy">
                @L["Admin.Booths.Save"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private sealed class FormModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string NameArabic { get; set; } = string.Empty;
        public Guid? ExhibitorId { get; set; }
        public string OfficerName { get; set; } = string.Empty;
        public string OfficerPhone { get; set; } = string.Empty;
        public string OfficerEmail { get; set; } = string.Empty;
        public string Sector { get; set; } = string.Empty;
        public string SectorArabic { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string DescriptionArabic { get; set; } = string.Empty;
        public Guid? HallId { get; set; }
        public double? MapX { get; set; }
        public double? MapY { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminBoothSummary> _page = new();
    private bool _loading;
    private bool _busy;
    private Toast? _toast;
    // D-199 — halls cached at mount so the form's hall dropdown doesn't
    // round-trip on every Add/Edit modal open. The same list also resolves
    // the Hall column in the grid (HallName).
    private List<AdminHallSummary> _halls = new();
    // B1 — D-222: active exhibitors cached at mount so the form's Exhibitor
    // dropdown is ready on first open and the grid's Exhibitor column can
    // resolve a name (mirrors the Hall pattern). Bounded → one Top=500
    // round-trip is fine.
    private List<AdminExhibitorSummary> _exhibitors = new();

    private bool _editOpen;
    private bool _isEdit;
    private Guid _editingId;
    private FormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadHallsAsync();
        await LoadExhibitorsAsync();
        await LoadAsync();
    }

    private async Task LoadExhibitorsAsync()
    {
        var env = await JS.InvokeAsync<ApiResult<GridPage<AdminExhibitorSummary>>>(
            "simfAccount.postJson", "/account/api/admin/exhibitors/list",
            new GridQuery { Top = 500 });
        if (env is { Success: true, Data: not null })
        {
            // Only active exhibitors can staff a booth — the server enforces
            // the same rule.
            _exhibitors = env.Data.Items
                .Where(c => c.IsActive)
                .OrderBy(c => c.NameEn).ToList();
        }
        else
        {
            _toast = new Toast("error",
                env?.Error?.MessageForCurrentCulture()
                ?? L["Admin.Booths.ExhibitorsLoadFailed"]);
        }
    }

    private string ExhibitorName(Guid? exhibitorId)
    {
        if (exhibitorId is null) return "—";
        var exhibitor = _exhibitors.FirstOrDefault(c => c.Id == exhibitorId.Value);
        return exhibitor is null ? "—" : exhibitor.NameEn;
    }

    private void OnExhibitorIdChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _form.ExhibitorId = string.IsNullOrWhiteSpace(raw) ? null
            : (Guid.TryParse(raw, out var g) ? g : (Guid?)null);
    }

    private async Task LoadHallsAsync()
    {
        // D-199 — eager-load active halls so the Add / Edit modal's dropdown
        // is ready on first open and the grid's Hall column can resolve a
        // name. The list is bounded so a single Top=500 round-trip is fine.
        var env = await JS.InvokeAsync<ApiResult<GridPage<AdminHallSummary>>>(
            "simfAccount.postJson", "/account/api/admin/halls/list",
            new GridQuery { Top = 500 });
        if (env is { Success: true, Data: not null })
        {
            _halls = env.Data.Items.Where(h => h.IsActive)
                .OrderBy(h => h.Name).ToList();
        }
        else
        {
            _toast = new Toast("error",
                env?.Error?.MessageForCurrentCulture()
                ?? L["Admin.Booths.HallsLoadFailed"]);
        }
    }

    private string HallName(Guid? hallId)
    {
        if (hallId is null) return "—";
        var hall = _halls.FirstOrDefault(h => h.Id == hallId.Value);
        return hall is null ? "—" : hall.Name;
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminBoothSummary>>>(
                "simfAccount.postJson",
                "/account/api/admin/booths/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Booths.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private void OnAdd()
    {
        _editOpen = true;
        _isEdit = false;
        _editingId = Guid.Empty;
        _form = new FormModel();
        _toast = null;
    }

    private async Task OnEdit(AdminBoothSummary row)
    {
        // The grid summary omits the bilingual exhibitor/sector/description
        // and map position, so fetch the full detail before populating the
        // form (mirrors the GET /admin/booths/{id} contract).
        if (_busy) return;
        _busy = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminBoothDetail>>(
                "simfAccount.getJson",
                $"/account/api/admin/booths/{row.Id}");
            if (env is { Success: true, Data: not null })
            {
                var d = env.Data;
                _editingId = d.Id;
                _form = new FormModel
                {
                    Code = d.Code,
                    Name = d.Name,
                    NameArabic = d.NameArabic,
                    ExhibitorId = d.ExhibitorId,
                    OfficerName = d.OfficerName ?? string.Empty,
                    OfficerPhone = d.OfficerPhone ?? string.Empty,
                    OfficerEmail = d.OfficerEmail ?? string.Empty,
                    Sector = d.Sector ?? string.Empty,
                    SectorArabic = d.SectorArabic ?? string.Empty,
                    Description = d.Description ?? string.Empty,
                    DescriptionArabic = d.DescriptionArabic ?? string.Empty,
                    HallId = d.HallId,
                    MapX = d.MapX,
                    MapY = d.MapY,
                    IsActive = d.IsActive,
                };
                _isEdit = true;
                _editOpen = true;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Booths.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        // Required text guards (server-side FluentValidation is the source of
        // truth; this stops an obviously-empty submit round-trip).
        if (string.IsNullOrWhiteSpace(_form.Code)
            || string.IsNullOrWhiteSpace(_form.Name)
            || string.IsNullOrWhiteSpace(_form.NameArabic))
        {
            _toast = new Toast("error", L["Admin.Booths.Required"]);
            return;
        }
        _busy = true;
        _toast = null;
        try
        {
            ApiResult<AdminBoothDetail>? env;
            if (_isEdit)
            {
                env = await JS.InvokeAsync<ApiResult<AdminBoothDetail>>(
                    "simfAccount.putJson",
                    $"/account/api/admin/booths/{_editingId}",
                    new AdminUpdateBoothRequest
                    {
                        Code = _form.Code,
                        Name = _form.Name,
                        NameArabic = _form.NameArabic,
                        ExhibitorId = _form.ExhibitorId,
                        OfficerName = Trimmed(_form.OfficerName),
                        OfficerPhone = Trimmed(_form.OfficerPhone),
                        OfficerEmail = Trimmed(_form.OfficerEmail),
                        Sector = Trimmed(_form.Sector),
                        SectorArabic = Trimmed(_form.SectorArabic),
                        Description = Trimmed(_form.Description),
                        DescriptionArabic = Trimmed(_form.DescriptionArabic),
                        HallId = _form.HallId,
                        MapX = _form.MapX,
                        MapY = _form.MapY,
                        IsActive = _form.IsActive,
                    });
            }
            else
            {
                env = await JS.InvokeAsync<ApiResult<AdminBoothDetail>>(
                    "simfAccount.postJson",
                    "/account/api/admin/booths",
                    new AdminCreateBoothRequest
                    {
                        Code = _form.Code,
                        Name = _form.Name,
                        NameArabic = _form.NameArabic,
                        ExhibitorId = _form.ExhibitorId,
                        OfficerName = Trimmed(_form.OfficerName),
                        OfficerPhone = Trimmed(_form.OfficerPhone),
                        OfficerEmail = Trimmed(_form.OfficerEmail),
                        Sector = Trimmed(_form.Sector),
                        SectorArabic = Trimmed(_form.SectorArabic),
                        Description = Trimmed(_form.Description),
                        DescriptionArabic = Trimmed(_form.DescriptionArabic),
                        HallId = _form.HallId,
                        MapX = _form.MapX,
                        MapY = _form.MapY,
                    });
            }
            if (env is { Success: true })
            {
                _editOpen = false;
                _toast = new Toast("success", L["Admin.Booths.Saved"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Booths.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private async Task OnDeleteAsync(AdminBoothSummary row)
    {
        if (_busy) return;
        // Confirm destructive actions: a stray click pulls the booth from the
        // public exhibition list + 2D map immediately, with no undo today.
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm", L["Admin.Booths.Delete.Confirm"].Value);
        if (!confirmed) return;
        _busy = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.deleteJson",
                $"/account/api/admin/booths/{row.Id}");
            if (env is { Success: true })
            {
                _toast = new Toast("success", L["Admin.Booths.Deleted"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Booths.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    // Optional bilingual / description fields are nullable on the wire — send
    // null rather than an empty string when the admin leaves them blank.
    private static string? Trimmed(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void OnDescriptionEnChanged(ChangeEventArgs e) =>
        _form.Description = e.Value?.ToString() ?? string.Empty;

    private void OnDescriptionArChanged(ChangeEventArgs e) =>
        _form.DescriptionArabic = e.Value?.ToString() ?? string.Empty;

    private void OnHallIdChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _form.HallId = string.IsNullOrWhiteSpace(raw) ? null
            : (Guid.TryParse(raw, out var g) ? g : (Guid?)null);
    }

    private void OnMapXChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _form.MapX = string.IsNullOrWhiteSpace(raw) ? null
            : (double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var n)
                ? n : (double?)null);
    }

    private void OnMapYChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _form.MapY = string.IsNullOrWhiteSpace(raw) ? null
            : (double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var n)
                ? n : (double?)null);
    }
}
