@* Reusable Visitor View form, hosted by CrudShell (popup or full page)
   from VisitorsList. Inherits CrudViewDeleteFormBase so it exposes the standard
   surface (IsDelete / Initial / OnDeleted / OnCancel). This page has NO
   single-row delete path — a row "delete" on the visitors grid opens the
   reason-gated bulk-delete dialog on the list page (preserved there) — so this
   form is DETAILS-ONLY: it never renders a Delete button and never raises
   OnDeleted. It loads the full profile via the admin read
   (/account/api/admin/visitors/{id}/profile) and renders the ID document image
   inline, exactly as the inline SimfModal Details flow did. *@
@inherits CrudViewDeleteFormBase<AdminUserSummary>

@if (_loading)
{
    <p>@L["Admin.Pending.View.Loading"]</p>
}
else if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}
else if (_profile is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.Pending.View.Field.Email"]</dt>
        <dd>@_profile.Email</dd>
        <dt>@L["Admin.Pending.View.Field.DisplayName"]</dt>
        <dd>@_profile.DisplayName</dd>
        <dt>@L["Admin.Pending.View.Field.UserType"]</dt>
        <dd>@_profile.UserType</dd>
        <dt>@L["Admin.Users.Details.Field.State"]</dt>
        <dd>@_profile.AccountState</dd>
        <dt>@L["Admin.Pending.View.Field.ProfileType"]</dt>
        <dd>@(_profile.ProfileTypeName ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
        <dt>@L["Admin.Pending.View.Field.Created"]</dt>
        <dd>@_profile.CreatedAt.FormatSaudi("dd-MM-yyyy hh:mm tt")</dd>
    </dl>
    <dl class="simf-dl">
        <dt>@L["Admin.Pending.View.Field.ArabicName"]</dt>
        <dd>@(_profile.ArabicName ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
        <dt>@L["Admin.Pending.View.Field.EnglishName"]</dt>
        <dd>@(_profile.EnglishName ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
        <dt>@L["Admin.Pending.View.Field.Nationality"]</dt>
        <dd>@(_profile.NationalityCode ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
        <dt>@L["Admin.Pending.View.Field.DateOfBirth"]</dt>
        <dd>@(_profile.DateOfBirth?.ToString("dd-MM-yyyy") ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
        <dt>@L["Admin.Pending.View.Field.PlaceOfBirth"]</dt>
        <dd>@(_profile.PlaceOfBirth ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
        <dt>@L["Admin.Pending.View.Field.IdentityType"]</dt>
        <dd>@IdentityTypeLabel(_profile)</dd>
        <dt>@L["Admin.Pending.View.Field.IdentityNumber"]</dt>
        <dd>@(IdentityNumber(_profile) ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
        <dt>@L["Admin.Pending.View.Field.SaudiMobile"]</dt>
        <dd>@(_profile.SaudiMobile ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
        <dt>@L["Admin.Pending.View.Field.InternationalMobile"]</dt>
        <dd>@(_profile.InternationalMobile ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
        <dt>@L["Admin.Pending.View.Field.InterestCount"]</dt>
        <dd>@_profile.InterestIds.Count</dd>
        <dt>@L["Admin.Pending.View.Field.QrId"]</dt>
        <dd>@(_profile.QrId ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
    </dl>
    @if (_profile.HasIdImage)
    {
        <div class="simf-walkin__id-image">
            <h4>@L["Admin.Pending.View.Field.IdImage"]</h4>
            <img src="@($"/account/api/admin/visitors/{_profile.Id}/id-document?v={SimfClock.Now.Ticks}")"
                 alt="@L["Admin.Pending.View.Field.IdImage"]" />
        </div>
    }
    @* The visitor's profile photo (avatar) alongside the
       ID image, streamed from the admin avatar-fetch route (Visitors.View). *@
    @if (_profile.HasAvatar)
    {
        <AdminProfilePhotoBlock Heading="@L["Admin.Pending.View.Field.Photo"]"
                                Src="@($"/account/api/admin/visitors/{_profile.Id}/avatar?v={SimfClock.Now.Ticks}")" />
    }
    @* Flip this visitor into a partner (Other) type. *@
    <AuthorizedAction Permission="@PermissionCatalog.Accounts.ChangeType">
        <ChangeAccountTypeBlock AccountId="_profile.Id" IsVisitorScope="true"
                                OnChanged="OnCancel" />
    </AuthorizedAction>
}

<div class="simf-form__actions">
    <SimfButton Type="button" Variant="secondary" OnClick="OnCancel">
        @L["Admin.Visitors.Details.Close"]
    </SimfButton>
</div>
