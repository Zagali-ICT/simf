@* D-199 (CP UI for D-199 sponsors, Mockup page 23) — admin CRUD over the
   public sponsors list. The public screen groups logos by tier (Platinum
   first, then Gold, Silver, Bronze) then orders by DisplayOrder asc, NameAr
   asc within a tier — admins control tier, name (En/Ar), logo path, link,
   display order and the active flag here. Centralized dialog/full-page framing
   D-353: Add / Edit / View / Delete are hosted by CrudShell, which frames the
   reusable SponsorsAddEdit and SponsorsViewDelete forms as a popup or a full
   page per the admin's toolbar choice (persisted in localStorage via
   CpPreferences). The inline SimfModal form + native confirm() delete it used to
   carry are gone. D-356: Excel export/import wired through CrudGridExcel. *@
@page "/admin/sponsors"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Sponsors.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject CpPreferences Prefs

<PageTitle>@L["Admin.Sponsors.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Sponsors.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminSponsorSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.NameEn)"
                          Caption="@L["Admin.Sponsors.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Sponsors.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminSponsorSummary" Key="nameEn"
                                        Header="@L["Admin.Sponsors.Col.NameEn"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.NameEn</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSponsorSummary" Key="nameAr"
                                        Header="@L["Admin.Sponsors.Col.NameAr"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.NameAr</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSponsorSummary" Key="tier"
                                        Header="@L["Admin.Sponsors.Col.Tier"]"
                                        Sortable="true">
                        <CellTemplate>@context.TierName</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSponsorSummary" Key="logo"
                                        Header="@L["Admin.Sponsors.Col.Logo"]">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.LogoRelativePath) ? "—" : context.LogoRelativePath)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSponsorSummary" Key="url"
                                        Header="@L["Admin.Sponsors.Col.Url"]">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.Url) ? "—" : context.Url)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSponsorSummary" Key="displayOrder"
                                        Header="@L["Admin.Sponsors.Col.DisplayOrder"]"
                                        Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSponsorSummary" Key="isActive"
                                        Header="@L["Admin.Sponsors.Col.Active"]"
                                        Sortable="true">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Sponsors.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="sponsors"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Sponsors.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <SponsorsAddEdit IsEdit="_isEdit" Initial="_target"
                             OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <SponsorsViewDelete IsDelete="_isDelete" Initial="_target"
                                OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@code {
    private record Toast(string Variant, string Message);

    private enum FormKind { None, AddEdit, ViewDelete }

    private const string PageKey = "sponsors";

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminSponsorSummary> _page = new();
    private bool _loading;
    private Toast? _toast;

    private CrudPresentation _presentation = CrudPresentation.Dialog;
    private FormKind _form = FormKind.None;
    private bool _isEdit;
    private bool _isDelete;
    private AdminSponsorDetail? _target;
    private CrudGridExcel? _excel;

    private bool FormOpen => _form != FormKind.None;
    private bool GridHidden => FormOpen && _presentation == CrudPresentation.Page;

    private string FormTitle => _form switch
    {
        FormKind.AddEdit => _isEdit
            ? L["Admin.Sponsors.Edit.Title"]
            : L["Admin.Sponsors.Add.Title"],
        FormKind.ViewDelete => _isDelete
            ? L["Admin.Sponsors.Delete.Title"]
            : L["Admin.Sponsors.Details.Title"],
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _presentation = await Prefs.GetPresentationAsync(PageKey);
        await LoadAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminSponsorSummary>>>(
                "simfAccount.postJson",
                "/account/api/admin/sponsors/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Sponsors.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _toast = null;
        _form = FormKind.AddEdit;
        _isEdit = false;
        _target = null;
        return Task.CompletedTask;
    }

    private async Task OnEditAsync(AdminSponsorSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.AddEdit;
        _isEdit = true;
        _target = detail;
    }

    private async Task OnDetailsAsync(AdminSponsorSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = false;
        _target = detail;
    }

    private async Task OnDeleteAsync(AdminSponsorSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = true;
        _target = detail;
    }

    // Edit / View / Delete all work against the full detail — the grid summary
    // omits ContactId (SIMF-FDS-014 / D-283), so editing from a summary-only
    // form would wipe an existing link. Returns null and surfaces a toast on
    // failure.
    private async Task<AdminSponsorDetail?> LoadDetailAsync(Guid id)
    {
        _toast = null;
        var env = await JS.InvokeAsync<ApiResult<AdminSponsorDetail>>(
            "simfAccount.getJson", $"/account/api/admin/sponsors/{id}");
        if (env is { Success: true, Data: not null })
        {
            return env.Data;
        }
        _toast = new Toast("error",
            env?.Error?.MessageForCurrentCulture()
            ?? L["Admin.Sponsors.LoadFailed"]);
        return null;
    }

    private void CloseForm()
    {
        _form = FormKind.None;
        _target = null;
    }

    // D-356 — Excel export/import wired to the reusable CrudGridExcel component.
    private Task OnExportAsync(IReadOnlyList<AdminSponsorSummary> selected) =>
        _excel!.ExportAsync(selected.Select(row => row.Id).ToList(), _query);

    private Task OnImportAsync() => _excel!.TriggerImportAsync();

    private async Task OnImportedAsync()
    {
        _toast = new Toast("success", L["Grid.Import.Done"]);
        await LoadAsync();
    }

    private void OnExcelError(string message) => _toast = new Toast("error", message);

    private async Task OnSavedAsync(AdminSponsorDetail saved)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.Sponsors.Saved"]);
        await LoadAsync();
    }

    private async Task OnDeletedAsync(AdminSponsorDetail deleted)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.Sponsors.Deleted"]);
        await LoadAsync();
    }
}
