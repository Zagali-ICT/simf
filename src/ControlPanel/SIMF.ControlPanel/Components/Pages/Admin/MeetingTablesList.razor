@* SIMF-FDS-013 (D-248) — flexible hall configuration: set a hall's purpose,
   define / generate meeting tables (random-by-count or by row-column), and
   reserve hall space (whole / random-by-count / row-column) over a time-slot.
   Mirrors BoothsList. *@
@page "/admin/meeting-tables"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.MeetingTables.View)]
@using SIMF.Contracts.BusinessMeetings
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.MeetingTables.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.MeetingTables.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.MeetingTables.Field.Hall"]</span>
            <select class="simf-field__input" value="@(_hallId?.ToString() ?? string.Empty)"
                    @onchange="OnHallChangedAsync" disabled="@_busy">
                <option value="">@L["Admin.MeetingTables.Field.HallChoose"]</option>
                @foreach (var hall in _halls)
                {
                    <option value="@hall.Id">@hall.Name — @hall.NameArabic</option>
                }
            </select>
        </label>

        @if (_hallId is not null)
        {
            <div class="simf-form__inline">
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.MeetingTables.Field.Purpose"]</span>
                    <select class="simf-field__input" value="@_purpose" @onchange="OnPurposeChanged"
                            disabled="@_busy">
                        <option value="0">@L["Admin.MeetingTables.Purpose.General"]</option>
                        <option value="1">@L["Admin.MeetingTables.Purpose.Booth"]</option>
                        <option value="2">@L["Admin.MeetingTables.Purpose.Session"]</option>
                        <option value="3">@L["Admin.MeetingTables.Purpose.Meeting"]</option>
                    </select>
                </label>
                <AuthorizedAction Permission="@PermissionCatalog.Halls.Edit">
                    <SimfButton Type="button" Disabled="_busy" OnClick="SavePurposeAsync">
                        @L["Admin.MeetingTables.Purpose.Save"]
                    </SimfButton>
                </AuthorizedAction>
            </div>

            <h3>@L["Admin.MeetingTables.Tables.Heading"]</h3>
            <SimfDataGrid TItem="MeetingTableRow"
                          Query="_tableQuery" Page="_tablePage" Loading="_tableLoading"
                          OnQueryChanged="OnTableQueryChangedAsync"
                          Multiselect="true" RowKey="@(r => r.Id.ToString())" RowLabel="@(r => r.Code)"
                          Caption="@L["Admin.MeetingTables.Tables.Heading"]"
                          OnAdd="OnAddTable" OnEditOne="OnEditTable" OnDeleteOne="OnDeleteTableAsync"
                          PrevLabel="@L["Grid.Prev"]" NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]" LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]" PageFormatter="@FormatPage"
                          LoadingLabel="@L["Grid.Loading"]" ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]" SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Admin.MeetingTables.AddTable"]"
                          EditLabel="@L["Grid.Edit"]" DeleteLabel="@L["Grid.Delete"]"
                          SummaryFormatter="@FormatSummary">
                <Columns>
                    <SimfDataGridColumn TItem="MeetingTableRow" Key="code" Header="@L["Admin.MeetingTables.Col.Code"]">
                        <CellTemplate>@context.Code</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="MeetingTableRow" Key="row" Header="@L["Admin.MeetingTables.Col.Row"]">
                        <CellTemplate>@(context.RowLabel ?? "—")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="MeetingTableRow" Key="column" Header="@L["Admin.MeetingTables.Col.Column"]">
                        <CellTemplate>@(context.ColumnNumber?.ToString() ?? "—")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="MeetingTableRow" Key="capacity" Header="@L["Admin.MeetingTables.Col.Capacity"]">
                        <CellTemplate>@context.Capacity</CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <CustomToolbar>
                    <SimfToolbarButton Icon="flask" Title="@L["Admin.MeetingTables.Generate"]" OnClick="OnGenerate">
                        @L["Admin.MeetingTables.Generate"]
                    </SimfToolbarButton>
                </CustomToolbar>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.MeetingTables.Tables.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <h3>@L["Admin.MeetingTables.Allocations.Heading"]</h3>
            <SimfDataGrid TItem="HallAllocationRow"
                          Query="_allocQuery" Page="_allocPage" Loading="_allocLoading"
                          OnQueryChanged="OnAllocQueryChangedAsync"
                          Multiselect="true" RowKey="@(r => r.Id.ToString())" RowLabel="@(r => r.Purpose.ToString())"
                          Caption="@L["Admin.MeetingTables.Allocations.Heading"]"
                          OnAdd="OnAddAllocation" OnDeleteOne="OnReleaseAllocationAsync"
                          PrevLabel="@L["Grid.Prev"]" NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]" LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]" PageFormatter="@FormatPage"
                          LoadingLabel="@L["Grid.Loading"]" ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]" SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Admin.MeetingTables.AddAllocation"]"
                          DeleteLabel="@L["Admin.MeetingTables.Release"]"
                          SummaryFormatter="@FormatSummary">
                <Columns>
                    <SimfDataGridColumn TItem="HallAllocationRow" Key="purpose" Header="@L["Admin.MeetingTables.Col.Purpose"]">
                        <CellTemplate>@context.Purpose</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="HallAllocationRow" Key="mode" Header="@L["Admin.MeetingTables.Col.Mode"]">
                        <CellTemplate>@context.Mode @(context.Mode == HallAllocationMode.RandomByCount ? $"({context.UnitCount})" : context.Mode == HallAllocationMode.RowColumn ? $"({context.RowColumnSpec})" : "")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="HallAllocationRow" Key="start" Header="@L["Admin.MeetingTables.Col.Start"]">
                        <CellTemplate>@context.StartUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="HallAllocationRow" Key="end" Header="@L["Admin.MeetingTables.Col.End"]">
                        <CellTemplate>@context.EndUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.MeetingTables.Allocations.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        }
    </div>
</div>

@if (_tableOpen)
{
    <SimfModal Open="true"
               Title="@(_isEditTable ? L["Admin.MeetingTables.EditTable.Title"] : L["Admin.MeetingTables.AddTable.Title"])"
               OnClose="@(() => _tableOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <SimfTextField Label="@L["Admin.MeetingTables.Col.Code"]"
                               Value="@_tableForm.Code"
                               ValueChanged="@(v => _tableForm.Code = v)"
                               ValueExpression="@(() => _tableForm.Code)"
                               MaxLength="16" Disabled="_busy" />
                <SimfTextField Label="@L["Admin.MeetingTables.Col.Row"]"
                               Value="@_tableForm.RowLabel"
                               ValueChanged="@(v => _tableForm.RowLabel = v)"
                               ValueExpression="@(() => _tableForm.RowLabel)"
                               MaxLength="8" Disabled="_busy" />
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.MeetingTables.Col.Column"]</span>
                    <input class="simf-field__input" type="number" step="1" min="1"
                           value="@_tableForm.ColumnNumber" @onchange="OnColumnChanged" disabled="@_busy" />
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.MeetingTables.Col.Capacity"]</span>
                    <input class="simf-field__input" type="number" step="1" min="2" max="100"
                           value="@_tableForm.Capacity" @onchange="OnCapacityChanged" disabled="@_busy" />
                </label>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="@(() => _tableOpen = false)">
                @L["Admin.MeetingTables.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SaveTableAsync" Loading="_busy">
                @L["Admin.MeetingTables.Save"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_generateOpen)
{
    <SimfModal Open="true" Title="@L["Admin.MeetingTables.Generate.Title"]"
               OnClose="@(() => _generateOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.MeetingTables.Col.Mode"]</span>
                    <select class="simf-field__input" value="@((int)_genForm.Mode)"
                            @onchange="OnGenModeChanged" disabled="@_busy">
                        <option value="@((int)HallAllocationMode.RandomByCount)">@L["Admin.MeetingTables.Mode.RandomByCount"]</option>
                        <option value="@((int)HallAllocationMode.RowColumn)">@L["Admin.MeetingTables.Mode.RowColumn"]</option>
                    </select>
                </label>
                @if (_genForm.Mode == HallAllocationMode.RandomByCount)
                {
                    <label class="simf-field">
                        <span class="simf-field__label">@L["Admin.MeetingTables.Generate.Count"]</span>
                        <input class="simf-field__input" type="number" step="1" min="1"
                               value="@_genForm.Count" @onchange="OnGenCountChanged" disabled="@_busy" />
                    </label>
                }
                else
                {
                    <label class="simf-field">
                        <span class="simf-field__label">@L["Admin.MeetingTables.Generate.Spec"]</span>
                        <input class="simf-field__input" type="text" placeholder="A1,A2,B3"
                               value="@_genForm.RowColumnSpec" @onchange="OnGenSpecChanged" disabled="@_busy" />
                    </label>
                }
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.MeetingTables.Col.Capacity"]</span>
                    <input class="simf-field__input" type="number" step="1" min="2" max="100"
                           value="@_genForm.Capacity" @onchange="OnGenCapacityChanged" disabled="@_busy" />
                </label>
                <SimfCheckbox Value="_genForm.Reset" ValueChanged="@(v => _genForm.Reset = v)" Disabled="_busy">
                    @L["Admin.MeetingTables.Generate.Reset"]
                </SimfCheckbox>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="@(() => _generateOpen = false)">
                @L["Admin.MeetingTables.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="GenerateAsync" Loading="_busy">
                @L["Admin.MeetingTables.Generate.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_allocOpen)
{
    <SimfModal Open="true" Title="@L["Admin.MeetingTables.AddAllocation.Title"]"
               OnClose="@(() => _allocOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.MeetingTables.Col.Purpose"]</span>
                    <select class="simf-field__input" value="@((int)_allocForm.Purpose)"
                            @onchange="OnAllocPurposeChanged" disabled="@_busy">
                        <option value="3">@L["Admin.MeetingTables.Purpose.Meeting"]</option>
                        <option value="2">@L["Admin.MeetingTables.Purpose.Session"]</option>
                        <option value="1">@L["Admin.MeetingTables.Purpose.Booth"]</option>
                        <option value="0">@L["Admin.MeetingTables.Purpose.General"]</option>
                    </select>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.MeetingTables.Col.Mode"]</span>
                    <select class="simf-field__input" value="@((int)_allocForm.Mode)"
                            @onchange="OnAllocModeChanged" disabled="@_busy">
                        <option value="@((int)HallAllocationMode.Whole)">@L["Admin.MeetingTables.Mode.Whole"]</option>
                        <option value="@((int)HallAllocationMode.RandomByCount)">@L["Admin.MeetingTables.Mode.RandomByCount"]</option>
                        <option value="@((int)HallAllocationMode.RowColumn)">@L["Admin.MeetingTables.Mode.RowColumn"]</option>
                    </select>
                </label>
                @if (_allocForm.Mode == HallAllocationMode.RandomByCount)
                {
                    <label class="simf-field">
                        <span class="simf-field__label">@L["Admin.MeetingTables.Generate.Count"]</span>
                        <input class="simf-field__input" type="number" step="1" min="1"
                               value="@_allocForm.UnitCount" @onchange="OnAllocCountChanged" disabled="@_busy" />
                    </label>
                }
                else if (_allocForm.Mode == HallAllocationMode.RowColumn)
                {
                    <label class="simf-field">
                        <span class="simf-field__label">@L["Admin.MeetingTables.Generate.Spec"]</span>
                        <input class="simf-field__input" type="text" placeholder="A1,A2,B3"
                               value="@_allocForm.RowColumnSpec" @onchange="OnAllocSpecChanged" disabled="@_busy" />
                    </label>
                }
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.MeetingTables.Col.Start"]</span>
                    <input class="simf-field__input" type="datetime-local"
                           value="@_allocStartText" @onchange="OnAllocStartChanged" disabled="@_busy" />
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.MeetingTables.Col.End"]</span>
                    <input class="simf-field__input" type="datetime-local"
                           value="@_allocEndText" @onchange="OnAllocEndChanged" disabled="@_busy" />
                </label>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="@(() => _allocOpen = false)">
                @L["Admin.MeetingTables.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SaveAllocationAsync" Loading="_busy">
                @L["Admin.MeetingTables.Save"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private sealed class TableForm
    {
        public string Code { get; set; } = string.Empty;
        public string RowLabel { get; set; } = string.Empty;
        public int? ColumnNumber { get; set; }
        public int Capacity { get; set; } = 2;
    }

    private List<AdminHallSummary> _halls = new();
    private Guid? _hallId;
    private int _purpose;
    private GridQuery _tableQuery = new() { Top = 20 };
    private GridPage<MeetingTableRow> _tablePage = new();
    private bool _tableLoading;

    private GridQuery _allocQuery = new() { Top = 20 };
    private GridPage<HallAllocationRow> _allocPage = new();
    private bool _allocLoading;

    private bool _busy;
    private Toast? _toast;

    private bool _tableOpen;
    private bool _isEditTable;
    private Guid _editingTableId;
    private TableForm _tableForm = new();

    private bool _generateOpen;
    private GenerateMeetingTablesRequest _genForm = new();

    private bool _allocOpen;
    private CreateHallAllocationRequest _allocForm = new();
    private string _allocStartText = string.Empty;
    private string _allocEndText = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadHallsAsync();

    private async Task LoadHallsAsync()
    {
        var env = await JS.InvokeAsync<ApiResult<GridPage<AdminHallSummary>>>(
            "simfAccount.postJson", "/account/api/admin/halls/list", new GridQuery { Top = 500 });
        if (env is { Success: true, Data: not null })
        {
            _halls = env.Data.Items.Where(h => h.IsActive).OrderBy(h => h.Name).ToList();
        }
        else
        {
            _toast = new Toast("error",
                env?.Error?.MessageForCurrentCulture() ?? L["Admin.MeetingTables.LoadFailed"]);
        }
    }

    private async Task OnHallChangedAsync(ChangeEventArgs e)
    {
        _hallId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        _toast = null;
        if (_hallId is { } hid)
        {
            _purpose = _halls.FirstOrDefault(h => h.Id == hid)?.Purpose ?? 0;
            _tableQuery = new GridQuery { Top = _tableQuery.Top };
            _allocQuery = new GridQuery { Top = _allocQuery.Top };
            await LoadTablesAsync();
            await LoadAllocationsAsync();
        }
    }

    private void OnPurposeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) _purpose = v;
    }

    private async Task SavePurposeAsync()
    {
        if (_busy || _hallId is not { } hid) return;
        _busy = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.putJson", $"/account/api/admin/halls/{hid}/purpose",
                new SetHallPurposeRequest { Purpose = (HallPurpose)_purpose });
            if (env is { Success: true })
            {
                _toast = new Toast("success", L["Admin.MeetingTables.Purpose.Saved"]);
                // reflect the new purpose in the cached hall list
                var idx = _halls.FindIndex(h => h.Id == hid);
                if (idx >= 0) _halls[idx] = _halls[idx] with { Purpose = _purpose };
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture() ?? L["Admin.MeetingTables.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task OnTableQueryChangedAsync(GridQuery next)
    {
        _tableQuery = next;
        await LoadTablesAsync();
    }

    private async Task LoadTablesAsync()
    {
        if (_hallId is not { } hid) return;
        _tableLoading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<MeetingTableRow>>>(
                "simfAccount.postJson", $"/account/api/admin/halls/{hid}/meeting-tables/list", _tableQuery);
            if (env is { Success: true, Data: not null }) _tablePage = env.Data;
        }
        finally { _tableLoading = false; }
    }

    private async Task OnAllocQueryChangedAsync(GridQuery next)
    {
        _allocQuery = next;
        await LoadAllocationsAsync();
    }

    private async Task LoadAllocationsAsync()
    {
        if (_hallId is not { } hid) return;
        _allocLoading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<HallAllocationRow>>>(
                "simfAccount.postJson", $"/account/api/admin/halls/{hid}/hall-allocations/list", _allocQuery);
            if (env is { Success: true, Data: not null }) _allocPage = env.Data;
        }
        finally { _allocLoading = false; }
    }

    private void OnAddTable()
    {
        _isEditTable = false;
        _editingTableId = Guid.Empty;
        _tableForm = new TableForm();
        _tableOpen = true;
        _toast = null;
    }

    private void OnEditTable(MeetingTableRow row)
    {
        _isEditTable = true;
        _editingTableId = row.Id;
        _tableForm = new TableForm
        {
            Code = row.Code,
            RowLabel = row.RowLabel ?? string.Empty,
            ColumnNumber = row.ColumnNumber,
            Capacity = row.Capacity,
        };
        _tableOpen = true;
        _toast = null;
    }

    private async Task SaveTableAsync()
    {
        if (_busy || _hallId is not { } hid) return;
        if (string.IsNullOrWhiteSpace(_tableForm.Code))
        {
            _toast = new Toast("error", L["Admin.MeetingTables.Validation.Code"]);
            return;
        }
        _busy = true;
        try
        {
            ApiResult<MeetingTableRow>? env;
            if (_isEditTable)
            {
                env = await JS.InvokeAsync<ApiResult<MeetingTableRow>>(
                    "simfAccount.putJson", $"/account/api/admin/meeting-tables/{_editingTableId}",
                    new UpdateMeetingTableRequest
                    {
                        Code = _tableForm.Code,
                        RowLabel = Trimmed(_tableForm.RowLabel),
                        ColumnNumber = _tableForm.ColumnNumber,
                        Capacity = _tableForm.Capacity,
                    });
            }
            else
            {
                env = await JS.InvokeAsync<ApiResult<MeetingTableRow>>(
                    "simfAccount.postJson", $"/account/api/admin/halls/{hid}/meeting-tables",
                    new CreateMeetingTableRequest
                    {
                        Code = _tableForm.Code,
                        RowLabel = Trimmed(_tableForm.RowLabel),
                        ColumnNumber = _tableForm.ColumnNumber,
                        Capacity = _tableForm.Capacity,
                    });
            }
            if (env is { Success: true })
            {
                _tableOpen = false;
                _toast = new Toast("success", L["Admin.MeetingTables.Saved"]);
                await LoadTablesAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture() ?? L["Admin.MeetingTables.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private async Task OnDeleteTableAsync(MeetingTableRow row)
    {
        if (_busy) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", L["Admin.MeetingTables.Delete.Confirm"].Value);
        if (!confirmed) return;
        _busy = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.deleteJson", $"/account/api/admin/meeting-tables/{row.Id}");
            if (env is { Success: true })
            {
                _toast = new Toast("success", L["Admin.MeetingTables.Deleted"]);
                await LoadTablesAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture() ?? L["Admin.MeetingTables.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private void OnGenerate()
    {
        _genForm = new GenerateMeetingTablesRequest { Mode = HallAllocationMode.RandomByCount, Capacity = 2 };
        _generateOpen = true;
        _toast = null;
    }

    private async Task GenerateAsync()
    {
        if (_busy || _hallId is not { } hid) return;
        _busy = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<MeetingTablesGenerated>>(
                "simfAccount.postJson", $"/account/api/admin/halls/{hid}/meeting-tables/generate", _genForm);
            if (env is { Success: true })
            {
                _generateOpen = false;
                _toast = new Toast("success", L["Admin.MeetingTables.Generated"]);
                await LoadTablesAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture() ?? L["Admin.MeetingTables.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private void OnAddAllocation()
    {
        _allocForm = new CreateHallAllocationRequest
        {
            Purpose = HallPurpose.Meeting,
            Mode = HallAllocationMode.Whole,
        };
        _allocStartText = string.Empty;
        _allocEndText = string.Empty;
        _allocOpen = true;
        _toast = null;
    }

    private async Task SaveAllocationAsync()
    {
        if (_busy || _hallId is not { } hid) return;
        if (!TryParseUtc(_allocStartText, out var start) || !TryParseUtc(_allocEndText, out var end) || end <= start)
        {
            _toast = new Toast("error", L["Admin.MeetingTables.Validation.Slot"]);
            return;
        }
        if ((_allocForm.Mode == HallAllocationMode.RandomByCount && _allocForm.UnitCount is not > 0)
            || (_allocForm.Mode == HallAllocationMode.RowColumn
                && string.IsNullOrWhiteSpace(_allocForm.RowColumnSpec)))
        {
            _toast = new Toast("error", L["Admin.MeetingTables.Validation.Allocation"]);
            return;
        }
        _busy = true;
        try
        {
            _allocForm.StartUtc = start;
            _allocForm.EndUtc = end;
            var env = await JS.InvokeAsync<ApiResult<HallAllocationRow>>(
                "simfAccount.postJson", $"/account/api/admin/halls/{hid}/hall-allocations", _allocForm);
            if (env is { Success: true })
            {
                _allocOpen = false;
                _toast = new Toast("success", L["Admin.MeetingTables.Saved"]);
                await LoadAllocationsAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture() ?? L["Admin.MeetingTables.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private async Task OnReleaseAllocationAsync(HallAllocationRow row)
    {
        if (_busy) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", L["Admin.MeetingTables.Release.Confirm"].Value);
        if (!confirmed) return;
        _busy = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.deleteJson", $"/account/api/admin/hall-allocations/{row.Id}");
            if (env is { Success: true })
            {
                _toast = new Toast("success", L["Admin.MeetingTables.Released"]);
                await LoadAllocationsAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture() ?? L["Admin.MeetingTables.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

