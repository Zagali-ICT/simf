@* D-353 — reusable Interest View/Delete form, hosted by CrudShell (as a popup
   or a full page) from InterestsList.razor. Inherits CrudViewDeleteFormBase so
   it exposes the standard parameter surface (IsDelete / Initial / OnDeleted /
   OnCancel). Read-only details always show; when IsDelete=true a Deactivate
   button appears and a SimfConfirm gates the destructive call. Replaces the
   inline details modal + one-click delete that lived in InterestsList. *@
@inherits CrudViewDeleteFormBase<AdminInterestSummary>
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.Interests.Column.Name"]</dt>
        <dd>@Initial.Name</dd>
        <dt>@L["Admin.Interests.Column.NameArabic"]</dt>
        <dd>@Initial.NameArabic</dd>
        <dt>@L["Admin.Interests.Column.DisplayOrder"]</dt>
        <dd>@Initial.DisplayOrder</dd>
        <dt>@L["Admin.Interests.Column.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Admin.Interests.Active.Yes"] : L["Admin.Interests.Active.No"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.Interests.Action.Deactivate"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Interests.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.Interests.Delete.Title"]"
                 Message="@string.Format(L["Admin.Interests.Delete.Message"], Initial.Name)"
                 ConfirmLabel="@L["Admin.Interests.Action.Deactivate"]"
                 CancelLabel="@L["Admin.Interests.Add.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" />
}

@code {
    private bool _busy;
    private bool _confirming;
    private string? _error;

    private async Task ConfirmDeleteAsync()
    {
        if (_busy || Initial is null) return;
        _busy = true;
        _error = null;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.deleteJson", $"/account/api/admin/interests/{Initial.Id}");
            if (envelope is { Success: true })
            {
                _confirming = false;
                await OnDeleted.InvokeAsync(Initial);
            }
            else
            {
                // Close the confirm first so the error lands on the visible
                // form body, not behind the (still-open) confirm overlay.
                _confirming = false;
                _error = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Interests.Fallback"];
            }
        }
        catch (Exception)
        {
            _confirming = false;
            _error = L["Admin.Interests.Fallback"];
        }
        finally { _busy = false; }
    }
}
