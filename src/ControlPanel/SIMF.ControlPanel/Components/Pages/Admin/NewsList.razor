@* D-199 (CP UI for the D-199 News module, Mockup screen 29 authoring) —
   admin CRUD over the public News feed. The public feed is sorted by
   PublishedAt / DisplayOrder; admins control the title, body, category,
   image, publish date and order here. The admin grid shows every row
   regardless of IsActive / publish window so editors can manage drafts
   and reactivate soft-deleted items. Centralized dialog/full-page framing
   D-353: Add / Edit / View / Delete are hosted by CrudShell, which frames
   the reusable NewsAddEdit and NewsViewDelete forms as a popup or a full
   page per the admin's toolbar choice (persisted in localStorage via
   CpPreferences). The inline SimfModal form + native confirm() delete it
   used to carry are gone. *@
@page "/admin/news"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.News.View)]
@using SIMF.Contracts.PublicRelations
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject CpPreferences Prefs

<PageTitle>@L["Admin.News.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.News.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminNewsSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Title)"
                          Caption="@L["Admin.News.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.News.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="title"
                                        Header="@L["Admin.News.Col.TitleEn"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Title</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="titlearabic"
                                        Header="@L["Admin.News.Col.TitleAr"]"
                                        Filterable="true">
                        <CellTemplate>@context.TitleArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="category"
                                        Header="@L["Admin.News.Col.CategoryEn"]"
                                        Filterable="true">
                        <CellTemplate>@context.Category</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="categoryarabic"
                                        Header="@L["Admin.News.Col.CategoryAr"]"
                                        Filterable="true">
                        <CellTemplate>@context.CategoryArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="publishedat"
                                        Header="@L["Admin.News.Col.PublishedAt"]"
                                        Sortable="true">
                        <CellTemplate>@context.PublishedAt.ToString("yyyy-MM-dd")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="displayorder"
                                        Header="@L["Admin.News.Col.DisplayOrder"]"
                                        Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="isactive"
                                        Header="@L["Admin.News.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.News.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.News.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <NewsAddEdit IsEdit="_isEdit" Initial="_target"
                         OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <NewsViewDelete IsDelete="_isDelete" Initial="_target"
                            OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@code {
    private record Toast(string Variant, string Message);

    private enum FormKind { None, AddEdit, ViewDelete }

    private const string PageKey = "news";

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminNewsSummary> _page = new();
    private bool _loading;
    private Toast? _toast;

    private CrudPresentation _presentation = CrudPresentation.Dialog;
    private FormKind _form = FormKind.None;
    private bool _isEdit;
    private bool _isDelete;
    private AdminNewsDetail? _target;

    private bool FormOpen => _form != FormKind.None;
    private bool GridHidden => FormOpen && _presentation == CrudPresentation.Page;

    private string FormTitle => _form switch
    {
        FormKind.AddEdit => _isEdit
            ? L["Admin.News.Edit.Title"]
            : L["Admin.News.Add.Title"],
        FormKind.ViewDelete => _isDelete
            ? L["Admin.News.Delete.Title"]
            : L["Admin.News.Details.Title"],
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _presentation = await Prefs.GetPresentationAsync(PageKey);
        await LoadAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Admin.News.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminNewsSummary>>>(
                "simfAccount.postJson",
                "/account/api/admin/news/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.News.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _toast = null;
        _form = FormKind.AddEdit;
        _isEdit = false;
        _target = null;
        return Task.CompletedTask;
    }

    private async Task OnEditAsync(AdminNewsSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.AddEdit;
        _isEdit = true;
        _target = detail;
    }

    private async Task OnDetailsAsync(AdminNewsSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = false;
        _target = detail;
    }

    private async Task OnDeleteAsync(AdminNewsSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = true;
        _target = detail;
    }

    // Edit / View / Delete all work against the full detail (the grid summary
    // omits the body / excerpt / image). Returns null and surfaces a toast on
    // failure.
    private async Task<AdminNewsDetail?> LoadDetailAsync(Guid id)
    {
        _toast = null;
        var env = await JS.InvokeAsync<ApiResult<AdminNewsDetail>>(
            "simfAccount.getJson", $"/account/api/admin/news/{id}");
        if (env is { Success: true, Data: not null })
        {
            return env.Data;
        }
        _toast = new Toast("error",
            env?.Error?.MessageForCurrentCulture()
            ?? L["Admin.News.LoadFailed"]);
        return null;
    }

    private void CloseForm()
    {
        _form = FormKind.None;
        _target = null;
    }

    private async Task OnSavedAsync(AdminNewsDetail saved)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.News.Saved"]);
        await LoadAsync();
    }

    private async Task OnDeletedAsync(AdminNewsDetail deleted)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.News.Deleted"]);
        await LoadAsync();
    }
}
