@* The Control Panel authoring UI for the News module —
   admin CRUD over the public News feed. The public feed is sorted by
   PublishedAt / DisplayOrder; admins control the title, body, category,
   image, publish date and order here. The admin grid shows every row
   regardless of IsActive / publish window so editors can manage drafts
   and reactivate soft-deleted items. Add / Edit / View / Delete are
   hosted by CrudShell, which frames
   the reusable NewsAddEdit and NewsViewDelete forms as a popup or a full
   page per the admin's toolbar choice (persisted in localStorage via
   CpPreferences). The inline SimfModal form + native confirm() delete it
   used to carry are gone. *@
@page "/admin/news"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.News.View)]
@using SIMF.Contracts.PublicRelations

<PageTitle>@L["Admin.News.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.News.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <div class="simf-toast">
                    <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
                </div>
            }

            <SimfDataGrid TItem="AdminNewsSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Title)"
                          Caption="@L["Admin.News.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.News.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary"
                          AddPermission="@PermissionCatalog.News.Create"
                          EditPermission="@PermissionCatalog.News.Edit"
                          DeletePermission="@PermissionCatalog.News.Delete"
                          ImportPermission="@PermissionCatalog.News.Import"
                          ExportPermission="@PermissionCatalog.News.Export">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="title"
                                        Header="@L["Admin.News.Col.TitleEn"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>
                            <SimfIdentityCell ImageUrl="@ImageUrl(context)"
                                              Name="@context.Title"
                                              NameSecondary="@context.TitleArabic" />
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="titlearabic"
                                        Header="@L["Admin.News.Col.TitleAr"]"
                                        Filterable="true">
                        <CellTemplate>@context.TitleArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="category"
                                        Header="@L["Admin.News.Col.CategoryEn"]"
                                        Filterable="true">
                        <CellTemplate>@context.Category</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="categoryarabic"
                                        Header="@L["Admin.News.Col.CategoryAr"]"
                                        Filterable="true">
                        <CellTemplate>@context.CategoryArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="publishedat"
                                        Header="@L["Admin.News.Col.PublishedAt"]"
                                        Sortable="true">
                        <CellTemplate>@context.PublishedAt.ToString("dd-MM-yyyy")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="displayorder"
                                        Header="@L["Admin.News.Col.DisplayOrder"]"
                                        Sortable="true">
                        <CellTemplate>@context.DisplayOrder</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminNewsSummary" Key="isactive"
                                        Header="@L["Admin.News.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.News.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="news"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.News.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <NewsAddEdit IsEdit="_isEdit" Initial="_target"
                         OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <NewsViewDelete IsDelete="_isDelete" Initial="_target"
                            OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
