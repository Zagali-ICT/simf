@* D-202 Track-2 (CP UI for the D-202 statistics dashboard) — a read-only
   overview of live event counts aggregated across both DbContexts. Calls
   GET /account/api/admin/statistics → ApiResult<StatisticsDashboard> and
   renders each metric as a stat card. No create / edit / delete — every
   value is a live aggregate read computed on demand by the backend. *@
@page "/admin/statistics"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Statistics.View)]

<PageTitle>@L["Admin.Statistics.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Statistics.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        @if (_loading)
        {
            <p>@L["Admin.Statistics.Loading"]</p>
        }
        else if (_dashboard is null)
        {
            <SimfEmptyState Title="@L["Admin.Statistics.None"]" />
        }
        else
        {
            @* Reuse the existing .simf-form__actions flex-row layout so the
               cards wrap into a responsive grid — there is no dedicated
               stat-grid class in the component CSS this wave (same approach
               as RatingsList). *@
            <div class="simf-form__actions">
                <SimfStatCard Title="@L["Admin.Statistics.Stat.TotalAttendees"]"
                              Value="@Count(_dashboard.TotalAttendees)"
                              Href="/admin/attendees" />
                <SimfStatCard Title="@L["Admin.Statistics.Stat.ApprovedAttendees"]"
                              Value="@Count(_dashboard.ApprovedAttendees)"
                              Href="/admin/attendees" />
                <SimfStatCard Title="@L["Admin.Statistics.Stat.PendingApprovals"]"
                              Value="@Count(_dashboard.PendingApprovals)"
                              Href="/admin/visitors/pending" />
                <SimfStatCard Title="@L["Admin.Statistics.Stat.Sessions"]"
                              Value="@Count(_dashboard.Sessions)"
                              Href="/admin/sessions" />
                <SimfStatCard Title="@L["Admin.Statistics.Stat.Speakers"]"
                              Value="@Count(_dashboard.Speakers)"
                              Href="/admin/speakers" />
                <SimfStatCard Title="@L["Admin.Statistics.Stat.Booths"]"
                              Value="@Count(_dashboard.Booths)"
                              Href="/admin/booths" />
                <SimfStatCard Title="@L["Admin.Statistics.Stat.Sponsors"]"
                              Value="@Count(_dashboard.Sponsors)"
                              Href="/admin/sponsors" />
                <SimfStatCard Title="@L["Admin.Statistics.Stat.NewsArticles"]"
                              Value="@Count(_dashboard.NewsArticles)"
                              Href="/admin/news" />
                <SimfStatCard Title="@L["Admin.Statistics.Stat.MediaItems"]"
                              Value="@Count(_dashboard.MediaItems)"
                              Href="/admin/media-library" />
                <SimfStatCard Title="@L["Admin.Statistics.Stat.RatingsCount"]"
                              Value="@Count(_dashboard.RatingsCount)"
                              Href="/admin/ratings" />
                <SimfStatCard Title="@L["Admin.Statistics.Stat.AverageRating"]"
                              Value="@_dashboard.AverageRating.ToString("0.0", CultureInfo.InvariantCulture)"
                              Href="/admin/ratings" />
            </div>
        }
    </div>
</div>
