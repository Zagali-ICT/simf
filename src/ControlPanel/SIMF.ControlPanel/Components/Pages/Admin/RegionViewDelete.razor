@* Reusable Region View/Delete form, hosted by CrudShell (as a popup or
   a full page) from RegionsList.razor. Inherits CrudViewDeleteFormBase so it
   exposes the standard parameter surface (IsDelete / Initial / OnDeleted /
   OnCancel). Read-only details always show (including SortOrder + the created /
   updated timestamps the grid summary omits); when IsDelete=true a Deactivate
   button appears and a SimfConfirm gates the destructive call. Mirrors the
   Organisation View/Delete form. *@
@inherits CrudViewDeleteFormBase<AdminRegionDetail>
@using SIMF.Contracts.Regions

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.Regions.Col.Code"]</dt>
        <dd>@Initial.Code</dd>
        <dt>@L["Admin.Regions.Col.NameAr"]</dt>
        <dd>@Initial.NameArabic</dd>
        <dt>@L["Admin.Regions.Col.NameEn"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.Name) ? "—" : Initial.Name)</dd>
        <dt>@L["Admin.Regions.Field.SortOrder"]</dt>
        <dd>@Initial.SortOrder</dd>
        <dt>@L["Admin.Regions.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.Regions.Action.Deactivate"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Regions.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.Regions.Delete.Title"]"
                 Message="@string.Format(L["Admin.Regions.Delete.Message"], Initial.NameArabic)"
                 ConfirmLabel="@L["Admin.Regions.Action.Deactivate"]"
                 CancelLabel="@L["Admin.Regions.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" 
                 Permission="@PermissionCatalog.Regions.Delete"/>
}
