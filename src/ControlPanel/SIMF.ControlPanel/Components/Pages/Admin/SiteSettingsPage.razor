@* D-464 — CP "Site Settings" page: edit the public branding settings — the
   registration welcome message (bilingual) + the social-media links. Reads /
   writes the whitelisted site-settings keys via /admin/site-settings; the app +
   website consume them through GET /app/site-settings. Gated by Configuration.*. *@
@page "/admin/site-settings"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Configuration.Edit)]
@using SIMF.Contracts.Admin
@using SIMF.Contracts.Configuration
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.SiteSettings.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.SiteSettings.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toastMessage is not null)
        {
            <SimfAlert Variant="@_toastVariant">@_toastMessage</SimfAlert>
        }

        @if (_loading)
        {
            <p>@L["Admin.SiteSettings.Loading"]</p>
        }
        else
        {
            <EditForm EditContext="_editContext" OnSubmit="SaveAsync" class="simf-form">
                <div class="simf-form__fields">
                    <h3>@L["Admin.SiteSettings.Section.Registration"]</h3>
                    <p>@L["Admin.SiteSettings.Section.Registration.Hint"]</p>
                    <SimfTextField Label="@L["Admin.SiteSettings.Field.RegMessageAr"]"
                                   MaxLength="2048"
                                   @bind-Value="_model.RegistrationMessageAr" Disabled="_busy" />
                    <SimfTextField Label="@L["Admin.SiteSettings.Field.RegMessageEn"]"
                                   MaxLength="2048"
                                   @bind-Value="_model.RegistrationMessageEn" Disabled="_busy" />

                    <h3>@L["Admin.SiteSettings.Section.Social"]</h3>
                    <p>@L["Admin.SiteSettings.Section.Social.Hint"]</p>
                    <SimfTextField Label="Facebook" MaxLength="512"
                                   @bind-Value="_model.Facebook" Disabled="_busy" />
                    <SimfTextField Label="X (Twitter)" MaxLength="512"
                                   @bind-Value="_model.X" Disabled="_busy" />
                    <SimfTextField Label="Instagram" MaxLength="512"
                                   @bind-Value="_model.Instagram" Disabled="_busy" />
                    <SimfTextField Label="LinkedIn" MaxLength="512"
                                   @bind-Value="_model.LinkedIn" Disabled="_busy" />
                    <SimfTextField Label="YouTube" MaxLength="512"
                                   @bind-Value="_model.YouTube" Disabled="_busy" />
                    <SimfTextField Label="TikTok" MaxLength="512"
                                   @bind-Value="_model.TikTok" Disabled="_busy" />
                    <SimfTextField Label="Snapchat" MaxLength="512"
                                   @bind-Value="_model.Snapchat" Disabled="_busy" />
                </div>
                <div class="simf-form__actions">
                    <SimfButton Loading="_busy" LoadingLabel="@L["Admin.SiteSettings.Saving"]">
                        @L["Admin.SiteSettings.Save"]
                    </SimfButton>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private readonly Model _model = new();
    private EditContext _editContext = default!;
    private bool _loading = true;
    private bool _busy;
    private string? _toastMessage;
    private string _toastVariant = "success";

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_model);
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<SiteSettingsResponse>>(
                "simfAccount.getJson", "/account/api/admin/site-settings");
            if (envelope is { Success: true, Data: not null })
            {
                var d = envelope.Data;
                _model.RegistrationMessageAr = d.RegistrationSuccessMessageAr;
                _model.RegistrationMessageEn = d.RegistrationSuccessMessageEn;
                _model.Facebook = d.Social.Facebook ?? string.Empty;
                _model.X = d.Social.X ?? string.Empty;
                _model.Instagram = d.Social.Instagram ?? string.Empty;
                _model.LinkedIn = d.Social.LinkedIn ?? string.Empty;
                _model.YouTube = d.Social.YouTube ?? string.Empty;
                _model.TikTok = d.Social.TikTok ?? string.Empty;
                _model.Snapchat = d.Social.Snapchat ?? string.Empty;
            }
            else
            {
                _toastVariant = "error";
                _toastMessage = L["Admin.SiteSettings.LoadFailed"];
            }
        }
        catch (Exception)
        {
            _toastVariant = "error";
            _toastMessage = L["Admin.SiteSettings.LoadFailed"];
        }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (_busy) { return; }
        _busy = true;
        _toastMessage = null;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<SiteSettingsResponse>>(
                "simfAccount.putJson", "/account/api/admin/site-settings",
                new AdminUpdateSiteSettingsRequest
                {
                    RegistrationMessageAr = _model.RegistrationMessageAr,
                    RegistrationMessageEn = _model.RegistrationMessageEn,
                    Facebook = _model.Facebook,
                    X = _model.X,
                    Instagram = _model.Instagram,
                    LinkedIn = _model.LinkedIn,
                    YouTube = _model.YouTube,
                    TikTok = _model.TikTok,
                    Snapchat = _model.Snapchat,
                });
            if (envelope is { Success: true })
            {
                _toastVariant = "success";
                _toastMessage = L["Admin.SiteSettings.Saved"];
            }
            else
            {
                _toastVariant = "error";
                _toastMessage = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.SiteSettings.SaveFailed"];
            }
        }
        catch (Exception)
        {
            _toastVariant = "error";
            _toastMessage = L["Admin.SiteSettings.SaveFailed"];
        }
        finally { _busy = false; }
    }

    private sealed class Model
    {
        public string RegistrationMessageAr { get; set; } = string.Empty;
        public string RegistrationMessageEn { get; set; } = string.Empty;
        public string Facebook { get; set; } = string.Empty;
        public string X { get; set; } = string.Empty;
        public string Instagram { get; set; } = string.Empty;
        public string LinkedIn { get; set; } = string.Empty;
        public string YouTube { get; set; } = string.Empty;
        public string TikTok { get; set; } = string.Empty;
        public string Snapchat { get; set; } = string.Empty;
    }
}
