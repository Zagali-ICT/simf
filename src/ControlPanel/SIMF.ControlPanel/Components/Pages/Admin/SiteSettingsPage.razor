@* D-464 — CP "Site Settings" page: edit the public branding settings — the
   registration welcome message (bilingual) + the social-media links. Reads /
   writes the whitelisted site-settings keys via /admin/site-settings; the app +
   website consume them through GET /app/site-settings. Gated by Configuration.*. *@
@page "/admin/site-settings"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Configuration.Edit)]
@using SIMF.Contracts.Admin
@using SIMF.Contracts.Configuration

<PageTitle>@L["Admin.SiteSettings.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.SiteSettings.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toastMessage is not null)
        {
            <SimfAlert Variant="@_toastVariant">@_toastMessage</SimfAlert>
        }

        @if (_loading)
        {
            <p>@L["Admin.SiteSettings.Loading"]</p>
        }
        else
        {
            <EditForm EditContext="_editContext" OnSubmit="SaveAsync" class="simf-form">
                <div class="simf-form__fields">
                    <h3>@L["Admin.SiteSettings.Section.Registration"]</h3>
                    <p>@L["Admin.SiteSettings.Section.Registration.Hint"]</p>
                    <SimfTextField Label="@L["Admin.SiteSettings.Field.RegMessageAr"]"
                                   MaxLength="2048"
                                   @bind-Value="_model.RegistrationMessageAr" Disabled="_busy" />
                    <SimfTextField Label="@L["Admin.SiteSettings.Field.RegMessageEn"]"
                                   MaxLength="2048"
                                   @bind-Value="_model.RegistrationMessageEn" Disabled="_busy" />

                    <h3>@L["Admin.SiteSettings.Section.Social"]</h3>
                    <p>@L["Admin.SiteSettings.Section.Social.Hint"]</p>
                    <SimfTextField Label="Facebook" MaxLength="512"
                                   @bind-Value="_model.Facebook" Disabled="_busy" />
                    <SimfTextField Label="X (Twitter)" MaxLength="512"
                                   @bind-Value="_model.X" Disabled="_busy" />
                    <SimfTextField Label="Instagram" MaxLength="512"
                                   @bind-Value="_model.Instagram" Disabled="_busy" />
                    <SimfTextField Label="LinkedIn" MaxLength="512"
                                   @bind-Value="_model.LinkedIn" Disabled="_busy" />
                    <SimfTextField Label="YouTube" MaxLength="512"
                                   @bind-Value="_model.YouTube" Disabled="_busy" />
                    <SimfTextField Label="TikTok" MaxLength="512"
                                   @bind-Value="_model.TikTok" Disabled="_busy" />
                    <SimfTextField Label="Snapchat" MaxLength="512"
                                   @bind-Value="_model.Snapchat" Disabled="_busy" />
                </div>
                <div class="simf-form__actions">
                    <SimfButton Loading="_busy" LoadingLabel="@L["Admin.SiteSettings.Saving"]">
                        @L["Admin.SiteSettings.Save"]
                    </SimfButton>
                </div>
            </EditForm>
        }
    </div>
</div>
