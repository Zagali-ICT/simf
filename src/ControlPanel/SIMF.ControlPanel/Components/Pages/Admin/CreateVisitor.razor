@* Control Panel — create a new visitor account. Hosts the reusable
   CreateVisitorForm so the visitors list page can show the
   same form inside an Add modal. The URL /admin/visitors/new stays as a
   deep-link fallback. *@
@page "/admin/visitors/new"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Visitors.Create)]

<PageTitle>@L["Admin.CreateVisitor.Title"] · SIMF</PageTitle>

<SimfPageHeader Title="@L["Admin.CreateVisitor.Title"]" />

<section class="simf-card simf-page-card simf-page-card--wide">
    <p>@L["Admin.CreateVisitor.Supporting"]</p>

    <CreateVisitorForm OnSuccess="OnCreatedAsync"
                       OnCancel="OnBackToListAsync" />
</section>
