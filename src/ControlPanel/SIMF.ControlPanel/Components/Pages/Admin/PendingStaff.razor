@* Control Panel — pending staff approval queue (P4b). Administrator-only.
   Each row gets an Approve button (one-click) and a Reject button that
   opens a reason modal (10–500 chars). Approval mints the QR id; both
   actions audit one row per click (P4a backend). *@
@page "/admin/admins/pending"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Admins.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@L["Admin.Pending.Staff.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Pending.Staff.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        <p>@L["Admin.Pending.Supporting"]</p>

        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toastVariant">@_toast</SimfAlert>
        }

        <SimfDataGrid TItem="AdminPendingUserSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      OnApproveSelected="OnBulkApproveAsync"
                      ApproveSelectedLabel="@L["Admin.Pending.Action.BulkApprove"]"
                      OnRejectSelected="OnBulkRejectAsync"
                      RejectSelectedLabel="@L["Admin.Pending.Action.BulkReject"]"
                      RowKey="@(u => u.Id.ToString())"
                      RowLabel="@(u => u.Email)"
                      Caption="@L["Admin.Pending.Staff.Title"]"
                      SelectAllLabel="@L["Admin.Pending.Action.SelectAll"]"
                      SelectRowLabel="@L["Admin.Pending.Action.SelectRow"]"
                      PrevLabel="@L["Admin.Users.Prev"]"
                      NextLabel="@L["Admin.Users.Next"]"
                      FirstLabel="@L["Admin.Pending.Pager.First"]"
                      LastLabel="@L["Admin.Pending.Pager.Last"]"
                      PageSizeLabel="@L["Admin.Pending.Pager.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.Users.Loading"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminPendingUserSummary" Key="email"
                                    Header="@L["Admin.Users.Column.Email"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Email</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminPendingUserSummary" Key="displayName"
                                    Header="@L["Admin.Users.Column.DisplayName"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.DisplayName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminPendingUserSummary" Key="created"
                                    Header="@L["Admin.Pending.Column.Created"]">
                    <CellTemplate>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions Context="user">
                <SimfButton Type="button" Variant="primary"
                            Disabled="_busy"
                            OnClick="@(() => ApproveAsync(user))">
                    @L["Admin.Pending.Action.Approve"]
                </SimfButton>
                <SimfButton Type="button" Variant="secondary"
                            Disabled="_busy"
                            OnClick="@(() => OpenReject(user))">
                    @L["Admin.Pending.Action.Reject"]
                </SimfButton>
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Pending.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_rejectTarget is not null)
{
    <SimfModal Open="true"
               Title="@L["Admin.Pending.Reject.Title"]"
               OnClose="@(() => _rejectTarget = null)">
        <ChildContent>
            <p>@string.Format(L["Admin.Pending.Reject.Confirm"], _rejectTarget.Email)</p>
            <SimfTextarea Label="@L["Admin.Pending.Reject.Reason"]"
                          Helper="@L["Admin.Pending.Reject.ReasonHint"]"
                          Rows="3" MaxLength="500"
                          Value="@_rejectReason"
                          ValueChanged="@(v => _rejectReason = v)" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _rejectTarget = null)">
                @L["Admin.Pending.Reject.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="primary"
                        Loading="_busy"
                        Disabled="@(_rejectReason.Length is < 10 or > 500)"
                        OnClick="ConfirmRejectAsync">
                @L["Admin.Pending.Reject.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@* P1.3 (D-214) — bulk reject: shared-reason modal for the selected pending admins. *@
@if (_bulkRejectSelected is not null)
{
    <SimfModal Open="true"
               Title="@L["Admin.Pending.BulkReject.Title"]"
               OnClose="@(() => _bulkRejectSelected = null)">
        <ChildContent>
            <p>@string.Format(L["Admin.Pending.BulkReject.Confirm"], _bulkRejectSelected.Count)</p>
            <SimfTextarea Label="@L["Admin.Pending.Reject.Reason"]"
                          Helper="@L["Admin.Pending.Reject.ReasonHint"]"
                          Rows="3" MaxLength="500"
                          Value="@_bulkRejectReason"
                          ValueChanged="@(v => _bulkRejectReason = v)" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _bulkRejectSelected = null)">
                @L["Admin.Pending.Reject.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="primary"
                        Loading="_busy"
                        Disabled="@(_bulkRejectReason.Length is < 10 or > 500)"
                        OnClick="ConfirmBulkRejectAsync">
                @L["Admin.Pending.BulkReject.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminPendingUserSummary>? _page;
    private bool _loading;
    private bool _busy;
    private AdminPendingUserSummary? _rejectTarget;
    private string _rejectReason = string.Empty;
    // P1.3 (D-214) — bulk reject (shared-reason) modal state.
    private IReadOnlyList<AdminPendingUserSummary>? _bulkRejectSelected;
    private string _bulkRejectReason = string.Empty;
    private string? _toast;
    private string _toastVariant = "success";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<GridPage<AdminPendingUserSummary>>>(
                "simfAccount.postJson", "/account/api/admin/admins/pending/list", _query);
            _page = envelope is { Success: true, Data: not null }
                ? envelope.Data
                : GridPage<AdminPendingUserSummary>.Of(
                    Array.Empty<AdminPendingUserSummary>(), 0, _query);
        }
        finally { _loading = false; }
    }

    private async Task ApproveAsync(AdminPendingUserSummary user)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.postJson",
                $"/account/api/admin/admins/{user.Id}/approve", new { });
            if (envelope is { Success: true })
            {
                _toast = string.Format(L["Admin.Pending.Approved.Toast"], user.Email);
                _toastVariant = "success";
                await LoadAsync();
            }
            else
            {
                _toast = envelope?.Error?.MessageForCurrentCulture() ?? L["Admin.Users.Fallback"];
                _toastVariant = "error";
            }
        }
        finally { _busy = false; }
    }

    private void OpenReject(AdminPendingUserSummary user)
    {
        _rejectTarget = user;
        _rejectReason = string.Empty;
        _toast = null;
    }

    private async Task ConfirmRejectAsync()
    {
        if (_busy || _rejectTarget is null) return;
        _busy = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.postJson",
                $"/account/api/admin/admins/{_rejectTarget.Id}/reject",
                new AdminRejectRequest { Reason = _rejectReason });
            if (envelope is { Success: true })
            {
                _toast = string.Format(L["Admin.Pending.Rejected.Toast"], _rejectTarget.Email);
                _toastVariant = "success";
                _rejectTarget = null;
                _rejectReason = string.Empty;
                await LoadAsync();
            }
            else
            {
                _toast = envelope?.Error?.MessageForCurrentCulture() ?? L["Admin.Users.Fallback"];
                _toastVariant = "error";
            }
        }
        finally { _busy = false; }
    }

    // P1.3 (D-214) — bulk approve the selected pending admins.
    private async Task OnBulkApproveAsync(IReadOnlyList<AdminPendingUserSummary> selected)
    {
        if (_busy || selected.Count == 0) return;
        _busy = true;
        try
        {
            var ids = selected.Select(u => u.Id).ToList();
            var envelope = await JS.InvokeAsync<ApiResult<AdminBulkApprovalResponse>>(
                "simfAccount.postJson", "/account/api/admin/admins/bulk-approve",
                new AdminBulkApprovalRequest { Ids = ids });
            if (envelope is { Success: true, Data: not null })
            {
                var result = envelope.Data;
                _toast = string.Format(
                    L["Admin.Pending.BulkApproved.Toast"],
                    result.Approved, result.Skipped);
                _toastVariant = result.Skipped == 0 ? "success" : "warning";
                await LoadAsync();
            }
            else
            {
                _toast = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Users.Fallback"];
                _toastVariant = "error";
            }
        }
        finally { _busy = false; }
    }

    // P1.3 (D-214) — open the shared-reason modal with the selected pending rows.
    private void OnBulkRejectAsync(IReadOnlyList<AdminPendingUserSummary> selected)
    {
        if (_busy || selected.Count == 0) return;
        _bulkRejectSelected = selected;
        _bulkRejectReason = string.Empty;
        _toast = null;
    }

    private async Task ConfirmBulkRejectAsync()
    {
        if (_busy || _bulkRejectSelected is null) return;
        _busy = true;
        try
        {
            var ids = _bulkRejectSelected.Select(u => u.Id).ToList();
            var envelope = await JS.InvokeAsync<ApiResult<AdminBulkRejectResponse>>(
                "simfAccount.postJson", "/account/api/admin/admins/bulk-reject",
                new AdminBulkRejectRequest { Ids = ids, Reason = _bulkRejectReason });
            if (envelope is { Success: true, Data: not null })
            {
                var result = envelope.Data;
                _toast = string.Format(
                    L["Admin.Pending.BulkRejected.Toast"],
                    result.Rejected, result.Skipped);
                _toastVariant = result.Skipped == 0 ? "success" : "warning";
                _bulkRejectSelected = null;
                _bulkRejectReason = string.Empty;
                await LoadAsync();
            }
            else
            {
                _toast = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Users.Fallback"];
                _toastVariant = "error";
            }
        }
        finally { _busy = false; }
    }

    private string FormatSummary(int from, int to, int total) =>
        string.Format(L["Admin.Users.Pager.Summary"], from, to, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Admin.Pending.Pager.Page"], current, total);
}
