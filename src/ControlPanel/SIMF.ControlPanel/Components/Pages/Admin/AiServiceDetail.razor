@* CP Phase-2 — per-service detail: a tabbed drill-down for one AI service
   (AiFeature), reached from the services console. Routing tab = the inline
   AiRoutingEditor (set provider/model on the active prompt); Prompts tab = this
   service's prompts; Analytics tab = its 24h health from the dashboard aggregate.
   Read-mostly; the only write is the routing edit (gated AiPrompts.Edit). *@
@page "/admin/ai/services/{Feature}"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.AiPrompts.View)]
@using SIMF.Components.Layout

<PageTitle>@L["Admin.AiServiceDetail.Title"] · SIMF</PageTitle>

<SimfBanner Title="@(_feature?.ToString() ?? L["Admin.AiServiceDetail.Title"])" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        @if (_feature is null)
        {
            <SimfEmptyState Title="@L["Admin.AiServiceDetail.Unknown"]" />
        }
        else
        {
            <SimfTabs Tabs="_tabs" Active="_active" ActiveChanged="OnTabChangedAsync" />

            @if (_active == "routing")
            {
                @if (_activePromptId is null)
                {
                    <SimfEmptyState Title="@L["Admin.AiServiceDetail.NoActiveRouting"]" />
                }
                else
                {
                    <AuthorizedAction Permission="@PermissionCatalog.AiPrompts.Edit">
                        <AiRoutingEditor PromptId="_activePromptId.Value" OnSaved="OnRoutingSavedAsync" />
                    </AuthorizedAction>
                }
            }
            else if (_active == "prompts")
            {
                @if (_prompts.Count == 0)
                {
                    <SimfEmptyState Title="@L["Admin.AiPrompts.None"]" />
                }
                else
                {
                    <table class="simf-table">
                        <thead>
                            <tr>
                                <th>@L["Admin.AiPrompts.Col.Key"]</th>
                                <th>@L["Admin.AiPrompts.Col.Provider"]</th>
                                <th>@L["Admin.AiPrompts.Col.Model"]</th>
                                <th>@L["Admin.AiPrompts.Col.Version"]</th>
                                <th>@L["Admin.AiPrompts.Col.Active"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _prompts)
                            {
                                <tr>
                                    <td><code>@p.Key</code></td>
                                    <td>@p.Provider</td>
                                    <td>@p.Model</td>
                                    <td>v@(p.Version)</td>
                                    <td>
                                        @if (p.IsActive)
                                        {
                                            <SimfPill Variant="on">@L["Admin.AiPrompts.Active.Yes"]</SimfPill>
                                        }
                                        else
                                        {
                                            <SimfPill Variant="off">@L["Admin.AiPrompts.Active.No"]</SimfPill>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            else if (_active == "analytics")
            {
                @if (_statsLoading)
                {
                    <p>@L["Admin.AiDashboard.Loading"]</p>
                }
                else if (_stat is null)
                {
                    <SimfEmptyState Title="@L["Admin.AiDashboard.NoActivity"]" />
                }
                else
                {
                    <p class="simf-field__helper">@L["Admin.AiDashboard.Window"]</p>
                    <div class="simf-form__actions">
                        <SimfStatCard Title="@L["Admin.AiDashboard.Calls"]"
                                      Value="@_stat.Calls.ToString("N0")" />
                        <SimfStatCard Title="@L["Admin.AiDashboard.ErrorRate"]"
                                      Value="@AiEnumOptions.Pct(_stat.ErrorRate)" />
                        <SimfStatCard Title="@L["Admin.AiDashboard.Latency"]"
                                      Value="@($"{_stat.AvgLatencyMs} ms")" />
                        <SimfStatCard Title="@L["Admin.AiDashboard.Tokens"]"
                                      Value="@_stat.TotalTokens.ToString("N0")" />
                    </div>
                }
            }
        }
    </div>
</div>
