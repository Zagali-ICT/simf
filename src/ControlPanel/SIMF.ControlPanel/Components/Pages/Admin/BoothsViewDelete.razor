@* Reusable Booth View/Delete form, hosted by CrudShell (popup or full
   page) from BoothsList. Inherits CrudViewDeleteFormBase so it exposes the
   standard surface (IsDelete / Initial / OnDeleted / OnCancel). Read-only
   details always show; when IsDelete=true a Delete button appears and a
   SimfConfirm gates the soft-delete (replaces the old native JS confirm() on the
   list). Adds the View path the inline modal never had. The exhibitor + hall
   names are resolved from the cached lookups (the detail carries only the ids).
   *@
@inherits CrudViewDeleteFormBase<AdminBoothDetail>
@using SIMF.Contracts.Exhibition
@using SIMF.Contracts.Exhibitors

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    @* The booth's own logo (BoothLogo, owner = the booth — the same asset the app
       renders on the booth card). Placeholder icon when the booth has no logo yet. *@
    <div class="simf-image-upload__preview">
        <SimfImageThumb Src="@LogoSrc(Initial.Id)"
                        Alt="@Initial.Name"
                        Class="simf-img-thumb--lg" />
    </div>

    <dl class="simf-dl">
        <dt>@L["Admin.Booths.Col.Code"]</dt>
        <dd>@Initial.Code</dd>
        <dt>@L["Admin.Booths.Col.NameEn"]</dt>
        <dd>@Initial.Name</dd>
        <dt>@L["Admin.Booths.Col.NameAr"]</dt>
        <dd>@Initial.NameArabic</dd>
        <dt>@L["Admin.Booths.Col.Exhibitor"]</dt>
        <dd>@ExhibitorName(Initial.ExhibitorId)</dd>
        @* Exhibitor-owned, read-only (resolved from the linked
           Exhibitor / its Contact); not editable on the booth form. *@
        <dt>@L["Admin.Booths.Field.Website"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.Website) ? "—" : Initial.Website)</dd>
        <dt>@L["Admin.Booths.Field.Tier"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.TierName) ? "—" : Initial.TierName)</dd>
        <dt>@L["Admin.Booths.Field.CityEn"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.City) ? "—" : Initial.City)</dd>
        <dt>@L["Admin.Booths.Field.CityAr"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.CityArabic) ? "—" : Initial.CityArabic)</dd>
        <dt>@L["Admin.Booths.Field.OfficerName"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.OfficerName) ? "—" : Initial.OfficerName)</dd>
        <dt>@L["Admin.Booths.Field.OfficerPhone"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.OfficerPhone) ? "—" : Initial.OfficerPhone)</dd>
        <dt>@L["Admin.Booths.Field.OfficerEmail"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.OfficerEmail) ? "—" : Initial.OfficerEmail)</dd>
        <dt>@L["Admin.Booths.Field.SectorEn"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.Sector) ? "—" : Initial.Sector)</dd>
        <dt>@L["Admin.Booths.Field.SectorAr"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.SectorArabic) ? "—" : Initial.SectorArabic)</dd>
        <dt>@L["Admin.Booths.Field.DescriptionEn"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.Description) ? "—" : Initial.Description)</dd>
        <dt>@L["Admin.Booths.Field.DescriptionAr"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.DescriptionArabic) ? "—" : Initial.DescriptionArabic)</dd>
        <dt>@L["Admin.Booths.Col.Hall"]</dt>
        <dd>@HallName(Initial.HallId)</dd>
        <dt>@L["Admin.Booths.Field.MapX"]</dt>
        <dd>@(Initial.MapX?.ToString(CultureInfo.InvariantCulture) ?? "—")</dd>
        <dt>@L["Admin.Booths.Field.MapY"]</dt>
        <dd>@(Initial.MapY?.ToString(CultureInfo.InvariantCulture) ?? "—")</dd>
        <dt>@L["Admin.Booths.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.Booths.Delete"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Booths.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.Booths.Delete.Title"]"
                 Message="@string.Format(L["Admin.Booths.Delete.Message"], Initial.Name)"
                 ConfirmLabel="@L["Admin.Booths.Delete"]"
                 CancelLabel="@L["Admin.Booths.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" 
                 Permission="@PermissionCatalog.Booths.Delete"/>
}
