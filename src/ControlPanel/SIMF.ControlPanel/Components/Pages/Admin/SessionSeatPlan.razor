@* D-182 (CP UI for D-175 seat reservations) — admin picks a session,
   sees active seat reservations, can paint a row as admin-reserved
   (blocks visitor self-pick of that row) or release individual
   reservations. The hall layout determines which rows are valid;
   the backend validates against `HallSeatLayout.RowLabels`. *@
@page "/admin/sessions/seat-plans"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.SeatPlans.View)]

<PageTitle>@L["Admin.SessionSeatPlans.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.SessionSeatPlans.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }
        <p class="simf-hint">@L["Admin.SessionSeatPlans.Hint"]</p>

        @if (_sessions.Count == 0 && !_loading)
        {
            <SimfEmptyState Title="@L["Admin.SessionSeatPlans.None"]" />
        }
        else
        {
            <label class="simf-field simf-field--inline">
                <span class="simf-field__label">@L["Admin.SessionSeatPlans.Pick"]</span>
                <select class="simf-field__input"
                        value="@(_selectedSessionId?.ToString() ?? string.Empty)"
                        @onchange="OnSessionChangedAsync" disabled="@_loading">
                    <option value=""></option>
                    @foreach (var session in _sessions)
                    {
                        <option value="@session.Id">@session.Code — @session.Title</option>
                    }
                </select>
            </label>
        }

        @if (_loading)
        {
            <p>@L["Admin.SessionSeatPlans.Loading"]</p>
        }
        else if (_selectedSessionId is not null)
        {
            <div class="simf-form__fields">
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.SessionSeatPlans.ReserveRow.Label"]</span>
                    <input class="simf-field__input" type="text"
                           value="@_reserveRowLabel"
                           @onchange="OnReserveRowChanged"
                           disabled="@_busy" />
                </label>
                <div class="simf-form__actions">
                    <AuthorizedAction Permission="@PermissionCatalog.SeatPlans.Edit">
                        <SimfButton Type="button" OnClick="ReserveRowAsync" Loading="_busy" LoadingLabel="@L["Grid.Working"]">
                            @L["Admin.SessionSeatPlans.ReserveRow.Action"]
                        </SimfButton>
                    </AuthorizedAction>
                </div>

                @* D-771 (owner 2026-07-26) — a VVIP seat has NO registration: the
                   admin types the guest's name here, then taps the seat on the grid
                   to hold it. The note travels with the block and is what the app +
                   the staff seating desk show for that seat. Raw inputs (not
                   SimfTextField, which freezes without ValueExpression — D-648). *@
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.SessionSeatPlans.GuestHint.Arabic"]</span>
                    <input class="simf-field__input" type="text" maxlength="256"
                           value="@_guestHintArabic"
                           @onchange="OnGuestHintArabicChanged"
                           disabled="@_busy" />
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.SessionSeatPlans.GuestHint.English"]</span>
                    <input class="simf-field__input" type="text" maxlength="256"
                           value="@_guestHint"
                           @onchange="OnGuestHintChanged"
                           disabled="@_busy" />
                </label>
                <p class="simf-hint">@L["Admin.SessionSeatPlans.GuestHint.Hint"]</p>
            </div>

            @* P1.4 (D-215) — visual seat grid: render the hall layout when it
               is available, overlaying each reservation by (row, seat). A free
               seat is clickable to reserve it for a VIP (2026-07-18); a reserved
               seat is clickable to release it. *@
            @if (_layout is not null && _layout.RowLabels.Count > 0)
            {
                <div class="seatgrid">
                    @for (var r = 0; r < _layout.RowLabels.Count; r++)
                    {
                        var rowLabel = _layout.RowLabels[r];
                        var tier = TierOfRow(r);
                        <div class="seatgrid__row seatgrid__row--@TierModifier(tier)">
                            <span class="seatgrid__row-label" title="@TierLabel(tier)">@rowLabel</span>
                            @for (var seat = 1; seat <= SeatsInRow(r); seat++)
                            {
                                var cell = FindReservation(rowLabel, seat);
                                var seatNumber = seat;
                                @* DEF-SEA-001 — a held seat no longer releases on the
                                   click itself: tapping it opens the confirmation
                                   below, which names the holder. A free seat still
                                   reserves in one tap (non-destructive). *@
                                <button type="button"
                                        class="seatgrid__seat @SeatStateClass(cell)"
                                        disabled="@_busy"
                                        title="@SeatTitle(rowLabel, seatNumber, cell)"
                                        @onclick="@(() => OnSeatClickAsync(rowLabel, seatNumber, cell))">
                                    @seatNumber
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="seatgrid__legend">
                    <span class="seatgrid__legend-item">
                        <span class="seatgrid__swatch seatgrid__swatch--free"></span>@L["Admin.SessionSeatPlans.Legend.Free"]
                    </span>
                    <span class="seatgrid__legend-item">
                        <span class="seatgrid__swatch seatgrid__swatch--user"></span>@L["Admin.SessionSeatPlans.Legend.User"]
                    </span>
                    <span class="seatgrid__legend-item">
                        <span class="seatgrid__swatch seatgrid__swatch--admin"></span>@L["Admin.SessionSeatPlans.Legend.Admin"]
                    </span>
                    <span class="seatgrid__legend-item">
                        <span class="seatgrid__swatch seatgrid__swatch--random"></span>@L["Admin.SessionSeatPlans.Legend.Random"]
                    </span>
                </div>
                <p class="simf-table__summary">
                    @(string.Format(L["Admin.SessionSeatPlans.Summary"], _reservations.Count))
                </p>

                @* DEF-SEA-001 — the grid alone never said WHOSE seat a coloured
                   square was. This roster names every holder next to their seat, so
                   the admin can read the plan without hovering each square. *@
                @if (_reservations.Count > 0)
                {
                    <table class="simf-table">
                        <thead>
                            <tr>
                                <th>@L["Admin.SessionSeatPlans.Col.Seat"]</th>
                                <th>@L["Admin.SessionSeatPlans.Col.Holder"]</th>
                                <th>@L["Admin.SessionSeatPlans.Col.Kind"]</th>
                                <th>@L["Admin.SessionSeatPlans.Col.State"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var held in _reservations)
                            {
                                <tr>
                                    <td>@SeatCoords(held)</td>
                                    <td>@HolderLabel(held)</td>
                                    <td>@held.Kind</td>
                                    <td>@StateLabel(held)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            else if (_reservations.Count == 0)
            {
                <SimfEmptyState Title="@L["Admin.SessionSeatPlans.NoReservations"]" />
            }
            else
            {
                @* Fallback: no hall layout defined yet — list the reservations.
                   DEF-SEA-001: the holder column and the confirmed release apply
                   here too, so both routes to a release name the person. *@
                <table class="simf-table">
                    <thead>
                        <tr>
                            <th>@L["Admin.SessionSeatPlans.Col.Row"]</th>
                            <th>@L["Admin.SessionSeatPlans.Col.Seat"]</th>
                            <th>@L["Admin.SessionSeatPlans.Col.Holder"]</th>
                            <th>@L["Admin.SessionSeatPlans.Col.Kind"]</th>
                            <th>@L["Admin.SessionSeatPlans.Col.State"]</th>
                            <th>@L["Admin.SessionSeatPlans.Col.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _reservations)
                        {
                            <tr>
                                <td>@row.RowLabel</td>
                                <td>@row.SeatNumber</td>
                                <td>@HolderLabel(row)</td>
                                <td>@row.Kind</td>
                                <td>@StateLabel(row)</td>
                                <td>
                                    <AuthorizedAction Permission="@PermissionCatalog.SeatPlans.Edit">
                                        <SimfButton Type="button" Variant="danger"
                                                    OnClick="@(() => AskRelease(row))"
                                                    Disabled="_busy">
                                            @L["Admin.SessionSeatPlans.Release"]
                                        </SimfButton>
                                    </AuthorizedAction>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="simf-table__summary">
                    @(string.Format(L["Admin.SessionSeatPlans.Summary"], _reservations.Count))
                </p>
            }
        }
    </div>
</div>

@* DEF-SEA-001 — a release takes a live attendee's seat and cannot be undone, so
   it goes through the CP's shared must-decide confirm (the same component every
   CRUD delete uses). The message names the seat AND its holder. *@
<SimfConfirm Open="@(_releasing is not null)"
             Title="@L["Admin.SessionSeatPlans.Release.Title"]"
             Message="@ReleaseConfirmMessage()"
             ConfirmLabel="@L["Admin.SessionSeatPlans.Release"]"
             CancelLabel="@L["Admin.SessionSeatPlans.Release.Cancel"]"
             Danger="true"
             Busy="_busy"
             OnConfirm="ConfirmReleaseAsync"
             OnCancel="CancelRelease"
             Permission="@PermissionCatalog.SeatPlans.Edit">
    <ChildContent>
        @if (_releasing is { } target)
        {
            <dl class="simf-dl">
                <dt>@L["Admin.SessionSeatPlans.Col.Seat"]</dt>
                <dd>@SeatCoords(target)</dd>
                <dt>@L["Admin.SessionSeatPlans.Col.Holder"]</dt>
                <dd data-testid="release-holder">@HolderLabel(target)</dd>
                <dt>@L["Admin.SessionSeatPlans.Col.State"]</dt>
                <dd>@StateLabel(target)</dd>
            </dl>
        }
    </ChildContent>
</SimfConfirm>
