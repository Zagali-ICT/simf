@* SIMF-FDS-014 (D-283/C2b) — reusable "link an existing Contact" picker for the
   Sponsor / Exhibitor / MediaPartner / Speaker / Booth admin forms. Link-existing
   only (no create-new — manage the directory at /admin/contacts). Binds a
   nullable ContactId via two-way Value/ValueChanged. Data comes from the CP BFF
   (/account/api/admin/contacts/picker for search, /{id} to resolve the current
   selection's name on edit), so this component is CP-scoped rather than a
   presentational SIMF.Components control. *@
@using SIMF.Contracts.Contacts

<div class="simf-field">
    <span class="simf-field__label">@L["Admin.Contacts.Picker.Label"]</span>
    <p class="simf-field__helper">@L["Admin.Contacts.Picker.Hint"]</p>

    @if (_selected is not null)
    {
        <div class="simf-pill-row">
            <SimfPill Variant="on">@string.Format(L["Admin.Contacts.Picker.Linked"], SelectedLabel(_selected))</SimfPill>
            <SimfButton Type="button" Variant="secondary" Disabled="Disabled" OnClick="ClearAsync">
                @L["Admin.Contacts.Picker.Clear"]
            </SimfButton>
        </div>
    }
    else
    {
        <span class="simf-field__helper">@L["Admin.Contacts.Picker.NotLinked"]</span>
    }

    <div class="simf-toolbar__search">
        <SimfTextField Label="@L["Admin.Contacts.Picker.Search"]"
                       Value="@_search"
                       ValueChanged="@(v => _search = v)"
                       ValueExpression="@(() => _search)"
                       Disabled="@(Disabled || _searching)" />
        <SimfButton Type="button" Disabled="@(Disabled || _searching)" OnClick="SearchAsync">
            @L["Admin.Contacts.Picker.SearchApply"]
        </SimfButton>
    </div>

    @if (_searched)
    {
        @if (_results.Count == 0)
        {
            <p class="simf-field__helper">@L["Admin.Contacts.Picker.None"]</p>
        }
        else
        {
            <ul class="simf-picker-results">
                @foreach (var item in _results)
                {
                    <li>
                        <SimfButton Type="button" Variant="secondary" Disabled="Disabled"
                                    OnClick="@(() => SelectAsync(item))">
                            @ItemLabel(item)
                        </SimfButton>
                    </li>
                }
            </ul>
        }
    }
</div>
