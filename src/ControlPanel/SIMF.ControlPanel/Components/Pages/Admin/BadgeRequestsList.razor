@* D-500 (Wave 5, الطلبات "طلب تحديث البادج") — admin queue for badge job-title
   update requests submitted from the app. On Accept the API applies the requested
   title to the requester's profile. Respond modal accepts / rejects with an
   optional note; Pending → Pending is rejected server-side
   (BADGE_UPDATE_REQUEST_STATUS_INVALID). SimfDataGrid (server-paged, sortable +
   filterable, full pager); Respond is a quiet reply button shown only for Pending
   rows. Mirrors SpeakerMeetingRequestsList.razor (no export path). *@
@page "/admin/badge-requests"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.BadgeUpdateRequests.View)]
@using SIMF.Common.Enums
@using SIMF.Contracts.Requests

<PageTitle>@L["Admin.BadgeRequests.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.BadgeRequests.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminBadgeUpdateRequestRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="false"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.RequesterName ?? r.Id.ToString())"
                      Caption="@L["Admin.BadgeRequests.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.BadgeRequests.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminBadgeUpdateRequestRow" Key="requester"
                                    Header="@L["Admin.BadgeRequests.Col.Requester"]">
                    <CellTemplate>@(context.RequesterName ?? "—")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBadgeUpdateRequestRow" Key="jobTitle"
                                    Header="@L["Admin.BadgeRequests.Col.Requested"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.RequestedJobTitle</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBadgeUpdateRequestRow" Key="current"
                                    Header="@L["Admin.BadgeRequests.Col.Current"]">
                    <CellTemplate>@(string.IsNullOrWhiteSpace(context.CurrentJobTitle) ? "—" : context.CurrentJobTitle)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBadgeUpdateRequestRow" Key="status"
                                    Header="@L["Admin.BadgeRequests.Col.Status"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>
                        @switch (context.Status)
                        {
                            case MeetingRequestStatus.Pending:
                                <SimfPill Variant="warn">@L["Admin.BadgeRequests.Filter.Pending"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Accepted:
                                <SimfPill Variant="on">@L["Admin.BadgeRequests.Filter.Accepted"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Rejected:
                                <SimfPill Variant="off">@L["Admin.BadgeRequests.Filter.Rejected"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Cancelled:
                                <SimfPill Variant="off">@L["Admin.BadgeRequests.Filter.Cancelled"]</SimfPill>
                                break;
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBadgeUpdateRequestRow" Key="createdAt"
                                    Header="@L["Admin.BadgeRequests.Col.CreatedAt"]"
                                    Sortable="true">
                    <CellTemplate>@context.CreatedAt.FormatSaudi("dd-MM-yyyy hh:mm tt")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBadgeUpdateRequestRow" Key="respondedAt"
                                    Header="@L["Admin.BadgeRequests.Col.RespondedAt"]"
                                    Sortable="true">
                    <CellTemplate>
                        @(context.RespondedAt is null ? "—"
                            : context.RespondedAt.Value.FormatSaudi("dd-MM-yyyy hh:mm tt"))
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @if (context.Status == MeetingRequestStatus.Pending)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.BadgeUpdateRequests.Manage">
                        <SimfToolbarButton Icon="reply" Title="@L["Admin.BadgeRequests.Respond"]"
                                           OnClick="@(() => OnRespondAsync(context))" />
                    </AuthorizedAction>
                }
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.BadgeRequests.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_respondOpen && _respondTarget is not null)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.BadgeRequests.Respond.Title"]"
               OnClose="@(() => _respondOpen = false)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <div class="simf-form__fields">
                <dl class="simf-dl">
                    <dt>@L["Admin.BadgeRequests.Col.Requester"]</dt>
                    <dd>
                        <div>@(_respondTarget.RequesterName ?? "—")</div>
                        @if (_loadingDetail)
                        {
                            <div class="simf-table__sub">@L["Admin.BadgeRequests.LoadingDetail"]</div>
                        }
                        else if (!string.IsNullOrEmpty(_respondTarget.RequesterEmail))
                        {
                            <div class="simf-table__sub">@_respondTarget.RequesterEmail</div>
                        }
                    </dd>
                    <dt>@L["Admin.BadgeRequests.Col.Current"]</dt>
                    <dd>@(string.IsNullOrWhiteSpace(_respondTarget.CurrentJobTitle) ? "—" : _respondTarget.CurrentJobTitle)</dd>
                    <dt>@L["Admin.BadgeRequests.Col.Requested"]</dt>
                    <dd>@_respondTarget.RequestedJobTitle</dd>
                    @if (!string.IsNullOrWhiteSpace(_respondTarget.Note))
                    {
                        <dt>@L["Admin.BadgeRequests.Col.Note"]</dt>
                        <dd>@_respondTarget.Note</dd>
                    }
                </dl>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.BadgeRequests.Respond.Status"]</span>
                    <select class="simf-field__input" value="@((int)_respondStatus)"
                            @onchange="OnRespondStatusChanged" disabled="@_busy">
                        <option value="@((int)MeetingRequestStatus.Accepted)">
                            @L["Admin.BadgeRequests.Respond.Accept"]
                        </option>
                        <option value="@((int)MeetingRequestStatus.Rejected)">
                            @L["Admin.BadgeRequests.Respond.Reject"]
                        </option>
                    </select>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.BadgeRequests.Respond.Note"]</span>
                    <textarea class="simf-field__input" rows="4"
                              value="@_respondNote"
                              @onchange="OnRespondNoteChanged"
                              disabled="@_busy"></textarea>
                </label>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                        OnClick="@(() => _respondOpen = false)">
                @L["Admin.BadgeRequests.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SendResponseAsync" Loading="_busy" LoadingLabel="@L["Grid.Working"]">
                @L["Admin.BadgeRequests.Respond.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
