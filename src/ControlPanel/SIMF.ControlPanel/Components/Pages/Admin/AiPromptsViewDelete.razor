@* D-353 — reusable AI-prompt View/Delete form, hosted by CrudShell (as a popup
   or a full page) from AiPromptsList.razor. Inherits CrudViewDeleteFormBase so
   it exposes the standard parameter surface (IsDelete / Initial / OnDeleted /
   OnCancel). Read-only details always show; when IsDelete=true a Deactivate
   button appears and a SimfConfirm gates the destructive call (replaces the
   old one-click delete action on the list). Adds the View path the inline
   form never had. *@
@inherits CrudViewDeleteFormBase<AdminAiPromptDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.AiPrompts.Col.Key"]</dt>
        <dd><code>@Initial.Key</code></dd>
        <dt>@L["Admin.AiPrompts.Col.Feature"]</dt>
        <dd>@Initial.Feature</dd>
        <dt>@L["Admin.AiPrompts.Col.DisplayName"]</dt>
        <dd>@Initial.DisplayName</dd>
        <dt>@L["Admin.AiPrompts.Field.DisplayNameArabic"]</dt>
        <dd>@Initial.DisplayNameArabic</dd>
        <dt>@L["Admin.AiPrompts.Col.Provider"]</dt>
        <dd>@Initial.Provider</dd>
        <dt>@L["Admin.AiPrompts.Col.Model"]</dt>
        <dd>@Initial.Model</dd>
        <dt>@L["Admin.AiPrompts.Field.SystemPrompt"]</dt>
        <dd><pre class="simf-pre--wrap">@Initial.SystemPrompt</pre></dd>
        <dt>@L["Admin.AiPrompts.Field.UserPromptTemplate"]</dt>
        <dd><pre class="simf-pre--wrap">@Initial.UserPromptTemplate</pre></dd>
        <dt>@L["Admin.AiPrompts.Field.Temperature"]</dt>
        <dd>@Initial.Temperature.ToString(CultureInfo.InvariantCulture)</dd>
        <dt>@L["Admin.AiPrompts.Field.MaxOutputTokens"]</dt>
        <dd>@Initial.MaxOutputTokens</dd>
        <dt>@L["Admin.AiPrompts.Col.Version"]</dt>
        <dd>v@(Initial.Version)</dd>
        <dt>@L["Admin.AiPrompts.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Admin.AiPrompts.Active.Yes"] : L["Admin.AiPrompts.Active.No"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.AiPrompts.Delete"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.AiPrompts.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.AiPrompts.Delete.Title"]"
                 Message="@string.Format(L["Admin.AiPrompts.Delete.Message"], Initial.Key)"
                 ConfirmLabel="@L["Admin.AiPrompts.Delete"]"
                 CancelLabel="@L["Admin.AiPrompts.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" />
}
