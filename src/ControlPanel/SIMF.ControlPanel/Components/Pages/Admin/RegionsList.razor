@* Region lookup (CP UI) — admin CRUD over the bilingual administrative-regions
   lookup (the 13 official Saudi regions). Rows are seeded from
   SaudiRegions.All and can be created/edited/deactivated by hand. A search box
   reloads the grid server-side via GridQuery.Search. Mirrors the
   Organisation lookup page (D-353): the owner-mandated SimfDataGrid
   (server-paged, sortable + filterable, full pager) plus the CrudShell that
   frames the reusable RegionAddEdit and RegionViewDelete forms as a popup or a
   full page per the admin's toolbar choice (persisted in localStorage via
   CpPreferences). No Excel import/export — regions are a small fixed lookup. *@
@page "/admin/regions"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Regions.View)]
@using SIMF.Contracts.Regions
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject CpPreferences Prefs

<PageTitle>@L["Admin.Regions.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Regions.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <div class="simf-toolbar">
                <div class="simf-toolbar__search">
                    <SimfTextField Label="@L["Admin.Regions.Search"]"
                                   Placeholder="@L["Admin.Regions.Search.Placeholder"]"
                                   Value="@_search"
                                   ValueChanged="@(v => _search = v)"
                                   ValueExpression="@(() => _search)"
                                   Disabled="_loading" />
                    <SimfButton Type="button" Disabled="_loading" OnClick="ApplySearchAsync">
                        @L["Admin.Regions.Search.Apply"]
                    </SimfButton>
                </div>
            </div>

            <SimfDataGrid TItem="AdminRegionSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.NameArabic)"
                          Caption="@L["Admin.Regions.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAdd"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Regions.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminRegionSummary" Key="code"
                                        Header="@L["Admin.Regions.Col.Code"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Code</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminRegionSummary" Key="name"
                                        Header="@L["Admin.Regions.Col.NameAr"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.NameArabic</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminRegionSummary" Key="nameEn"
                                        Header="@L["Admin.Regions.Col.NameEn"]"
                                        Filterable="true">
                        <CellTemplate>@(string.IsNullOrWhiteSpace(context.Name) ? "—" : context.Name)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminRegionSummary" Key="isActive"
                                        Header="@L["Admin.Regions.Col.Active"]"
                                        Sortable="true">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Regions.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Regions.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <RegionAddEdit IsEdit="_isEdit" Initial="_target"
                           OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <RegionViewDelete IsDelete="_isDelete" Initial="_target"
                              OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@code {
    private record Toast(string Variant, string Message);

    private enum FormKind { None, AddEdit, ViewDelete }

    private const string PageKey = "regions";

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminRegionSummary> _page = new();
    private bool _loading;
    private Toast? _toast;
    private string _search = string.Empty;

    private CrudPresentation _presentation = CrudPresentation.Dialog;
    private FormKind _form = FormKind.None;
    private bool _isEdit;
    private bool _isDelete;
    private AdminRegionDetail? _target;

    private bool FormOpen => _form != FormKind.None;
    private bool GridHidden => FormOpen && _presentation == CrudPresentation.Page;

    private string FormTitle => _form switch
    {
        FormKind.AddEdit => _isEdit
            ? L["Admin.Regions.Edit.Title"]
            : L["Admin.Regions.Add.Title"],
        FormKind.ViewDelete => _isDelete
            ? L["Admin.Regions.Delete.Title"]
            : L["Admin.Regions.Details.Title"],
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _presentation = await Prefs.GetPresentationAsync(PageKey);
        await LoadAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminRegionSummary>>>(
                "simfAccount.postJson",
                "/account/api/admin/regions/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Regions.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    // Search reloads the grid server-side via GridQuery.Search, resetting to
    // the first page so the result set starts at the top.
    private async Task ApplySearchAsync()
    {
        _query.Skip = 0;
        _query.Search = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
        await LoadAsync();
    }

    private void OnAdd()
    {
        _toast = null;
        _form = FormKind.AddEdit;
        _isEdit = false;
        _target = null;
    }

    private async Task OnEditAsync(AdminRegionSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.AddEdit;
        _isEdit = true;
        _target = detail;
    }

    private async Task OnDetailsAsync(AdminRegionSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = false;
        _target = detail;
    }

    private async Task OnDeleteAsync(AdminRegionSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = true;
        _target = detail;
    }

    // The grid summary omits SortOrder / timestamps, so Edit / View / Delete
    // all work against the full detail (mirrors GET /admin/regions/{id}).
    // Returns null and surfaces a toast on failure.
    private async Task<AdminRegionDetail?> LoadDetailAsync(Guid id)
    {
        _toast = null;
        var env = await JS.InvokeAsync<ApiResult<AdminRegionDetail>>(
            "simfAccount.getJson", $"/account/api/admin/regions/{id}");
        if (env is { Success: true, Data: not null })
        {
            return env.Data;
        }
        _toast = new Toast("error",
            env?.Error?.MessageForCurrentCulture()
            ?? L["Admin.Regions.LoadFailed"]);
        return null;
    }

    private void CloseForm()
    {
        _form = FormKind.None;
        _target = null;
    }

    private async Task OnSavedAsync(AdminRegionDetail saved)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.Regions.Saved"]);
        await LoadAsync();
    }

    private async Task OnDeletedAsync(AdminRegionDetail deleted)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.Regions.Deleted"]);
        await LoadAsync();
    }
}
