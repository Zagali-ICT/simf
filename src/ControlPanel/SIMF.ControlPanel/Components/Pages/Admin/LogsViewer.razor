@* Control Panel — real-time log viewer (P6). Lists every project's log
   files under {Storage:LogDirectory}, tails the chosen file with a 5-second
   poll, and offers a Download button that streams the file to disk.
   Mirrors the IBS pattern: per-project, per-day. *@
@page "/admin/logs"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Logs.View)]
@implements IDisposable

<PageTitle>@L["Admin.Logs.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Logs.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        <p>@L["Admin.Logs.Supporting"]</p>

    @if (_loadingList)
    {
        <p>@L["Admin.Logs.Loading"]</p>
    }
    else if (_list is null || _list.Projects.Count == 0)
    {
        <SimfEmptyState Title="@L["Admin.Logs.Empty"]" />
    }
    else
    {
        @* D-117 — Q-E: two strict rows. Row 1 = filters (Project / File / Lines + Auto-refresh).
           Row 2 = action buttons (Refresh / Download). Group-aligned. *@
        <div class="simf-logs__row simf-logs__row--filters">
            <label class="simf-field">
                <span class="simf-field__label">@L["Admin.Logs.Project"]</span>
                <select class="simf-field__input" value="@_selectedProject"
                        @onchange="OnProjectChangedAsync">
                    @foreach (var project in _list.Projects)
                    {
                        <option value="@project.Name">@project.Name (@project.FileCount)</option>
                    }
                </select>
            </label>
            <label class="simf-field">
                <span class="simf-field__label">@L["Admin.Logs.File"]</span>
                <select class="simf-field__input" value="@_selectedFile"
                        @onchange="OnFileChangedAsync">
                    @foreach (var entry in CurrentProjectFiles())
                    {
                        <option value="@entry.FileName">
                            @entry.FileName — @FormatSize(entry.SizeBytes)
                            (@entry.LastModifiedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))
                        </option>
                    }
                </select>
            </label>
            <label class="simf-field">
                <span class="simf-field__label">@L["Admin.Logs.Lines"]</span>
                <select class="simf-field__input" value="@_lineCount"
                        @onchange="OnLineCountChangedAsync">
                    <option value="100">100</option>
                    <option value="500">500</option>
                    <option value="1000">1000</option>
                    <option value="5000">5000</option>
                </select>
            </label>
            <label class="simf-field simf-field--inline simf-logs__autorefresh">
                <input type="checkbox" checked="@_autoRefresh"
                       @onchange="OnAutoRefreshChanged" />
                <span>@L["Admin.Logs.AutoRefresh"]</span>
            </label>
        </div>

        <div class="simf-logs__row simf-logs__row--actions">
            <SimfButton Type="button" OnClick="RefreshAsync" Disabled="_loadingTail">
                @L["Admin.Logs.Refresh"]
            </SimfButton>
            <SimfButton Type="button" Variant="secondary" OnClick="DownloadAsync"
                        Disabled="@string.IsNullOrEmpty(_selectedFile)">
                @L["Admin.Logs.Download"]
            </SimfButton>
        </div>

        @if (_tail is not null)
        {
            <p class="simf-text-muted">
                @_tail.FileName · @FormatSize(_tail.SizeBytes) · @_tail.LineCount lines
            </p>
            <pre class="simf-logs-viewer">@_tail.Content</pre>
        }
    }
    </div>
</div>
