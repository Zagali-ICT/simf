@* D-478 (#11, Group G phase 2) — admin review desk for delegation↔delegation
   (G2G) meeting requests: a delegate of one invited country asks to meet another
   invited country's delegation ("count X meets country Y"). The team Accepts /
   Rejects with an optional note; on accept the requester is notified + emailed.
   Pending → Pending is rejected server-side (DELEGATION_MEETING_REQUEST_INVALID).
   SimfDataGrid (server-paged, status-filterable); the Respond action is a quiet
   reply button shown only for Pending rows. Mirrors SpeakerMeetingRequestsList. *@
@page "/admin/delegation-meetings"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.DelegationMeetings.View)]
@using SIMF.Contracts.Programme

<PageTitle>@L["Admin.DelegationMeetings.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.DelegationMeetings.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminDelegationMeetingRequestRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="false"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.TargetCountry)"
                      Caption="@L["Admin.DelegationMeetings.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.DelegationMeetings.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminDelegationMeetingRequestRow" Key="requestingCountry"
                                    Header="@L["Admin.DelegationMeetings.Col.From"]">
                    <CellTemplate>@context.RequestingCountry</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationMeetingRequestRow" Key="targetCountry"
                                    Header="@L["Admin.DelegationMeetings.Col.To"]">
                    <CellTemplate>@context.TargetCountry</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationMeetingRequestRow" Key="attendeeCount"
                                    Header="@L["Admin.DelegationMeetings.Col.Attendees"]">
                    <CellTemplate>@context.AttendeeCount</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationMeetingRequestRow" Key="subject"
                                    Header="@L["Admin.DelegationMeetings.Col.Subject"]">
                    <CellTemplate>@context.Subject</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationMeetingRequestRow" Key="status"
                                    Header="@L["Admin.DelegationMeetings.Col.Status"]"
                                    Filterable="true">
                    <CellTemplate>
                        @switch (context.Status)
                        {
                            case MeetingRequestStatus.Pending:
                                <SimfPill Variant="warn">@L["Admin.DelegationMeetings.Filter.Pending"]</SimfPill>
                                break;
                            case MeetingRequestStatus.AwaitingSpeaker:
                                <SimfPill Variant="warn">@L["Admin.Meetings.Status.AwaitingConfirmation"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Accepted:
                                <SimfPill Variant="on">@L["Admin.DelegationMeetings.Filter.Accepted"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Done:
                                <SimfPill Variant="on">@L["Admin.Meetings.Status.Done"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Rejected:
                                <SimfPill Variant="off">@L["Admin.DelegationMeetings.Filter.Rejected"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Cancelled:
                                <SimfPill Variant="off">@L["Admin.Meetings.Status.Cancelled"]</SimfPill>
                                break;
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationMeetingRequestRow" Key="createdAt"
                                    Header="@L["Admin.DelegationMeetings.Col.CreatedAt"]" Sortable="true">
                    <CellTemplate>@context.CreatedAt.FormatSaudi("dd-MM-yyyy hh:mm tt")</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @* Bi-Meeting rework — quiet actions by state: Respond (review + bind a
                   hall) on Pending; Confirm/Cancel on an Approved (AwaitingSpeaker)
                   request; Check in a confirmed (Accepted) meeting → Done. *@
                @if (context.Status is MeetingRequestStatus.Pending
                    or MeetingRequestStatus.AwaitingSpeaker)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.DelegationMeetings.Manage">
                        <SimfToolbarButton Icon="reply" Title="@L["Admin.DelegationMeetings.Respond"]"
                                           OnClick="@(() => OnRespondAsync(context))" />
                    </AuthorizedAction>
                }
                else if (context.Status == MeetingRequestStatus.Accepted)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.DelegationMeetings.Manage">
                        <SimfToolbarButton Icon="log-in" Title="@L["Admin.Meetings.CheckIn"]"
                                           Disabled="_busy"
                                           OnClick="@(() => OnCheckInAsync(context))" />
                    </AuthorizedAction>
                }
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.DelegationMeetings.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_respondOpen && _respondTarget is not null)
{
    <SimfModal Open="true" Title="@L["Admin.DelegationMeetings.Respond.Title"]"
               OnClose="@(() => _respondOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <dl class="simf-dl">
                    <dt>@L["Admin.DelegationMeetings.Col.From"]</dt>
                    <dd>@_respondTarget.RequestingCountry</dd>
                    <dt>@L["Admin.DelegationMeetings.Col.To"]</dt>
                    <dd>@_respondTarget.TargetCountry</dd>
                    <dt>@L["Admin.DelegationMeetings.Col.Attendees"]</dt>
                    <dd>@_respondTarget.AttendeeCount</dd>
                    <dt>@L["Admin.DelegationMeetings.Requester"]</dt>
                    <dd>
                        @if (_loadingDetail)
                        {
                            <div class="simf-table__sub">@L["Admin.DelegationMeetings.LoadingDetail"]</div>
                        }
                        else if (!string.IsNullOrEmpty(_respondTarget.RequesterEmail))
                        {
                            <div class="simf-table__sub">@_respondTarget.RequesterEmail</div>
                        }
                        else
                        {
                            <div class="simf-table__sub">—</div>
                        }
                    </dd>
                    <dt>@L["Admin.DelegationMeetings.Col.Subject"]</dt>
                    <dd>@_respondTarget.Subject</dd>
                </dl>

                @* Bi-Meeting rework — Pending review binds the meeting to a free hall
                   slot (Approve → the other delegation is emailed a confirm link + gets
                   an app notification to confirm; Confirm → the admin already has the
                   other party's verbal confirmation, booked straight away). An Approved
                   (AwaitingSpeaker) request only needs a Confirm (verbal) or a Cancel —
                   the hall is already bound. *@
                @if (_respondTarget.Status == MeetingRequestStatus.Pending)
                {
                    <label class="simf-field">
                        <span class="simf-field__label">@L["Admin.Meetings.Bind.Hall"]</span>
                        <select class="simf-field__input" value="@(_bindHallId?.ToString() ?? string.Empty)"
                                @onchange="OnBindHallChangedAsync" disabled="@_busy">
                            <option value="">@L["Admin.Meetings.Bind.PickHall"]</option>
                            @foreach (var hall in _halls)
                            {
                                <option value="@hall.Id">@hall.Name</option>
                            }
                        </select>
                    </label>
                    @if (_bindHallId is not null)
                    {
                        <label class="simf-field">
                            <span class="simf-field__label">@L["Admin.Meetings.Bind.Slot"]</span>
                            @if (_loadingSlots)
                            {
                                <div class="simf-table__sub">@L["Admin.Meetings.Bind.LoadingSlots"]</div>
                            }
                            else if (_hallSlots.Count == 0)
                            {
                                <div class="simf-table__sub">@L["Admin.Meetings.Bind.NoSlots"]</div>
                            }
                            else
                            {
                                <select class="simf-field__input" value="@_bindSlotIndex"
                                        @onchange="OnBindSlotChanged" disabled="@_busy">
                                    <option value="-1">@L["Admin.Meetings.Bind.SelectSlot"]</option>
                                    @for (var i = 0; i < _hallSlots.Count; i++)
                                    {
                                        <option value="@i">@FormatSlot(_hallSlots[i])</option>
                                    }
                                </select>
                            }
                        </label>
                        @if (_hallTables.Count > 0)
                        {
                            <label class="simf-field">
                                <span class="simf-field__label">@L["Admin.Meetings.Bind.Table"]</span>
                                <select class="simf-field__input" value="@(_bindTableId?.ToString() ?? string.Empty)"
                                        @onchange="OnBindTableChanged" disabled="@_busy">
                                    <option value="">@L["Admin.Meetings.Bind.NoTable"]</option>
                                    @foreach (var table in _hallTables)
                                    {
                                        <option value="@table.Id">@table.Code</option>
                                    }
                                </select>
                            </label>
                        }
                    }
                }
                else if (_respondTarget.Status == MeetingRequestStatus.AwaitingSpeaker
                    && _respondTarget.SlotStartUtc is { } awaitStart)
                {
                    <dl class="simf-dl">
                        <dt>@L["Admin.Meetings.Bind.Slot"]</dt>
                        <dd>@awaitStart.FormatSaudi("dd-MM-yyyy hh:mm tt")</dd>
                    </dl>
                }
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Meetings.Note"]</span>
                    <textarea class="simf-field__input" rows="4"
                              value="@_respondNote"
                              @onchange="OnRespondNoteChanged"
                              disabled="@_busy"></textarea>
                </label>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                        OnClick="@(() => _respondOpen = false)">
                @L["Admin.Meetings.Close"]
            </SimfButton>
            <SimfButton Type="button" Variant="danger" Disabled="_busy"
                        OnClick="DeclineAsync">
                @(_respondTarget.Status == MeetingRequestStatus.Pending
                    ? L["Admin.Meetings.Decline"] : L["Admin.Meetings.Cancel"])
            </SimfButton>
            @if (_respondTarget.Status == MeetingRequestStatus.Pending)
            {
                <SimfButton Type="button" OnClick="ApproveAsync" Loading="_busy">
                    @L["Admin.Meetings.Approve"]
                </SimfButton>
            }
            <SimfButton Type="button" OnClick="ConfirmAsync" Loading="_busy">
                @L["Admin.Meetings.Confirm"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
