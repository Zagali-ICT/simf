@* D-127 — On-site walk-in registration form. The exhibition staff at the
   registration desk uses this to register a walk-in Visitor or Other
   face-to-face. Hosts the full profile shape in one scrollable form with
   grouped <fieldset> sections; on submit the server auto-approves and
   mints the QR badge in one transaction. The parent receives the response
   via OnSuccess and is responsible for showing the success modal.

   D-129 updates:
     - Saudi national ID validated as 10 digits starting with 1.
     - When Saudi: country picker hidden, NationalityCode forced to "SA".
     - When non-Saudi: country picker required; Iqama-or-Passport radio
       sub-picker means staff fills exactly one ID-number field.
     - Iqama number validated as 10 digits starting with 2.
     - Optional ID-document file input on every walk-in — uploaded right
       after the create-onsite call succeeds, so the View modal can
       render the captured image.
     - Maxlength on every text input (defence in depth alongside the
       server-side FluentValidation rules).
*@
@using SIMF.Contracts.UserProfile
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form simf-walkin">
    @* -- Section 1: Profile type ---------------------------------------- *@
    <fieldset class="simf-walkin__section" disabled="@(_busy ? "disabled" : null)">
        <legend>@L["Admin.WalkIn.Section.ProfileType"]</legend>
        <p class="simf-walkin__hint">@L["Admin.WalkIn.Section.ProfileType.Hint"]</p>
        @if (_profileTypes.Length == 0)
        {
            <SimfAlert Variant="info">@L["Admin.WalkIn.ProfileType.NoneSeeded"]</SimfAlert>
        }
        else
        {
            <div class="simf-walkin__cards" role="radiogroup"
                 aria-label="@L["Admin.WalkIn.Section.ProfileType"]">
                @foreach (var pt in _profileTypes)
                {
                    var selected = _model.ProfileTypeId == pt.Id;
                    <button type="button"
                            class="simf-walkin__card @(selected ? "is-selected" : null)"
                            style="@($"--simf-walkin-card-color: {pt.PageColor}")"
                            role="radio" aria-checked="@(selected ? "true" : "false")"
                            @onclick="@(() => SelectProfileType(pt.Id))">
                        <span class="simf-walkin__swatch" aria-hidden="true"></span>
                        <span class="simf-walkin__card-name">@LabelFor(pt)</span>
                    </button>
                }
            </div>
        }
    </fieldset>

    @* -- Section 2: Identity ------------------------------------------- *@
    <fieldset class="simf-walkin__section" disabled="@(_busy ? "disabled" : null)">
        <legend>@L["Admin.WalkIn.Section.Identity"]</legend>
        <div class="simf-walkin__grid">
            <SimfTextField Label="@L["Admin.WalkIn.Field.EnglishName"]"
                           Helper="@L["Admin.WalkIn.Field.EnglishName.Hint"]"
                           MaxLength="128"
                           @bind-Value="_model.EnglishName" />
            <SimfTextField Label="@L["Admin.WalkIn.Field.ArabicName"]"
                           Helper="@L["Admin.WalkIn.Field.ArabicName.Hint"]"
                           MaxLength="128"
                           @bind-Value="_model.ArabicName" />
            <SimfTextField Label="@L["Admin.WalkIn.Field.DisplayName"]"
                           Helper="@L["Admin.WalkIn.Field.DisplayName.Hint"]"
                           MaxLength="128"
                           @bind-Value="_model.DisplayName" />
            <div class="simf-field">
                <label class="simf-field__label" for="walkin-dob">
                    @L["Admin.WalkIn.Field.DateOfBirth"]
                </label>
                <div class="simf-field__control">
                    <input id="walkin-dob" type="date" class="simf-field__input"
                           value="@(_model.DateOfBirth?.ToString("yyyy-MM-dd"))"
                           @onchange="OnDateOfBirthChanged" />
                </div>
            </div>
            <SimfTextField Label="@L["Admin.WalkIn.Field.PlaceOfBirth"]"
                           MaxLength="128"
                           @bind-Value="_model.PlaceOfBirth" />
        </div>
    </fieldset>

    @* -- Section 3: Nationality + identity document -------------------- *@
    <fieldset class="simf-walkin__section" disabled="@(_busy ? "disabled" : null)">
        <legend>@L["Admin.WalkIn.Section.Nationality"]</legend>
        <div class="simf-walkin__toggle" role="radiogroup"
             aria-label="@L["Admin.WalkIn.Field.IsSaudi"]">
            <button type="button"
                    class="simf-walkin__toggle-btn @(_model.IsSaudi ? "is-selected" : null)"
                    role="radio" aria-checked="@(_model.IsSaudi ? "true" : "false")"
                    @onclick="@(() => SetIsSaudi(true))">
                @L["Admin.WalkIn.IsSaudi.Yes"]
            </button>
            <button type="button"
                    class="simf-walkin__toggle-btn @(!_model.IsSaudi ? "is-selected" : null)"
                    role="radio" aria-checked="@(!_model.IsSaudi ? "true" : "false")"
                    @onclick="@(() => SetIsSaudi(false))">
                @L["Admin.WalkIn.IsSaudi.No"]
            </button>
        </div>
        @if (_model.IsSaudi)
        {
            @* Saudi visitors: nationality is implicitly SA, no picker.
               National ID is the only ID field. *@
            <div class="simf-walkin__grid">
                <SimfTextField Label="@L["Admin.WalkIn.Field.NationalId"]"
                               Helper="@L["Admin.WalkIn.Field.NationalId.Hint"]"
                               MaxLength="10" InputMode="numeric"
                               @bind-Value="_model.NationalId" />
            </div>
        }
        else
        {
            @* Non-Saudi visitors: country picker is required, plus a second
               toggle row that picks ONE document — Iqama or Passport — so
               the form never carries stale data from the other branch. *@
            <div class="simf-walkin__grid">
                <div class="simf-field">
                    <label class="simf-field__label" for="walkin-nationality">
                        @L["Admin.WalkIn.Field.Nationality"]
                    </label>
                    <div class="simf-field__control">
                        <select id="walkin-nationality" class="simf-field__input"
                                value="@_model.NationalityCode"
                                @onchange="OnNationalityChanged">
                            <option value="">@L["Admin.WalkIn.Field.Nationality.Placeholder"]</option>
                            @foreach (var c in _countries)
                            {
                                <option value="@c.Code">@CountryLabel(c)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="simf-walkin__toggle" role="radiogroup"
                 aria-label="@L["Admin.WalkIn.Field.NonSaudiIdKind"]">
                <button type="button"
                        class="simf-walkin__toggle-btn @(_idKind == "Iqama" ? "is-selected" : null)"
                        role="radio" aria-checked="@(_idKind == "Iqama" ? "true" : "false")"
                        @onclick="@(() => SetNonSaudiIdKind("Iqama"))">
                    @L["Admin.WalkIn.NonSaudiIdKind.Iqama"]
                </button>
                <button type="button"
                        class="simf-walkin__toggle-btn @(_idKind == "Passport" ? "is-selected" : null)"
                        role="radio" aria-checked="@(_idKind == "Passport" ? "true" : "false")"
                        @onclick="@(() => SetNonSaudiIdKind("Passport"))">
                    @L["Admin.WalkIn.NonSaudiIdKind.Passport"]
                </button>
            </div>
            <div class="simf-walkin__grid">
                @if (_idKind == "Iqama")
                {
                    <SimfTextField Label="@L["Admin.WalkIn.Field.IqamaNumber"]"
                                   Helper="@L["Admin.WalkIn.Field.Iqama.Hint"]"
                                   MaxLength="10" InputMode="numeric"
                                   @bind-Value="_model.IqamaNumber" />
                }
                else
                {
                    <SimfTextField Label="@L["Admin.WalkIn.Field.PassportNumber"]"
                                   Helper="@L["Admin.WalkIn.Field.Passport.Hint"]"
                                   MaxLength="20"
                                   @bind-Value="_model.PassportNumber" />
                }
            </div>
        }
    </fieldset>

    @* -- Section 4: Contact ------------------------------------------- *@
    <fieldset class="simf-walkin__section" disabled="@(_busy ? "disabled" : null)">
        <legend>@L["Admin.WalkIn.Section.Contact"]</legend>
        <div class="simf-walkin__grid">
            @if (_model.IsSaudi)
            {
                <SimfTextField Label="@L["Admin.WalkIn.Field.SaudiMobile"]"
                               Helper="@L["Admin.WalkIn.Field.SaudiMobile.Hint"]"
                               @bind-Value="_model.SaudiMobile"
                               MaxLength="32" InputMode="tel" Type="tel" />
            }
            else
            {
                <SimfTextField Label="@L["Admin.WalkIn.Field.InternationalMobile"]"
                               Helper="@L["Admin.WalkIn.Field.InternationalMobile.Hint"]"
                               @bind-Value="_model.InternationalMobile"
                               MaxLength="32" InputMode="tel" Type="tel" />
            }
            <SimfTextField Label="@L["Admin.WalkIn.Field.Email"]"
                           Helper="@L["Admin.WalkIn.Field.Email.Hint"]"
                           @bind-Value="_model.Email"
                           MaxLength="256" InputMode="email" Type="email" />
        </div>
    </fieldset>

    @* -- Section 5: ID document (file upload) -------------------------- *@
    <fieldset class="simf-walkin__section" disabled="@(_busy ? "disabled" : null)">
        <legend>@L["Admin.WalkIn.Section.IdDocument"]</legend>
        <p class="simf-walkin__hint">@L["Admin.WalkIn.Section.IdDocument.Hint"]</p>
        <div class="simf-field">
            <input id="walkin-id-document" type="file" class="simf-field__input"
                   accept="image/png,image/jpeg,image/webp"
                   @onchange="OnIdDocumentChanged" />
            @if (!string.IsNullOrEmpty(_idDocumentName))
            {
                <div class="simf-field__helper">
                    @string.Format(L["Admin.WalkIn.Field.IdDocument.Selected"], _idDocumentName)
                </div>
            }
        </div>
    </fieldset>

    @* -- Section 6: Interests (visitor only) -------------------------- *@
    @if (string.Equals(Kind, "Visitor", StringComparison.OrdinalIgnoreCase) && _interests.Length > 0)
    {
        <fieldset class="simf-walkin__section" disabled="@(_busy ? "disabled" : null)">
            <legend>@L["Admin.WalkIn.Section.Interests"]</legend>
            <p class="simf-walkin__hint">@L["Admin.WalkIn.Section.Interests.Hint"]</p>
            <div class="simf-walkin__chips" role="group"
                 aria-label="@L["Admin.WalkIn.Section.Interests"]">
                @foreach (var interest in _interests)
                {
                    var selected = _model.InterestIds.Contains(interest.Id);
                    <button type="button"
                            class="simf-walkin__chip @(selected ? "is-selected" : null)"
                            aria-pressed="@(selected ? "true" : "false")"
                            @onclick="@(() => ToggleInterest(interest.Id))">
                        @InterestLabel(interest)
                    </button>
                }
            </div>
        </fieldset>
    }

    @* -- Submit row ---------------------------------------------------- *@
    <div class="simf-form__actions simf-walkin__actions">
        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.WalkIn.Submitting"]">
            @L["Admin.WalkIn.Submit"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.WalkIn.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>

@code {
    private readonly Model _model = new();
    private EditContext _editContext = default!;
    private bool _busy;
    private string? _error;
    private AdminProfileTypeSummary[] _profileTypes = Array.Empty<AdminProfileTypeSummary>();
    private CountryDto[] _countries = Array.Empty<CountryDto>();
    private InterestDto[] _interests = Array.Empty<InterestDto>();
    private string _idKind = "Iqama";
    private string? _idDocumentName;

    /// <summary>"Visitor" or "Other" — drives the profile-type picker
    /// query and the interests section visibility.</summary>
    [Parameter] public string Kind { get; set; } = "Visitor";

    /// <summary>Fires after a successful register-onsite. The parent uses
    /// the response to render the post-submit success modal with the QR.</summary>
    [Parameter] public EventCallback<AdminWalkInRegistrationResponse> OnSuccess { get; set; }

    /// <summary>Optional cancel callback. When unset, no Cancel button.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_model);

        // Load profile types for this kind + interests + countries in
        // parallel — the desk shouldn't wait for three sequential round-trips.
        var profileTypesTask = JS.InvokeAsync<ApiResult<IReadOnlyList<AdminProfileTypeSummary>>>(
            "simfAccount.getJson",
            $"/account/api/admin/profile-types?userType={Uri.EscapeDataString(Kind)}").AsTask();
        var countriesTask = JS.InvokeAsync<ApiResult<CountryListResponse>>(
            "simfAccount.getJson",
            "/account/api/admin/walk-in/countries").AsTask();

        Task<ApiResult<InterestListResponse>>? interestsTask = null;
        if (string.Equals(Kind, "Visitor", StringComparison.OrdinalIgnoreCase))
        {
            interestsTask = JS.InvokeAsync<ApiResult<InterestListResponse>>(
                "simfAccount.getJson", "/account/api/interests").AsTask();
        }

        var ptEnvelope = await profileTypesTask;
        if (ptEnvelope is { Success: true, Data: not null })
        {
            _profileTypes = ptEnvelope.Data.OrderBy(p => p.Name).ToArray();
        }

        var cEnvelope = await countriesTask;
        if (cEnvelope is { Success: true, Data: not null })
        {
            _countries = cEnvelope.Data.Countries.ToArray();
        }

        if (interestsTask is not null)
        {
            var iEnvelope = await interestsTask;
            if (iEnvelope is { Success: true, Data: not null })
            {
                _interests = iEnvelope.Data.Interests.ToArray();
            }
        }
    }

    private void SelectProfileType(Guid id) => _model.ProfileTypeId = id;

    private void SetIsSaudi(bool value)
    {
        _model.IsSaudi = value;
        // Clear the ID field that no longer applies so the validator
        // doesn't see stale data when staff toggles back and forth.
        if (value)
        {
            _model.IqamaNumber = null;
            _model.PassportNumber = null;
            // Saudi visitors: nationality is implicitly SA, no picker.
            _model.NationalityCode = "SA";
        }
        else
        {
            _model.NationalId = null;
            // Default to an empty pick so the placeholder shows.
            if (_model.NationalityCode == "SA")
            {
                _model.NationalityCode = string.Empty;
            }
            // Default the Iqama / Passport sub-picker to Iqama for fresh
            // non-Saudi state; staff can flip.
            _idKind = "Iqama";
        }
    }

    private void SetNonSaudiIdKind(string kind)
    {
        _idKind = kind;
        // Clear the other ID field so the wrong value never leaks to the
        // server payload if staff toggled after typing.
        if (kind == "Iqama") { _model.PassportNumber = null; }
        else { _model.IqamaNumber = null; }
    }

    private void OnNationalityChanged(ChangeEventArgs e)
    {
        _model.NationalityCode = e.Value?.ToString() ?? string.Empty;
    }

    private void OnDateOfBirthChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _model.DateOfBirth = string.IsNullOrEmpty(raw) || !DateOnly.TryParse(raw, out var parsed)
            ? null
            : parsed;
    }

    private async Task OnIdDocumentChanged(ChangeEventArgs _)
    {
        // Grab the picked file name (best-effort, browsers expose only
        // the file name for native <input type="file">). The actual upload
        // happens after a successful register-onsite — we need the new
        // user id first.
        var name = await JS.InvokeAsync<string?>(
            "eval", "document.getElementById('walkin-id-document')?.files?.[0]?.name ?? null");
        _idDocumentName = name;
    }

    private void ToggleInterest(Guid id)
    {
        if (!_model.InterestIds.Remove(id))
        {
            _model.InterestIds.Add(id);
        }
    }

    private string LabelFor(AdminProfileTypeSummary pt) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? pt.NameArabic : pt.Name;

    // Saudi national ID is exactly 10 digits starting with 1; Iqama (residency
    // permit) starts with 2. Mirrors the server-side FluentValidation regex.
    private static readonly System.Text.RegularExpressions.Regex SaudiIdPattern =
        new("^1[0-9]{9}$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static readonly System.Text.RegularExpressions.Regex IqamaPattern =
        new("^2[0-9]{9}$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string CountryLabel(CountryDto c) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
            ? $"{c.NameAr} ({c.Code})"
            : $"{c.NameEn} ({c.Code})";

    private static string InterestLabel(InterestDto i) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? i.NameArabic : i.Name;

    private async Task HandleSubmitAsync()
    {
        if (_busy) return;
        _error = null;

        // Client-side gate — the server-side FluentValidation owns the
        // canonical rule set; this is just the friendly UX layer.
        if (_model.ProfileTypeId == Guid.Empty)
        {
            _error = L["Admin.WalkIn.Error.ProfileTypeRequired"]; return;
        }
        if (_model.EnglishName.Length is < 2 or > 128)
        {
            _error = L["Admin.WalkIn.Error.EnglishNameRequired"]; return;
        }
        if (_model.ArabicName.Length is < 2 or > 128)
        {
            _error = L["Admin.WalkIn.Error.ArabicNameRequired"]; return;
        }
        if (_model.DisplayName.Length is < 2 or > 128)
        {
            _error = L["Admin.WalkIn.Error.DisplayNameRequired"]; return;
        }
        if (_model.IsSaudi)
        {
            if (string.IsNullOrWhiteSpace(_model.NationalId)
                || !SaudiIdPattern.IsMatch(_model.NationalId))
            {
                _error = L["Admin.WalkIn.Error.NationalIdRequired"]; return;
            }
            // Force nationality to SA — the picker is hidden in this branch.
            _model.NationalityCode = "SA";
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_model.NationalityCode))
            {
                _error = L["Admin.WalkIn.Error.NationalityRequired"]; return;
            }
            if (_idKind == "Iqama")
            {
                if (string.IsNullOrWhiteSpace(_model.IqamaNumber)
                    || !IqamaPattern.IsMatch(_model.IqamaNumber))
                {
                    _error = L["Admin.WalkIn.Error.IqamaInvalid"]; return;
                }
                _model.PassportNumber = null;
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_model.PassportNumber)
                    || _model.PassportNumber.Length > 20)
                {
                    _error = L["Admin.WalkIn.Error.PassportRequired"]; return;
                }
                _model.IqamaNumber = null;
            }
        }
        if (string.IsNullOrWhiteSpace(_model.SaudiMobile) && string.IsNullOrWhiteSpace(_model.InternationalMobile))
        {
            _error = L["Admin.WalkIn.Error.MobileRequired"]; return;
        }

        var basePath = string.Equals(Kind, "Other", StringComparison.OrdinalIgnoreCase)
            ? "/account/api/admin/others"
            : "/account/api/admin/visitors";

        _busy = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<AdminWalkInRegistrationResponse>>(
                "simfAccount.postJson", $"{basePath}/register-onsite",
                new AdminWalkInRegistrationRequest
                {
                    Email = string.IsNullOrWhiteSpace(_model.Email) ? null : _model.Email.Trim(),
                    DisplayName = _model.DisplayName.Trim(),
                    ArabicName = _model.ArabicName.Trim(),
                    EnglishName = _model.EnglishName.Trim(),
                    ProfileTypeId = _model.ProfileTypeId,
                    NationalityCode = _model.NationalityCode.Trim().ToUpperInvariant(),
                    DateOfBirth = _model.DateOfBirth,
                    PlaceOfBirth = string.IsNullOrWhiteSpace(_model.PlaceOfBirth) ? null : _model.PlaceOfBirth.Trim(),
                    IsSaudi = _model.IsSaudi,
                    NationalId = _model.IsSaudi ? _model.NationalId : null,
                    IqamaNumber = _model.IsSaudi ? null : _model.IqamaNumber,
                    PassportNumber = _model.IsSaudi ? null : _model.PassportNumber,
                    SaudiMobile = string.IsNullOrWhiteSpace(_model.SaudiMobile) ? null : _model.SaudiMobile.Trim(),
                    InternationalMobile = string.IsNullOrWhiteSpace(_model.InternationalMobile) ? null : _model.InternationalMobile.Trim(),
                    InterestIds = _model.InterestIds.ToList(),
                });

            if (envelope is { Success: true, Data: not null })
            {
                // If staff picked an ID-document file, upload it now that
                // we have the new user id. The upload is fire-and-forget —
                // a failed upload doesn't undo the registration, but the
                // failure surfaces as a soft warning on the success view.
                if (!string.IsNullOrEmpty(_idDocumentName))
                {
                    try
                    {
                        await JS.InvokeAsync<object?>(
                            "simfAccount.uploadFile",
                            $"{basePath}/{envelope.Data.UserId}/id-document",
                            "walkin-id-document");
                    }
                    catch (Exception) { /* surfaces as HasIdImage=false in the View modal */ }
                }
                await OnSuccess.InvokeAsync(envelope.Data);
                ResetForm();
            }
            else
            {
                _error = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.WalkIn.Error.Fallback"];
            }
        }
        catch (Exception)
        {
            _error = L["Admin.WalkIn.Error.Fallback"];
        }
        finally { _busy = false; }
    }

    /// <summary>Clears the model to defaults so the desk can immediately
    /// register the next walk-in. Preserves the selected ProfileTypeId
    /// because most walks-in to one desk are the same kind.</summary>
    public void ResetForm()
    {
        var keepProfileTypeId = _model.ProfileTypeId;
        var keepIsSaudi = _model.IsSaudi;
        var keepNationality = _model.NationalityCode;
        _model.Email = string.Empty;
        _model.DisplayName = string.Empty;
        _model.ArabicName = string.Empty;
        _model.EnglishName = string.Empty;
        _model.DateOfBirth = null;
        _model.PlaceOfBirth = string.Empty;
        _model.NationalId = null;
        _model.IqamaNumber = null;
        _model.PassportNumber = null;
        _model.SaudiMobile = null;
        _model.InternationalMobile = null;
        _model.InterestIds.Clear();
        _model.ProfileTypeId = keepProfileTypeId;
        _model.IsSaudi = keepIsSaudi;
        _model.NationalityCode = keepNationality;
        _idDocumentName = null;
        StateHasChanged();
    }

    private sealed class Model
    {
        public string? Email { get; set; }
        public string DisplayName { get; set; } = string.Empty;
        public string ArabicName { get; set; } = string.Empty;
        public string EnglishName { get; set; } = string.Empty;
        public Guid ProfileTypeId { get; set; }
        public string NationalityCode { get; set; } = "SA";
        public DateOnly? DateOfBirth { get; set; }
        public string PlaceOfBirth { get; set; } = string.Empty;
        public bool IsSaudi { get; set; } = true;
        public string? NationalId { get; set; }
        public string? IqamaNumber { get; set; }
        public string? PassportNumber { get; set; }
        public string? SaudiMobile { get; set; }
        public string? InternationalMobile { get; set; }
        public List<Guid> InterestIds { get; set; } = new();
    }
}
