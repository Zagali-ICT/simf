@* D-127 — On-site walk-in registration form. The exhibition staff at the
   registration desk uses this to register a walk-in Visitor or Other
   face-to-face. On submit the server auto-approves and mints the QR badge in
   one transaction. The parent receives the response via OnSuccess and is
   responsible for showing the success modal.

   UI (2026-07-22) — professional redesign. The long record is grouped into
   numbered <SimfFormSection> cards laid out with the house responsive
   simf-form__grid (bilingual pairs side by side), matching SpeakersAddEdit —
   replacing the older <fieldset>/<legend> sections + the bespoke 3-column
   scaffold. The native gender/language/nationality/region <select>s, the DOB
   date input and the file inputs now use SimfSelect / SimfDatePicker /
   SimfFileUpload for one consistent field shell. Behaviour, fields, endpoints
   and validation are unchanged; a single wrapping <fieldset disabled> keeps the
   submit-time lockout of every control.

   D-129 rules (unchanged):
     - Saudi national ID validated as 10 digits starting with 1.
     - When Saudi: country picker hidden, NationalityCode forced to "SA".
     - When non-Saudi: country picker required; Iqama-or-Passport radio
       sub-picker means staff fills exactly one ID-number field.
     - Iqama number validated as 10 digits starting with 2.
     - Optional ID-document file input on every walk-in — uploaded right
       after the create-onsite call succeeds, so the View modal can
       render the captured image.
     - Maxlength on every text input (defence in depth alongside the
       server-side FluentValidation rules).
*@
@using SIMF.Contracts.UserProfile
@using SIMF.Contracts.Organisations
@using SIMF.Contracts.Regions
@using SIMF.Common
@using SIMF.Common.Enums
@implements IDisposable

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form simf-walkin">
    @* One disabled-able fieldset wraps every section so a submit locks all
       controls at once (native inputs, SimfSelect/SimfTextField inputs, the
       custom picker/toggle/chip buttons) — no per-field Disabled needed. The
       default fieldset chrome is reset in the scoped stylesheet. *@
    <fieldset class="simf-walkin__fields" disabled="@(_busy ? "disabled" : null)">
        @{ var step = 0; }

        @* -- Profile type -------------------------------------------------- *@
        <SimfFormSection Number="@(++step)" Title="@L["Admin.WalkIn.Section.ProfileType"]"
                         Hint="@L["Admin.WalkIn.Section.ProfileType.Hint"]">
            @if (_profileTypes.Length == 0)
            {
                <SimfAlert Variant="info">@L["Admin.WalkIn.ProfileType.NoneSeeded"]</SimfAlert>
            }
            else
            {
                <div class="simf-walkin__cards" role="radiogroup"
                     aria-label="@L["Admin.WalkIn.Section.ProfileType"]">
                    @foreach (var pt in _profileTypes)
                    {
                        var selected = _model.ProfileTypeId == pt.Id;
                        <button type="button"
                                class="simf-walkin__card @(selected ? "is-selected" : null)"
                                style="@($"--simf-walkin-card-color: {pt.PageColor}")"
                                role="radio" aria-checked="@(selected ? "true" : "false")"
                                @onclick="@(() => SelectProfileType(pt.Id))">
                            <span class="simf-walkin__swatch" aria-hidden="true"></span>
                            <span class="simf-walkin__card-name">@LabelFor(pt)</span>
                        </button>
                    }
                </div>
            }
        </SimfFormSection>

        @* -- VIP (موج) — VIP page only. Optional welcome-message fields the
           technical teams use to greet the VVIP/VIP. *@
        @if (VipMode)
        {
            <SimfFormSection Number="@(++step)" Title="@L["Admin.WalkIn.Section.Vip"]"
                             Hint="@L["Admin.WalkIn.Section.Vip.Hint"]">
                <div class="simf-form__grid">
                    <SimfTextField Label="@L["Admin.WalkIn.Field.MawjId"]"
                                   Helper="@L["Admin.WalkIn.Field.MawjId.Hint"]"
                                   MaxLength="64"
                                   Value="@(_model.MawjId ?? string.Empty)"
                                   ValueChanged="@(v => _model.MawjId = string.IsNullOrWhiteSpace(v) ? null : v)"
                                   ValueExpression="@(() => _model.MawjId)" />
                    <SimfTextField Label="@L["Admin.WalkIn.Field.Honorific"]"
                                   Helper="@L["Admin.WalkIn.Field.Honorific.Hint"]"
                                   MaxLength="64"
                                   Value="@(_model.Honorific ?? string.Empty)"
                                   ValueChanged="@(v => _model.Honorific = string.IsNullOrWhiteSpace(v) ? null : v)"
                                   ValueExpression="@(() => _model.Honorific)" />
                    <SimfTextField Label="@L["Admin.WalkIn.Field.HonorificArabic"]"
                                   MaxLength="64"
                                   Value="@(_model.HonorificArabic ?? string.Empty)"
                                   ValueChanged="@(v => _model.HonorificArabic = string.IsNullOrWhiteSpace(v) ? null : v)"
                                   ValueExpression="@(() => _model.HonorificArabic)" />
                    <SimfSelect TValue="string"
                                Label="@L["Admin.WalkIn.Field.PreferredLanguage"]"
                                Helper="@L["Admin.WalkIn.Field.PreferredLanguage.Hint"]"
                                Placeholder="@L["Admin.WalkIn.Field.PreferredLanguage.Placeholder"]"
                                Items="PreferredLanguages"
                                ValueFor="@(c => c)"
                                LabelFor="@(c => PreferredLanguageLabel(c))"
                                Value="_model.PreferredLanguage"
                                ValueChanged="OnPreferredLanguagePicked" />
                </div>
            </SimfFormSection>
        }

        @* -- Identity. Badge name first (most visible on the printed badge),
           DOB beside it; the two full names each take a full-width row (owner
           request); job title + place of birth, then gender + the vehicle plate. *@
        <SimfFormSection Number="@(++step)" Title="@L["Admin.WalkIn.Section.Identity"]">
            <div class="simf-form__grid">
                <SimfTextField Label="@L["Admin.WalkIn.Field.DisplayName"]"
                               Helper="@L["Admin.WalkIn.Field.DisplayName.Hint"]"
                               MaxLength="128"
                               @bind-Value="_model.DisplayName" />
                <SimfDatePicker Label="@L["Admin.WalkIn.Field.DateOfBirth"]"
                                Value="@(_model.DateOfBirth?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                ValueChanged="OnDateOfBirthChanged" />
            </div>
            @* الاسم الكامل (إنجليزي) — full-width row of its own (owner request). *@
            <SimfTextField Label="@L["Admin.WalkIn.Field.EnglishName"]"
                           Helper="@L["Admin.WalkIn.Field.EnglishName.Hint"]"
                           MaxLength="128"
                           @bind-Value="_model.EnglishName" />
            @* الاسم الكامل (عربي) — full-width row of its own (owner request). *@
            <SimfTextField Label="@L["Admin.WalkIn.Field.ArabicName"]"
                           Helper="@L["Admin.WalkIn.Field.ArabicName.Hint"]"
                           MaxLength="128"
                           @bind-Value="_model.ArabicName" />
            <div class="simf-form__grid">
                @* D-163 (PDF §2.6) — optional job title for the badge. *@
                <SimfTextField Label="@L["Admin.WalkIn.Field.JobTitle"]"
                               Helper="@L["Admin.WalkIn.Field.JobTitle.Hint"]"
                               MaxLength="128"
                               Value="@(_model.JobTitle ?? string.Empty)"
                               ValueChanged="@(v => _model.JobTitle = string.IsNullOrWhiteSpace(v) ? null : v)"
                               ValueExpression="@(() => _model.JobTitle)" />
                <SimfTextField Label="@L["Admin.WalkIn.Field.JobTitleArabic"]"
                               MaxLength="100"
                               Value="@(_model.JobTitleArabic ?? string.Empty)"
                               ValueChanged="@(v => _model.JobTitleArabic = string.IsNullOrWhiteSpace(v) ? null : v)"
                               ValueExpression="@(() => _model.JobTitleArabic)" />
            </div>
            <div class="simf-form__grid">
                @* D-469 / D-547 — birth location: a Saudi walk-in picks one of the
                   13 official regions (keyed on the stable region code); a non-Saudi
                   gets the free-text field "as in passport". *@
                @if (_model.IsSaudi)
                {
                    <SimfSelect TValue="RegionOption"
                                Label="@L["Admin.WalkIn.Field.PlaceOfBirth"]"
                                Placeholder="@L["Admin.WalkIn.Field.PlaceOfBirth.Select"]"
                                Items="_regions"
                                ValueFor="@(r => r.Code)"
                                LabelFor="@(r => RegionName(r))"
                                Value="@(_regions.FirstOrDefault(r => r.Code == RegionCodeForName(_model.PlaceOfBirth)))"
                                ValueChanged="OnBirthRegionPicked" />
                }
                else
                {
                    <SimfTextField Label="@L["Admin.WalkIn.Field.PlaceOfBirth"]"
                                   Helper="@L["Admin.WalkIn.Field.PlaceOfBirth.PassportHint"]"
                                   MaxLength="128"
                                   @bind-Value="_model.PlaceOfBirth" />
                }
                @* D-395 — gender picker (enum-name option values). *@
                <SimfSelect TValue="string"
                            Label="@L["Admin.WalkIn.Field.Gender"]"
                            Items="GenderCodes"
                            ValueFor="@(c => c)"
                            LabelFor="@(c => GenderLabel(c))"
                            Value="@(_model.Gender.ToString())"
                            ValueChanged="OnGenderPicked" />
            </div>
            @* C6 (D-459) — رقم اللوحة: standard Saudi-plate entry — three
               17-letter dropdowns (Arabic · Latin) + a 1–4 digit field. The picks
               assemble into _model.PlateNumber; the server validates
               SaudiPlate.IsValid and stores the canonical code. *@
            <div class="simf-field">
                <label class="simf-field__label">@L["Admin.WalkIn.Field.PlateNumber"]</label>
                <div class="simf-field__control simf-walkin__plate">
                    @for (var i = 0; i < _plateLetters.Length; i++)
                    {
                        var idx = i;
                        <select class="simf-field__input simf-walkin__plate-letter"
                                value="@_plateLetters[idx]"
                                @onchange="@(e => OnPlateLetterChanged(idx, e))"
                                aria-label="@($"{L["Admin.WalkIn.Field.Plate.Letter"]} {idx + 1}")">
                            <option value="">@L["Admin.WalkIn.Field.Plate.Letter"]</option>
                            @foreach (var letter in SaudiPlate.Letters)
                            {
                                <option value="@letter.Code">@($"{letter.Arabic} · {letter.English}")</option>
                            }
                        </select>
                    }
                    <input class="simf-field__input simf-walkin__plate-digits"
                           inputmode="numeric" maxlength="4"
                           placeholder="@L["Admin.WalkIn.Field.Plate.Digits"]"
                           value="@_plateDigits" @oninput="OnPlateDigitsChanged"
                           aria-label="@L["Admin.WalkIn.Field.Plate.Digits"]" />
                </div>
                <div class="simf-field__helper">@L["Admin.WalkIn.Field.PlateNumber.Hint"]</div>
            </div>
        </SimfFormSection>

        @* -- Organisation (الجهة) — required (B3 / D-221). Searchable typeahead
           over the active organisations lookup; the desk must pick a registered
           organisation. *@
        <SimfFormSection Number="@(++step)" Title="@L["Admin.WalkIn.Section.Organisation"]">
            <div class="simf-field @(_orgError is not null ? "simf-field--error" : null)">
                <label class="simf-field__label" for="walkin-org-search">
                    @L["Admin.WalkIn.Field.Organisation"]
                </label>
                <div class="simf-field__control">
                    <input id="walkin-org-search" class="simf-field__input"
                           autocomplete="off"
                           placeholder="@L["Admin.WalkIn.Field.Organisation.Search"]"
                           value="@_orgSearch" @oninput="OnOrgSearchInputAsync"
                           @onfocusin="OpenOrgList"
                           aria-invalid="@(_orgError is not null ? "true" : null)" />
                </div>
                @if (_orgListOpen && _orgResults.Length > 0)
                {
                    <ul class="simf-walkin__org-results" role="listbox"
                        aria-label="@L["Admin.WalkIn.Section.Organisation"]">
                        @foreach (var org in _orgResults)
                        {
                            <li>
                                @* preventDefault on mousedown keeps focus on the
                                   input so the option click registers before blur. *@
                                <button type="button" class="simf-walkin__org-option"
                                        @onmousedown:preventDefault="true"
                                        @onclick="@(() => SelectOrganisation(org))">
                                    @OrgLabel(org)
                                </button>
                            </li>
                        }
                    </ul>
                }
                else if (_orgListOpen && _orgSearch.Length > 0)
                {
                    <ul class="simf-walkin__org-results">
                        <li class="simf-walkin__org-empty">
                            @L["Admin.WalkIn.Field.Organisation.NoResults"]
                        </li>
                    </ul>
                }
                @if (_orgError is not null)
                {
                    <div class="simf-field__error" role="alert">
                        <SimfIcon Name="alert" Size="14" Class="simf-field__error-icon" />
                        <span>@_orgError</span>
                    </div>
                }
                else if (_model.OrganisationId is not null && _orgSelectedLabel is not null)
                {
                    <div class="simf-field__helper">
                        @string.Format(L["Admin.WalkIn.Field.Organisation.Selected"], _orgSelectedLabel)
                    </div>
                }
                else
                {
                    <div class="simf-field__helper">@L["Admin.WalkIn.Field.Organisation.Hint"]</div>
                }
            </div>
        </SimfFormSection>

        @* -- Nationality + identity document ------------------------------ *@
        <SimfFormSection Number="@(++step)" Title="@L["Admin.WalkIn.Section.Nationality"]">
            <div class="simf-walkin__toggle" role="radiogroup"
                 aria-label="@L["Admin.WalkIn.Field.IsSaudi"]">
                <button type="button"
                        class="simf-walkin__toggle-btn @(_model.IsSaudi ? "is-selected" : null)"
                        role="radio" aria-checked="@(_model.IsSaudi ? "true" : "false")"
                        @onclick="@(() => SetIsSaudi(true))">
                    @L["Admin.WalkIn.IsSaudi.Yes"]
                </button>
                <button type="button"
                        class="simf-walkin__toggle-btn @(!_model.IsSaudi ? "is-selected" : null)"
                        role="radio" aria-checked="@(!_model.IsSaudi ? "true" : "false")"
                        @onclick="@(() => SetIsSaudi(false))">
                    @L["Admin.WalkIn.IsSaudi.No"]
                </button>
            </div>
            @if (_model.IsSaudi)
            {
                @* Saudi visitors: nationality is implicitly SA, no picker.
                   National ID is the only ID field. *@
                <SimfTextField Label="@L["Admin.WalkIn.Field.NationalId"]"
                               Helper="@L["Admin.WalkIn.Field.NationalId.Hint"]"
                               MaxLength="10" Numeric="true" Autocomplete="off"
                               @bind-Value="_model.NationalId" />
            }
            else
            {
                @* Non-Saudi visitors: country picker is required, plus a second
                   toggle that picks ONE document — Iqama or Passport — so the form
                   never carries stale data from the other branch. *@
                <SimfSelect TValue="CountryDto"
                            Label="@L["Admin.WalkIn.Field.Nationality"]"
                            Placeholder="@L["Admin.WalkIn.Field.Nationality.Placeholder"]"
                            Items="_countries"
                            ValueFor="@(c => c.Code)"
                            LabelFor="@(c => CountryLabel(c))"
                            Value="@(_countries.FirstOrDefault(c => c.Code == _model.NationalityCode))"
                            ValueChanged="OnNationalityPicked" />
                <div class="simf-walkin__toggle" role="radiogroup"
                     aria-label="@L["Admin.WalkIn.Field.NonSaudiIdKind"]">
                    <button type="button"
                            class="simf-walkin__toggle-btn @(_idKind == "Iqama" ? "is-selected" : null)"
                            role="radio" aria-checked="@(_idKind == "Iqama" ? "true" : "false")"
                            @onclick="@(() => SetNonSaudiIdKind("Iqama"))">
                        @L["Admin.WalkIn.NonSaudiIdKind.Iqama"]
                    </button>
                    <button type="button"
                            class="simf-walkin__toggle-btn @(_idKind == "Passport" ? "is-selected" : null)"
                            role="radio" aria-checked="@(_idKind == "Passport" ? "true" : "false")"
                            @onclick="@(() => SetNonSaudiIdKind("Passport"))">
                        @L["Admin.WalkIn.NonSaudiIdKind.Passport"]
                    </button>
                </div>
                @if (_idKind == "Iqama")
                {
                    <SimfTextField Label="@L["Admin.WalkIn.Field.IqamaNumber"]"
                                   Helper="@L["Admin.WalkIn.Field.Iqama.Hint"]"
                                   MaxLength="10" Numeric="true" Autocomplete="off"
                                   @bind-Value="_model.IqamaNumber" />
                }
                else
                {
                    <SimfTextField Label="@L["Admin.WalkIn.Field.PassportNumber"]"
                                   Helper="@L["Admin.WalkIn.Field.Passport.Hint"]"
                                   MaxLength="20" Autocomplete="off"
                                   @bind-Value="_model.PassportNumber" />
                }
            }
        </SimfFormSection>

        @* -- Contact ------------------------------------------------------ *@
        <SimfFormSection Number="@(++step)" Title="@L["Admin.WalkIn.Section.Contact"]">
            <div class="simf-form__grid">
                @if (_model.IsSaudi)
                {
                    <SimfTextField Label="@L["Admin.WalkIn.Field.SaudiMobile"]"
                                   Helper="@L["Admin.WalkIn.Field.SaudiMobile.Hint"]"
                                   @bind-Value="_model.SaudiMobile" Autocomplete="off"
                                   MaxLength="32" InputMode="tel" Type="tel" />
                }
                else
                {
                    <SimfTextField Label="@L["Admin.WalkIn.Field.InternationalMobile"]"
                                   Helper="@L["Admin.WalkIn.Field.InternationalMobile.Hint"]"
                                   @bind-Value="_model.InternationalMobile" Autocomplete="off"
                                   MaxLength="32" InputMode="tel" Type="tel" />
                }
                <SimfTextField Label="@L["Admin.WalkIn.Field.Email"]"
                               Helper="@L["Admin.WalkIn.Field.Email.Hint"]"
                               @bind-Value="_model.Email"
                               MaxLength="256" InputMode="email" Type="email" />
            </div>
        </SimfFormSection>

        @* -- ID document + optional photos (deferred upload after create) -- *@
        <SimfFormSection Number="@(++step)" Title="@L["Admin.WalkIn.Section.IdDocument"]"
                         Hint="@L["Admin.WalkIn.Section.IdDocument.Hint"]">
            <SimfFileUpload @ref="_idDocUpload"
                            Label="@L["Admin.WalkIn.Field.IdDocument"]"
                            Accept="image/png,image/jpeg,image/webp"
                            PickedFilename="@_idDocumentName"
                            PickedLabel="@L["Admin.WalkIn.FilePicked"]"
                            OnFilePicked="OnIdDocumentPicked" />
            @* D-427 (CS-3) — optional profile photo (the visitor's "logo"); shown
               next to the ID image in the approve modal. Any PNG/JPEG/WebP. *@
            <SimfFileUpload @ref="_avatarUpload"
                            Label="@L["Admin.WalkIn.Field.Photo"]"
                            Helper="@L["Admin.WalkIn.Field.Photo.Hint"]"
                            Accept="image/png,image/jpeg,image/webp"
                            PickedFilename="@_avatarName"
                            PickedLabel="@L["Admin.WalkIn.FilePicked"]"
                            OnFilePicked="OnAvatarPicked" />
            @* V-1 (D-429) — separate VIP welcome photo (موج). A clear high-res
               portrait shared with the technical teams. VIP page only. *@
            @if (VipMode)
            {
                <SimfFileUpload @ref="_vipPhotoUpload"
                                Label="@L["Admin.WalkIn.Field.VipPhoto"]"
                                Helper="@L["Admin.WalkIn.Field.VipPhoto.Hint"]"
                                Accept="image/png,image/jpeg,image/webp"
                                PickedFilename="@_vipPhotoName"
                                PickedLabel="@L["Admin.WalkIn.FilePicked"]"
                                OnFilePicked="OnVipPhotoPicked" />
            }
        </SimfFormSection>

        @* -- Interests (visitor only) ------------------------------------- *@
        @if (string.Equals(Kind, "Visitor", StringComparison.OrdinalIgnoreCase) && _interests.Length > 0)
        {
            <SimfFormSection Number="@(++step)" Title="@L["Admin.WalkIn.Section.Interests"]"
                             Hint="@L["Admin.WalkIn.Section.Interests.Hint"]">
                <div class="simf-walkin__chips" role="group"
                     aria-label="@L["Admin.WalkIn.Section.Interests"]">
                    @foreach (var interest in _interests)
                    {
                        var selected = _model.InterestIds.Contains(interest.Id);
                        <button type="button"
                                class="simf-walkin__chip @(selected ? "is-selected" : null)"
                                aria-pressed="@(selected ? "true" : "false")"
                                @onclick="@(() => ToggleInterest(interest.Id))">
                            @InterestLabel(interest)
                        </button>
                    }
                </div>
            </SimfFormSection>
        }
    </fieldset>

    @* -- Submit row ---------------------------------------------------- *@
    <div class="simf-form__actions simf-walkin__actions">
        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.WalkIn.Submitting"]">
            @L["Admin.WalkIn.Submit"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.WalkIn.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
