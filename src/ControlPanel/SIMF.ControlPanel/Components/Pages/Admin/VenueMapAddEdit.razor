@* Reusable venue-map node Add/Edit form, hosted by CrudShell (popup or
   full page) from VenueMapList. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel). IsEdit
   =false runs Create (POST); IsEdit=true runs Edit (PUT against Initial) and
   shows the IsActive checkbox. Preserves the kind enum dropdown, the X/Y
   position inputs and the optional Hall / Booth pickers + the same create/update
   request DTOs + JS calls the inline SimfModal form used. The Hall + Booth
   pickers are loaded at mount (mirrors the old list page). *@
@inherits CrudAddEditFormBase<AdminVenueMapNodeDetail>
@using SIMF.Common.Enums
@using SIMF.Contracts.Admin
@using SIMF.Contracts.Exhibition

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.VenueMap.Field.Label"]"
                       Value="@_model.Label"
                       ValueChanged="@(v => _model.Label = v)"
                       ValueExpression="@(() => _model.Label)"
                       MaxLength="128" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.VenueMap.Field.LabelArabic"]"
                       Value="@_model.LabelArabic"
                       ValueChanged="@(v => _model.LabelArabic = v)"
                       ValueExpression="@(() => _model.LabelArabic)"
                       MaxLength="128" Disabled="_busy" />
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.VenueMap.Field.Kind"]</span>
            <select class="simf-field__input" value="@((int)_model.Kind)"
                    @onchange="OnKindChanged" disabled="@_busy">
                @foreach (var k in Enum.GetValues<VenueMapNodeKind>())
                {
                    <option value="@((int)k)">@k</option>
                }
            </select>
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.VenueMap.Field.X"]</span>
            <input class="simf-field__input" type="number" step="0.1"
                   value="@_model.X" @onchange="OnXChanged" disabled="@_busy" />
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.VenueMap.Field.Y"]</span>
            <input class="simf-field__input" type="number" step="0.1"
                   value="@_model.Y" @onchange="OnYChanged" disabled="@_busy" />
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.VenueMap.Field.Hall"]</span>
            <select class="simf-field__input" value="@_model.HallId"
                    @onchange="@(e => _model.HallId = e.Value?.ToString() ?? string.Empty)"
                    disabled="@_busy">
                <option value="">@L["Admin.VenueMap.None.Option"]</option>
                @foreach (var h in _halls)
                {
                    <option value="@h.Id">@h.Name</option>
                }
            </select>
        </label>
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.VenueMap.Field.Booth"]</span>
            <select class="simf-field__input" value="@_model.BoothId"
                    @onchange="@(e => _model.BoothId = e.Value?.ToString() ?? string.Empty)"
                    disabled="@_busy">
                <option value="">@L["Admin.VenueMap.None.Option"]</option>
                @foreach (var b in _booths)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </label>
        @if (IsEdit)
        {
            <SimfCheckbox Value="_model.IsActive"
                          ValueChanged="@(v => _model.IsActive = v)"
                          Disabled="_busy">
                @L["Admin.VenueMap.Field.IsActive"]
            </SimfCheckbox>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy"
                    LoadingLabel="@(IsEdit ? L["Admin.VenueMap.Edit.Submitting"] : L["Admin.VenueMap.New.Submitting"])">
            @(IsEdit ? L["Admin.VenueMap.Edit.Submit"] : L["Admin.VenueMap.New.Submit"])
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.VenueMap.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
