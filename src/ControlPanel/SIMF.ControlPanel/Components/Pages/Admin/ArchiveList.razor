@* D-199 (Mockup screen 24) — admin CRUD over the public Archive / Past
   Editions list. Each edition carries a year, bilingual title + summary,
   the headline attendees/sessions/speakers counts, an optional cover-image
   relative path, and the active flag that gates public visibility.
   Centralized dialog/full-page framing D-353: Add / Edit / View / Delete are
   hosted by CrudShell, which frames the reusable ArchiveAddEdit and
   ArchiveViewDelete forms as a popup or a full page per the admin's toolbar
   choice (persisted in localStorage via CpPreferences). The "make this year
   history" snapshot action (D-275) stays as its own dialog. The inline
   SimfModal edit form + native confirm() delete it used to carry are gone. *@
@page "/admin/archive"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Archive.View)]
@using SIMF.Contracts.Archive

<PageTitle>@L["Admin.Archive.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Archive.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            @* D-275 (§9) — one-click "make this year history" snapshot. *@
            <div class="simf-toolbar">
                <AuthorizedAction Permission="@PermissionCatalog.Archive.Snapshot">
                    <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                                OnClick="OnSnapshotOpen">
                        @L["Admin.Archive.Snapshot.Button"]
                    </SimfButton>
                </AuthorizedAction>
            </div>

            <SimfDataGrid TItem="AdminArchiveEditionSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.TitleEn)"
                          Caption="@L["Admin.Archive.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Archive.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminArchiveEditionSummary" Key="year"
                                        Header="@L["Admin.Archive.Col.Year"]"
                                        Sortable="true">
                        <CellTemplate>@context.Year</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminArchiveEditionSummary" Key="titleEn"
                                        Header="@L["Admin.Archive.Col.TitleEn"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>
                            <SimfIdentityCell ImageUrl="@CoverImageUrl(context)"
                                              Name="@context.TitleEn"
                                              NameSecondary="@context.TitleAr" />
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminArchiveEditionSummary" Key="titleAr"
                                        Header="@L["Admin.Archive.Col.TitleAr"]"
                                        Filterable="true">
                        <CellTemplate>@context.TitleAr</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminArchiveEditionSummary" Key="attendees"
                                        Header="@L["Admin.Archive.Col.Attendees"]">
                        <CellTemplate>@context.Attendees</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminArchiveEditionSummary" Key="sessions"
                                        Header="@L["Admin.Archive.Col.Sessions"]">
                        <CellTemplate>@context.Sessions</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminArchiveEditionSummary" Key="speakers"
                                        Header="@L["Admin.Archive.Col.Speakers"]">
                        <CellTemplate>@context.Speakers</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminArchiveEditionSummary" Key="isActive"
                                        Header="@L["Admin.Archive.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Archive.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="archive"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Archive.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <ArchiveAddEdit IsEdit="_isEdit" Initial="_target"
                            OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <ArchiveViewDelete IsDelete="_isDelete" Initial="_target"
                               OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@* D-275 (§9) — "make this year history" confirm dialog (counts auto-computed). *@
@if (_snapshotOpen)
{
    <SimfModal Open="true"
               Title="@L["Admin.Archive.Snapshot.Title"]"
               OnClose="@(() => _snapshotOpen = false)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <div class="simf-form__fields">
                <p>@L["Admin.Archive.Snapshot.Intro"]</p>
                <SimfCheckbox Value="_snapshotMakeVisible"
                              ValueChanged="@(v => _snapshotMakeVisible = v)"
                              Disabled="_busy">
                    @L["Admin.Archive.Snapshot.MakeVisible"]
                </SimfCheckbox>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="@(() => _snapshotOpen = false)">
                @L["Admin.Archive.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SnapshotConfirmAsync" Loading="_busy" LoadingLabel="@L["Grid.Working"]">
                @L["Admin.Archive.Snapshot.Confirm"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
