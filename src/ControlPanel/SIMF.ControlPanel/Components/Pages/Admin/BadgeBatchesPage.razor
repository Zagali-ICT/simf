@* Persisted bulk-badge batches desk. Lists every
   bulk-generate run (BadgeBatch) newest-first; a batch can be re-emailed (re-render
   its QR pack + send to an organiser) or revoked (disable every account it minted +
   mark it inactive). SimfDataGrid (server-paged); quiet row actions shown only for
   active batches. Mirrors DelegationMeetingsList. *@
@page "/admin/visitors/badge-batches"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Visitors.ViewBatches)]

<PageTitle>@L["Admin.BadgeBatches.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.BadgeBatches.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <div class="simf-toast">
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            </div>
        }

        <SimfDataGrid TItem="AdminBadgeBatchSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="false"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => Contents(r))"
                      Caption="@L["Admin.BadgeBatches.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.BadgeBatches.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                @* Who the order is for, first: an order identified only by its
                   counts is unrecognisable once two of them are the same size,
                   which is the whole reason it carries a name. *@
                <SimfDataGridColumn TItem="AdminBadgeBatchSummary" Key="name"
                                    Header="@L["Admin.BadgeBatches.Col.Name"]">
                    <CellTemplate>@OrderName(context)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBadgeBatchSummary" Key="summary"
                                    Header="@L["Admin.BadgeBatches.Col.Summary"]">
                    <CellTemplate>@Contents(context)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBadgeBatchSummary" Key="total"
                                    Header="@L["Admin.BadgeBatches.Col.Total"]">
                    <CellTemplate>@context.TotalCount</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBadgeBatchSummary" Key="delegate"
                                    Header="@L["Admin.BadgeBatches.Col.Delegate"]">
                    <CellTemplate>
                        @if (context.IsDelegate)
                        {
                            <SimfPill Variant="on">@L["Admin.BadgeBatches.Delegate.Yes"]</SimfPill>
                        }
                        else
                        {
                            <span class="simf-table__sub">—</span>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBadgeBatchSummary" Key="recipient"
                                    Header="@L["Admin.BadgeBatches.Col.Recipient"]">
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.RecipientEmail))
                        {
                            @context.RecipientEmail
                        }
                        else
                        {
                            <span class="simf-table__sub">—</span>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBadgeBatchSummary" Key="createdAt"
                                    Header="@L["Admin.BadgeBatches.Col.CreatedAt"]">
                    <CellTemplate>@context.CreatedAt.FormatSaudi("dd-MM-yyyy hh:mm tt")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminBadgeBatchSummary" Key="status"
                                    Header="@L["Admin.BadgeBatches.Col.Status"]">
                    <CellTemplate>
                        @if (context.IsActive)
                        {
                            <SimfPill Variant="on">@L["Admin.BadgeBatches.Status.Active"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Admin.BadgeBatches.Status.Revoked"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @* Re-email + revoke only make sense for an active batch. *@
                @if (context.IsActive)
                {
                    @* Top-up MINTS badges, so it carries Visitors.BulkGenerate —
                       the permission its endpoint checks — and not the
                       ManageBatches the two neighbouring buttons use. Creating
                       more of an order is a different authority from re-emailing
                       or revoking one. *@
                    <AuthorizedAction Permission="@PermissionCatalog.Visitors.BulkGenerate">
                        <SimfToolbarButton Icon="plus" Title="@L["Admin.BadgeBatches.TopUp"]"
                                           Disabled="_busy"
                                           OnClick="@(() => OpenTopUp(context))" />
                    </AuthorizedAction>
                    <AuthorizedAction Permission="@PermissionCatalog.Visitors.ManageBatches">
                        <SimfToolbarButton Icon="mail" Title="@L["Admin.BadgeBatches.ReEmail"]"
                                           Disabled="_busy"
                                           OnClick="@(() => OpenReEmail(context))" />
                    </AuthorizedAction>
                    <AuthorizedAction Permission="@PermissionCatalog.Visitors.ManageBatches">
                        <SimfToolbarButton Icon="power" Title="@L["Admin.BadgeBatches.Revoke"]"
                                           Disabled="_busy"
                                           OnClick="@(() => OpenRevoke(context))" />
                    </AuthorizedAction>
                }
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.BadgeBatches.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_reEmailTarget is not null)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.BadgeBatches.ReEmail.Title"]"
               OnClose="@(() => _reEmailTarget = null)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <div class="simf-form__fields">
                <dl class="simf-dl">
                    <dt>@L["Admin.BadgeBatches.Col.Summary"]</dt>
                    <dd>@Contents(_reEmailTarget)</dd>
                    <dt>@L["Admin.BadgeBatches.Col.Total"]</dt>
                    <dd>@_reEmailTarget.TotalCount</dd>
                </dl>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.BadgeBatches.ReEmail.Recipient"]</span>
                    <input class="simf-field__input" type="email" dir="ltr"
                           placeholder="@L["Admin.BadgeBatches.ReEmail.Placeholder"]"
                           @bind="_reEmailRecipient" disabled="@_busy" />
                </label>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                        OnClick="@(() => _reEmailTarget = null)">
                @L["Admin.BadgeBatches.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="ReEmailAsync" Loading="_busy" LoadingLabel="@L["Grid.Working"]">
                @L["Admin.BadgeBatches.ReEmail.Send"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@* Top-up. One tier per run, deliberately: the API takes a list, but an order is
   topped up to add "3 more VIP", and repeating the action is clearer than a
   second row-builder in a modal. The counts the order already holds are shown
   above the field, because "add 3" is only meaningful next to what is there. *@
@if (_topUpTarget is not null)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.BadgeBatches.TopUp.Title"]"
               OnClose="CloseTopUp"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <div class="simf-form__fields">
                <dl class="simf-dl">
                    <dt>@L["Admin.BadgeBatches.Col.Name"]</dt>
                    <dd>@OrderName(_topUpTarget)</dd>
                    <dt>@L["Admin.BadgeBatches.Col.Summary"]</dt>
                    <dd>@Contents(_topUpTarget)</dd>
                    <dt>@L["Admin.BadgeBatches.Col.Total"]</dt>
                    <dd>@_topUpTarget.TotalCount</dd>
                </dl>
                @if (_topUpError is not null)
                {
                    <SimfAlert Variant="error">@_topUpError</SimfAlert>
                }

                @* The tier lookup is gated on ProfileTypes.View, which is not the
                   permission that renders this button, so it can legitimately
                   come back empty or refused. Say so, rather than leaving an
                   empty picker whose only answer is "choose a profile type". *@
                @if (_profileTypesError is not null)
                {
                    <SimfAlert Variant="error">@_profileTypesError</SimfAlert>
                }
                else if (NoTiersToPick)
                {
                    <SimfEmptyState Title="@L["Admin.Delegates.Bulk.NoTypes"]" />
                }
                else
                {
                    <SimfSelect TValue="AdminProfileTypeSummary"
                                Label="@L["Admin.Delegates.Bulk.ProfileType"]"
                                Placeholder="@L["Admin.Delegates.Bulk.ProfileType.Placeholder"]"
                                Items="_profileTypes"
                                ValueFor="@(pt => pt.Id.ToString())"
                                LabelFor="@(pt => TypeLabel(pt))"
                                Value="_topUpType"
                                ValueChanged="@(pt => _topUpType = pt)"
                                Disabled="_busy" />
                    <SimfTextField Label="@L["Admin.BadgeBatches.TopUp.Count"]"
                                   Numeric="true" MaxLength="4"
                                   Value="@_topUpCount"
                                   ValueChanged="@(v => _topUpCount = v)"
                                   ValueExpression="@(() => _topUpCount)"
                                   Disabled="_busy" />
                }
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="CloseTopUp">
                @L["Admin.BadgeBatches.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="TopUpAsync" Loading="_busy"
                        Disabled="@(NoTiersToPick || _profileTypesError is not null)"
                        LoadingLabel="@L["Grid.Working"]">
                @L["Admin.BadgeBatches.TopUp.Confirm"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_revokeTarget is not null)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.BadgeBatches.Revoke.Title"]"
               OnClose="@(() => _revokeTarget = null)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <p>@string.Format(L["Admin.BadgeBatches.Revoke.Body"], _revokeTarget.TotalCount, Contents(_revokeTarget))</p>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                        OnClick="@(() => _revokeTarget = null)">
                @L["Admin.BadgeBatches.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="danger" OnClick="RevokeAsync" Loading="_busy" LoadingLabel="@L["Grid.Working"]">
                @L["Admin.BadgeBatches.Revoke.Confirm"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
