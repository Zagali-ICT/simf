@* Reusable Create-Admin form. Lifted out of CreateUser.razor so both
   the standalone /admin/admins/new page (fallback) and the Add-modal on the
   admins list page can host the same form. The host owns the layout chrome
   (banner / card / modal); this component is the form itself + its EditForm
   + its POST. *@

@if (_success is not null)
{
    <SimfAlert Variant="success">@_success</SimfAlert>
}
@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.CreateUser.Email"]"
                       @bind-Value="_model.Email"
                       Type="email" Icon="mail" InputMode="email"
                       Autocomplete="off" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.CreateUser.DisplayName"]"
                       @bind-Value="_model.DisplayName"
                       Autocomplete="off" Disabled="_busy" />
        <div class="simf-form__group">
            <p class="simf-form__group-label">@L["Admin.CreateUser.RolesLabel"]</p>
            @if (_rolesLoading)
            {
                <p>@L["Admin.CreateUser.RolesLoading"]</p>
            }
            else if (_roleNames.Count == 0)
            {
                <p>@L["Admin.CreateUser.RolesNone"]</p>
            }
            else
            {
                @foreach (var roleName in _roleNames)
                {
                    <SimfCheckbox Value="_selectedRoles.Contains(roleName)"
                                  ValueChanged="@((bool on) => ToggleRole(roleName, on))"
                                  Disabled="_busy">
                        @roleName
                    </SimfCheckbox>
                }
            }
        </div>
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.CreateUser.Submitting"]">
            @L["Admin.CreateUser.Submit"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy"
                        OnClick="OnCancel">
                @CancelLabel
            </SimfButton>
        }
    </div>
</EditForm>
