@* D-353 — reusable Region Add/Edit form, hosted by CrudShell (as a popup or a
   full page) from RegionsList.razor. Inherits CrudAddEditFormBase so it exposes
   the standard CRUD-form parameter surface (IsEdit / Initial / OnSuccess /
   OnCancel). IsEdit=false runs Create (POST); IsEdit=true runs Edit (PUT
   against Initial) and shows the IsActive checkbox. Mirrors the Organisation
   Add/Edit form. The bilingual lookup carries SortOrder + timestamps in the
   full detail (not the grid summary), so the list page fetches the full detail
   before opening this form in Edit mode. *@
@inherits CrudAddEditFormBase<AdminRegionDetail>
@using SIMF.Contracts.Regions

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.Regions.Field.Code"]"
                       MaxLength="16"
                       @bind-Value="_model.Code" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Regions.Field.NameAr"]"
                       MaxLength="256"
                       @bind-Value="_model.NameArabic" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Regions.Field.NameEn"]"
                       MaxLength="256"
                       @bind-Value="_model.Name" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Regions.Field.SortOrder"]"
                       Type="number"
                       Value="@_sortOrderInput"
                       ValueChanged="@(v => _sortOrderInput = v)"
                       ValueExpression="@(() => _sortOrderInput)"
                       Disabled="_busy" />

        @if (IsEdit)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.Regions.Field.IsActive"]
            </SimfCheckbox>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.Regions.Save"]">
            @L["Admin.Regions.Save"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Regions.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
