@* Control Panel — list Other-typed accounts (P7e — D-055, promoted to the
   canonical D-117 CRUD pattern in D-114). Administrator-only. Uses
   SimfDataGrid with the full toolbar wired against the D-113 backend
   (/account/api/admin/others/*), SimfBanner page-top, and modal-based
   Add / Edit / Details flows. /admin/others/new is preserved as a
   deep-link fallback (Q-D). *@
@page "/admin/others"
@layout CpShellLayout
@attribute [Authorize(Roles = "Administrator")]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.Others.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Others.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        <SimfDataGrid TItem="AdminUserSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(user => user.Id.ToString())"
                      RowLabel="@(user => user.Email)"
                      Caption="@L["Admin.Others.Title"]"
                      FilterColumnLabel="@L["Admin.Users.FilterColumn"]"
                      OnAdd="OnAddAsync"
                      OnEditOne="OnEditAsync"
                      OnDetailsOne="OnDetailsAsync"
                      OnDeleteSelected="OnBulkDeleteAsync"
                      OnDeleteOne="OnRowDeleteAsync"
                      OnDuplicateOne="OnDuplicateAsync"
                      OnCopySelected="OnCopySelectedAsync"
                      OnCopyOne="OnCopyOneAsync"
                      OnPaste="OnPasteAsync"
                      OnExport="OnExportAsync"
                      OnImport="OnImportAsync"
                      PrevLabel="@L["Admin.Users.Prev"]"
                      NextLabel="@L["Admin.Users.Next"]"
                      FirstLabel="@L["Admin.Users.Pager.First"]"
                      LastLabel="@L["Admin.Users.Pager.Last"]"
                      PageSizeLabel="@L["Admin.Users.Pager.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.Users.Loading"]"
                      FilterPlaceholder="@L["Admin.Users.FilterPlaceholder"]"
                      ActionsHeader="@L["Admin.Users.Column.Actions"]"
                      SelectAllLabel="@L["Admin.Users.Action.SelectAll"]"
                      SelectRowLabel="@L["Admin.Users.Action.SelectRow"]"
                      AddLabel="@L["Admin.Users.Action.Add"]"
                      EditLabel="@L["Admin.Users.Action.Edit"]"
                      DetailsLabel="@L["Admin.Users.Action.Details"]"
                      DeleteLabel="@L["Admin.Users.Action.Delete"]"
                      CopyLabel="@L["Admin.Users.Action.Copy"]"
                      PasteLabel="@L["Admin.Users.Action.Paste"]"
                      DuplicateLabel="@L["Admin.Users.Action.Duplicate"]"
                      ImportLabel="@L["Admin.Users.Action.Import"]"
                      ExportLabel="@L["Admin.Users.Action.Export"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminUserSummary" Key="email"
                                    Header="@L["Admin.Users.Column.Email"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Email</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminUserSummary" Key="displayName"
                                    Header="@L["Admin.Users.Column.DisplayName"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.DisplayName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminUserSummary" Key="state"
                                    Header="@L["Admin.Users.Column.State"]"
                                    Sortable="true">
                    <CellTemplate>@context.AccountState</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Others.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_toast is not null)
{
    <div class="simf-toast">
        <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
    </div>
}

@* D-114 — hidden file input used by Import. *@
<input type="file" id="others-import-input" accept=".xlsx"
       class="simf-hidden-input"
       aria-label="@L["Admin.Users.Import.Picker"]"
       @onchange="OnImportFileSelectedAsync" />

@* D-114 — Add other modal (replaces navigation to /admin/others/new). *@
@if (_addOpen)
{
    <SimfModal Open="true" Title="@L["Admin.Others.Add.Title"]" OnClose="@(() => _addOpen = false)">
        <ChildContent>
            <CreateOtherForm OnSuccess="OnAddSucceededAsync"
                             OnCancel="@(() => _addOpen = false)"
                             CancelLabel="@L["Admin.Others.Add.Close"]" />
        </ChildContent>
    </SimfModal>
}

@* D-114 — Edit stub modal (real Edit awaits the generic-CRUD API). *@
@if (_editOpen)
{
    <SimfModal Open="true" Title="@L["Admin.Others.Edit.Title"]" OnClose="@(() => _editOpen = false)">
        <ChildContent>
            <p>@L["Admin.Others.Edit.NotYet"]</p>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" OnClick="@(() => _editOpen = false)">
                @L["Admin.Others.Edit.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@* D-129 — Details modal: loads the full profile via the D-126 admin read +
   renders the ID document image inline (encrypted at rest, streamed
   decrypted from the same admin endpoint). *@
@if (_detailsTarget is not null)
{
    <SimfModal Open="true"
               Title="@string.Format(L["Admin.Others.Details.Title"], _detailsTarget.Email)"
               OnClose="CloseDetails">
        <ChildContent>
            @if (_detailsLoading)
            {
                <p>@L["Admin.Pending.View.Loading"]</p>
            }
            else if (_detailsError is not null)
            {
                <SimfAlert Variant="error">@_detailsError</SimfAlert>
            }
            else if (_detailsProfile is not null)
            {
                <dl class="simf-dl">
                    <dt>@L["Admin.Pending.View.Field.Email"]</dt>
                    <dd>@_detailsProfile.Email</dd>
                    <dt>@L["Admin.Pending.View.Field.DisplayName"]</dt>
                    <dd>@_detailsProfile.DisplayName</dd>
                    <dt>@L["Admin.Pending.View.Field.UserType"]</dt>
                    <dd>@_detailsProfile.UserType</dd>
                    <dt>@L["Admin.Users.Details.Field.State"]</dt>
                    <dd>@_detailsProfile.AccountState</dd>
                    <dt>@L["Admin.Pending.View.Field.ProfileType"]</dt>
                    <dd>@(_detailsProfile.ProfileTypeName ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                    <dt>@L["Admin.Pending.View.Field.Created"]</dt>
                    <dd>@_detailsProfile.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
                <dl class="simf-dl">
                    <dt>@L["Admin.Pending.View.Field.ArabicName"]</dt>
                    <dd>@(_detailsProfile.ArabicName ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                    <dt>@L["Admin.Pending.View.Field.EnglishName"]</dt>
                    <dd>@(_detailsProfile.EnglishName ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                    <dt>@L["Admin.Pending.View.Field.Nationality"]</dt>
                    <dd>@(_detailsProfile.NationalityCode ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                    <dt>@L["Admin.Pending.View.Field.DateOfBirth"]</dt>
                    <dd>@(_detailsProfile.DateOfBirth?.ToString("yyyy-MM-dd") ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                    <dt>@L["Admin.Pending.View.Field.PlaceOfBirth"]</dt>
                    <dd>@(_detailsProfile.PlaceOfBirth ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                    <dt>@L["Admin.Pending.View.Field.IdentityType"]</dt>
                    <dd>@IdentityTypeLabel(_detailsProfile)</dd>
                    <dt>@L["Admin.Pending.View.Field.IdentityNumber"]</dt>
                    <dd>@(IdentityNumber(_detailsProfile) ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                    <dt>@L["Admin.Pending.View.Field.SaudiMobile"]</dt>
                    <dd>@(_detailsProfile.SaudiMobile ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                    <dt>@L["Admin.Pending.View.Field.InternationalMobile"]</dt>
                    <dd>@(_detailsProfile.InternationalMobile ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                    <dt>@L["Admin.Pending.View.Field.QrId"]</dt>
                    <dd>@(_detailsProfile.QrId ?? L["Admin.Pending.View.MissingValue"].Value)</dd>
                </dl>
                @if (_detailsProfile.HasIdImage)
                {
                    <div class="simf-walkin__id-image">
                        <h4>@L["Admin.Pending.View.Field.IdImage"]</h4>
                        <img src="@($"/account/api/admin/others/{_detailsProfile.Id}/id-document?v={DateTime.UtcNow.Ticks}")"
                             alt="@L["Admin.Pending.View.Field.IdImage"]" />
                    </div>
                }
            }
        </ChildContent>
        <Footer>
            <SimfButton Type="button" OnClick="CloseDetails">
                @L["Admin.Others.Details.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_bulkDeleteOpen)
{
    <SimfModal Open="true" Title="@L["Admin.Others.BulkDelete.Title"]" OnClose="@(() => _bulkDeleteOpen = false)">
        <ChildContent>
            <p>@string.Format(L["Admin.Others.BulkDelete.Confirm"], _bulkDeleteTargets.Count)</p>
            <SimfTextarea Label="@L["Admin.Users.BulkDelete.Reason"]"
                          Helper="@L["Admin.Users.BulkDelete.ReasonHint"]"
                          Rows="3" MaxLength="500"
                          Value="@_bulkDeleteReason" ValueChanged="@(v => _bulkDeleteReason = v)" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _bulkDeleteOpen = false)">
                @L["Admin.Users.BulkDelete.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="primary"
                        Loading="_busy"
                        Disabled="@(_bulkDeleteReason.Length is < 10 or > 500)"
                        OnClick="ConfirmBulkDeleteAsync">
                @L["Admin.Users.BulkDelete.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_duplicateOpen)
{
    <SimfModal Open="true" Title="@L["Admin.Others.Duplicate.Title"]" OnClose="@(() => _duplicateOpen = false)">
        <ChildContent>
            <p>@string.Format(L["Admin.Users.Duplicate.Confirm"], _duplicateSource?.Email)</p>
            <SimfTextField Label="@L["Admin.Users.Duplicate.NewEmail"]"
                           Helper="@L["Admin.Users.Duplicate.NewEmailHint"]"
                           Type="email" Icon="mail"
                           Value="@_duplicateEmail"
                           ValueChanged="@(v => _duplicateEmail = v)"
                           ValueExpression="@(() => _duplicateEmail)" />
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="@(() => _duplicateOpen = false)">
                @L["Admin.Users.Duplicate.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="primary"
                        Loading="_busy"
                        Disabled="@(!IsLikelyEmail(_duplicateEmail))"
                        OnClick="ConfirmDuplicateAsync">
                @L["Admin.Users.Duplicate.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_importResult is not null)
{
    <SimfModal Open="true" Title="@L["Admin.Users.Import.ResultTitle"]" OnClose="@(() => _importResult = null)">
        <ChildContent>
            <p>@string.Format(L["Admin.Users.Import.ResultBody"], _importResult.Created, _importResult.Skipped)</p>
            @if (_importResult.Errors.Count > 0)
            {
                <ul class="simf-import-errors">
                    @foreach (var error in _importResult.Errors)
                    {
                        <li>@($"Row {error.Row} ({error.Email}): {error.Reason}")</li>
                    }
                </ul>
            }
        </ChildContent>
        <Footer>
            <SimfButton Type="button" OnClick="@(() => _importResult = null)">
                @L["Admin.Users.Import.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminUserSummary>? _page;
    private bool _loading;
    private bool _busy;

    private bool _addOpen;
    private bool _editOpen;
    private AdminUserSummary? _detailsTarget;
    private AdminUserProfileView? _detailsProfile;
    private bool _detailsLoading;
    private string? _detailsError;

    private bool _bulkDeleteOpen;
    private IReadOnlyList<AdminUserSummary> _bulkDeleteTargets = Array.Empty<AdminUserSummary>();
    private string _bulkDeleteReason = string.Empty;

    private bool _duplicateOpen;
    private AdminUserSummary? _duplicateSource;
    private string _duplicateEmail = string.Empty;

    private AdminImportUsersResponse? _importResult;
    private Toast? _toast;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<GridPage<AdminUserSummary>>>(
                "simfAccount.postJson", "/account/api/admin/others/list", _query);
            _page = envelope is { Success: true, Data: not null }
                ? envelope.Data
                : GridPage<AdminUserSummary>.Of(
                    Array.Empty<AdminUserSummary>(), 0, _query);
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _addOpen = true;
        return Task.CompletedTask;
    }

    private async Task OnAddSucceededAsync(AdminCreateUserResponse created)
    {
        _addOpen = false;
        ShowToast("success", string.Format(L["Admin.CreateUser.Success"], created.Email));
        await LoadAsync();
    }

    private Task OnEditAsync(AdminUserSummary _)
    {
        _editOpen = true;
        return Task.CompletedTask;
    }

    private async Task OnDetailsAsync(AdminUserSummary user)
    {
        _detailsTarget = user;
        _detailsProfile = null;
        _detailsError = null;
        _detailsLoading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<AdminUserProfileView>>(
                "simfAccount.getJson",
                $"/account/api/admin/others/{user.Id}/profile");
            if (envelope is { Success: true, Data: not null })
            {
                _detailsProfile = envelope.Data;
            }
            else
            {
                _detailsError = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Pending.View.Fallback"];
            }
        }
        catch (Exception)
        {
            _detailsError = L["Admin.Pending.View.Fallback"];
        }
        finally { _detailsLoading = false; }
    }

    private void CloseDetails()
    {
        _detailsTarget = null;
        _detailsProfile = null;
        _detailsError = null;
        _detailsLoading = false;
    }

    private string IdentityTypeLabel(AdminUserProfileView profile)
    {
        if (!string.IsNullOrEmpty(profile.NationalId))
            return L["Admin.Pending.View.IdentityType.National"];
        if (!string.IsNullOrEmpty(profile.IqamaNumber))
            return L["Admin.Pending.View.IdentityType.Iqama"];
        if (!string.IsNullOrEmpty(profile.PassportNumber))
            return L["Admin.Pending.View.IdentityType.Passport"];
        return L["Admin.Pending.View.MissingValue"];
    }

    private static string? IdentityNumber(AdminUserProfileView profile) =>
        profile.NationalId
            ?? profile.IqamaNumber
            ?? profile.PassportNumber;

    private Task OnRowDeleteAsync(AdminUserSummary user)
    {
        _bulkDeleteTargets = new[] { user };
        _bulkDeleteReason = string.Empty;
        _bulkDeleteOpen = true;
        return Task.CompletedTask;
    }

    private Task OnBulkDeleteAsync(IReadOnlyList<AdminUserSummary> users)
    {
        if (users.Count == 0)
        {
            ShowToast("error", L["Admin.Users.NoSelection"]);
            return Task.CompletedTask;
        }
        _bulkDeleteTargets = users;
        _bulkDeleteReason = string.Empty;
        _bulkDeleteOpen = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmBulkDeleteAsync()
    {
        if (_bulkDeleteReason.Length is < 10 or > 500 || _bulkDeleteTargets.Count == 0) return;
        _busy = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<AdminBulkDeleteResponse>>(
                "simfAccount.postJson", "/account/api/admin/others/bulk-delete",
                new AdminBulkDeleteRequest
                {
                    Ids = _bulkDeleteTargets.Select(u => u.Id).ToList(),
                    Reason = _bulkDeleteReason,
                });
            if (envelope is { Success: true, Data: not null })
            {
                _bulkDeleteOpen = false;
                ShowToast("success", string.Format(
                    L["Admin.Users.BulkDelete.Success"],
                    envelope.Data.Deleted, envelope.Data.Skipped));
                await LoadAsync();
            }
            else
            {
                ShowToast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Users.BulkDelete.Fallback"]);
            }
        }
        finally { _busy = false; }
    }

    private Task OnDuplicateAsync(AdminUserSummary user)
    {
        _duplicateSource = user;
        _duplicateEmail = string.Empty;
        _duplicateOpen = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmDuplicateAsync()
    {
        if (_duplicateSource is null || !IsLikelyEmail(_duplicateEmail)) return;
        _busy = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<AdminCreateUserResponse>>(
                "simfAccount.postJson", "/account/api/admin/others/duplicate",
                new AdminDuplicateUserRequest
                {
                    SourceId = _duplicateSource.Id,
                    NewEmail = _duplicateEmail,
                });
            if (envelope is { Success: true, Data: not null })
            {
                _duplicateOpen = false;
                ShowToast("success", string.Format(
                    L["Admin.Users.Duplicate.Success"], envelope.Data.Email));
                await LoadAsync();
            }
            else
            {
                ShowToast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Users.Duplicate.Fallback"]);
            }
        }
        finally { _busy = false; }
    }

    private Task OnCopySelectedAsync(IReadOnlyList<AdminUserSummary> users)
    {
        if (users.Count == 0) return Task.CompletedTask;
        ShowToast("info", string.Format(L["Admin.Users.Copy.Count"], users.Count));
        return Task.CompletedTask;
    }

    private Task OnCopyOneAsync(AdminUserSummary user)
    {
        ShowToast("info", string.Format(L["Admin.Users.Copy.One"], user.Email));
        return Task.CompletedTask;
    }

    private Task OnPasteAsync(string clipboard)
    {
        if (string.IsNullOrWhiteSpace(clipboard))
        {
            ShowToast("error", L["Admin.Users.Paste.Empty"]);
            return Task.CompletedTask;
        }
        ShowToast("info", L["Admin.Users.Paste.NotImplemented"]);
        return Task.CompletedTask;
    }

    private async Task OnExportAsync(IReadOnlyList<AdminUserSummary> selected)
    {
        var ids = selected.Select(u => u.Id).ToList();
        await JS.InvokeVoidAsync("simfAccount.downloadXlsx",
            "/account/api/admin/others/export",
            new AdminExportUsersRequest { Ids = ids, Query = ids.Count == 0 ? _query : null });
    }

    private async Task OnImportAsync() =>
        await JS.InvokeVoidAsync("simfAccount.triggerFileInput", "others-import-input");

    private async Task OnImportFileSelectedAsync()
    {
        _busy = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<AdminImportUsersResponse>>(
                "simfAccount.uploadFile", "/account/api/admin/others/import", "others-import-input");
            if (envelope is { Success: true, Data: not null })
            {
                _importResult = envelope.Data;
                await LoadAsync();
            }
            else
            {
                ShowToast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Users.Import.Fallback"]);
            }
        }
        finally { _busy = false; }
    }

    private string FormatSummary(int from, int to, int total) =>
        string.Format(L["Admin.Users.Pager.Summary"], from, to, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Admin.Users.Pager.Page"], current, total);

    private static bool IsLikelyEmail(string value) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains('@', StringComparison.Ordinal)
        && value.Length <= 256;

    private void ShowToast(string variant, string message)
    {
        _toast = new Toast(variant, message);
    }

    private sealed record Toast(string Variant, string Message);
}
