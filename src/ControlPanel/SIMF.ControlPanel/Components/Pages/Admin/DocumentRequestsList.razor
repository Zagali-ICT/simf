@* D-500 (Wave 5, الطلبات "طلب وثيقة المشاركة") — admin queue for participation
   document requests submitted from the app. Respond modal accepts / rejects with
   an optional note; Pending → Pending is rejected server-side
   (PARTICIPATION_DOCUMENT_REQUEST_STATUS_INVALID). SimfDataGrid (server-paged,
   sortable + filterable, full pager); Respond is a quiet reply button shown only
   for Pending rows. Mirrors SpeakerMeetingRequestsList.razor (no export path —
   these are created in the app + responded to here). *@
@page "/admin/document-requests"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.ParticipationDocumentRequests.View)]
@using SIMF.Common.Enums
@using SIMF.Contracts.Requests
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.DocumentRequests.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.DocumentRequests.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminParticipationDocumentRequestRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="false"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.RequesterName ?? r.Id.ToString())"
                      Caption="@L["Admin.DocumentRequests.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.DocumentRequests.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminParticipationDocumentRequestRow" Key="requester"
                                    Header="@L["Admin.DocumentRequests.Col.Requester"]">
                    <CellTemplate>@(context.RequesterName ?? "—")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminParticipationDocumentRequestRow" Key="documentType"
                                    Header="@L["Admin.DocumentRequests.Col.DocumentType"]">
                    <CellTemplate>@DocumentTypeLabel(context.DocumentType)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminParticipationDocumentRequestRow" Key="note"
                                    Header="@L["Admin.DocumentRequests.Col.Note"]">
                    <CellTemplate>@(string.IsNullOrWhiteSpace(context.Note) ? "—" : context.Note)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminParticipationDocumentRequestRow" Key="status"
                                    Header="@L["Admin.DocumentRequests.Col.Status"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>
                        @switch (context.Status)
                        {
                            case MeetingRequestStatus.Pending:
                                <SimfPill Variant="warn">@L["Admin.DocumentRequests.Filter.Pending"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Accepted:
                                <SimfPill Variant="on">@L["Admin.DocumentRequests.Filter.Accepted"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Rejected:
                                <SimfPill Variant="off">@L["Admin.DocumentRequests.Filter.Rejected"]</SimfPill>
                                break;
                            case MeetingRequestStatus.Cancelled:
                                <SimfPill Variant="off">@L["Admin.DocumentRequests.Filter.Cancelled"]</SimfPill>
                                break;
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminParticipationDocumentRequestRow" Key="createdAt"
                                    Header="@L["Admin.DocumentRequests.Col.CreatedAt"]"
                                    Sortable="true">
                    <CellTemplate>@context.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminParticipationDocumentRequestRow" Key="respondedAt"
                                    Header="@L["Admin.DocumentRequests.Col.RespondedAt"]"
                                    Sortable="true">
                    <CellTemplate>
                        @(context.RespondedAt is null ? "—"
                            : context.RespondedAt.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'"))
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @if (context.Status == MeetingRequestStatus.Pending)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.ParticipationDocumentRequests.Manage">
                        <SimfToolbarButton Icon="reply" Title="@L["Admin.DocumentRequests.Respond"]"
                                           OnClick="@(() => OnRespondAsync(context))" />
                    </AuthorizedAction>
                }
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.DocumentRequests.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_respondOpen && _respondTarget is not null)
{
    <SimfModal Open="true" Title="@L["Admin.DocumentRequests.Respond.Title"]"
               OnClose="@(() => _respondOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <dl class="simf-dl">
                    <dt>@L["Admin.DocumentRequests.Col.Requester"]</dt>
                    <dd>
                        <div>@(_respondTarget.RequesterName ?? "—")</div>
                        @if (_loadingDetail)
                        {
                            <div class="simf-table__sub">@L["Admin.DocumentRequests.LoadingDetail"]</div>
                        }
                        else if (!string.IsNullOrEmpty(_respondTarget.RequesterEmail))
                        {
                            <div class="simf-table__sub">@_respondTarget.RequesterEmail</div>
                        }
                    </dd>
                    <dt>@L["Admin.DocumentRequests.Col.DocumentType"]</dt>
                    <dd>@DocumentTypeLabel(_respondTarget.DocumentType)</dd>
                    @if (!string.IsNullOrWhiteSpace(_respondTarget.Note))
                    {
                        <dt>@L["Admin.DocumentRequests.Col.Note"]</dt>
                        <dd>@_respondTarget.Note</dd>
                    }
                </dl>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.DocumentRequests.Respond.Status"]</span>
                    <select class="simf-field__input" value="@((int)_respondStatus)"
                            @onchange="OnRespondStatusChanged" disabled="@_busy">
                        <option value="@((int)MeetingRequestStatus.Accepted)">
                            @L["Admin.DocumentRequests.Respond.Accept"]
                        </option>
                        <option value="@((int)MeetingRequestStatus.Rejected)">
                            @L["Admin.DocumentRequests.Respond.Reject"]
                        </option>
                    </select>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.DocumentRequests.Respond.Note"]</span>
                    <textarea class="simf-field__input" rows="4"
                              value="@_respondNote"
                              @onchange="OnRespondNoteChanged"
                              disabled="@_busy"></textarea>
                </label>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy"
                        OnClick="@(() => _respondOpen = false)">
                @L["Admin.DocumentRequests.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SendResponseAsync" Loading="_busy">
                @L["Admin.DocumentRequests.Respond.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminParticipationDocumentRequestRow> _page = new();
    private bool _loading;
    private bool _busy;
    private Toast? _toast;

    private bool _respondOpen;
    private AdminParticipationDocumentRequestDetail? _respondTarget;
    private bool _loadingDetail;
    private MeetingRequestStatus _respondStatus = MeetingRequestStatus.Accepted;
    private string _respondNote = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private string DocumentTypeLabel(ParticipationDocumentType type) => type switch
    {
        ParticipationDocumentType.ParticipationLetter => L["Admin.DocumentRequests.Type.ParticipationLetter"],
        ParticipationDocumentType.InvitationLetter => L["Admin.DocumentRequests.Type.InvitationLetter"],
        _ => L["Admin.DocumentRequests.Type.AttendanceCertificate"],
    };

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminParticipationDocumentRequestRow>>>(
                "simfAccount.postJson",
                "/account/api/admin/document-requests/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.DocumentRequests.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private async Task OnRespondAsync(AdminParticipationDocumentRequestRow row)
    {
        _respondTarget = new AdminParticipationDocumentRequestDetail(
            row.Id, row.RequestedByUserId, row.RequesterName, RequesterEmail: null,
            row.DocumentType, row.Note, row.Status, row.ResponseNote,
            row.CreatedAt, row.RespondedAt);
        _respondStatus = MeetingRequestStatus.Accepted;
        _respondNote = string.Empty;
        _respondOpen = true;
        _loadingDetail = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminParticipationDocumentRequestDetail>>(
                "simfAccount.getJson",
                $"/account/api/admin/document-requests/{row.Id}");
            if (env is { Success: true, Data: not null } && _respondOpen
                && _respondTarget?.Id == row.Id)
            {
                _respondTarget = env.Data;
            }
        }
        finally { _loadingDetail = false; }
    }

    private void OnRespondStatusChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            _respondStatus = (MeetingRequestStatus)v;
        }
    }

    private void OnRespondNoteChanged(ChangeEventArgs e) =>
        _respondNote = e.Value?.ToString() ?? string.Empty;

    private async Task SendResponseAsync()
    {
        if (_respondTarget is null || _busy) return;
        _busy = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminParticipationDocumentRequestDetail>>(
                "simfAccount.putJson",
                $"/account/api/admin/document-requests/{_respondTarget.Id}/respond",
                new RespondToParticipationDocumentRequestRequest
                {
                    Status = _respondStatus,
                    ResponseNote = string.IsNullOrWhiteSpace(_respondNote)
                        ? null : _respondNote.Trim(),
                });
            if (env is { Success: true })
            {
                _respondOpen = false;
                _toast = new Toast("success", L["Admin.DocumentRequests.Respond.Done"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.DocumentRequests.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }
}
