@* P2.4 (D-229) — System Configuration page (SIMF-FDS-012 §5.5). Admin CRUD
   over the platform system-settings store (the settings that are not content
   and not categories). Ships empty; the team seeds the keys once the client
   confirms the list (FDS-012 OI-2). Registration open/close lives on its own
   Operations page. Centralized dialog/full-page framing D-353: Add / Edit /
   View / Delete are hosted by CrudShell, which frames the reusable
   ConfigurationAddEdit and ConfigurationViewDelete forms as a popup or a full
   page per the admin's toolbar choice (persisted in localStorage via
   CpPreferences). Edit / View / Delete work against the full detail fetched by
   id (the grid carries a summary). The inline SimfModal form + native confirm()
   delete it used to carry are gone. *@
@page "/admin/configuration"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Configuration.View)]
@using SIMF.Contracts.Admin

<PageTitle>@L["Admin.Configuration.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Configuration.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <div class="simf-toast">
                    <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
                </div>
            }

            <SimfDataGrid TItem="AdminSystemSettingSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Key)"
                          Caption="@L["Admin.Configuration.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Configuration.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminSystemSettingSummary" Key="key"
                                        Header="@L["Admin.Configuration.Col.Key"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate><code>@context.Key</code></CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSystemSettingSummary" Key="value"
                                        Header="@L["Admin.Configuration.Col.Value"]"
                                        Filterable="true">
                        <CellTemplate>@context.Value</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSystemSettingSummary" Key="description"
                                        Header="@L["Admin.Configuration.Col.Description"]"
                                        Filterable="true">
                        <CellTemplate>@context.Description</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSystemSettingSummary" Key="isActive"
                                        Header="@L["Admin.Configuration.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Configuration.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="system-settings"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Configuration.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <ConfigurationAddEdit IsEdit="_isEdit" Initial="_target"
                                  OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <ConfigurationViewDelete IsDelete="_isDelete" Initial="_target"
                                     OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
