@* P2.4 (D-229) — System Configuration page (SIMF-FDS-012 §5.5). Admin CRUD
   over the platform system-settings store (the settings that are not content
   and not categories). Ships empty; the team seeds the keys once the client
   confirms the list (FDS-012 OI-2). Registration open/close lives on its own
   Operations page. Centralized dialog/full-page framing D-353: Add / Edit /
   View / Delete are hosted by CrudShell, which frames the reusable
   ConfigurationAddEdit and ConfigurationViewDelete forms as a popup or a full
   page per the admin's toolbar choice (persisted in localStorage via
   CpPreferences). Edit / View / Delete work against the full detail fetched by
   id (the grid carries a summary). The inline SimfModal form + native confirm()
   delete it used to carry are gone. *@
@page "/admin/configuration"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Configuration.View)]
@using SIMF.Contracts.Admin
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject CpPreferences Prefs

<PageTitle>@L["Admin.Configuration.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Configuration.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminSystemSettingSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Key)"
                          Caption="@L["Admin.Configuration.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Configuration.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminSystemSettingSummary" Key="key"
                                        Header="@L["Admin.Configuration.Col.Key"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate><code>@context.Key</code></CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSystemSettingSummary" Key="value"
                                        Header="@L["Admin.Configuration.Col.Value"]"
                                        Filterable="true">
                        <CellTemplate>@context.Value</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSystemSettingSummary" Key="description"
                                        Header="@L["Admin.Configuration.Col.Description"]"
                                        Filterable="true">
                        <CellTemplate>@context.Description</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminSystemSettingSummary" Key="isActive"
                                        Header="@L["Admin.Configuration.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Configuration.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Configuration.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <ConfigurationAddEdit IsEdit="_isEdit" Initial="_target"
                                  OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <ConfigurationViewDelete IsDelete="_isDelete" Initial="_target"
                                     OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@code {
    private record Toast(string Variant, string Message);

    private enum FormKind { None, AddEdit, ViewDelete }

    private const string PageKey = "configuration";

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminSystemSettingSummary> _page = new();
    private bool _loading;
    private Toast? _toast;

    private CrudPresentation _presentation = CrudPresentation.Dialog;
    private FormKind _form = FormKind.None;
    private bool _isEdit;
    private bool _isDelete;
    private AdminSystemSettingDetail? _target;

    private bool FormOpen => _form != FormKind.None;
    private bool GridHidden => FormOpen && _presentation == CrudPresentation.Page;

    private string FormTitle => _form switch
    {
        FormKind.AddEdit => _isEdit
            ? L["Admin.Configuration.Edit.Title"]
            : L["Admin.Configuration.Add.Title"],
        FormKind.ViewDelete => _isDelete
            ? L["Admin.Configuration.Delete.Title"]
            : L["Admin.Configuration.Details.Title"],
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _presentation = await Prefs.GetPresentationAsync(PageKey);
        await LoadAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Admin.Configuration.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<GridPage<AdminSystemSettingSummary>>>(
                "simfAccount.postJson", "/account/api/admin/system-settings/list", _query);
            if (envelope is { Success: true, Data: not null })
            {
                _page = envelope.Data;
            }
            else
            {
                _toast = new Toast("error",
                    envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Configuration.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private Task OnAddAsync()
    {
        _toast = null;
        _form = FormKind.AddEdit;
        _isEdit = false;
        _target = null;
        return Task.CompletedTask;
    }

    private async Task OnEditAsync(AdminSystemSettingSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.AddEdit;
        _isEdit = true;
        _target = detail;
    }

    private async Task OnDetailsAsync(AdminSystemSettingSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = false;
        _target = detail;
    }

    private async Task OnDeleteAsync(AdminSystemSettingSummary row)
    {
        var detail = await LoadDetailAsync(row.Id);
        if (detail is null) return;
        _form = FormKind.ViewDelete;
        _isDelete = true;
        _target = detail;
    }

    // Edit / View / Delete all work against the full detail (the grid carries
    // a summary). Returns null and surfaces a toast on failure.
    private async Task<AdminSystemSettingDetail?> LoadDetailAsync(Guid id)
    {
        _toast = null;
        var envelope = await JS.InvokeAsync<ApiResult<AdminSystemSettingDetail>>(
            "simfAccount.getJson", $"/account/api/admin/system-settings/{id}");
        if (envelope is { Success: true, Data: not null })
        {
            return envelope.Data;
        }
        _toast = new Toast("error",
            envelope?.Error?.MessageForCurrentCulture()
            ?? L["Admin.Configuration.LoadFailed"]);
        return null;
    }

    private void CloseForm()
    {
        _form = FormKind.None;
        _target = null;
    }

    private async Task OnSavedAsync(AdminSystemSettingDetail saved)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.Configuration.Saved"]);
        await LoadAsync();
    }

    private async Task OnDeletedAsync(AdminSystemSettingDetail deleted)
    {
        CloseForm();
        _toast = new Toast("success", L["Admin.Configuration.Deleted"]);
        await LoadAsync();
    }
}
