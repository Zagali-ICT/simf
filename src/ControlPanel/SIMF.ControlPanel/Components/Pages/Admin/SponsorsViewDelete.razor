@* D-353 — reusable Sponsor View/Delete form, hosted by CrudShell (popup or full
   page) from SponsorsList. Inherits CrudViewDeleteFormBase so it exposes the
   standard surface (IsDelete / Initial / OnDeleted / OnCancel). Read-only
   details always show; when IsDelete=true a Delete button appears and a
   SimfConfirm gates the soft-delete (replaces the old native JS confirm() on the
   list). Adds the View path the inline modal never had. *@
@inherits CrudViewDeleteFormBase<AdminSponsorDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    @* D-357 — logo from the unified media-asset pipeline. *@
    <div class="simf-image-upload__preview">
        <SimfImageThumb Src="@($"/account/api/admin/assets/SponsorLogo/{Initial.Id}/image")"
                        Alt="@Initial.NameEn" Class="simf-img-thumb--lg" />
    </div>

    <dl class="simf-dl">
        <dt>@L["Admin.Sponsors.Col.NameEn"]</dt>
        <dd>@Initial.NameEn</dd>
        <dt>@L["Admin.Sponsors.Col.NameAr"]</dt>
        <dd>@Initial.NameAr</dd>
        <dt>@L["Admin.Sponsors.Col.Tier"]</dt>
        <dd>@Initial.TierName</dd>
        <dt>@L["Admin.Sponsors.Col.Logo"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.LogoRelativePath) ? "—" : Initial.LogoRelativePath)</dd>
        <dt>@L["Admin.Sponsors.Col.Url"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.Url) ? "—" : Initial.Url)</dd>
        <dt>@L["Admin.Sponsors.Col.DisplayOrder"]</dt>
        <dd>@Initial.DisplayOrder</dd>
        <dt>@L["Admin.Sponsors.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.Sponsors.Delete"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Sponsors.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.Sponsors.Delete.Title"]"
                 Message="@string.Format(L["Admin.Sponsors.Delete.Message"], Initial.NameEn)"
                 ConfirmLabel="@L["Admin.Sponsors.Delete"]"
                 CancelLabel="@L["Admin.Sponsors.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" />
}
