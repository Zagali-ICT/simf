@* D-473 / D-751 (#10) — reusable bulk badge generator. Redesigned (2026-07-22)
   from the flat "count box per profile type" grid into a batch-builder: pick a
   profile type + count and press Add to build a batch list (e.g. VIP × 5,
   Delegate × 3), then Generate → confirm popup (summary + optional organiser
   email). The generated placeholder badges carry default data + a ready QR and,
   when a recipient is supplied, are zipped and emailed. Hosted by both the
   Delegates desk and the Visitors list (via a dialog); the request contract is
   unchanged (POST /account/api/admin/visitors/bulk-generate). *@

@if (ShowHeader)
{
    <h2 class="simf-section-title">@L["Admin.Delegates.Bulk.Title"]</h2>
    <p class="simf-section-hint">@L["Admin.Delegates.Bulk.Hint"]</p>
}

@if (_bulkToast is not null)
{
    <SimfAlert Variant="@_bulkToast.Variant">@_bulkToast.Message</SimfAlert>
}

@if (_profileTypes.Count == 0)
{
    <SimfEmptyState Title="@L["Admin.Delegates.Bulk.NoTypes"]" />
}
else
{
    @* Add row — profile-type picker + count + Add. *@
    <div class="simf-bulk-builder__add">
        <SimfSelect TValue="AdminProfileTypeSummary"
                    Label="@L["Admin.Delegates.Bulk.ProfileType"]"
                    Placeholder="@L["Admin.Delegates.Bulk.ProfileType.Placeholder"]"
                    Items="_profileTypes"
                    ValueFor="@(pt => pt.Id.ToString())"
                    LabelFor="@(pt => TypeLabel(pt))"
                    Value="_selectedType"
                    ValueChanged="@(pt => _selectedType = pt)"
                    Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Delegates.Bulk.Count"]"
                       Numeric="true" MaxLength="4"
                       Value="@_countInput"
                       ValueChanged="@(v => _countInput = v)"
                       ValueExpression="@(() => _countInput)"
                       Disabled="_busy" />
        <div class="simf-bulk-builder__add-action">
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="AddToBatch">
                @L["Admin.Delegates.Bulk.Add"]
            </SimfButton>
        </div>
    </div>

    @* Batch list. *@
    @if (_batch.Count == 0)
    {
        <p class="simf-section-hint simf-bulk-builder__empty">@L["Admin.Delegates.Bulk.Empty"]</p>
    }
    else
    {
        <ul class="simf-bulk-builder__list">
            @foreach (var row in _batch)
            {
                <li class="simf-bulk-builder__row">
                    <span class="simf-bulk-builder__swatch" aria-hidden="true"
                          style="@(row.Color is null ? null : $"--simf-bulk-swatch-color: {row.Color}")"></span>
                    <span class="simf-bulk-builder__name">@row.TypeName</span>
                    <span class="simf-bulk-builder__count">× @row.Count</span>
                    <button type="button" class="simf-bulk-builder__remove"
                            aria-label="@string.Format(L["Admin.Delegates.Bulk.Remove"], row.TypeName)"
                            disabled="@(_busy ? "disabled" : null)"
                            @onclick="@(() => RemoveFromBatch(row.TypeId))">
                        <SimfIcon Name="close" Size="16" />
                    </button>
                </li>
            }
        </ul>
        <p class="simf-bulk-builder__total">
            @string.Format(L["Admin.Delegates.Bulk.Total"], BatchTotal)
        </p>
    }

    <SimfCheckbox @bind-Value="_bulkIsDelegate" Disabled="_busy">
        @L["Admin.Delegates.Bulk.IsDelegate"]
    </SimfCheckbox>

    <div class="simf-form__actions">
        <SimfButton Type="button" Disabled="@(_busy || _batch.Count == 0)"
                    OnClick="OpenConfirm">
            @L["Admin.Delegates.Bulk.Generate"]
        </SimfButton>
    </div>
}

@* D-751 (#10) — confirm step: the batch summary + an optional organiser email;
   on confirm the QR badges are zipped and emailed to that address. *@
<SimfModal Open="_confirmOpen"
           RequireExplicitClose="true"
           Title="@L["Admin.Delegates.Bulk.Confirm.Title"]"
           CloseLabel="@L["Admin.Delegates.Bulk.Confirm.Cancel"]"
           OnClose="CloseConfirm">
    <ChildContent>
        <p class="simf-section-hint">
            @string.Format(L["Admin.Delegates.Bulk.Confirm.Summary"], _confirmCountsText, BatchTotal)
        </p>
        <SimfTextField Label="@L["Admin.Delegates.Bulk.Confirm.Email"]"
                       Type="email" MaxLength="256"
                       Helper="@L["Admin.Delegates.Bulk.Confirm.EmailHelper"]"
                       Value="@_recipientEmail"
                       ValueChanged="@(v => _recipientEmail = v)"
                       ValueExpression="@(() => _recipientEmail)"
                       Disabled="_busy" />
        @if (!string.IsNullOrWhiteSpace(_recipientEmail))
        {
            <p class="simf-section-hint">
                @string.Format(L["Admin.Delegates.Bulk.Confirm.EmailTo"], _recipientEmail.Trim())
            </p>
        }
    </ChildContent>
    <Footer>
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="CloseConfirm">
            @L["Admin.Delegates.Bulk.Confirm.Cancel"]
        </SimfButton>
        <SimfButton Type="button" Loading="_busy"
                    LoadingLabel="@L["Admin.Delegates.Bulk.Generating"]"
                    OnClick="GenerateBulkAsync">
            @L["Admin.Delegates.Bulk.Generate"]
        </SimfButton>
    </Footer>
</SimfModal>
