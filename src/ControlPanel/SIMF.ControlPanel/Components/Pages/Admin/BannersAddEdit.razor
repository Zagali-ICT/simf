@* Reusable Banner Add/Edit form, hosted by CrudShell (popup or full
   page) from BannersList. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel).
   IsEdit=false runs Create (POST); IsEdit=true runs Edit (PUT against Initial)
   and shows the IsActive checkbox. Carries the optional click-through LinkUrl;
   the image is no longer a typed field, it is uploaded into the file store from
   the Edit branch. Supersedes the inline SimfModal form that lived in
   BannersList. *@
@inherits CrudAddEditFormBase<AdminBannerDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.Banners.Field.TitleEn"]"
                       @bind-Value="_model.TitleEn" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Banners.Field.TitleAr"]"
                       @bind-Value="_model.TitleAr" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Banners.Field.BodyEn"]"
                       @bind-Value="_model.BodyEn" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Banners.Field.BodyAr"]"
                       @bind-Value="_model.BodyAr" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Banners.Field.LinkUrl"]"
                       @bind-Value="_model.LinkUrl" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Banners.Field.Start"]"
                       Type="datetime-local"
                       @bind-Value="_model.Start" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Banners.Field.End"]"
                       Type="datetime-local"
                       @bind-Value="_model.End" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Banners.Field.DisplayOrder"]"
                       Type="number"
                       Value="@_displayOrderInput"
                       ValueChanged="@(v => _displayOrderInput = v)"
                       ValueExpression="@(() => _displayOrderInput)"
                       Disabled="_busy" />
        @if (IsEdit)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.Banners.Field.IsActive"]
            </SimfCheckbox>
        }
        @* The hero image, via the unified media-asset pipeline. Served publicly
           at /app/assets/Banner/{id}/image and rotated on the app home hero.
           Upload attaches bytes, Link records an external URL as a StoredFile -
           either way it is one row in the one store, which is why the free-text
           ImageUrl field that used to sit above is gone.

           Edit only: the banner row must exist before anything can be attached
           to it. The create form shows the slot and says so, matching
           SpeakersAddEdit. *@
        @if (IsEdit && Initial is not null)
        {
            <div class="simf-field">
                <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
                <SimfImageUpload Category="Banner" OwnerId="@Initial.Id" Alt="@_model.TitleEn" />
            </div>
        }
        else
        {
            <div class="simf-photo-empty">
                <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
                <SimfImageThumb Class="simf-img-thumb--lg" Alt="@_model.TitleEn" />
                <span class="simf-field__helper">@L["Admin.Asset.SaveFirst"]</span>
            </div>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy" LoadingLabel="@L["Admin.Banners.Submit"]">
            @L["Admin.Banners.Submit"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Banners.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
