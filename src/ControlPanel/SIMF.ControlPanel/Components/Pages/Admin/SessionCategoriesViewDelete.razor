@* Reusable Session-Category View/Delete form, hosted by CrudShell (as
   a popup or a full page) from SessionCategoriesList.razor. Inherits
   CrudViewDeleteFormBase so it exposes the standard parameter surface
   (IsDelete / Initial / OnDeleted / OnCancel). Read-only details always show;
   when IsDelete=true a Deactivate button appears and a SimfConfirm gates the
   destructive call (replaces the old native JS confirm() on the list). Adds
   the View path the inline form never had. *@
@inherits CrudViewDeleteFormBase<AdminSessionCategoryDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.SessionCategories.Col.NameEn"]</dt>
        <dd>@Initial.Name</dd>
        <dt>@L["Admin.SessionCategories.Col.NameAr"]</dt>
        <dd>@Initial.NameArabic</dd>
        <dt>@L["Admin.SessionCategories.Col.Order"]</dt>
        <dd>@Initial.DisplayOrder</dd>
        <dt>@L["Admin.SessionCategories.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.SessionCategories.Action.Deactivate"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.SessionCategories.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.SessionCategories.Delete.Title"]"
                 Message="@string.Format(L["Admin.SessionCategories.Delete.Message"], Initial.Name)"
                 ConfirmLabel="@L["Admin.SessionCategories.Action.Deactivate"]"
                 CancelLabel="@L["Admin.SessionCategories.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" 
                 Permission="@PermissionCatalog.SessionCategories.Delete"/>
}
