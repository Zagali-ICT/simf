@* Reusable Hall View/Delete form, hosted by CrudShell (popup or full
   page) from HallsList. Inherits CrudViewDeleteFormBase so it exposes the
   standard surface (IsDelete / Initial / OnDeleted / OnCancel). Read-only
   details always show; when IsDelete=true a Deactivate button appears and a
   SimfConfirm gates the soft-delete (was a one-click delete on the list). *@
@inherits CrudViewDeleteFormBase<AdminHallDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.Halls.Column.Code"]</dt>
        <dd>@Initial.Code</dd>
        <dt>@L["Admin.Halls.Column.Name"]</dt>
        <dd>@Initial.Name</dd>
        <dt>@L["Admin.Halls.Column.NameArabic"]</dt>
        <dd>@Initial.NameArabic</dd>
        <dt>@L["Admin.Halls.Column.Capacity"]</dt>
        <dd>@Initial.Capacity</dd>
        <dt>@L["Admin.Halls.Column.Floor"]</dt>
        <dd>@(Initial.Floor ?? "—")</dd>
        <dt>@L["Admin.Halls.Field.FacilityNotes"]</dt>
        <dd>@(Initial.FacilityNotes ?? "—")</dd>
        <dt>@L["Admin.Halls.Column.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Admin.Halls.Active.Yes"] : L["Admin.Halls.Active.No"])</dd>
    </dl>

    @* The hall's occupancy view: what this hall is actually doing.
       Without it the session/booking overlap rule only ever surfaced as a 409. *@
    <h3 class="simf-section-title">@L["Admin.Halls.Schedule.Heading"]</h3>
    @if (_scheduleLoading)
    {
        <p>@L["Admin.Halls.Schedule.Loading"]</p>
    }
    else if (_schedule.Count == 0)
    {
        <SimfEmptyState Title="@L["Admin.Halls.Schedule.None"]" />
    }
    else
    {
        <div class="simf-table-wrapper">
            <table class="simf-table">
                <caption class="simf-visually-hidden">@L["Admin.Halls.Schedule.Heading"]</caption>
                <thead>
                    <tr>
                        <th>@L["Admin.Halls.Schedule.Col.Code"]</th>
                        <th>@L["Admin.Halls.Schedule.Col.Title"]</th>
                        <th>@L["Admin.Halls.Schedule.Col.Start"]</th>
                        <th>@L["Admin.Halls.Schedule.Col.End"]</th>
                        <th>@L["Admin.Halls.Schedule.Col.Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in _schedule)
                    {
                        <tr>
                            <td>@session.Code</td>
                            <td>@SessionTitle(session)</td>
                            <td>@Local(session.Start)</td>
                            <td>@Local(session.End)</td>
                            <td>
                                <SimfPill Variant="@StatusPillVariant(session.Status)">
                                    @StatusLabel(session.Status)
                                </SimfPill>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="simf-table__summary">
            @(string.Format(L["Admin.Halls.Schedule.Count"], _schedule.Count))
        </p>
        @* The endpoint caps the page, so say when the schedule is partial
           rather than letting a capped list read as the whole occupancy. *@
        @if (_scheduleTotal > _schedule.Count)
        {
            <SimfAlert Variant="info">
                @(string.Format(L["Admin.Halls.Schedule.Capped"],
                                _schedule.Count, _scheduleTotal))
            </SimfAlert>
        }
    }

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.Halls.Action.Deactivate"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.Halls.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.Halls.Delete.Title"]"
                 Message="@string.Format(L["Admin.Halls.Delete.Message"], Initial.Name)"
                 ConfirmLabel="@L["Admin.Halls.Action.Deactivate"]"
                 CancelLabel="@L["Admin.Halls.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" 
                 Permission="@PermissionCatalog.Halls.Delete"/>
}
