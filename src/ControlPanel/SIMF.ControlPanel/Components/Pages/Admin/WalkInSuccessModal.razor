@* D-127 — Post-submit success modal that the walk-in registration desk
   shows after a successful POST /admin/{visitors,others}/register-onsite.
   Renders the visitor's name + the minted QR id with an SVG QR badge so
   the visitor can scan it with their phone (or the desk can print it).
   Three primary actions:
     - Close: dismiss; the parent typically reloads the list grid.
     - Print: window.print, with print-specific CSS hiding the rest.
     - Register another: dismiss + call OnRegisterAnother so the parent
       can reopen the form with a fresh model.
*@
@inject IStringLocalizer<Strings> L

@if (Response is not null)
{
    <SimfModal Open="true"
               Title="@(Pending ? L["Admin.WalkIn.Success.PendingTitle"] : L["Admin.WalkIn.Success.Title"])"
               OnClose="OnClose">
        <ChildContent>
            <div class="simf-walkin-badge"
                 style="@($"--simf-badge-color: {Response.ProfileTypeColor}")">
                <div class="simf-walkin-badge__header">
                    <span class="simf-walkin-badge__type">@TypeLabel</span>
                </div>
                <div class="simf-walkin-badge__name">@Response.DisplayName</div>
                <div class="simf-walkin-badge__email">@EmailLabel</div>
                @* D-425: a pending walk-in has no QR yet — it is minted on
                   approval. Only show the QR badge once the account is approved. *@
                @if (!Pending)
                {
                    <div class="simf-walkin-badge__qr">@((MarkupString)_qrSvg)</div>
                    <div class="simf-walkin-badge__qrid">@Response.QrId</div>
                }
            </div>
            @if (Pending)
            {
                <SimfAlert Variant="info">@L["Admin.WalkIn.Success.PendingBody"]</SimfAlert>
            }
            else
            {
                <SimfAlert Variant="success">@L["Admin.WalkIn.Success.Body"]</SimfAlert>
            }
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="OnClose">
                @L["Admin.WalkIn.Success.Close"]
            </SimfButton>
            @* No badge to print until the QR exists (i.e. after approval). *@
            @if (!Pending)
            {
                <SimfButton Type="button" Variant="secondary" OnClick="OnPrint">
                    @L["Admin.WalkIn.Success.Print"]
                </SimfButton>
            }
            <SimfButton Type="button" Variant="primary" OnClick="OnRegisterAnother">
                @L["Admin.WalkIn.Success.Another"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private string _qrSvg = string.Empty;

    // D-425 — a pending walk-in carries no QR id yet (minted on approval).
    private bool Pending => Response is not null && string.IsNullOrEmpty(Response.QrId);

    /// <summary>The walk-in response — when null the modal is hidden.</summary>
    [Parameter] public AdminWalkInRegistrationResponse? Response { get; set; }

    /// <summary>Fires when the modal is dismissed (Close / overlay / Esc).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Fires when the desk clicks "Register another" — the parent
    /// typically resets the form and closes this modal.</summary>
    [Parameter] public EventCallback OnRegisterAnother { get; set; }

    /// <summary>Fires when the desk clicks Print. The parent invokes
    /// <c>window.print</c> via JS (kept out of this component so the
    /// JS-runtime dependency stays on the host page).</summary>
    [Parameter] public EventCallback OnPrint { get; set; }

    protected override void OnParametersSet()
    {
        if (Response is not null && !string.IsNullOrEmpty(Response.QrId))
        {
            _qrSvg = BuildQrSvg(Response.QrId);
        }
        else
        {
            _qrSvg = string.Empty;
        }
    }

    private string TypeLabel
    {
        get
        {
            if (Response is null) { return string.Empty; }
            return CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                ? Response.ProfileTypeNameArabic
                : Response.ProfileTypeName;
        }
    }

    private string EmailLabel
    {
        get
        {
            if (Response is null) { return string.Empty; }
            // The placeholder synthetic email shouldn't be displayed to staff.
            if (Response.Email.EndsWith("@simf.local", StringComparison.OrdinalIgnoreCase))
            {
                return L["Admin.WalkIn.Success.NoEmail"];
            }
            return Response.Email;
        }
    }

    private static string BuildQrSvg(string qrId)
    {
        using var generator = new QRCoder.QRCodeGenerator();
        using var data = generator.CreateQrCode(qrId, QRCoder.QRCodeGenerator.ECCLevel.Q);
        return new QRCoder.SvgQRCode(data).GetGraphic(
            pixelsPerModule: 6,
            darkColorHex: "#0B2545",
            lightColorHex: "#FFFFFF",
            drawQuietZones: true);
    }
}
