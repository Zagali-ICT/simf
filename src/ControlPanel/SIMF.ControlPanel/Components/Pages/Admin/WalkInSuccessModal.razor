@* D-127 — Post-submit success modal that the walk-in registration desk
   shows after a successful POST /admin/{visitors,others}/register-onsite.
   Renders the visitor's name + the minted QR id with an SVG QR badge so
   the visitor can scan it with their phone (or the desk can print it).
   Three primary actions:
     - Close: dismiss; the parent typically reloads the list grid.
     - Print: window.print, with print-specific CSS hiding the rest.
     - Register another: dismiss + call OnRegisterAnother so the parent
       can reopen the form with a fresh model.
*@

@if (Response is not null)
{
    <SimfModal Open="true"
               Title="@(Pending ? L["Admin.WalkIn.Success.PendingTitle"] : L["Admin.WalkIn.Success.Title"])"
               OnClose="OnClose">
        <ChildContent>
            <div class="simf-walkin-badge"
                 style="@($"--simf-badge-color: {Response.ProfileTypeColor}")">
                <div class="simf-walkin-badge__header">
                    <span class="simf-walkin-badge__type">@TypeLabel</span>
                </div>
                <div class="simf-walkin-badge__name">@Response.DisplayName</div>
                <div class="simf-walkin-badge__email">@EmailLabel</div>
                @* D-425: a pending walk-in has no QR yet — it is minted on
                   approval. Only show the QR badge once the account is approved. *@
                @if (!Pending)
                {
                    <div class="simf-walkin-badge__qr">@((MarkupString)_qrSvg)</div>
                    <div class="simf-walkin-badge__qrid">@Response.QrId</div>
                }
            </div>
            @if (Pending)
            {
                <SimfAlert Variant="info">@L["Admin.WalkIn.Success.PendingBody"]</SimfAlert>
            }
            else
            {
                <SimfAlert Variant="success">@L["Admin.WalkIn.Success.Body"]</SimfAlert>
            }
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="OnClose">
                @L["Admin.WalkIn.Success.Close"]
            </SimfButton>
            @* No badge to print until the QR exists (i.e. after approval). *@
            @if (!Pending)
            {
                <SimfButton Type="button" Variant="secondary" OnClick="OnPrint">
                    @L["Admin.WalkIn.Success.Print"]
                </SimfButton>
            }
            <SimfButton Type="button" Variant="primary" OnClick="OnRegisterAnother">
                @L["Admin.WalkIn.Success.Another"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
