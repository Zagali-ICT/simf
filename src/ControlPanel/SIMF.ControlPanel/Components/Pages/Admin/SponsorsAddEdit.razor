@* D-353 — reusable Sponsor Add/Edit form, hosted by CrudShell (popup or full
   page) from SponsorsList. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel). IsEdit
   =false runs Create (POST); IsEdit=true runs Edit (PUT against Initial) and
   shows the IsActive checkbox. Preserves the tier dropdown, the optional
   shared-Contact link (SIMF-FDS-014 / D-283) and the same create/update request
   DTOs + JS calls the inline SimfModal form used. *@
@inherits CrudAddEditFormBase<AdminSponsorDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.Sponsors.Field.NameEn"]"
                       Value="@_model.NameEn"
                       ValueChanged="@(v => _model.NameEn = v)"
                       ValueExpression="@(() => _model.NameEn)"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Sponsors.Field.NameAr"]"
                       Value="@_model.NameAr"
                       ValueChanged="@(v => _model.NameAr = v)"
                       ValueExpression="@(() => _model.NameAr)"
                       Disabled="_busy" />
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Sponsors.Field.Tier"]</span>
            <select class="simf-field__input"
                    value="@_model.Tier.ToString()"
                    @onchange="OnTierChanged"
                    disabled="@_busy">
                @foreach (var tier in _tiers)
                {
                    <option value="@tier.Value">@tier.Name</option>
                }
            </select>
        </label>
        <SimfTextField Label="@L["Admin.Sponsors.Field.Url"]"
                       Value="@_model.Url"
                       ValueChanged="@(v => _model.Url = v)"
                       ValueExpression="@(() => _model.Url)"
                       Disabled="_busy" />
        @* D-432 — optional bilingual tagline shown under the sponsor name. *@
        <SimfTextField Label="@L["Admin.Sponsors.Field.TaglineAr"]"
                       Value="@_model.TaglineAr"
                       ValueChanged="@(v => _model.TaglineAr = v)"
                       ValueExpression="@(() => _model.TaglineAr)"
                       MaxLength="256"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Sponsors.Field.Tagline"]"
                       Value="@_model.Tagline"
                       ValueChanged="@(v => _model.Tagline = v)"
                       ValueExpression="@(() => _model.Tagline)"
                       MaxLength="256"
                       Disabled="_busy" />
        @* Optional bilingual about paragraph (longer than the tagline). *@
        <SimfTextField Label="@L["Admin.Sponsors.Field.AboutAr"]"
                       Value="@_model.AboutAr"
                       ValueChanged="@(v => _model.AboutAr = v)"
                       ValueExpression="@(() => _model.AboutAr)"
                       MaxLength="2048"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Sponsors.Field.About"]"
                       Value="@_model.About"
                       ValueChanged="@(v => _model.About = v)"
                       ValueExpression="@(() => _model.About)"
                       MaxLength="2048"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Sponsors.Field.Logo"]"
                       Value="@_model.LogoRelativePath"
                       ValueChanged="@(v => _model.LogoRelativePath = v)"
                       ValueExpression="@(() => _model.LogoRelativePath)"
                       Disabled="_busy" />
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.Sponsors.Field.DisplayOrder"]</span>
            <input class="simf-field__input" type="number" min="0" max="99999"
                   value="@_model.DisplayOrder"
                   @onchange="OnDisplayOrderChanged"
                   disabled="@_busy" />
        </label>
        @if (IsEdit)
        {
            <SimfCheckbox Value="_model.IsActive"
                          ValueChanged="@(v => _model.IsActive = v)"
                          Disabled="_busy">
                @L["Admin.Sponsors.Field.IsActive"]
            </SimfCheckbox>
        }
        @* D-357 — logo via the unified media-asset pipeline (edit only; the row
           must exist before bytes can be attached). *@
        @if (IsEdit && Initial is not null)
        {
            <div class="simf-field">
                <span class="simf-field__label">@L["Admin.Asset.Heading"]</span>
                <SimfImageUpload Category="SponsorLogo" OwnerId="@Initial.Id" Alt="@_model.NameEn" />
            </div>
        }
    </div>

    @* Contact information (D-766: identity-card fields inlined from the removed
       shared Contact directory). The website slot is the Url field above. *@
    <SimfFormSection Title="@L["Admin.ContactField.Heading"]">
        <div class="simf-form__grid">
            <SimfSelect TValue="string"
                        Label="@L["Admin.ContactField.Country"]"
                        Placeholder="@L["Admin.ContactField.CountryNone"]"
                        Items="_countryIds"
                        ValueFor="@(id => id)"
                        LabelFor="@(id => CountryLabel(id))"
                        Value="@_countryIdInput"
                        ValueChanged="@(v => _countryIdInput = v ?? string.Empty)"
                        Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ContactField.Email"]"
                           MaxLength="320"
                           @bind-Value="_model.Email" Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ContactField.PhonePrimary"]"
                           MaxLength="32"
                           @bind-Value="_model.PhonePrimary" Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ContactField.PhoneSecondary"]"
                           MaxLength="32"
                           @bind-Value="_model.PhoneSecondary" Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ContactField.City"]"
                           MaxLength="128"
                           @bind-Value="_model.City" Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ContactField.CityArabic"]"
                           MaxLength="128"
                           @bind-Value="_model.CityArabic" Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ContactField.Facebook"]"
                           MaxLength="256"
                           @bind-Value="_model.FacebookUrl" Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ContactField.X"]"
                           MaxLength="256"
                           @bind-Value="_model.XUrl" Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ContactField.LinkedIn"]"
                           MaxLength="256"
                           @bind-Value="_model.LinkedInUrl" Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ContactField.Instagram"]"
                           MaxLength="256"
                           @bind-Value="_model.InstagramUrl" Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ContactField.Latitude"]"
                           Helper="@L["Admin.ContactField.LatLongHint"]"
                           Value="@_latitudeInput"
                           ValueChanged="@(v => _latitudeInput = v)"
                           ValueExpression="@(() => _latitudeInput)"
                           Disabled="_busy" />
            <SimfTextField Label="@L["Admin.ContactField.Longitude"]"
                           Value="@_longitudeInput"
                           ValueChanged="@(v => _longitudeInput = v)"
                           ValueExpression="@(() => _longitudeInput)"
                           Disabled="_busy" />
        </div>
    </SimfFormSection>

    <div class="simf-form__actions">
        <SimfButton Loading="_busy"
                    LoadingLabel="@(IsEdit ? L["Admin.Sponsors.Edit.Submitting"] : L["Admin.Sponsors.New.Submitting"])">
            @(IsEdit ? L["Admin.Sponsors.Edit.Submit"] : L["Admin.Sponsors.New.Submit"])
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Sponsors.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
