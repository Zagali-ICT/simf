@* VIP Registration desk (/admin/visitors/vip) — a copy of the visitor list,
   scoped to VVIP + VIP accounts. The grid lists the VIP guests; "New VIP" opens
   the VVIP/VIP registration wizard (CreateVisitorForm in VIP mode) as a full
   section; the per-row Edit opens the shared account form (name / email / tier /
   photo / ID / VIP welcome photo). Add is gated by Visitors.RegisterOnsite and
   Edit by Visitors.Edit (the API enforces the same policies). *@
@page "/admin/visitors/vip"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Visitors.RegisterOnsite)]

<PageTitle>@L["Admin.VipRegistration.ListTitle"] · SIMF</PageTitle>

@if (_toast is not null)
{
    <div class="simf-toast">
        <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
    </div>
}

@if (_addOpen)
{
    @* New VIP — the VVIP/VIP registration wizard (picker restricted to VVIP/VIP,
       Mawj welcome fields + VIP welcome photo). *@
    <SimfPageHeader Title="@L["Admin.VipRegistration.Title"]" />
    <section class="simf-card simf-page-card simf-page-card--wide">
        <p>@L["Admin.VipRegistration.Supporting"]</p>
        <CreateVisitorForm VipMode="true"
                           OnSuccess="OnAddedAsync"
                           OnCancel="@(() => _addOpen = false)" />
    </section>
}
else
{
    <SimfBanner Title="@L["Admin.VipRegistration.ListTitle"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            <SimfDataGrid TItem="AdminVipSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          RowKey="@(r => r.UserId.ToString())"
                          RowLabel="@(r => RecipientLabel(r))"
                          OnAdd="@(_canRegister ? EventCallback.Factory.Create(this, OnAddVip) : default)"
                          OnEditOne="@(_canEdit ? EventCallback.Factory.Create<AdminVipSummary>(this, OnEditVip) : default)"
                          OnDetailsOne="OnVipDetails"
                          AddLabel="@L["Admin.Vips.Action.AddVip"]"
                          EditLabel="@L["Admin.Users.Action.Edit"]"
                          DetailsLabel="@L["Admin.Vips.Action.Details"]"
                          Caption="@L["Admin.VipRegistration.ListTitle"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Vips.Loading"]"
                          SummaryFormatter="@FormatSummary">
                <Columns>
                    <SimfDataGridColumn TItem="AdminVipSummary" Key="name" Header="@L["Admin.Vips.Col.Name"]">
                        <CellTemplate>@RecipientLabel(context)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminVipSummary" Key="jobTitle" Header="@L["Admin.Vips.Col.JobTitle"]">
                        <CellTemplate>@(context.JobTitle ?? "—")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminVipSummary" Key="profileType" Header="@L["Admin.Vips.Col.ProfileType"]">
                        <CellTemplate>@TypeLabel(context)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminVipSummary" Key="email" Header="@L["Admin.Vips.Col.Email"]">
                        <CellTemplate>@(context.Email ?? "—")</CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Vips.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>
        </div>
    </div>

@* The read affordance. This page resolved its permissions into booleans
   and passed `default` for a denied action, so a reader holding neither Register
   nor Edit saw a grid with no actions column at all, and the Arabic name and job
   title the row carries were reachable only through the edit form. Details is
   unconditional: the page gate already decided who may read this list. *@
<SimfDetails Open="@(_vipDetails is not null)"
             Title="@(_vipDetails is null ? string.Empty : RecipientLabel(_vipDetails))"
             CloseLabel="@L["Grid.Close"]"
             OnClose="@(() => _vipDetails = null)">
    @if (_vipDetails is not null)
    {
        <SimfDetailRow Label="@L["Admin.Vips.Col.Name"]" Value="@_vipDetails.EnglishName" />
        <SimfDetailRow Label="@L["Admin.Vips.Col.NameAr"]" Value="@_vipDetails.ArabicName" />
        <SimfDetailRow Label="@L["Admin.Vips.Col.JobTitle"]" Value="@_vipDetails.JobTitle" />
        <SimfDetailRow Label="@L["Admin.Vips.Col.JobTitleAr"]" Value="@_vipDetails.JobTitleArabic" />
        <SimfDetailRow Label="@L["Admin.Vips.Col.ProfileType"]" Value="@TypeLabel(_vipDetails)" />
        <SimfDetailRow Label="@L["Admin.Vips.Col.Email"]" Value="@_vipDetails.Email" />
    }
</SimfDetails>
}

@* Edit VIP — change this VIP's name / email / tier / photo / ID / welcome photo
   via the shared account edit form, keyed by the account id. *@
@if (_editOpen)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@L["Admin.Vips.Edit.Title"]"
               OnClose="@(() => _editOpen = false)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <EditAccountForm AccountId="_editUserId" Scope="visitors" IsVisitorScope="true"
                             ShowVipPhoto="true"
                             OnSaved="OnEditSavedAsync"
                             OnCancel="@(() => _editOpen = false)" />
        </ChildContent>
    </SimfModal>
}
