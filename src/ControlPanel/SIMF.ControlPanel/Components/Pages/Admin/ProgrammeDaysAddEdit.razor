@* Reusable programme-day Add/Edit form, hosted by CrudShell (popup or
   full page) from ProgrammeDaysList. Inherits CrudAddEditFormBase so it exposes
   the standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel).
   IsEdit=false runs Create (POST); IsEdit=true runs Edit (PUT against Initial),
   shows the IsActive checkbox, and exposes the logo upload (the day row must
   exist before bytes can be attached — ProgrammeDayImage is owned by Id). *@
@inherits CrudAddEditFormBase<AdminProgrammeDayDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<div class="simf-form">
    <div class="simf-form__fields">
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.ProgrammeDays.Field.Date"]</span>
            <input class="simf-field__input" type="date"
                   value="@_dateText"
                   @onchange="OnDateChanged"
                   disabled="@_busy" />
        </label>
        <SimfTextField Label="@L["Admin.ProgrammeDays.Field.TitleEn"]"
                       MaxLength="128"
                       Value="@_model.Title"
                       ValueChanged="@(v => _model.Title = v)"
                       ValueExpression="@(() => _model.Title)"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.ProgrammeDays.Field.TitleAr"]"
                       MaxLength="128"
                       Value="@_model.TitleArabic"
                       ValueChanged="@(v => _model.TitleArabic = v)"
                       ValueExpression="@(() => _model.TitleArabic)"
                       Disabled="_busy" />
        <label class="simf-field">
            <span class="simf-field__label">@L["Admin.ProgrammeDays.Field.DisplayOrder"]</span>
            <input class="simf-field__input" type="number" min="0" max="99999"
                   value="@_model.DisplayOrder"
                   @onchange="OnDisplayOrderChanged"
                   disabled="@_busy" />
        </label>
        @if (IsEdit)
        {
            <SimfCheckbox Value="_model.IsActive"
                          ValueChanged="@(v => _model.IsActive = v)"
                          Disabled="_busy">
                @L["Admin.ProgrammeDays.Field.IsActive"]
            </SimfCheckbox>
        }
        @* Logo via the unified media-asset pipeline (edit only; the row
           must exist before bytes can be attached). *@
        @if (IsEdit && Initial is not null)
        {
            <div class="simf-field">
                <span class="simf-field__label">@L["Admin.ProgrammeDays.Field.Logo"]</span>
                <SimfImageUpload Category="ProgrammeDayImage" OwnerId="@Initial.Id" Alt="@_model.Title" />
            </div>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Type="button" OnClick="HandleSubmitAsync"
                    Loading="_busy" LoadingLabel="@L["Admin.ProgrammeDays.Save"]">
            @L["Admin.ProgrammeDays.Save"]
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.ProgrammeDays.Cancel"]
            </SimfButton>
        }
    </div>
</div>
