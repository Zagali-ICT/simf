@* D-353 — reusable Hall Add/Edit form, hosted by CrudShell (popup or full
   page) from HallsList. Inherits CrudAddEditFormBase so it exposes the standard
   CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel). Branches Create
   vs Update on IsEdit (POST when !IsEdit, PUT against Initial!.Id when IsEdit).
   Supersedes HallForm.razor (D-134), which keyed off Initial==null. *@
@using System.Globalization
@inherits CrudAddEditFormBase<AdminHallDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        <SimfTextField Label="@L["Admin.Halls.Field.Code"]"
                       Helper="@L["Admin.Halls.Field.CodeHint"]"
                       MaxLength="16"
                       @bind-Value="_model.Code" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Halls.Field.Name"]"
                       Helper="@L["Admin.Halls.Field.NameHint"]"
                       MaxLength="128"
                       @bind-Value="_model.Name" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Halls.Field.NameArabic"]"
                       Helper="@L["Admin.Halls.Field.NameArabicHint"]"
                       MaxLength="128"
                       @bind-Value="_model.NameArabic" Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Halls.Field.Capacity"]"
                       Helper="@L["Admin.Halls.Field.CapacityHint"]"
                       Type="number"
                       Value="@_capacityInput"
                       ValueChanged="@(v => _capacityInput = v)"
                       ValueExpression="@(() => _capacityInput)"
                       Disabled="_busy" />
        @* D-485 — how attendees join sessions in this hall (assigned seat vs
           open/general admission). A session can override this per-session. *@
        <SimfSelect TValue="string"
                    Label="@L["Admin.Halls.Field.SeatMode"]"
                    Items="_seatModeOptions"
                    ValueFor="@(id => id)"
                    LabelFor="@(id => SeatModeLabel(id))"
                    Value="@_seatModeInput"
                    ValueChanged="@(v => _seatModeInput = v ?? "0")"
                    Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Halls.Field.Floor"]"
                       Helper="@L["Admin.Halls.Field.FloorHint"]"
                       MaxLength="32"
                       @bind-Value="_model.Floor" Disabled="_busy" />
        <SimfTextarea Label="@L["Admin.Halls.Field.EquipmentNotes"]"
                      Helper="@L["Admin.Halls.Field.EquipmentNotesHint"]"
                      Rows="3" MaxLength="1024"
                      Value="@_model.EquipmentNotes"
                      ValueChanged="@(v => _model.EquipmentNotes = v)" />
        <SimfTextField Label="@L["Admin.Halls.Field.GeofenceLat"]"
                       Helper="@L["Admin.Halls.Field.GeofenceHint"]"
                       Value="@_geoLatInput"
                       ValueChanged="@(v => _geoLatInput = v)"
                       ValueExpression="@(() => _geoLatInput)"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Halls.Field.GeofenceLon"]"
                       Value="@_geoLonInput"
                       ValueChanged="@(v => _geoLonInput = v)"
                       ValueExpression="@(() => _geoLonInput)"
                       Disabled="_busy" />
        <SimfTextField Label="@L["Admin.Halls.Field.GeofenceRadius"]"
                       Helper="@L["Admin.Halls.Field.GeofenceRadiusHint"]"
                       Type="number"
                       Value="@_geoRadiusInput"
                       ValueChanged="@(v => _geoRadiusInput = v)"
                       ValueExpression="@(() => _geoRadiusInput)"
                       Disabled="_busy" />
        @* D-839 — the hall's other arrival knob, beside the geofence it belongs with. *@
        <SimfTextField Label="@L["Admin.Halls.Field.ArrivalGrace"]"
                       Helper="@L["Admin.Halls.Field.ArrivalGraceHint"]"
                       Type="number"
                       Min="0" Max="@ArrivalGraceMax"
                       Value="@_arrivalGraceInput"
                       ValueChanged="@(v => _arrivalGraceInput = v)"
                       ValueExpression="@(() => _arrivalGraceInput)"
                       Disabled="_busy" />
        @if (IsEdit)
        {
            <SimfCheckbox @bind-Value="_model.IsActive" Disabled="_busy">
                @L["Admin.Halls.Field.IsActive"]
            </SimfCheckbox>
        }
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy"
                    LoadingLabel="@(IsEdit ? L["Admin.Halls.Edit.Submitting"] : L["Admin.Halls.New.Submitting"])">
            @(IsEdit ? L["Admin.Halls.Edit.Submit"] : L["Admin.Halls.New.Submit"])
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Halls.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
