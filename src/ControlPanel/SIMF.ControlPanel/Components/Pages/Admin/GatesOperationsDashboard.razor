@* D-199 — read-only Gates operations dashboard. A live overview of who is
   currently checked-in inside the venue plus the gate roster. Consumes the
   existing gate BFF passthroughs only (D-148): GET .../gates/reports/currently-inside
   and POST .../gates/list. No create / edit / delete — operations happen in the
   operator console (/admin/gates/operator) and gate CRUD (/admin/gates). *@
@page "/admin/gates/dashboard"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Gates.Manage)]

<PageTitle>@L["Admin.GatesDashboard.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.GatesDashboard.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <div class="simf-form__actions">
            <SimfButton Type="button" Loading="_loading"
                        LoadingLabel="@L["Admin.GatesDashboard.Refreshing"]"
                        OnClick="LoadAsync">
                @L["Admin.GatesDashboard.Refresh"]
            </SimfButton>
        </div>

        @if (_loading)
        {
            <p>@L["Admin.GatesDashboard.Loading"]</p>
        }
        else
        {
            <div class="simf-form__actions">
                <SimfStatCard Title="@L["Admin.GatesDashboard.Stat.Inside"]"
                              Value="@_inside.Count.ToString(CultureInfo.InvariantCulture)" />
                <SimfStatCard Title="@L["Admin.GatesDashboard.Stat.Gates"]"
                              Value="@_gates.Count.ToString(CultureInfo.InvariantCulture)" />
            </div>

            <h3>@L["Admin.GatesDashboard.Inside.Title"]</h3>
            @if (_inside.Count == 0)
            {
                <SimfEmptyState Title="@L["Admin.GatesDashboard.Inside.None"]" />
            }
            else
            {
                <table class="simf-table">
                    <thead>
                        <tr>
                            <th>@L["Admin.GatesDashboard.Inside.Col.Name"]</th>
                            <th>@L["Admin.GatesDashboard.Inside.Col.ProfileType"]</th>
                            <th>@L["Admin.GatesDashboard.Inside.Col.Gate"]</th>
                            <th>@L["Admin.GatesDashboard.Inside.Col.EnteredAt"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _inside)
                        {
                            <tr>
                                <td>@NameOf(row)</td>
                                <td>@(string.IsNullOrWhiteSpace(row.ProfileTypeName) ? "—" : row.ProfileTypeName)</td>
                                <td>@row.LastCheckInGateCode</td>
                                <td>@row.LastCheckInAtUtc.FormatSaudi("yyyy-MM-dd hh:mm:ss tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="simf-table__summary">
                    @(string.Format(L["Admin.GatesDashboard.Inside.Summary"], _inside.Count))
                </p>
            }

            <h3>@L["Admin.GatesDashboard.Gates.Title"]</h3>
            @if (_gates.Count == 0)
            {
                <SimfEmptyState Title="@L["Admin.GatesDashboard.Gates.None"]" />
            }
            else
            {
                <table class="simf-table">
                    <thead>
                        <tr>
                            <th>@L["Admin.GatesDashboard.Gates.Col.Code"]</th>
                            <th>@L["Admin.GatesDashboard.Gates.Col.Name"]</th>
                            <th>@L["Admin.GatesDashboard.Gates.Col.Active"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gate in _gates)
                        {
                            <tr>
                                <td>@gate.Code</td>
                                <td>@NameOf(gate)</td>
                                <td>
                                    @if (gate.IsActive)
                                    {
                                        <SimfPill Variant="on">@L["Admin.GatesDashboard.Gates.Active.Yes"]</SimfPill>
                                    }
                                    else
                                    {
                                        <SimfPill Variant="off">@L["Admin.GatesDashboard.Gates.Active.No"]</SimfPill>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="simf-table__summary">
                    @(string.Format(L["Admin.GatesDashboard.Gates.Summary"], _gates.Count))
                </p>
            }
        }
    </div>
</div>
