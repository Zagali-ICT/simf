@* D-199 (Mockup screen 40 "Rate the Forum") — read-only admin view of the
   attendee forum ratings. Shows the average-stars + count headline and a
   SimfDataGrid of individual ratings (stars, comment, active, date). No create
   / edit / delete — ratings are owned by the attendees who submit them. *@
@page "/admin/ratings"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Ratings.View)]
@using SIMF.Contracts.Feedback
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.Ratings.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Ratings.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        @* Reuse the existing .simf-form__actions flex-row layout to lay the
           two headline stat cards side by side — there is no dedicated
           stat-row class in the component CSS this wave. *@
        <div class="simf-form__actions">
            <SimfStatCard Title="@L["Admin.Ratings.Stat.Average"]"
                          Value="@_averageStars.ToString("0.0", CultureInfo.InvariantCulture)" />
            <SimfStatCard Title="@L["Admin.Ratings.Stat.Count"]"
                          Value="@_ratingCount.ToString(CultureInfo.InvariantCulture)" />
        </div>

        <SimfDataGrid TItem="AdminRatingSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => $"{r.Stars}/5")"
                      Caption="@L["Admin.Ratings.Title"]"
                      OnExport="OnExportAsync"
                      ExportLabel="@L["Grid.Export"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      AddLabel="@L["Grid.Add"]"
                      EditLabel="@L["Grid.Edit"]"
                      DetailsLabel="@L["Grid.Details"]"
                      DeleteLabel="@L["Grid.Delete"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      LoadingLabel="@L["Admin.Ratings.Loading"]"
                      PageFormatter="@FormatPage"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminRatingSummary" Key="stars"
                                    Header="@L["Admin.Ratings.Col.Stars"]"
                                    Sortable="true">
                    <CellTemplate>@(context.Stars) / 5</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminRatingSummary" Key="comment"
                                    Header="@L["Admin.Ratings.Col.Comment"]"
                                    Filterable="true">
                    <CellTemplate>
                        @(string.IsNullOrWhiteSpace(context.Comment) ? "—" : context.Comment)
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminRatingSummary" Key="isActive"
                                    Header="@L["Admin.Ratings.Col.Active"]">
                    <CellTemplate>
                        @if (context.IsActive)
                        {
                            <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminRatingSummary" Key="createdAt"
                                    Header="@L["Admin.Ratings.Col.CreatedAt"]"
                                    Sortable="true">
                    <CellTemplate>
                        @context.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Ratings.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@code {
    private record Toast(string Variant, string Message);

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminRatingSummary> _page = new();
    private double _averageStars;
    private int _ratingCount;
    private bool _loading;
    private Toast? _toast;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    // D-356 — Excel export (selected rows, or the current filtered set). Direct
    // download via the generic /export proxy. Export only — ratings are owned by
    // the attendees who submit them, so the admin view is read-only (no import).
    private Task OnExportAsync(IReadOnlyList<AdminRatingSummary> selected) =>
        JS.InvokeVoidAsync("simfAccount.downloadXlsx",
            "/account/api/admin/ratings/export",
            new AdminGridExportRequest
            {
                Ids = selected.Select(row => row.Id).ToList(),
                Query = selected.Count == 0 ? _query : null,
            }).AsTask();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminRatingsPage>>(
                "simfAccount.postJson",
                "/account/api/admin/feedback/ratings", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data.Ratings;
                _averageStars = env.Data.AverageStars;
                _ratingCount = env.Data.RatingCount;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Ratings.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }
}
