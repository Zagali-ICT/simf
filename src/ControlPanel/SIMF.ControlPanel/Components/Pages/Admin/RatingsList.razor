@* Read-only admin view of submitted rating responses. Shows the overall-average
   + count headline, per-type KPI cards (response count + average overall + the
   per-question averages), and a SimfDataGrid of individual responses. No create /
   edit / delete — responses are owned by the attendees who submit them. The
   rating *configuration* (types / questions) lives on /admin/rating-config. *@
@page "/admin/ratings"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Ratings.View)]
@using SIMF.Contracts.Feedback
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.Ratings.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Ratings.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <div class="simf-form__actions">
            <SimfStatCard Title="@L["Admin.Ratings.Stat.Average"]"
                          Value="@_averageOverall.ToString("0.0", CultureInfo.InvariantCulture)" />
            <SimfStatCard Title="@L["Admin.Ratings.Stat.Count"]"
                          Value="@_responseCount.ToString(CultureInfo.InvariantCulture)" />
        </div>

        @if (_kpi is not null && _kpi.Types.Count > 0)
        {
            <h2 class="simf-section__title">@L["Admin.Ratings.Kpi.Heading"]</h2>
            <div class="simf-form__actions">
                @foreach (var type in _kpi.Types)
                {
                    <SimfStatCard Title="@type.Name"
                                  Value="@type.AverageOverall.ToString("0.0", CultureInfo.InvariantCulture)"
                                  Delta="@string.Format(L["Admin.Ratings.Kpi.Responses"], type.ResponseCount)"
                                  DeltaTone="neutral" />
                }
            </div>
        }

        <SimfDataGrid TItem="AdminRatingResponseSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.RatingTypeName)"
                      Caption="@L["Admin.Ratings.Title"]"
                      OnExport="OnExportAsync"
                      ExportLabel="@L["Grid.Export"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      AddLabel="@L["Grid.Add"]"
                      EditLabel="@L["Grid.Edit"]"
                      DetailsLabel="@L["Grid.Details"]"
                      DeleteLabel="@L["Grid.Delete"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      LoadingLabel="@L["Admin.Ratings.Loading"]"
                      PageFormatter="@FormatPage"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminRatingResponseSummary" Key="type"
                                    Header="@L["Admin.Ratings.Col.Type"]">
                    <CellTemplate>@context.RatingTypeName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminRatingResponseSummary" Key="target"
                                    Header="@L["Admin.Ratings.Col.Target"]">
                    <CellTemplate>@(context.TargetId == Guid.Empty ? "—" : context.TargetId.ToString())</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminRatingResponseSummary" Key="overall"
                                    Header="@L["Admin.Ratings.Col.Overall"]" Sortable="true">
                    <CellTemplate>@(context.OverallStars is null ? "—" : $"{context.OverallStars} / 5")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminRatingResponseSummary" Key="answers"
                                    Header="@L["Admin.Ratings.Col.Answers"]">
                    <CellTemplate>@context.AnswerCount</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminRatingResponseSummary" Key="comment"
                                    Header="@L["Admin.Ratings.Col.Comment"]"
                                    Filterable="true">
                    <CellTemplate>
                        @(string.IsNullOrWhiteSpace(context.Comment) ? "—" : context.Comment)
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminRatingResponseSummary" Key="isActive"
                                    Header="@L["Admin.Ratings.Col.Active"]">
                    <CellTemplate>
                        @if (context.IsActive)
                        {
                            <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminRatingResponseSummary" Key="createdAt"
                                    Header="@L["Admin.Ratings.Col.CreatedAt"]"
                                    Sortable="true">
                    <CellTemplate>
                        @context.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Ratings.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@code {
    private record Toast(string Variant, string Message);

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminRatingResponseSummary> _page = new();
    private double _averageOverall;
    private int _responseCount;
    private AdminRatingKpiView? _kpi;
    private bool _loading;
    private Toast? _toast;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadKpiAsync();
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    // Excel export (selected rows, or the current filtered set). Export only —
    // responses are owned by the attendees who submit them (read-only view).
    private Task OnExportAsync(IReadOnlyList<AdminRatingResponseSummary> selected) =>
        JS.InvokeVoidAsync("simfAccount.downloadXlsx",
            "/account/api/admin/ratings/export",
            new AdminGridExportRequest
            {
                Ids = selected.Select(row => row.Id).ToList(),
                Query = selected.Count == 0 ? _query : null,
            }).AsTask();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminRatingResponsesPage>>(
                "simfAccount.postJson",
                "/account/api/admin/feedback/ratings", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data.Responses;
                _averageOverall = env.Data.AverageOverall;
                _responseCount = env.Data.ResponseCount;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Ratings.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private async Task LoadKpiAsync()
    {
        var env = await JS.InvokeAsync<ApiResult<AdminRatingKpiView>>(
            "simfAccount.getJson", "/account/api/admin/feedback/ratings/kpi");
        if (env is { Success: true, Data: not null }) { _kpi = env.Data; }
    }
}
