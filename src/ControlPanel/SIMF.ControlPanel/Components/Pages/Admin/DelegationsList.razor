@* D-183 (CP UI for D-174 delegations, Mockup page 21) — admin CRUD
   over the public list of forum delegations. The public list is
   sorted IsPriority desc, DisplayOrder asc, NameArabic asc — admins
   control all three fields here.
   D-256 — migrated from the raw <table> to the owner-mandated
   SimfDataGrid (server-paged, sortable + filterable, full pager). *@
@page "/admin/delegations"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Delegations.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.Delegations.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.Delegations.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminDelegationSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.NameArabic)"
                      Caption="@L["Admin.Delegations.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      OnAdd="OnAdd"
                      OnEditOne="OnEdit"
                      OnDeleteOne="OnDeleteAsync"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.Delegations.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      AddLabel="@L["Grid.Add"]"
                      EditLabel="@L["Grid.Edit"]"
                      DeleteLabel="@L["Grid.Delete"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminDelegationSummary" Key="name"
                                    Header="@L["Admin.Delegations.Col.Name"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.Name</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationSummary" Key="nameArabic"
                                    Header="@L["Admin.Delegations.Col.NameArabic"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.NameArabic</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationSummary" Key="country"
                                    Header="@L["Admin.Delegations.Col.Country"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@(context.CountryName ?? "—")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationSummary" Key="memberCount"
                                    Header="@L["Admin.Delegations.Col.MemberCount"]"
                                    Sortable="true">
                    <CellTemplate>@context.MemberCount</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationSummary" Key="isPriority"
                                    Header="@L["Admin.Delegations.Col.Priority"]"
                                    Sortable="true">
                    <CellTemplate>
                        @if (context.IsPriority)
                        {
                            <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationSummary" Key="isInternational"
                                    Header="@L["Admin.Delegations.Col.International"]"
                                    Sortable="true">
                    <CellTemplate>
                        @if (context.IsInternational)
                        {
                            <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationSummary" Key="displayOrder"
                                    Header="@L["Admin.Delegations.Col.DisplayOrder"]"
                                    Sortable="true">
                    <CellTemplate>@context.DisplayOrder</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminDelegationSummary" Key="isActive"
                                    Header="@L["Admin.Delegations.Col.Active"]"
                                    Sortable="true">
                    <CellTemplate>
                        @if (context.IsActive)
                        {
                            <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.Delegations.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_editOpen)
{
    <SimfModal Open="true"
               Title="@(_isEdit ? L["Admin.Delegations.Edit.Title"] : L["Admin.Delegations.Add.Title"])"
               OnClose="@(() => _editOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <SimfTextField Label="@L["Admin.Delegations.Field.Name"]"
                               Value="@_form.Name"
                               ValueChanged="@(v => _form.Name = v)"
                               ValueExpression="@(() => _form.Name)"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.Delegations.Field.NameArabic"]"
                               Value="@_form.NameArabic"
                               ValueChanged="@(v => _form.NameArabic = v)"
                               ValueExpression="@(() => _form.NameArabic)"
                               Disabled="_busy" />
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Delegations.Field.CountryId"]</span>
                    <select class="simf-field__input"
                            value="@(_form.CountryId?.ToString() ?? string.Empty)"
                            @onchange="OnCountryIdChanged"
                            disabled="@_busy">
                        <option value="">@L["Admin.Delegations.Field.CountryNone"]</option>
                        @foreach (var country in _countries)
                        {
                            <option value="@country.Id">@country.NameEn — @country.NameAr</option>
                        }
                    </select>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Delegations.Field.MemberCount"]</span>
                    <input class="simf-field__input" type="number" min="0" max="100000"
                           value="@_form.MemberCount"
                           @onchange="OnMemberCountChanged"
                           disabled="@_busy" />
                </label>
                <SimfCheckbox Value="_form.IsPriority"
                              ValueChanged="@(v => _form.IsPriority = v)"
                              Disabled="_busy">
                    @L["Admin.Delegations.Field.IsPriority"]
                </SimfCheckbox>
                <SimfCheckbox Value="_form.IsInternational"
                              ValueChanged="@(v => _form.IsInternational = v)"
                              Disabled="_busy">
                    @L["Admin.Delegations.Field.IsInternational"]
                </SimfCheckbox>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.Delegations.Field.DisplayOrder"]</span>
                    <input class="simf-field__input" type="number" min="0" max="99999"
                           value="@_form.DisplayOrder"
                           @onchange="OnDisplayOrderChanged"
                           disabled="@_busy" />
                </label>
                <SimfCheckbox Value="_form.IsActive"
                              ValueChanged="@(v => _form.IsActive = v)"
                              Disabled="_busy">
                    @L["Admin.Delegations.Field.IsActive"]
                </SimfCheckbox>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="@(() => _editOpen = false)">
                @L["Admin.Delegations.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SaveAsync" Loading="_busy">
                @L["Admin.Delegations.Save"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private sealed class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string NameArabic { get; set; } = string.Empty;
        public int? CountryId { get; set; }
        public int MemberCount { get; set; }
        public bool IsPriority { get; set; }
        public bool IsInternational { get; set; }
        public int DisplayOrder { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminDelegationSummary> _page = new();
    private bool _loading;
    private bool _busy;
    private Toast? _toast;
    // D-184 — countries cached at mount so the form's country dropdown
    // doesn't round-trip on every Add/Edit modal open.
    private List<AdminCountrySummary> _countries = new();

    private bool _editOpen;
    private bool _isEdit;
    private Guid _editingId;
    private FormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCountriesAsync();
        await LoadAsync();
    }

    private async Task LoadCountriesAsync()
    {
        // D-184 — eager-load active countries so the Add / Edit modal's
        // dropdown is ready on first open. The list is bounded (low
        // hundreds at most) so a single Top=500 round-trip is fine.
        // D-184 (review-pass): surface load failures via the toast so
        // an admin opening Add/Edit with an empty dropdown knows why
        // — the previous silent fallthrough hid network/auth issues.
        var env = await JS.InvokeAsync<ApiResult<GridPage<AdminCountrySummary>>>(
            "simfAccount.postJson", "/account/api/admin/countries/list",
            new GridQuery { Top = 500 });
        if (env is { Success: true, Data: not null })
        {
            _countries = env.Data.Items.Where(c => c.IsActive)
                .OrderBy(c => c.DisplayOrder).ThenBy(c => c.NameEn).ToList();
        }
        else
        {
            _toast = new Toast("error",
                env?.Error?.MessageForCurrentCulture()
                ?? L["Admin.Delegations.CountriesLoadFailed"]);
        }
    }

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminDelegationSummary>>>(
                "simfAccount.postJson",
                "/account/api/admin/delegations/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Delegations.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private void OnAdd()
    {
        _editOpen = true;
        _isEdit = false;
        _editingId = Guid.Empty;
        _form = new FormModel();
        _toast = null;
    }

    private void OnEdit(AdminDelegationSummary row)
    {
        _editOpen = true;
        _isEdit = true;
        _editingId = row.Id;
        _form = new FormModel
        {
            Name = row.Name,
            NameArabic = row.NameArabic,
            CountryId = row.CountryId,
            MemberCount = row.MemberCount,
            IsPriority = row.IsPriority,
            IsInternational = row.IsInternational,
            DisplayOrder = row.DisplayOrder,
            IsActive = row.IsActive,
        };
        _toast = null;
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true;
        _toast = null;
        try
        {
            ApiResult<AdminDelegationSummary>? env;
            if (_isEdit)
            {
                env = await JS.InvokeAsync<ApiResult<AdminDelegationSummary>>(
                    "simfAccount.putJson",
                    $"/account/api/admin/delegations/{_editingId}",
                    new UpdateDelegationRequest
                    {
                        Name = _form.Name,
                        NameArabic = _form.NameArabic,
                        CountryId = _form.CountryId,
                        MemberCount = _form.MemberCount,
                        IsPriority = _form.IsPriority,
                        IsInternational = _form.IsInternational,
                        DisplayOrder = _form.DisplayOrder,
                        IsActive = _form.IsActive,
                    });
            }
            else
            {
                env = await JS.InvokeAsync<ApiResult<AdminDelegationSummary>>(
                    "simfAccount.postJson",
                    "/account/api/admin/delegations",
                    new CreateDelegationRequest
                    {
                        Name = _form.Name,
                        NameArabic = _form.NameArabic,
                        CountryId = _form.CountryId,
                        MemberCount = _form.MemberCount,
                        IsPriority = _form.IsPriority,
                        IsInternational = _form.IsInternational,
                        DisplayOrder = _form.DisplayOrder,
                    });
            }
            if (env is { Success: true })
            {
                _editOpen = false;
                _toast = new Toast("success", L["Admin.Delegations.Saved"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Delegations.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private async Task OnDeleteAsync(AdminDelegationSummary row)
    {
        if (_busy) return;
        // D-183 review-pass: confirm destructive actions. Soft-delete or
        // not, one stray click on the wrong row removes the delegation
        // from the public list immediately, and recovery requires the
        // admin to reactivate by hand (no undo button today).
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm", L["Admin.Delegations.Delete.Confirm"].Value);
        if (!confirmed) return;
        _busy = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.deleteJson",
                $"/account/api/admin/delegations/{row.Id}");
            if (env is { Success: true })
            {
                _toast = new Toast("success", L["Admin.Delegations.Deleted"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.Delegations.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private void OnCountryIdChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _form.CountryId = string.IsNullOrWhiteSpace(raw) ? null
            : (int.TryParse(raw, out var n) ? n : (int?)null);
    }

    private void OnMemberCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n)) _form.MemberCount = n;
    }

    private void OnDisplayOrderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n)) _form.DisplayOrder = n;
    }
}
