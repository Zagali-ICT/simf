@* D-202 Track-2 (CP UI for the D-202 exhibitors module) — admin CRUD over
   the exhibitors plus a per-exhibitor account-provisioning sub-flow.
   Exhibitors are created CP-side only (D-199 #3). A provisioned account is a
   Visitor login tagged to the exhibitor, created in the pending-approval
   state through the existing admin provisioning pipeline.
   D-353 centralised CRUD framing: Add / Edit / View / Delete are hosted by
   CrudShell, which frames the reusable ExhibitorsAddEdit / ExhibitorsViewDelete
   forms as a popup or a full page per the admin's toolbar choice (persisted in
   localStorage via CpPreferences). D-356 adds the generic Excel export/import
   bar (CrudGridExcel). The account-provisioning sub-flow stays a SimfModal
   overlay, independent of the CRUD shell. *@
@page "/admin/exhibitors"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Exhibitors.View)]
@using SIMF.Contracts.Exhibitors

<PageTitle>@L["Admin.Exhibitors.Title"] · SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Exhibitors.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <div class="simf-toast">
                    <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
                </div>
            }

            <SimfDataGrid TItem="AdminExhibitorSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.NameEn)"
                          Caption="@L["Admin.Exhibitors.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Exhibitors.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary"
                          AddPermission="@PermissionCatalog.Exhibitors.Create"
                          EditPermission="@PermissionCatalog.Exhibitors.Edit"
                          DeletePermission="@PermissionCatalog.Exhibitors.Delete"
                          ImportPermission="@PermissionCatalog.Exhibitors.Import"
                          ExportPermission="@PermissionCatalog.Exhibitors.Export">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminExhibitorSummary" Key="nameEn"
                                        Header="@L["Admin.Exhibitors.Col.NameEn"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>
                            <SimfIdentityCell ImageUrl="@LogoImageUrl(context)"
                                              Name="@context.NameEn"
                                              NameSecondary="@context.NameAr" />
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminExhibitorSummary" Key="nameAr"
                                        Header="@L["Admin.Exhibitors.Col.NameAr"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.NameAr</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminExhibitorSummary" Key="accountCount"
                                        Header="@L["Admin.Exhibitors.Col.AccountCount"]">
                        <CellTemplate>@context.AccountCount</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminExhibitorSummary" Key="isActive"
                                        Header="@L["Admin.Exhibitors.Col.Active"]"
                                        Sortable="true">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <RowActions>
                    @* Page-specific quiet action: open the per-exhibitor account
                       provisioning sub-flow. Gated by Exhibitors.Edit (no dedicated
                       provisioning permission exists in the catalogue). *@
                    <AuthorizedAction Permission="@PermissionCatalog.Exhibitors.Edit">
                        <SimfToolbarButton Icon="user" Title="@L["Admin.Exhibitors.Accounts"]"
                                           OnClick="@(() => OnAccountsAsync(context))" />
                    </AuthorizedAction>
                </RowActions>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Exhibitors.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="exhibitors"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Exhibitors.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <ExhibitorsAddEdit IsEdit="_isEdit" Initial="_target"
                               OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <ExhibitorsViewDelete IsDelete="_isDelete" Initial="_target"
                                  OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}

@if (_accountsOpen)
{
    <SimfModal Open="true"
               RequireExplicitClose="true"
               Title="@string.Format(L["Admin.Exhibitors.Accounts.Title"], _accountsExhibitorName)"
               OnClose="@(() => _accountsOpen = false)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <SimfAlert Variant="info">@L["Admin.Exhibitors.Accounts.Hint"]</SimfAlert>

            @if (_accountsLoading)
            {
                <p>@L["Admin.Exhibitors.Accounts.Loading"]</p>
            }
            else if (_accounts.Count == 0)
            {
                <SimfEmptyState Title="@L["Admin.Exhibitors.Accounts.None"]" />
            }
            else
            {
                <table class="simf-table">
                    <thead>
                        <tr>
                            <th>@L["Admin.Exhibitors.Accounts.Col.ContactName"]</th>
                            <th>@L["Admin.Exhibitors.Accounts.Col.Email"]</th>
                            <th>@L["Admin.Exhibitors.Accounts.Col.RoleLabel"]</th>
                            <th>@L["Admin.Exhibitors.Accounts.Col.Active"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in _accounts)
                        {
                            <tr>
                                <td>@account.ContactName</td>
                                <td>@account.Email</td>
                                <td>@(string.IsNullOrWhiteSpace(account.RoleLabel) ? "—" : account.RoleLabel)</td>
                                <td>@(account.IsActive ? "✓" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <h3 class="simf-field__label">@L["Admin.Exhibitors.Provision.Heading"]</h3>
            <div class="simf-form__fields">
                <SimfTextField Label="@L["Admin.Exhibitors.Provision.ContactName"]"
                               Value="@_provision.ContactName"
                               ValueChanged="@(v => _provision.ContactName = v)"
                               ValueExpression="@(() => _provision.ContactName)"
                               MaxLength="256"
                               Disabled="_provisionBusy" />
                <SimfTextField Label="@L["Admin.Exhibitors.Provision.Email"]"
                               Value="@_provision.Email"
                               ValueChanged="@(v => _provision.Email = v)"
                               ValueExpression="@(() => _provision.Email)"
                               MaxLength="320"
                               Disabled="_provisionBusy" />
                <SimfTextField Label="@L["Admin.Exhibitors.Provision.RoleLabel"]"
                               Value="@_provision.RoleLabel"
                               ValueChanged="@(v => _provision.RoleLabel = v)"
                               ValueExpression="@(() => _provision.RoleLabel)"
                               MaxLength="128"
                               Disabled="_provisionBusy" />
            </div>

            @* D-781 — attach an EXISTING account (typically one created on the
               Others page) to this exhibitor. Without it, an exhibitor-typed
               account created outside this modal has no ExhibitorMembership and is
               403'd on badge scan + My Visitors with no way to fix it. Its own
               permission: it hands an existing account access to visitor cards. *@
            <AuthorizedAction Permission="@PermissionCatalog.Exhibitors.LinkAccount">
                <h3 class="simf-field__label">@L["Admin.Exhibitors.Link.Heading"]</h3>
                <SimfAlert Variant="info">@L["Admin.Exhibitors.Link.Hint"]</SimfAlert>
                <div class="simf-form__fields">
                    <SimfTextField Label="@L["Admin.Exhibitors.Link.Email"]"
                                   Value="@_link.Email"
                                   ValueChanged="@(v => _link.Email = v)"
                                   ValueExpression="@(() => _link.Email)"
                                   MaxLength="320"
                                   Disabled="_linkBusy" />
                    <SimfTextField Label="@L["Admin.Exhibitors.Link.ContactName"]"
                                   Value="@_link.ContactName"
                                   ValueChanged="@(v => _link.ContactName = v)"
                                   ValueExpression="@(() => _link.ContactName)"
                                   MaxLength="256"
                                   Disabled="_linkBusy" />
                    <SimfTextField Label="@L["Admin.Exhibitors.Link.RoleLabel"]"
                                   Value="@_link.RoleLabel"
                                   ValueChanged="@(v => _link.RoleLabel = v)"
                                   ValueExpression="@(() => _link.RoleLabel)"
                                   MaxLength="128"
                                   Disabled="_linkBusy" />
                </div>
                <div class="simf-form__actions">
                    <SimfButton Type="button" OnClick="LinkAsync" Loading="_linkBusy" LoadingLabel="@L["Grid.Working"]">
                        @L["Admin.Exhibitors.Link.Submit"]
                    </SimfButton>
                </div>
            </AuthorizedAction>
        </ChildContent>
        <Footer>
            @* The modal now runs two async actions (provision + D-781 link), so
               Close stays disabled while either is in flight. *@
            <SimfButton Type="button" Variant="secondary" Disabled="@(_provisionBusy || _linkBusy)" OnClick="@(() => _accountsOpen = false)">
                @L["Admin.Exhibitors.Accounts.Close"]
            </SimfButton>
            <SimfButton Type="button" OnClick="ProvisionAsync" Loading="_provisionBusy" LoadingLabel="@L["Grid.Working"]">
                @L["Admin.Exhibitors.Provision.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
