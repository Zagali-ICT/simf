@* D-134 Sprint A â€” Roles CRUD. Built on the existing SimfRole +
   Permission + RolePermission entities. **No schema change** â€” pure
   Path 2. Centralized dialog/full-page framing D-353: Add / Edit / View /
   Delete are hosted by CrudShell, which frames the reusable RolesAddEdit and
   RolesViewDelete forms as a popup or a full page per the admin's toolbar
   choice (persisted in localStorage via CpPreferences). The extra per-row
   "Permissions" action (Issue-1) is preserved alongside the framework. *@
@page "/admin/roles"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.Roles.View)]

<PageTitle>@L["Admin.Roles.Title"] Â· SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.Roles.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminRoleSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Name)"
                          Caption="@L["Admin.Roles.Title"]"
                          FilterColumnLabel="@L["Admin.Roles.FilterColumn"]"
                          OnAdd="OnAddAsync"
                          OnEditOne="OnEditAsync"
                          OnDetailsOne="OnDetailsAsync"
                          OnDeleteOne="OnDeleteAsync"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Admin.Roles.Prev"]"
                          NextLabel="@L["Admin.Roles.Next"]"
                          FirstLabel="@L["Admin.Roles.Pager.First"]"
                          LastLabel="@L["Admin.Roles.Pager.Last"]"
                          PageSizeLabel="@L["Admin.Roles.Pager.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.Roles.Loading"]"
                          FilterPlaceholder="@L["Admin.Roles.FilterPlaceholder"]"
                          ActionsHeader="@L["Admin.Roles.Column.Actions"]"
                          SelectAllLabel="@L["Admin.Roles.Action.SelectAll"]"
                          SelectRowLabel="@L["Admin.Roles.Action.SelectRow"]"
                          AddLabel="@L["Admin.Roles.Action.Add"]"
                          EditLabel="@L["Admin.Roles.Action.Edit"]"
                          DetailsLabel="@L["Admin.Roles.Action.Details"]"
                          DeleteLabel="@L["Admin.Roles.Action.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminRoleSummary" Key="name"
                                        Header="@L["Admin.Roles.Column.Name"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@context.Name</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminRoleSummary" Key="baseline"
                                        Header="@L["Admin.Roles.Column.Baseline"]"
                                        Sortable="true">
                        <CellTemplate>
                            @if (context.IsBaseline)
                            {
                                <SimfPill Variant="admin">@L["Admin.Roles.Baseline.Yes"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill>@L["Admin.Roles.Baseline.No"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminRoleSummary" Key="userCount"
                                        Header="@L["Admin.Roles.Column.UserCount"]">
                        <CellTemplate>@context.UserCount</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminRoleSummary" Key="permissionCount"
                                        Header="@L["Admin.Roles.Column.PermissionCount"]">
                        <CellTemplate>@context.PermissionCount</CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <RowActions Context="role">
                    <AuthorizedAction Permission="@PermissionCatalog.Roles.AssignPermissions">
                        <SimfLink Href="@($"/admin/roles/{role.Id}/permissions")">
                            @L["Admin.Roles.Action.Permissions"]
                        </SimfLink>
                    </AuthorizedAction>
                </RowActions>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.Roles.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="roles"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.Roles.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <RolesAddEdit IsEdit="_isEdit" Initial="_target"
                          OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <RolesViewDelete IsDelete="_isDelete" Initial="_target"
                             OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
