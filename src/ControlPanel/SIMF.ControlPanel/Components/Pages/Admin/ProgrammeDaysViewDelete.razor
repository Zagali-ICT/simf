@* D-452 — reusable programme-day View/Delete form, hosted by CrudShell (popup
   or full page) from ProgrammeDaysList. Inherits CrudViewDeleteFormBase so it
   exposes the standard parameter surface (IsDelete / Initial / OnDeleted /
   OnCancel). Read-only details always show; when IsDelete=true a Deactivate
   button appears and a SimfConfirm gates the destructive call. *@
@inherits CrudViewDeleteFormBase<AdminProgrammeDayDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    <dl class="simf-dl">
        <dt>@L["Admin.ProgrammeDays.Col.Date"]</dt>
        <dd>@Initial.Date.ToString("yyyy-MM-dd")</dd>
        <dt>@L["Admin.ProgrammeDays.Col.TitleEn"]</dt>
        <dd>@Initial.Title</dd>
        <dt>@L["Admin.ProgrammeDays.Col.TitleAr"]</dt>
        <dd>@Initial.TitleArabic</dd>
        <dt>@L["Admin.ProgrammeDays.Col.Order"]</dt>
        <dd>@Initial.DisplayOrder</dd>
        <dt>@L["Admin.ProgrammeDays.Col.Image"]</dt>
        <dd>@(Initial.HasImage ? L["Admin.ProgrammeDays.Image.Set"] : L["Admin.ProgrammeDays.Image.None"])</dd>
        <dt>@L["Admin.ProgrammeDays.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.ProgrammeDays.Action.Deactivate"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.ProgrammeDays.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.ProgrammeDays.Delete.Title"]"
                 Message="@string.Format(L["Admin.ProgrammeDays.Delete.Message"], Initial.Title)"
                 ConfirmLabel="@L["Admin.ProgrammeDays.Action.Deactivate"]"
                 CancelLabel="@L["Admin.ProgrammeDays.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" />
}
