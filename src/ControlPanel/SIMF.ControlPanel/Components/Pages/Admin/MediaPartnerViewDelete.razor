@* D-353 â€” reusable Media-Partner View/Delete form, hosted by CrudShell (popup
   or full page) from MediaPartnersList.razor. Inherits CrudViewDeleteFormBase so
   it exposes the standard surface (IsDelete / Initial / OnDeleted / OnCancel).
   Read-only details always show (including the logo path); when IsDelete=true a
   Delete button appears and a SimfConfirm gates the soft-delete (replaces the
   old native JS confirm() on the list). Adds the View path the inline form
   never had. *@
@inherits CrudViewDeleteFormBase<AdminMediaPartnerDetail>
@using SIMF.Contracts.PublicRelations

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

@if (Initial is not null)
{
    @* D-357 — logo from the unified media-asset pipeline. *@
    <div class="simf-image-upload__preview">
        <SimfImageThumb Src="@($"/account/api/admin/assets/MediaPartnerLogo/{Initial.Id}/image")"
                        Alt="@Initial.Name" Class="simf-img-thumb--lg" />
    </div>

    <dl class="simf-dl">
        <dt>@L["Admin.MediaPartners.Col.NameEn"]</dt>
        <dd>@Initial.Name</dd>
        <dt>@L["Admin.MediaPartners.Col.NameAr"]</dt>
        <dd>@Initial.NameArabic</dd>
        <dt>@L["Admin.MediaPartners.Col.Logo"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.LogoRelativePath) ? "â€”" : Initial.LogoRelativePath)</dd>
        <dt>@L["Admin.MediaPartners.Col.Url"]</dt>
        <dd>@(string.IsNullOrWhiteSpace(Initial.Url) ? "â€”" : Initial.Url)</dd>
        <dt>@L["Admin.MediaPartners.Col.DisplayOrder"]</dt>
        <dd>@Initial.DisplayOrder</dd>
        <dt>@L["Admin.MediaPartners.Col.Active"]</dt>
        <dd>@(Initial.IsActive ? L["Grid.Active"] : L["Grid.Inactive"])</dd>
    </dl>

    <div class="simf-form__actions">
        @if (IsDelete)
        {
            <SimfButton Type="button" Variant="danger"
                        Disabled="_busy" OnClick="@(() => _confirming = true)">
                @L["Admin.MediaPartners.Delete"]
            </SimfButton>
        }
        <SimfButton Type="button" Variant="secondary"
                    Disabled="_busy" OnClick="OnCancel">
            @L["Admin.MediaPartners.Details.Close"]
        </SimfButton>
    </div>

    <SimfConfirm Open="_confirming"
                 Title="@L["Admin.MediaPartners.Delete.Title"]"
                 Message="@string.Format(L["Admin.MediaPartners.Delete.Message"], Initial.Name)"
                 ConfirmLabel="@L["Admin.MediaPartners.Delete"]"
                 CancelLabel="@L["Admin.MediaPartners.Cancel"]"
                 Danger="true"
                 Busy="_busy"
                 OnConfirm="ConfirmDeleteAsync"
                 OnCancel="@(() => _confirming = false)" />
}
