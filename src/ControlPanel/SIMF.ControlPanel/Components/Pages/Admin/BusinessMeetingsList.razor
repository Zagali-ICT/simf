@* SIMF-FDS-013 (D-248) — admin-arranged B2B/B2C business meetings. The admin
   schedules a meeting between two or more parties (companies + visitors) at a
   meeting table for a from–to time-slot; meetings are confirmed on save and can
   be cancelled. Mirrors BoothsList / SessionCategoriesList. *@
@page "/admin/business-meetings"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.BusinessMeetings.View)]
@using SIMF.Contracts.BusinessMeetings
@using SIMF.Contracts.Exhibitors

<PageTitle>@L["Admin.BusinessMeetings.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.BusinessMeetings.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="BusinessMeetingRow"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => $"{r.HallName} · {r.TableCode}")"
                      Caption="@L["Admin.BusinessMeetings.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      OnAdd="OnAddAsync"
                      OnDetailsOne="OnViewAsync"
                      OnExport="OnExportAsync"
                      ExportLabel="@L["Grid.Export"]"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.BusinessMeetings.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      AddLabel="@L["Admin.BusinessMeetings.New"]"
                      DetailsLabel="@L["Admin.BusinessMeetings.View"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="BusinessMeetingRow" Key="hall"
                                    Header="@L["Admin.BusinessMeetings.Col.Hall"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.HallName</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="BusinessMeetingRow" Key="table"
                                    Header="@L["Admin.BusinessMeetings.Col.Table"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@context.TableCode</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="BusinessMeetingRow" Key="type"
                                    Header="@L["Admin.BusinessMeetings.Col.Type"]"
                                    Sortable="true">
                    <CellTemplate>@context.MeetingType</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="BusinessMeetingRow" Key="start"
                                    Header="@L["Admin.BusinessMeetings.Col.Start"]"
                                    Sortable="true">
                    <CellTemplate>@context.StartUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="BusinessMeetingRow" Key="end"
                                    Header="@L["Admin.BusinessMeetings.Col.End"]"
                                    Sortable="true">
                    <CellTemplate>@context.EndUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="BusinessMeetingRow" Key="parties"
                                    Header="@L["Admin.BusinessMeetings.Col.Parties"]">
                    <CellTemplate>@context.ParticipantCount</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="BusinessMeetingRow" Key="status"
                                    Header="@L["Admin.BusinessMeetings.Col.Status"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>
                        @switch (context.Status)
                        {
                            case BusinessMeetingStatus.Confirmed:
                                <SimfPill Variant="on">@L["Admin.BusinessMeetings.Filter.Confirmed"]</SimfPill>
                                break;
                            case BusinessMeetingStatus.Cancelled:
                                <SimfPill Variant="off">@L["Admin.BusinessMeetings.Filter.Cancelled"]</SimfPill>
                                break;
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <RowActions>
                @* Page-specific quiet action: cancel a still-confirmed meeting. *@
                @if (context.Status == BusinessMeetingStatus.Confirmed)
                {
                    <AuthorizedAction Permission="@PermissionCatalog.BusinessMeetings.Cancel">
                        <SimfToolbarButton Icon="close" Title="@L["Admin.BusinessMeetings.Cancel"]"
                                           OnClick="@(() => OnCancel(context))" />
                    </AuthorizedAction>
                }
            </RowActions>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.BusinessMeetings.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_scheduleOpen)
{
    <SimfModal Open="true" Title="@L["Admin.BusinessMeetings.Schedule.Title"]"
               OnClose="@(() => _scheduleOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.BusinessMeetings.Field.Hall"]</span>
                    <select class="simf-field__input" value="@(_hallId?.ToString() ?? string.Empty)"
                            @onchange="OnHallChangedAsync" disabled="@_busy">
                        <option value="">@L["Admin.BusinessMeetings.Field.HallChoose"]</option>
                        @foreach (var hall in _meetingHalls)
                        {
                            <option value="@hall.Id">@hall.Name — @hall.NameArabic</option>
                        }
                    </select>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.BusinessMeetings.Field.Table"]</span>
                    <select class="simf-field__input" value="@(_form.MeetingTableId == Guid.Empty ? string.Empty : _form.MeetingTableId.ToString())"
                            @onchange="OnTableChanged" disabled="@(_busy || _hallId is null)">
                        <option value="">@L["Admin.BusinessMeetings.Field.TableChoose"]</option>
                        @foreach (var t in _tables)
                        {
                            <option value="@t.Id">@t.Code (@t.Capacity)</option>
                        }
                    </select>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.BusinessMeetings.Field.Type"]</span>
                    <select class="simf-field__input" value="@((int)_form.MeetingType)"
                            @onchange="OnTypeChanged" disabled="@_busy">
                        <option value="@((int)BusinessMeetingType.B2B)">B2B</option>
                        <option value="@((int)BusinessMeetingType.B2C)">B2C</option>
                        @* D-730 (owner item 15B) — government-to-business type. *@
                        <option value="@((int)BusinessMeetingType.G2B)">G2B</option>
                    </select>
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.BusinessMeetings.Field.Start"]</span>
                    <input class="simf-field__input" type="datetime-local"
                           value="@_startText" @onchange="OnStartChanged" disabled="@_busy" />
                </label>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.BusinessMeetings.Field.End"]</span>
                    <input class="simf-field__input" type="datetime-local"
                           value="@_endText" @onchange="OnEndChanged" disabled="@_busy" />
                </label>

                <fieldset class="simf-field">
                    <span class="simf-field__label">@L["Admin.BusinessMeetings.Field.Participants"]</span>
                    @if (_participants.Count > 0)
                    {
                        <ul class="simf-list">
                            @foreach (var p in _participants)
                            {
                                <li>
                                    @p.Name (@(p.Kind == MeetingPartyKind.Company
                                        ? L["Admin.BusinessMeetings.Party.Company"]
                                        : L["Admin.BusinessMeetings.Party.Visitor"]))
                                    <SimfButton Type="button" Disabled="_busy"
                                                OnClick="@(() => RemoveParticipant(p))">
                                        @L["Admin.BusinessMeetings.Party.Remove"]
                                    </SimfButton>
                                </li>
                            }
                        </ul>
                    }
                    <div class="simf-form__inline">
                        <select class="simf-field__input" value="@((int)_addKind)"
                                @onchange="OnAddKindChanged" disabled="@_busy">
                            <option value="@((int)MeetingPartyKind.Company)">@L["Admin.BusinessMeetings.Party.Company"]</option>
                            <option value="@((int)MeetingPartyKind.Visitor)">@L["Admin.BusinessMeetings.Party.Visitor"]</option>
                        </select>
                        @if (_addKind == MeetingPartyKind.Company)
                        {
                            <select class="simf-field__input" value="@(_addCompanyId?.ToString() ?? string.Empty)"
                                    @onchange="OnAddCompanyChanged" disabled="@_busy">
                                <option value="">@L["Admin.BusinessMeetings.Party.ChooseCompany"]</option>
                                @foreach (var c in _companies)
                                {
                                    <option value="@c.Id">@c.NameEn — @c.NameAr</option>
                                }
                            </select>
                        }
                        else
                        {
                            <select class="simf-field__input" value="@(_addVisitorId?.ToString() ?? string.Empty)"
                                    @onchange="OnAddVisitorChanged" disabled="@_busy">
                                <option value="">@L["Admin.BusinessMeetings.Party.ChooseVisitor"]</option>
                                @foreach (var v in _visitors)
                                {
                                    <option value="@v.UserId">@v.DisplayName</option>
                                }
                            </select>
                        }
                        <SimfButton Type="button" Disabled="_busy" OnClick="AddParticipant">
                            @L["Admin.BusinessMeetings.Party.Add"]
                        </SimfButton>
                    </div>
                </fieldset>

                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.BusinessMeetings.Field.Notes"]</span>
                    <textarea class="simf-field__input" rows="2" maxlength="1024"
                              value="@_form.Notes" @onchange="OnNotesChanged" disabled="@_busy"></textarea>
                </label>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="@(() => _scheduleOpen = false)">
                @L["Admin.BusinessMeetings.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SaveAsync" Loading="_busy">
                @L["Admin.BusinessMeetings.Schedule.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_cancelOpen && _cancelTarget is not null)
{
    <SimfModal Open="true" Title="@L["Admin.BusinessMeetings.Cancel.Title"]"
               OnClose="@(() => _cancelOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <p>@string.Format(L["Admin.BusinessMeetings.Cancel.Prompt"],
                    _cancelTarget.HallName, _cancelTarget.TableCode)</p>
                <label class="simf-field">
                    <span class="simf-field__label">@L["Admin.BusinessMeetings.Cancel.Reason"]</span>
                    <textarea class="simf-field__input" rows="3" maxlength="512"
                              value="@_cancelReason" @onchange="OnCancelReasonChanged"
                              disabled="@_busy"></textarea>
                </label>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" Disabled="_busy" OnClick="@(() => _cancelOpen = false)">
                @L["Admin.BusinessMeetings.Cancel.Keep"]
            </SimfButton>
            <SimfButton Type="button" OnClick="ConfirmCancelAsync" Loading="_busy">
                @L["Admin.BusinessMeetings.Cancel.Confirm"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@if (_detailOpen && _detail is not null)
{
    <SimfModal Open="true" Title="@L["Admin.BusinessMeetings.Detail.Title"]"
               OnClose="@(() => _detailOpen = false)">
        <ChildContent>
            <dl class="simf-dl">
                <dt>@L["Admin.BusinessMeetings.Col.Hall"]</dt><dd>@_detail.HallName</dd>
                <dt>@L["Admin.BusinessMeetings.Col.Table"]</dt><dd>@_detail.TableCode</dd>
                <dt>@L["Admin.BusinessMeetings.Col.Type"]</dt><dd>@_detail.MeetingType</dd>
                <dt>@L["Admin.BusinessMeetings.Col.Start"]</dt><dd>@_detail.StartUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</dd>
                <dt>@L["Admin.BusinessMeetings.Col.End"]</dt><dd>@_detail.EndUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</dd>
                <dt>@L["Admin.BusinessMeetings.Col.Parties"]</dt>
                <dd>
                    <ul class="simf-list">
                        @foreach (var p in _detail.Participants)
                        {
                            <li>@p.DisplayName (@(p.Kind == MeetingPartyKind.Company
                                ? L["Admin.BusinessMeetings.Party.Company"]
                                : L["Admin.BusinessMeetings.Party.Visitor"]))</li>
                        }
                    </ul>
                </dd>
                @if (!string.IsNullOrWhiteSpace(_detail.Notes))
                {
                    <dt>@L["Admin.BusinessMeetings.Field.Notes"]</dt><dd>@_detail.Notes</dd>
                }
                @if (_detail.Status == BusinessMeetingStatus.Cancelled
                    && !string.IsNullOrWhiteSpace(_detail.CancellationReason))
                {
                    <dt>@L["Admin.BusinessMeetings.Cancel.Reason"]</dt><dd>@_detail.CancellationReason</dd>
                }
            </dl>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="@(() => _detailOpen = false)">
                @L["Admin.BusinessMeetings.Detail.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
