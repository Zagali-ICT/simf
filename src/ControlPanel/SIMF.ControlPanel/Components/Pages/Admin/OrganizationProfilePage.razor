@* D-495 — CP "Organization Profile" page: edit the edition-generic forum config
   (name / title / slogan / bio, version + dates, status + year, location + GPS,
   contact, live-stream link, social links, and the about-items + details lists).
   Reads / writes via /admin/organization-profile; the app + website consume it
   through GET /app/organization-profile. View opens it; Manage saves.
   The long field set is grouped into titled SimfFormSection steps with a
   responsive two-column grid (bilingual pairs side by side); the about-items and
   details lists use the simf-repeater card (index + reorder + remove) — D-762. *@
@page "/admin/organization-profile"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.OrganizationProfile.View)]
@using SIMF.Contracts.Admin
@using SIMF.Contracts.Organization

<PageTitle>@L["Admin.OrganizationProfile.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.OrganizationProfile.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toastMessage is not null)
        {
            <SimfAlert Variant="@_toastVariant">@_toastMessage</SimfAlert>
        }

        @if (_loading)
        {
            <p>@L["Admin.OrganizationProfile.Loading"]</p>
        }
        else
        {
            <EditForm EditContext="_editContext" OnSubmit="SaveAsync" class="simf-form">
                <SimfFormSection Number="1" Title="@L["Admin.OrganizationProfile.Section.Identity"]"
                                 Hint="@L["Admin.OrganizationProfile.Section.IdentityHint"]">
                    <div class="simf-form__grid">
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.NameEn"]" MaxLength="256" @bind-Value="_model.Name" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.NameAr"]" MaxLength="256" @bind-Value="_model.NameArabic" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.TitleEn"]" MaxLength="256" @bind-Value="_model.Title" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.TitleAr"]" MaxLength="256" @bind-Value="_model.TitleArabic" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.SloganEn"]" MaxLength="512" @bind-Value="_model.Slogan" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.SloganAr"]" MaxLength="512" @bind-Value="_model.SloganArabic" Disabled="_busy" />
                        <div class="simf-form__grid-item--full">
                            <SimfTextarea Label="@L["Admin.OrganizationProfile.Field.BioEn"]" Rows="3" MaxLength="4000"
                                          Value="@_model.Bio" ValueChanged="@(v => _model.Bio = v)" Disabled="_busy" />
                        </div>
                        <div class="simf-form__grid-item--full">
                            <SimfTextarea Label="@L["Admin.OrganizationProfile.Field.BioAr"]" Rows="3" MaxLength="4000"
                                          Value="@_model.BioArabic" ValueChanged="@(v => _model.BioArabic = v)" Disabled="_busy" />
                        </div>
                    </div>
                </SimfFormSection>

                <SimfFormSection Number="2" Title="@L["Admin.OrganizationProfile.Section.Edition"]"
                                 Hint="@L["Admin.OrganizationProfile.Section.EditionHint"]">
                    <div class="simf-form__grid">
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.CurrentYear"]" MaxLength="4" @bind-Value="_model.CurrentYear" Disabled="_busy" />
                        <label class="simf-field">
                            <span class="simf-field__label">@L["Admin.OrganizationProfile.Field.Status"]</span>
                            <select class="simf-field__input" @bind="_model.Status" disabled="@_busy">
                                <option value="Soon">@L["Admin.OrganizationProfile.Status.Soon"]</option>
                                <option value="Open">@L["Admin.OrganizationProfile.Status.Open"]</option>
                                <option value="Archived">@L["Admin.OrganizationProfile.Status.Archived"]</option>
                            </select>
                        </label>
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.EventStart"]" MaxLength="10" @bind-Value="_model.EventStartDate" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.EventEnd"]" MaxLength="10" @bind-Value="_model.EventEndDate" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.Version"]" MaxLength="64" @bind-Value="_model.Version" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.SysVersion"]" MaxLength="64" @bind-Value="_model.SysVersion" Disabled="_busy" />
                    </div>
                </SimfFormSection>

                <SimfFormSection Number="3" Title="@L["Admin.OrganizationProfile.Section.Location"]"
                                 Hint="@L["Admin.OrganizationProfile.Section.LocationHint"]">
                    <div class="simf-form__grid">
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.LocationEn"]" MaxLength="512" @bind-Value="_model.LocationText" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.LocationAr"]" MaxLength="512" @bind-Value="_model.LocationTextArabic" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.Latitude"]" MaxLength="16" @bind-Value="_model.Latitude" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.Longitude"]" MaxLength="16" @bind-Value="_model.Longitude" Disabled="_busy" />
                    </div>
                </SimfFormSection>

                <SimfFormSection Number="4" Title="@L["Admin.OrganizationProfile.Section.Contact"]">
                    <div class="simf-form__grid">
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.Phone"]" MaxLength="64" @bind-Value="_model.ContactPhone" Disabled="_busy" />
                        <SimfTextField Label="@L["Admin.OrganizationProfile.Field.Email"]" MaxLength="256" @bind-Value="_model.ContactEmail" Disabled="_busy" />
                        <div class="simf-form__grid-item--full">
                            <SimfTextField Label="@L["Admin.OrganizationProfile.Field.Website"]" MaxLength="1024" @bind-Value="_model.ContactWebsite" Disabled="_busy" />
                        </div>
                    </div>
                </SimfFormSection>

                <SimfFormSection Number="5" Title="@L["Admin.OrganizationProfile.Section.Media"]"
                                 Hint="@L["Admin.OrganizationProfile.Section.MediaHint"]">
                    <div class="simf-form__grid">
                        <div class="simf-form__grid-item--full">
                            <SimfTextField Label="@L["Admin.OrganizationProfile.Field.LiveStream"]" MaxLength="1024" @bind-Value="_model.LiveStreamUrl" Disabled="_busy" />
                        </div>
                        <div class="simf-form__grid-item--full">
                            <SimfTextField Label="@L["Admin.OrganizationProfile.Field.HeroVideo"]" MaxLength="1024" @bind-Value="_model.BackgroundVideoUrl" Disabled="_busy" />
                        </div>
                        <div class="simf-form__grid-item--full">
                            <label class="simf-field">
                                <span class="simf-field__label">@L["Admin.OrganizationProfile.Field.HeroVideoFile"]</span>
                                <input type="file" id="@HeroVideoInputId" accept="video/mp4,video/webm,video/x-m4v"
                                       class="simf-field__input" disabled="@(_busy || _videoBusy)" />
                            </label>
                            <div class="simf-form__actions">
                                <AuthorizedAction Permission="@PermissionCatalog.OrganizationProfile.Manage">
                                    <SimfButton Type="button" Variant="secondary" OnClick="UploadHeroVideoAsync"
                                                Loading="_videoBusy" LoadingLabel="@L["Admin.OrganizationProfile.HeroVideoUploading"]"
                                                Disabled="_busy">
                                        @L["Admin.OrganizationProfile.HeroVideoUpload"]
                                    </SimfButton>
                                </AuthorizedAction>
                                @if (HasUploadedHeroVideo)
                                {
                                    <AuthorizedAction Permission="@PermissionCatalog.OrganizationProfile.Manage">
                                        <SimfButton Type="button" Variant="danger" OnClick="RemoveHeroVideoAsync"
                                                    Disabled="@(_busy || _videoBusy)">
                                            @L["Admin.OrganizationProfile.HeroVideoRemove"]
                                        </SimfButton>
                                    </AuthorizedAction>
                                }
                            </div>
                            <p class="simf-field__hint">@L["Admin.OrganizationProfile.HeroVideoHint"]</p>
                        </div>
                    </div>
                </SimfFormSection>

                <SimfFormSection Number="6" Title="@L["Admin.OrganizationProfile.Section.Social"]"
                                 Hint="@L["Admin.OrganizationProfile.Section.SocialHint"]">
                    <div class="simf-form__grid">
                        <SimfTextField Label="Facebook" MaxLength="1024" @bind-Value="_model.Facebook" Disabled="_busy" />
                        <SimfTextField Label="X (Twitter)" MaxLength="1024" @bind-Value="_model.X" Disabled="_busy" />
                        <SimfTextField Label="Instagram" MaxLength="1024" @bind-Value="_model.Instagram" Disabled="_busy" />
                        <SimfTextField Label="LinkedIn" MaxLength="1024" @bind-Value="_model.LinkedIn" Disabled="_busy" />
                        <SimfTextField Label="YouTube" MaxLength="1024" @bind-Value="_model.YouTube" Disabled="_busy" />
                        <SimfTextField Label="TikTok" MaxLength="1024" @bind-Value="_model.TikTok" Disabled="_busy" />
                        <SimfTextField Label="Snapchat" MaxLength="1024" @bind-Value="_model.Snapchat" Disabled="_busy" />
                    </div>
                </SimfFormSection>

                <SimfFormSection Number="7" Title="@L["Admin.OrganizationProfile.Section.About"]"
                                 Hint="@L["Admin.OrganizationProfile.Section.AboutHint"]">
                    <SimfRepeater TItem="AboutRow" Items="_model.AboutItems" IndexLabel="@L["Admin.OrganizationProfile.About.IndexLabel"]"
                                  EmptyText="@L["Admin.OrganizationProfile.About.Empty"]"
                                  AddLabel="@L["Admin.OrganizationProfile.About.Add"]" Disabled="_busy"
                                  MoveUpLabel="@L["Grid.MoveUp"]"
                                  MoveDownLabel="@L["Grid.MoveDown"]"
                                  RemoveLabel="@L["Grid.Remove"]"
                                  OnAdd="AddAbout" OnRemove="RemoveAbout"
                                  OnMove="@(m => MoveAbout(m.Item, m.Delta))">
                        <RowTemplate Context="item">
                            <div class="simf-form__grid">
                                <SimfTextField Label="@L["Admin.OrganizationProfile.Field.TitleEn"]" MaxLength="256" @bind-Value="item.Title" Disabled="_busy" />
                                <SimfTextField Label="@L["Admin.OrganizationProfile.Field.TitleAr"]" MaxLength="256" @bind-Value="item.TitleArabic" Disabled="_busy" />
                                <div class="simf-form__grid-item--full">
                                    <SimfTextarea Label="@L["Admin.OrganizationProfile.About.TextEn"]" Rows="3" MaxLength="4000"
                                                  Value="@item.Text" ValueChanged="@(v => item.Text = v)" Disabled="_busy" />
                                </div>
                                <div class="simf-form__grid-item--full">
                                    <SimfTextarea Label="@L["Admin.OrganizationProfile.About.TextAr"]" Rows="3" MaxLength="4000"
                                                  Value="@item.TextArabic" ValueChanged="@(v => item.TextArabic = v)" Disabled="_busy" />
                                </div>
                            </div>
                        </RowTemplate>
                    </SimfRepeater>
                </SimfFormSection>

                <SimfFormSection Number="8" Title="@L["Admin.OrganizationProfile.Section.Details"]"
                                 Hint="@L["Admin.OrganizationProfile.Section.DetailsHint"]">
                    <SimfRepeater TItem="DetailRow" Items="_model.Details" IndexLabel="@L["Admin.OrganizationProfile.Detail.IndexLabel"]"
                                  EmptyText="@L["Admin.OrganizationProfile.Detail.Empty"]"
                                  AddLabel="@L["Admin.OrganizationProfile.Detail.Add"]" Disabled="_busy"
                                  MoveUpLabel="@L["Grid.MoveUp"]"
                                  MoveDownLabel="@L["Grid.MoveDown"]"
                                  RemoveLabel="@L["Grid.Remove"]"
                                  OnAdd="AddDetail" OnRemove="RemoveDetail"
                                  OnMove="@(m => MoveDetail(m.Item, m.Delta))">
                        <RowTemplate Context="row">
                            <div class="simf-form__grid">
                                <SimfTextField Label="@L["Admin.OrganizationProfile.Field.NameEn"]" MaxLength="256" @bind-Value="row.Name" Disabled="_busy" />
                                <SimfTextField Label="@L["Admin.OrganizationProfile.Field.NameAr"]" MaxLength="256" @bind-Value="row.NameArabic" Disabled="_busy" />
                                <SimfTextField Label="@L["Admin.OrganizationProfile.Detail.ValueEn"]" MaxLength="1024" @bind-Value="row.Value" Disabled="_busy" />
                                <SimfTextField Label="@L["Admin.OrganizationProfile.Detail.ValueAr"]" MaxLength="1024" @bind-Value="row.ValueArabic" Disabled="_busy" />
                            </div>
                        </RowTemplate>
                    </SimfRepeater>
                </SimfFormSection>

                <div class="simf-form__actions">
                    <AuthorizedAction Permission="@PermissionCatalog.OrganizationProfile.Manage">
                        <SimfButton Loading="_busy" Disabled="_videoBusy" LoadingLabel="@L["Admin.OrganizationProfile.Saving"]">
                            @L["Admin.OrganizationProfile.Save"]
                        </SimfButton>
                    </AuthorizedAction>
                </div>
            </EditForm>
        }
    </div>
</div>
