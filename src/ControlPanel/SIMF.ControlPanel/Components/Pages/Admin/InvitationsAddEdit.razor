@* D-353 — reusable Invitation Add/Edit form, hosted by CrudShell (popup or full
   page) from InvitationsList. Inherits CrudAddEditFormBase so it exposes the
   standard CRUD-form surface (IsEdit / Initial / OnSuccess / OnCancel). Folds the
   two inline SimfModals the list used to carry: IsEdit=false runs the SEND/Add
   flow (recipient UserProfile id + optional notes → POST), IsEdit=true runs the
   EDIT flow (admin state override + notes → PUT against Initial). Recipient and
   SentBy are fixed once sent, so the Edit branch never re-shows the recipient
   field; State is system-defaulted to Pending on create, so the Add branch never
   shows the state field. Same create/update request DTOs + JS calls the inline
   modals used. *@
@inherits CrudAddEditFormBase<AdminInvitationDetail>

@if (_error is not null)
{
    <SimfAlert Variant="error">@_error</SimfAlert>
}

<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        @if (!IsEdit)
        {
            <SimfTextField Label="@L["Admin.Invitations.Field.Recipient"]"
                           Value="@_model.RecipientId"
                           ValueChanged="@(v => _model.RecipientId = v)"
                           ValueExpression="@(() => _model.RecipientId)"
                           Disabled="_busy" />
        }
        else
        {
            <SimfSelect TValue="InvitationState"
                        Label="@L["Admin.Invitations.Field.State"]"
                        Items="_invitationStates"
                        Value="_model.State"
                        ValueChanged="@((InvitationState v) => _model.State = v)"
                        ValueExpression="@(() => _model.State)"
                        Disabled="_busy" />
        }
        <SimfTextField Label="@L["Admin.Invitations.Field.Notes"]"
                       Value="@_model.Notes"
                       ValueChanged="@(v => _model.Notes = v)"
                       ValueExpression="@(() => _model.Notes)"
                       Disabled="_busy" />
    </div>
    <div class="simf-form__actions">
        <SimfButton Loading="_busy"
                    LoadingLabel="@(IsEdit ? L["Admin.Invitations.Edit.Submitting"] : L["Admin.Invitations.New.Submitting"])">
            @(IsEdit ? L["Admin.Invitations.Submit.Update"] : L["Admin.Invitations.Submit.Create"])
        </SimfButton>
        @if (OnCancel.HasDelegate)
        {
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_busy" OnClick="OnCancel">
                @L["Admin.Invitations.Cancel"]
            </SimfButton>
        }
    </div>
</EditForm>
