@* D-173 (gap doc G8, PDF Â§1, Â§2.1) â€” Dynamic CMS: editable content
   blocks (welcome message, page copy, labels). Admin upserts by Key.
   D-255 â€” migrated from a raw table to the standard SimfDataGrid.
   D-353 â€” centralized dialog/full-page framing: Add / Edit / View / Delete are
   hosted by CrudShell, which frames the reusable ContentBlockAddEdit and
   ContentBlockViewDelete forms as a popup or a full page per the admin's toolbar
   choice (persisted in localStorage via CpPreferences). The inline SimfModal
   form + one-click delete it used to carry are gone. The grid summary carries
   every field the forms need, so the row is bound straight through â€” no
   detail-fetch. *@
@page "/admin/content-blocks"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.ContentBlocks.View)]

<PageTitle>@L["Admin.ContentBlocks.Title"] Â· SIMF</PageTitle>

@if (!GridHidden)
{
    <SimfBanner Title="@L["Admin.ContentBlocks.Title"]" />

    <div class="simf-page-wide">
        <div class="simf-surface">
            @if (_toast is not null)
            {
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            }

            <SimfDataGrid TItem="AdminContentBlockSummary"
                          Query="_query"
                          Page="_page"
                          Loading="_loading"
                          OnQueryChanged="OnQueryChangedAsync"
                          Multiselect="true"
                          RowKey="@(r => r.Id.ToString())"
                          RowLabel="@(r => r.Key)"
                          Caption="@L["Admin.ContentBlocks.Title"]"
                          FilterColumnLabel="@L["Grid.FilterColumn"]"
                          OnAdd="OnAdd"
                          OnEditOne="OnEdit"
                          OnDetailsOne="OnDetails"
                          OnDeleteOne="OnDelete"
                          OnExport="OnExportAsync"
                          OnImport="OnImportAsync"
                          PrevLabel="@L["Grid.Prev"]"
                          NextLabel="@L["Grid.Next"]"
                          FirstLabel="@L["Grid.First"]"
                          LastLabel="@L["Grid.Last"]"
                          PageSizeLabel="@L["Grid.PageSize"]"
                          PageFormatter="@FormatPage"
                          LoadingLabel="@L["Admin.ContentBlocks.Loading"]"
                          FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                          ActionsHeader="@L["Grid.Actions"]"
                          SelectAllLabel="@L["Grid.SelectAll"]"
                          SelectRowLabel="@L["Grid.SelectRow"]"
                          AddLabel="@L["Grid.Add"]"
                          EditLabel="@L["Grid.Edit"]"
                          DetailsLabel="@L["Grid.Details"]"
                          DeleteLabel="@L["Grid.Delete"]"
                          ExportLabel="@L["Grid.Export"]"
                          ImportLabel="@L["Grid.Import"]"
                          SummaryFormatter="@FormatSummary">
                <CustomToolbar>
                    <CrudPresentationToggle PageKey="@PageKey" @bind-Value="_presentation" />
                </CustomToolbar>
                <Columns>
                    <SimfDataGridColumn TItem="AdminContentBlockSummary" Key="key"
                                        Header="@L["Admin.ContentBlocks.Col.Key"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate><code>@context.Key</code></CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminContentBlockSummary" Key="content"
                                        Header="@L["Admin.ContentBlocks.Col.ContentEn"]"
                                        Sortable="true" Filterable="true">
                        <CellTemplate>@TruncatePreview(context.Content)</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminContentBlockSummary" Key="lastUpdatedAt"
                                        Header="@L["Admin.ContentBlocks.Col.LastUpdatedAt"]"
                                        Sortable="true">
                        <CellTemplate>@context.LastUpdatedAt.FormatSaudi("yyyy-MM-dd hh:mm tt")</CellTemplate>
                    </SimfDataGridColumn>
                    <SimfDataGridColumn TItem="AdminContentBlockSummary" Key="isActive"
                                        Header="@L["Admin.ContentBlocks.Col.Active"]">
                        <CellTemplate>
                            @if (context.IsActive)
                            {
                                <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                            }
                            else
                            {
                                <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                            }
                        </CellTemplate>
                    </SimfDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <SimfEmptyState Title="@L["Admin.ContentBlocks.None"]" />
                </EmptyTemplate>
            </SimfDataGrid>

            <CrudGridExcel @ref="_excel" Resource="content-blocks"
                           OnImported="OnImportedAsync" OnError="OnExcelError" />
        </div>
    </div>
}

@if (FormOpen)
{
    <CrudShell Open="true" Presentation="_presentation"
               Title="@FormTitle" CloseLabel="@L["Admin.ContentBlocks.Details.Close"]"
               OnClose="CloseForm">
        @if (_form == FormKind.AddEdit)
        {
            <ContentBlockAddEdit IsEdit="_isEdit" Initial="_target"
                                 OnSuccess="OnSavedAsync" OnCancel="CloseForm" />
        }
        else if (_form == FormKind.ViewDelete)
        {
            <ContentBlockViewDelete IsDelete="_isDelete" Initial="_target"
                                    OnDeleted="OnDeletedAsync" OnCancel="CloseForm" />
        }
    </CrudShell>
}
