@* D-173 (gap doc G8, PDF §1, §2.1) — Dynamic CMS: editable content
   blocks (welcome message, page copy, labels). Admin upserts by Key.
   D-255 — migrated from a raw table to the standard SimfDataGrid. *@
@page "/admin/content-blocks"
@layout CpShellLayout
@attribute [RequirePermission(PermissionCatalog.ContentBlocks.View)]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

<PageTitle>@L["Admin.ContentBlocks.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Admin.ContentBlocks.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="AdminContentBlockSummary"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => r.Key)"
                      Caption="@L["Admin.ContentBlocks.Title"]"
                      FilterColumnLabel="@L["Grid.FilterColumn"]"
                      OnAdd="OnAdd"
                      OnEditOne="OnEdit"
                      OnDeleteOne="OnDelete"
                      PrevLabel="@L["Grid.Prev"]"
                      NextLabel="@L["Grid.Next"]"
                      FirstLabel="@L["Grid.First"]"
                      LastLabel="@L["Grid.Last"]"
                      PageSizeLabel="@L["Grid.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Admin.ContentBlocks.Loading"]"
                      FilterPlaceholder="@L["Grid.FilterPlaceholder"]"
                      ActionsHeader="@L["Grid.Actions"]"
                      SelectAllLabel="@L["Grid.SelectAll"]"
                      SelectRowLabel="@L["Grid.SelectRow"]"
                      AddLabel="@L["Grid.Add"]"
                      EditLabel="@L["Grid.Edit"]"
                      DetailsLabel="@L["Grid.Details"]"
                      DeleteLabel="@L["Grid.Delete"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="AdminContentBlockSummary" Key="key"
                                    Header="@L["Admin.ContentBlocks.Col.Key"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate><code>@context.Key</code></CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminContentBlockSummary" Key="content"
                                    Header="@L["Admin.ContentBlocks.Col.ContentEn"]"
                                    Sortable="true" Filterable="true">
                    <CellTemplate>@TruncatePreview(context.Content)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminContentBlockSummary" Key="lastUpdatedAt"
                                    Header="@L["Admin.ContentBlocks.Col.LastUpdatedAt"]"
                                    Sortable="true">
                    <CellTemplate>@context.LastUpdatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="AdminContentBlockSummary" Key="isActive"
                                    Header="@L["Admin.ContentBlocks.Col.Active"]">
                    <CellTemplate>
                        @if (context.IsActive)
                        {
                            <SimfPill Variant="on">@L["Grid.Active"]</SimfPill>
                        }
                        else
                        {
                            <SimfPill Variant="off">@L["Grid.Inactive"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Admin.ContentBlocks.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>
    </div>
</div>

@if (_editOpen)
{
    <SimfModal Open="true" Title="@L["Admin.ContentBlocks.Edit.Title"]"
               OnClose="@(() => _editOpen = false)">
        <ChildContent>
            <div class="simf-form__fields">
                <SimfTextField Label="@L["Admin.ContentBlocks.Field.Key"]"
                               Value="@_editKey"
                               ValueChanged="@(v => _editKey = v)"
                               ValueExpression="@(() => _editKey)"
                               Disabled="_busy || _isEdit" />
                <SimfTextField Label="@L["Admin.ContentBlocks.Field.ContentEn"]"
                               Value="@_editContentEn"
                               ValueChanged="@(v => _editContentEn = v)"
                               ValueExpression="@(() => _editContentEn)"
                               Disabled="_busy" />
                <SimfTextField Label="@L["Admin.ContentBlocks.Field.ContentAr"]"
                               Value="@_editContentAr"
                               ValueChanged="@(v => _editContentAr = v)"
                               ValueExpression="@(() => _editContentAr)"
                               Disabled="_busy" />
                <SimfCheckbox @bind-Value="_editIsActive" Disabled="_busy">
                    @L["Admin.ContentBlocks.Field.IsActive"]
                </SimfCheckbox>
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="@(() => _editOpen = false)">
                @L["Admin.ContentBlocks.Cancel"]
            </SimfButton>
            <SimfButton Type="button" OnClick="SubmitAsync" Loading="_busy">
                @L["Admin.ContentBlocks.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private GridQuery _query = new() { Top = 20 };
    private GridPage<AdminContentBlockSummary> _page = new();
    private bool _loading;
    private bool _busy;
    private Toast? _toast;

    private bool _editOpen;
    private bool _isEdit;
    private string _editKey = string.Empty;
    private string _editContentEn = string.Empty;
    private string _editContentAr = string.Empty;
    private bool _editIsActive = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Grid.Summary"], skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Grid.Page"], current, total);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<GridPage<AdminContentBlockSummary>>>(
                "simfAccount.postJson", "/account/api/admin/content-blocks/list", _query);
            if (env is { Success: true, Data: not null })
            {
                _page = env.Data;
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.ContentBlocks.LoadFailed"]);
            }
        }
        finally { _loading = false; }
    }

    private void OnAdd()
    {
        _editOpen = true;
        _isEdit = false;
        _editKey = string.Empty;
        _editContentEn = string.Empty;
        _editContentAr = string.Empty;
        _editIsActive = true;
    }

    private void OnEdit(AdminContentBlockSummary row)
    {
        _editOpen = true;
        _isEdit = true;
        _editKey = row.Key;
        _editContentEn = row.Content;
        _editContentAr = row.ContentArabic;
        _editIsActive = row.IsActive;
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true;
        _toast = null;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<AdminContentBlockSummary>>(
                "simfAccount.putJson", "/account/api/admin/content-blocks",
                new UpsertContentBlockRequest
                {
                    Key = _editKey,
                    Content = _editContentEn,
                    ContentArabic = _editContentAr,
                    IsActive = _editIsActive,
                });
            if (env is { Success: true })
            {
                _editOpen = false;
                _toast = new Toast("success", L["Admin.ContentBlocks.Saved"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.ContentBlocks.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private async Task OnDelete(AdminContentBlockSummary row)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var env = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.deleteJson",
                $"/account/api/admin/content-blocks/{Uri.EscapeDataString(row.Key)}");
            if (env is { Success: true })
            {
                _toast = new Toast("success", L["Admin.ContentBlocks.Deleted"]);
                await LoadAsync();
            }
            else
            {
                _toast = new Toast("error",
                    env?.Error?.MessageForCurrentCulture()
                    ?? L["Admin.ContentBlocks.LoadFailed"]);
            }
        }
        finally { _busy = false; }
    }

    private static string TruncatePreview(string s) =>
        s.Length > 80 ? s.Substring(0, 80) + "…" : s;
}
