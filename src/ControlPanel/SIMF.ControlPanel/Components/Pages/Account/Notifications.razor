@* CP — full notification list page, built on the canonical grid pattern.
   The bell links here via "View all".
   Mark-read on click, delete on the row action, bulk-dismiss via the
   toolbar checkbox + Delete. The "Mark all read" button stays outside
   the toolbar — it's a domain-specific bulk op (read, not delete). *@
@page "/account/notifications"
@layout CpShellLayout
@attribute [Authorize]

<PageTitle>@L["Account.Notifications.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Account.Notifications.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <div class="simf-toast">
                <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
            </div>
        }

        <SimfDataGrid TItem="NotificationDto"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => TitleFor(r))"
                      OnDetailsOne="OnDetailsAsync"
                      OnDeleteOne="@(r => AskDismiss(L["Account.Notifications.Dismiss.Confirm.Title"],
                                                     string.Format(L["Account.Notifications.Dismiss.Confirm.Message"], TitleFor(r)),
                                                     () => OnDeleteAsync(r)))"
                      OnDeleteSelected="@(rows => AskDismiss(L["Account.Notifications.BulkDismiss.Confirm.Title"],
                                                             string.Format(L["Account.Notifications.BulkDismiss.Confirm.Message"], rows.Count),
                                                             () => OnBulkDeleteAsync(rows)))"
                      Caption="@L["Account.Notifications.Title"]"
                      FilterColumnLabel="@L["Account.Notifications.FilterColumn"]"
                      PrevLabel="@L["Account.Notifications.Prev"]"
                      NextLabel="@L["Account.Notifications.Next"]"
                      FirstLabel="@L["Account.Notifications.Pager.First"]"
                      LastLabel="@L["Account.Notifications.Pager.Last"]"
                      PageSizeLabel="@L["Account.Notifications.Pager.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Account.Notifications.Loading"]"
                      FilterPlaceholder="@L["Account.Notifications.FilterPlaceholder"]"
                      ActionsHeader="@L["Account.Notifications.Column.Actions"]"
                      SelectAllLabel="@L["Account.Notifications.Action.SelectAll"]"
                      SelectRowLabel="@L["Account.Notifications.Action.SelectRow"]"
                      DetailsLabel="@L["Account.Notifications.Action.Details"]"
                      DeleteLabel="@L["Account.Notifications.Action.Delete"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="NotificationDto" Key="title"
                                    Header="@L["Account.Notifications.Column.Title"]">
                    <CellTemplate>
                        <strong>@TitleFor(context)</strong>
                        @if (context.ReadAt is null)
                        {
                            <SimfPill Variant="admin">@L["Account.Notifications.New"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="NotificationDto" Key="body"
                                    Header="@L["Account.Notifications.Column.Body"]">
                    <CellTemplate>@BodyFor(context)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="NotificationDto" Key="severity"
                                    Header="@L["Account.Notifications.Column.Severity"]">
                    <CellTemplate>@context.Severity</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="NotificationDto" Key="createdAt"
                                    Header="@L["Account.Notifications.Column.CreatedAt"]">
                    <CellTemplate>@context.CreatedAt.FormatSaudi()</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Account.Notifications.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>

        <div class="simf-form__actions">
            <SimfButton Type="button" Variant="secondary" OnClick="MarkAllReadAsync">
                @L["Account.Notifications.MarkAllRead"]
            </SimfButton>
        </div>
    </div>
</div>

@* The grid has no built-in confirmation, so dismissing a notification
   (single or bulk) would otherwise commit on the first click. *@
<SimfConfirm Open="@(_pendingDismiss is not null)"
             Danger="true"
             Title="@(_pendingDismiss?.Title ?? string.Empty)"
             Message="@(_pendingDismiss?.Message ?? string.Empty)"
             ConfirmLabel="@L["Account.Notifications.Action.Delete"]"
             CancelLabel="@L["Common.Cancel"]"
             OnConfirm="ConfirmDismissAsync"
             OnCancel="CancelDismiss" />

@if (_detailsTarget is not null)
{
    <SimfModal Open="true" Title="@L["Account.Notifications.Details.Title"]"
               OnClose="@(() => _detailsTarget = null)"
               CloseLabel="@L["Grid.Close"]">
        <ChildContent>
            <dl class="simf-dl">
                <dt>@L["Account.Notifications.Details.Field.Title"]</dt>
                <dd>@TitleFor(_detailsTarget)</dd>
                <dt>@L["Account.Notifications.Details.Field.Body"]</dt>
                <dd>@BodyFor(_detailsTarget)</dd>
                <dt>@L["Account.Notifications.Details.Field.Severity"]</dt>
                <dd>@_detailsTarget.Severity</dd>
                <dt>@L["Account.Notifications.Details.Field.CreatedAt"]</dt>
                <dd>@_detailsTarget.CreatedAt.FormatSaudi()</dd>
            </dl>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="@(() => _detailsTarget = null)">
                @L["Account.Notifications.Details.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
