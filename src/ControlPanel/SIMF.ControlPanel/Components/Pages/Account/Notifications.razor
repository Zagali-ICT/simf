@* CP — full notification list page (P12 — D-053, migrated to the canonical
   D-117 grid pattern in D-132). The bell links here via "View all".
   Mark-read on click, delete on the row action, bulk-dismiss via the
   toolbar checkbox + Delete. The "Mark all read" button stays outside
   the toolbar — it's a domain-specific bulk op (read, not delete). *@
@page "/account/notifications"
@layout CpShellLayout
@attribute [Authorize]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@L["Account.Notifications.Title"] · SIMF</PageTitle>

<SimfBanner Title="@L["Account.Notifications.Title"]" />

<div class="simf-page-wide">
    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="NotificationDto"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      Multiselect="true"
                      RowKey="@(r => r.Id.ToString())"
                      RowLabel="@(r => TitleFor(r))"
                      OnDetailsOne="OnDetailsAsync"
                      OnDeleteOne="OnDeleteAsync"
                      OnDeleteSelected="OnBulkDeleteAsync"
                      Caption="@L["Account.Notifications.Title"]"
                      FilterColumnLabel="@L["Account.Notifications.FilterColumn"]"
                      PrevLabel="@L["Account.Notifications.Prev"]"
                      NextLabel="@L["Account.Notifications.Next"]"
                      FirstLabel="@L["Account.Notifications.Pager.First"]"
                      LastLabel="@L["Account.Notifications.Pager.Last"]"
                      PageSizeLabel="@L["Account.Notifications.Pager.PageSize"]"
                      PageFormatter="@FormatPage"
                      LoadingLabel="@L["Account.Notifications.Loading"]"
                      FilterPlaceholder="@L["Account.Notifications.FilterPlaceholder"]"
                      ActionsHeader="@L["Account.Notifications.Column.Actions"]"
                      SelectAllLabel="@L["Account.Notifications.Action.SelectAll"]"
                      SelectRowLabel="@L["Account.Notifications.Action.SelectRow"]"
                      DetailsLabel="@L["Account.Notifications.Action.Details"]"
                      DeleteLabel="@L["Account.Notifications.Action.Delete"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="NotificationDto" Key="title"
                                    Header="@L["Account.Notifications.Column.Title"]">
                    <CellTemplate>
                        <strong>@TitleFor(context)</strong>
                        @if (context.ReadAt is null)
                        {
                            <SimfPill Variant="admin">@L["Account.Notifications.New"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="NotificationDto" Key="body"
                                    Header="@L["Account.Notifications.Column.Body"]">
                    <CellTemplate>@BodyFor(context)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="NotificationDto" Key="severity"
                                    Header="@L["Account.Notifications.Column.Severity"]">
                    <CellTemplate>@context.Severity</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="NotificationDto" Key="createdAt"
                                    Header="@L["Account.Notifications.Column.CreatedAt"]">
                    <CellTemplate>@context.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <SimfEmptyState Title="@L["Account.Notifications.None"]" />
            </EmptyTemplate>
        </SimfDataGrid>

        <div class="simf-form__actions">
            <SimfButton Type="button" Variant="secondary" OnClick="MarkAllReadAsync">
                @L["Account.Notifications.MarkAllRead"]
            </SimfButton>
        </div>
    </div>
</div>

@if (_detailsTarget is not null)
{
    <SimfModal Open="true" Title="@L["Account.Notifications.Details.Title"]"
               OnClose="@(() => _detailsTarget = null)">
        <ChildContent>
            <dl class="simf-dl">
                <dt>@L["Account.Notifications.Details.Field.Title"]</dt>
                <dd>@TitleFor(_detailsTarget)</dd>
                <dt>@L["Account.Notifications.Details.Field.Body"]</dt>
                <dd>@BodyFor(_detailsTarget)</dd>
                <dt>@L["Account.Notifications.Details.Field.Severity"]</dt>
                <dd>@_detailsTarget.Severity</dd>
                <dt>@L["Account.Notifications.Details.Field.CreatedAt"]</dt>
                <dd>@_detailsTarget.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" OnClick="@(() => _detailsTarget = null)">
                @L["Account.Notifications.Details.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}

@code {
    private record Toast(string Variant, string Message);

    private GridQuery _query = new() { Top = 25 };
    private GridPage<NotificationDto> _page = new();
    private bool _loading;
    private Toast? _toast;
    private NotificationDto? _detailsTarget;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnQueryChangedAsync(GridQuery next)
    {
        _query = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<GridPage<NotificationDto>>>(
                "simfAccount.postJson", "/account/api/notifications/list", _query);
            if (envelope is { Success: true, Data: not null })
            {
                _page = envelope.Data;
            }
        }
        finally { _loading = false; }
    }

    private Task OnDetailsAsync(NotificationDto row)
    {
        _detailsTarget = row;
        return Task.CompletedTask;
    }

    private async Task OnDeleteAsync(NotificationDto row)
    {
        await JS.InvokeAsync<ApiResult<bool>>(
            "simfAccount.deleteJson", $"/account/api/notifications/{row.Id}");
        await LoadAsync();
    }

    private async Task OnBulkDeleteAsync(IReadOnlyList<NotificationDto> rows)
    {
        // No bulk-dismiss endpoint exists yet; loop the per-row delete.
        // Latency is acceptable — selection caps at the visible page.
        foreach (var row in rows)
        {
            await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.deleteJson", $"/account/api/notifications/{row.Id}");
        }
        _toast = new Toast("success",
            string.Format(L["Account.Notifications.BulkDismissed"], rows.Count));
        await LoadAsync();
    }

    private async Task MarkAllReadAsync()
    {
        await JS.InvokeAsync<ApiResult<bool>>(
            "simfAccount.postJson", "/account/api/notifications/read-all", null);
        _toast = new Toast("success", L["Account.Notifications.MarkAllReadDone"]);
        await LoadAsync();
    }

    private string TitleFor(NotificationDto n) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
            ? n.TitleArabic : n.Title;

    private string BodyFor(NotificationDto n) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
            ? n.BodyArabic : n.Body;

    private string FormatSummary(int skip, int taken, int total) =>
        string.Format(L["Account.Notifications.Summary"],
            skip + 1, skip + taken, total);

    private string FormatPage(int current, int total) =>
        string.Format(L["Account.Notifications.Pager.Page"], current, total);
}
