@* Control Panel — the placeholder shown for a navigation module that has not
   been built yet. The feature modules arrive in their own increments. *@
@page "/m/{Module}"
@layout CpShellLayout
@attribute [Authorize]

<PageTitle>@PageTitle · SIMF</PageTitle>

<SimfPageHeader Title="@PageTitle" />

<div class="simf-panel">
    <h2 class="simf-panel__title">@L["Module.ComingSoon.Title"]</h2>
    <p class="simf-panel__text">@L["Module.ComingSoon.Text"]</p>
</div>
