@* Control Panel — the authenticated landing. This is a placeholder confirming
   the cookie sign-in works; the navigation shell replaces it next. *@
@page "/"
@rendermode AppRenderMode.InteractiveServerNoPrerender
@attribute [Authorize]

<PageTitle>SIMF Control Panel</PageTitle>

<SimfSignedInLanding Title="You're signed in"
                     Text="@_message">
    <form method="post" action="/auth/sign-out" data-enhance="false">
        <button type="submit" class="simf-button simf-button--secondary">Sign out</button>
    </form>
</SimfSignedInLanding>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _message = "The SIMF Control Panel shell is being prepared.";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            var name = user.Identity?.Name;
            if (!string.IsNullOrEmpty(name))
            {
                _message = $"Signed in as {name}. The SIMF Control Panel shell is being prepared.";
            }
        }
    }
}
