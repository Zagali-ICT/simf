@* Control Panel — forgot password. Requests a 6-digit reset code by email.
   The response is the same whether or not the account exists. *@
@page "/forgot-password"
@attribute [AllowAnonymous]
@inject IStringLocalizer<Strings> L
@inject SimfAuthClient Api
@inject SimfAuthSession Session
@inject NavigationManager Nav

<PageTitle>@L["Auth.PageTitle.Forgot"]</PageTitle>

<SimfAuthLayout>
    <Brand>
        <SimfBrandPanel AltText="@L["Brand.LogoAlt"]" Subtitle="@L["Brand.Subtitle"]" Caption="@L["Brand.Caption"]" />
    </Brand>
    <ChildContent>
        <SimfAuthCard Title="@L["Auth.Forgot.Title"]" SupportingText="@L["Auth.Forgot.Supporting"]">
            <TopControls>
                <SimfLanguageSwitch Href="@CultureHref" Label="@L["Auth.LanguageSwitch"]" />
                <SimfThemeToggle />
            </TopControls>
            <ChildContent>
                <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
                    @if (_error is not null)
                    {
                        <SimfAlert Variant="error">@_error</SimfAlert>
                    }
                    <div class="simf-form__fields">
                        <SimfTextField Label="@L["Auth.SignIn.Email"]" @bind-Value="_model.Email"
                                       Type="email" Icon="mail" InputMode="email"
                                       Autocomplete="username" Disabled="_loading" />
                    </div>
                    <div class="simf-form__actions">
                        <SimfButton Block="true" Loading="_loading" LoadingLabel="@L["Auth.Forgot.Submitting"]">
                            @L["Auth.Forgot.Submit"]
                        </SimfButton>
                    </div>
                    <div class="simf-form__secondary">
                        <SimfLink Href="/login">@L["Auth.Forgot.BackToSignIn"]</SimfLink>
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>@L["Auth.Footer"]</Footer>
        </SimfAuthCard>
    </ChildContent>
</SimfAuthLayout>

@code {
    private readonly EmailModel _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private bool _loading;
    private string? _error;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
        _messages = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += ClearFieldError;
    }

    private void ClearFieldError(object? sender, FieldChangedEventArgs e)
    {
        _messages.Clear(e.FieldIdentifier);
        _editContext.NotifyValidationStateChanged();
    }

    private string CultureHref
    {
        get
        {
            var next = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "en" : "ar";
            return $"/culture?culture={next}&redirectUri={Uri.EscapeDataString("/forgot-password")}";
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            _messages.Clear();

            if (string.IsNullOrWhiteSpace(_model.Email))
            {
                _messages.Add(_editContext.Field(nameof(EmailModel.Email)), L["Auth.SignIn.EmailRequired"]);
            }
            else if (!_model.Email.Contains('@', StringComparison.Ordinal))
            {
                _messages.Add(_editContext.Field(nameof(EmailModel.Email)), L["Auth.SignIn.EmailInvalid"]);
            }

            _editContext.NotifyValidationStateChanged();
            if (_editContext.GetValidationMessages().Any())
            {
                return;
            }

            var result = await Api.ForgotPasswordAsync(
                new ForgotPasswordRequest { Email = _model.Email });

            if (!result.Success)
            {
                _error = result.Error?.MessageForCurrentCulture() ?? L["Auth.Forgot.Fallback"];
                return;
            }

            // The API answers the same whether or not the account exists; the flow
            // always proceeds to the reset step.
            Session.PendingEmail = _model.Email;
            Nav.NavigateTo("/reset-password");
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class EmailModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
