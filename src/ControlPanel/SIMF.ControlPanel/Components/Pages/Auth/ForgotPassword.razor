@* Control Panel — forgot password. Requests a 6-digit reset code by email.
   The response is the same whether or not the account exists. *@
@page "/forgot-password"
@attribute [AllowAnonymous]

<PageTitle>@L["Auth.PageTitle.Forgot"]</PageTitle>

<SimfAuthLayout>
    <Brand>
        <SimfBrandPanel AltText="@L["Brand.LogoAlt"]" Subtitle="@L["Brand.Subtitle"]" Caption="@L["Brand.Caption"]" />
    </Brand>
    <ChildContent>
        <SimfAuthCard Title="@L["Auth.Forgot.Title"]" SupportingText="@L["Auth.Forgot.Supporting"]">
            <TopControls>
                <SimfLanguageSwitch Label="@L["Auth.LanguageSwitch"]" />
                <SimfThemeToggle />
            </TopControls>
            <ChildContent>
                <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
                    @if (_error is not null)
                    {
                        <SimfAlert Variant="error">@_error</SimfAlert>
                    }
                    <div class="simf-form__fields">
                        <SimfTextField Label="@L["Auth.SignIn.Email"]" @bind-Value="_model.Email"
                                       Type="email" Icon="mail" InputMode="email"
                                       Autocomplete="username" Disabled="_loading" />
                    </div>
                    <div class="simf-form__actions">
                        <SimfButton Block="true" Loading="_loading" LoadingLabel="@L["Auth.Forgot.Submitting"]">
                            @L["Auth.Forgot.Submit"]
                        </SimfButton>
                    </div>
                    <div class="simf-form__secondary">
                        <SimfLink Href="/login">@L["Auth.Forgot.BackToSignIn"]</SimfLink>
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>@L["Auth.Footer"]</Footer>
        </SimfAuthCard>
    </ChildContent>
</SimfAuthLayout>
