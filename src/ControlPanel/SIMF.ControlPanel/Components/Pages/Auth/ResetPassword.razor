@* Control Panel — reset password. Takes the emailed 6-digit code and a new
   password; on success the card swaps to a confirmation. *@
@page "/reset-password"
@attribute [AllowAnonymous]

<PageTitle>@L["Auth.PageTitle.Reset"]</PageTitle>

<SimfAuthLayout>
    <Brand>
        <SimfBrandPanel AltText="@L["Brand.LogoAlt"]" Subtitle="@L["Brand.Subtitle"]" Caption="@L["Brand.Caption"]" />
    </Brand>
    <ChildContent>
        <SimfAuthCard Title="@(_done ? L["Auth.Reset.Done.Title"] : L["Auth.Reset.Title"])"
                      SupportingText="@(_done ? null : L["Auth.Reset.Supporting"].Value)">
            <TopControls>
                <SimfLanguageSwitch Label="@L["Auth.LanguageSwitch"]" />
                <SimfThemeToggle />
            </TopControls>
            <ChildContent>
                @if (_done)
                {
                    <div class="simf-confirm">
                        <SimfIcon Name="check-circle" Size="32" Class="simf-confirm__icon" />
                        <h2 class="simf-confirm__title">@L["Auth.Reset.Done.Title"]</h2>
                        <p class="simf-confirm__text">@L["Auth.Reset.Done.Text"]</p>
                        <div class="simf-confirm__action">
                            <SimfButton Type="button" OnClick="GoToSignIn">@L["Auth.Reset.Done.SignIn"]</SimfButton>
                        </div>
                    </div>
                }
                else
                {
                    <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
                        @if (_error is not null)
                        {
                            <SimfAlert Variant="error">@_error</SimfAlert>
                        }
                        else if (Session.PendingEmail is not null)
                        {
                            <SimfAlert Variant="info">
                                @string.Format(L["Auth.Reset.CodeSentTo"], SimfAuthSession.MaskEmail(Session.PendingEmail))
                            </SimfAlert>
                        }
                        <div class="simf-form__fields">
                            <SimfTextField Label="@L["Auth.SignIn.Email"]" @bind-Value="_model.Email"
                                           Type="email" Icon="mail" InputMode="email"
                                           Autocomplete="username" Disabled="_loading" />
                            <SimfCodeField Label="@L["Auth.Reset.Code"]" @bind-Value="_model.Code"
                                           Helper="@L["Auth.Totp.CodeFormat"]" Disabled="_loading" />
                            <SimfPasswordField Label="@L["Auth.Reset.NewPassword"]" @bind-Value="_model.NewPassword"
                                               Autocomplete="new-password" Disabled="_loading"
                                               Helper="@L["Auth.Reset.PasswordHelper"]" />
                            <SimfPasswordField Label="@L["Auth.Reset.ConfirmPassword"]" @bind-Value="_model.ConfirmPassword"
                                               Autocomplete="new-password" Disabled="_loading" />
                        </div>
                        <div class="simf-form__actions">
                            <SimfButton Block="true" Loading="_loading" LoadingLabel="@L["Auth.Reset.Submitting"]">
                                @L["Auth.Reset.Submit"]
                            </SimfButton>
                        </div>
                        <div class="simf-form__secondary">
                            <SimfLink Href="/login">@L["Auth.Forgot.BackToSignIn"]</SimfLink>
                        </div>
                    </EditForm>
                }
            </ChildContent>
            <Footer>@L["Auth.Footer"]</Footer>
        </SimfAuthCard>
    </ChildContent>
</SimfAuthLayout>
