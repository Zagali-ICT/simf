@* Control Panel — recovery-code fallback for sign-in. The
   user reaches this page from the TOTP step's "Use a recovery code" link.
   Same MFA-token ticket and same cookie hand-off as the TOTP step. *@
@page "/login/recovery"
@attribute [AllowAnonymous]

<PageTitle>@L["Auth.PageTitle.RecoveryCode"]</PageTitle>

@if (Session.PendingMfaToken is not null)
{
    <SimfAuthLayout>
        <Brand>
            <SimfBrandPanel AltText="@L["Brand.LogoAlt"]" Subtitle="@L["Brand.Subtitle"]" Caption="@L["Brand.Caption"]" />
        </Brand>
        <ChildContent>
            <SimfAuthCard Title="@L["Auth.RecoveryCode.Title"]"
                          SupportingText="@L["Auth.RecoveryCode.Supporting"]">
                <TopControls>
                    <SimfLanguageSwitch Label="@L["Auth.LanguageSwitch"]" />
                    <SimfThemeToggle LightLabel='@L["Shell.ThemeLight"]' DarkLabel='@L["Shell.ThemeDark"]' AriaLabel='@L["Shell.ThemeSwitch"]' />
                </TopControls>
                <ChildContent>
                    <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
                        @if (_error is not null)
                        {
                            <SimfAlert Variant="error">@_error</SimfAlert>
                        }
                        <div class="simf-form__fields">
                            <SimfTextField Label="@L["Auth.RecoveryCode.Label"]"
                                           @bind-Value="_model.Code"
                                           Helper="@L["Auth.RecoveryCode.Hint"]"
                                           Autocomplete="one-time-code"
                                           Disabled="_loading" />
                        </div>
                        <div class="simf-form__actions">
                            <SimfButton Block="true" Loading="_loading"
                                        LoadingLabel="@L["Auth.RecoveryCode.Submitting"]">
                                @L["Auth.RecoveryCode.Submit"]
                            </SimfButton>
                        </div>
                        <div class="simf-form__secondary">
                            <SimfLink Href="/login/totp">@L["Auth.RecoveryCode.BackToTotp"]</SimfLink>
                            <SimfLink Href="/login">@L["Auth.Totp.BackToSignIn"]</SimfLink>
                        </div>
                    </EditForm>
                </ChildContent>
                <Footer>@L["Auth.Footer"]</Footer>
            </SimfAuthCard>
        </ChildContent>
    </SimfAuthLayout>
}
