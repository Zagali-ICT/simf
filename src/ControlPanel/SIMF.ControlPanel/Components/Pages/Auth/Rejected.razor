@* Control Panel — rejected state-banner page. Reached
   when an authenticated user's account_state cookie claim is Rejected.
   Reads the bilingual rejection reason from the cookie claims and
   shows it in the user's culture. *@
@page "/auth/rejected"
@layout MainLayout
@attribute [Authorize]

<PageTitle>@L["Auth.Rejected.Title"] · SIMF</PageTitle>

<main class="simf-auth-state" aria-labelledby="auth-rejected-title">
    <section class="simf-card simf-page-card">
        <h1 id="auth-rejected-title" class="simf-card__title">@L["Auth.Rejected.Title"]</h1>

        @if (!string.IsNullOrEmpty(_reason))
        {
            <p class="simf-card__supporting"><strong>@L["Auth.Rejected.Reason"]:</strong></p>
            <SimfAlert Variant="error">@_reason</SimfAlert>
        }
        else
        {
            <SimfAlert Variant="warning">@L["Auth.Rejected.NoReasonProvided"]</SimfAlert>
        }

        <p class="simf-card__supporting">@L["Auth.Rejected.ContactSupport"]</p>

        <form method="post" action="/auth/sign-out" class="simf-form__actions">
            <SimfButton Type="submit" Variant="primary">
                @L["Auth.Rejected.SignOut"]
            </SimfButton>
        </form>
    </section>
</main>
