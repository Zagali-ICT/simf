@* Control Panel — sign-in (the password step). On success the account holds a
   Control Panel role, so the second factor is an authenticator TOTP code —
   unless TwoFactorEnabled is false on the account, in which case the API
   returns the tokens directly. *@
@page "/login"
@attribute [AllowAnonymous]

<PageTitle>@L["Auth.PageTitle.SignIn"]</PageTitle>

<SimfAuthLayout>
    <Brand>
        <SimfBrandPanel AltText="@L["Brand.LogoAlt"]" Subtitle="@L["Brand.Subtitle"]" Caption="@L["Brand.Caption"]" />
    </Brand>
    <ChildContent>
        <SimfAuthCard Title="@L["Auth.SignIn.Title"]" SupportingText="@L["Auth.SignIn.Supporting"]">
            <TopControls>
                <SimfLanguageSwitch Label="@L["Auth.LanguageSwitch"]" />
                <SimfThemeToggle LightLabel="@L["Shell.ThemeLight"]" DarkLabel="@L["Shell.ThemeDark"]" />
            </TopControls>
            <ChildContent>
                <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
                    @if (_error is not null)
                    {
                        <SimfAlert Variant="error">@_error</SimfAlert>
                    }
                    @if (_info is not null)
                    {
                        <SimfAlert Variant="success">@_info</SimfAlert>
                    }
                    <div class="simf-form__fields">
                        <SimfTextField Label="@L["Auth.SignIn.Email"]" @bind-Value="_model.Email"
                                       Type="email" Icon="mail" InputMode="email"
                                       Autocomplete="username" Disabled="_loading" />
                        <SimfPasswordField Label="@L["Auth.SignIn.Password"]" @bind-Value="_model.Password"
                                           Autocomplete="current-password" Disabled="_loading" />
                    </div>
                    <SimfLink Href="/forgot-password" Block="true">@L["Auth.SignIn.ForgotLink"]</SimfLink>
                    <div class="simf-form__actions">
                        <SimfButton Block="true" Loading="_loading" LoadingLabel="@L["Auth.SignIn.Submitting"]">
                            @L["Auth.SignIn.Submit"]
                        </SimfButton>
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>@L["Auth.Footer"]</Footer>
        </SimfAuthCard>
    </ChildContent>
</SimfAuthLayout>

@* D-206: forced-change popup. A Control Panel sign-in whose credential is
   flagged for change comes back with a single-use ticket instead of a session;
   the operator sets a new password here (current password not re-asked — the
   ticket already proves it) and then signs in normally. *@
<SimfModal Open="_mustChangePassword" Title="@L["Auth.ChangePassword.Title"]"
           CloseLabel="@L["Auth.ChangePassword.Close"]" OnClose="CloseChangePassword">
    <p class="simf-form__helper">@L["Auth.ChangePassword.Intro"]</p>
    <ChangePasswordCard ShowCurrentField="false" Block="true" Busy="_changeBusy"
                        ErrorMessage="@_changeError" SubmitLabel="@L["Auth.ChangePassword.Submit"]"
                        OnSubmit="CompletePasswordChangeAsync" />
</SimfModal>
