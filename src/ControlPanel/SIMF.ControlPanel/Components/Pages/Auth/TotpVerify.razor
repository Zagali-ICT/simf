@* Control Panel — the second factor: a 6-digit code from the user's
   authenticator app. Reached only from the sign-in step when the account
   has TwoFactorEnabled=true. *@
@page "/login/totp"
@attribute [AllowAnonymous]

<PageTitle>@L["Auth.PageTitle.Totp"]</PageTitle>

@if (Session.PendingMfaToken is not null)
{
    <SimfAuthLayout>
        <Brand>
            <SimfBrandPanel AltText="@L["Brand.LogoAlt"]" Subtitle="@L["Brand.Subtitle"]" Caption="@L["Brand.Caption"]" />
        </Brand>
        <ChildContent>
            <SimfAuthCard Title="@L["Auth.Totp.Title"]" SupportingText="@L["Auth.Totp.Supporting"]">
                <TopControls>
                    <SimfLanguageSwitch Label="@L["Auth.LanguageSwitch"]" />
                    <SimfThemeToggle />
                </TopControls>
                <ChildContent>
                    <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
                        @if (_error is not null)
                        {
                            <SimfAlert Variant="error">@_error</SimfAlert>
                        }
                        <div class="simf-form__fields">
                            <SimfCodeField Label="@L["Auth.Totp.Code"]" @bind-Value="_model.Code"
                                           Helper="@L["Auth.Totp.CodeFormat"]" Disabled="_loading" />
                        </div>
                        <div class="simf-form__actions">
                            <SimfButton Block="true" Loading="_loading" LoadingLabel="@L["Auth.Totp.Submitting"]">
                                @L["Auth.Totp.Submit"]
                            </SimfButton>
                        </div>
                        <div class="simf-form__secondary">
                            <SimfLink Href="/login/recovery">@L["Auth.Totp.UseRecoveryCode"]</SimfLink>
                            <SimfLink Href="/login">@L["Auth.Totp.BackToSignIn"]</SimfLink>
                        </div>
                    </EditForm>
                </ChildContent>
                <Footer>@L["Auth.Footer"]</Footer>
            </SimfAuthCard>
        </ChildContent>
    </SimfAuthLayout>
}
