@* Control Panel — pending-approval state-banner page.
   Reached when an authenticated user's account_state cookie claim is
   PendingApproval. Reads the claim, shows a clear message + sign-out
   button. Uses MainLayout (not CpShellLayout) so the layout guard does
   not redirect the user back here in a loop. *@
@page "/auth/pending"
@layout MainLayout
@attribute [Authorize]

<PageTitle>@L["Auth.Pending.Title"] · SIMF</PageTitle>

<main class="simf-auth-state" aria-labelledby="auth-pending-title">
    <section class="simf-card simf-page-card">
        <h1 id="auth-pending-title" class="simf-card__title">@L["Auth.Pending.Title"]</h1>
        <p class="simf-card__supporting">@L["Auth.Pending.Supporting"]</p>
        @if (!string.IsNullOrEmpty(_email))
        {
            <p class="simf-card__supporting"><strong>@L["Auth.Pending.AccountEmail"]:</strong> @_email</p>
        }

        <form method="post" action="/auth/sign-out" class="simf-form__actions">
            <SimfButton Type="submit" Variant="primary">
                @L["Auth.Pending.SignOut"]
            </SimfButton>
        </form>
    </section>
</main>
