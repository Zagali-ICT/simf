@* D-206: shared change-password form. Used by the Profile page (with the
   current-password field) and by the forced-change sign-in popup (without it —
   the sign-in ticket already proved the current password). The host owns the
   API call, so this component stays endpoint-agnostic. *@
@inject IStringLocalizer<Strings> L

@if (ErrorMessage is not null)
{
    <SimfAlert Variant="error">@ErrorMessage</SimfAlert>
}
<EditForm Model="_model" OnSubmit="SubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        @if (ShowCurrentField)
        {
            <SimfPasswordField Label="@L["Profile.Password.Current"]"
                               @bind-Value="_model.CurrentPassword"
                               Autocomplete="current-password" Disabled="Busy" />
        }
        <SimfPasswordField Label="@L["Profile.Password.New"]"
                           @bind-Value="_model.NewPassword"
                           Autocomplete="new-password" Disabled="Busy" />
        <SimfPasswordField Label="@L["Profile.Password.Confirm"]"
                           @bind-Value="_model.ConfirmPassword"
                           Autocomplete="new-password" Disabled="Busy" />
    </div>
    <div class="simf-form__actions">
        <SimfButton Block="Block" Loading="Busy" LoadingLabel="@L["Profile.Password.Submit"]">
            @(SubmitLabel ?? L["Profile.Password.Submit"])
        </SimfButton>
    </div>
</EditForm>

@code {
    private readonly Model _model = new();

    /// <summary>Show the current-password field (Profile = true; forced-change popup = false).</summary>
    [Parameter] public bool ShowCurrentField { get; set; } = true;

    /// <summary>Disables the fields and shows the submit spinner while the host posts.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Server-side error to surface above the form; null hides the alert.</summary>
    [Parameter] public string? ErrorMessage { get; set; }

    /// <summary>Optional submit-button label; defaults to the Profile change label.</summary>
    [Parameter] public string? SubmitLabel { get; set; }

    /// <summary>Render the submit button full-width (used in the popup).</summary>
    [Parameter] public bool Block { get; set; }

    /// <summary>Raised with the entered values; the host performs the API call.</summary>
    [Parameter] public EventCallback<Model> OnSubmit { get; set; }

    private Task SubmitAsync() => OnSubmit.InvokeAsync(_model);

    /// <summary>The values the host needs to build its request.</summary>
    public sealed class Model
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
