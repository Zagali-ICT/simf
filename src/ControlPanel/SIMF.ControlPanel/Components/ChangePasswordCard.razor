@* D-206: shared change-password form. Used by the Profile page (with the
   current-password field) and by the forced-change sign-in popup (without it —
   the sign-in ticket already proved the current password). The host owns the
   API call, so this component stays endpoint-agnostic. *@

@if (ErrorMessage is not null)
{
    <SimfAlert Variant="error">@ErrorMessage</SimfAlert>
}
<EditForm Model="_model" OnSubmit="SubmitAsync" class="simf-form">
    <div class="simf-form__fields">
        @if (ShowCurrentField)
        {
            <SimfPasswordField Label="@L["Profile.Password.Current"]"
                               @bind-Value="_model.CurrentPassword"
                               Autocomplete="current-password" Disabled="Busy" />
        }
        <SimfPasswordField Label="@L["Profile.Password.New"]"
                           @bind-Value="_model.NewPassword"
                           Autocomplete="new-password" Disabled="Busy" />
        <SimfPasswordField Label="@L["Profile.Password.Confirm"]"
                           @bind-Value="_model.ConfirmPassword"
                           Autocomplete="new-password" Disabled="Busy" />
    </div>
    <div class="simf-form__actions">
        <SimfButton Block="Block" Loading="Busy" LoadingLabel="@L["Profile.Password.Submit"]">
            @(SubmitLabel ?? L["Profile.Password.Submit"])
        </SimfButton>
    </div>
</EditForm>
