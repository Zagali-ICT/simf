@* CpShellLayout — the Control Panel application shell: top bar, side
   navigation and content region. Used by every signed-in Control Panel page. *@
@inherits LayoutComponentBase
@layout MainLayout
@implements IDisposable

<SimfAppShell ToggleNavLabel='@L["Shell.ToggleNav"]'
              NavLabel='@L["Shell.AppName"]'
              SkipNavLabel='@L["Shell.SkipToMain"]'>
    <Brand>
        <SimfWordmark />
    </Brand>
    <Controls>
        <SimfLanguageSwitch Label='@L["Shell.SwitchLanguage"]' />
        <SimfThemeToggle LightLabel='@L["Shell.ThemeLight"]' DarkLabel='@L["Shell.ThemeDark"]' AriaLabel='@L["Shell.ThemeSwitch"]' />
        <AuthorizeView>
            <SimfNotificationBell @ref="_bell"
                AriaLabel='@L["Shell.Notifications"]'
                UnreadSuffixLabel='@L["Account.Notifications.UnreadSuffix"]'
                DropdownTitle='@L["Shell.Notifications"]'
                MarkAllReadLabel='@L["Account.Notifications.MarkAllRead"]'
                EmptyLabel='@L["Account.Notifications.Empty"]'
                ViewAllLabel='@L["Account.Notifications.ViewAll"]'
                ViewAllHref="/account/notifications"
                UseArabic="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar")" />
            <a class="simf-user" href="/account/profile" title="@L["Shell.MyProfile"]">
                @if (!string.IsNullOrEmpty(UserChrome.AvatarUrl))
                {
                    <img class="simf-user__avatar" src="@UserChrome.AvatarUrl" alt="" />
                }
                else
                {
                    <SimfIcon Name="user" Class="simf-user__icon" Size="18" />
                }
                <span>@context.User.Identity?.Name</span>
            </a>
        </AuthorizeView>
        <form method="post" action="/auth/sign-out" data-enhance="false">
            <button type="submit" class="simf-button simf-button--secondary">@L["Shell.SignOut"]</button>
        </form>
    </Controls>
    <SideNav>
        <div class="simf-nav-search">
            <SimfIcon Name="search" Class="simf-nav-search__icon" Size="16" />
            <input type="search" class="simf-nav-search__input"
                   placeholder="@L["Shell.NavSearchPlaceholder"]"
                   aria-label="@L["Shell.NavSearch"]"
                   @bind="_navFilter" @bind:event="oninput" />
        </div>
        @{
            var anyMatch = false;
        }
        @foreach (var group in CpNavigation.Groups)
        {
            var permitted = group.Items.Where(CanSee).ToList();
            // A group whose own label matches the filter shows all its (permitted)
            // items; otherwise only the items whose label matches.
            var visibleItems = GroupLabelMatches(group) ? permitted
                : permitted.Where(MatchesFilter).ToList();
            if (visibleItems.Count > 0)
            {
                anyMatch = true;
                <SimfNavGroup Label='@L[group.LabelKey]'>
                    @foreach (var item in visibleItems)
                    {
                        <SimfNavItem Href="@item.Href"
                                     Label='@L[item.LabelKey]'
                                     Icon="@item.Icon"
                                     BadgeLabel='@(item.IsStub ? L["Nav.Soon"].Value : null)' />
                    }
                </SimfNavGroup>
            }
        }
        @if (!anyMatch)
        {
            <p class="simf-nav-search__empty">@L["Shell.NavSearchEmpty"]</p>
        }
    </SideNav>
    <ChildContent>
        <CascadingValue Name="BellRefresh" Value="@(new Func<Task>(RefreshBellAsync))">
            @Body
        </CascadingValue>
    </ChildContent>
</SimfAppShell>

@* D-443 — token-driven session-expiry guard (signed-in shell only). *@
<SessionTimeoutGuard />

@* Floating Control Panel help assistant — visible to any operator holding
   Assistant.Use; renders nothing otherwise. Rendered once here so every
   signed-in CP page carries it. *@
<CpAssistantWidget />
