@* D-356 — reusable Excel export/import bar for any CRUD grid. The page wires
   its SimfDataGrid OnExport/OnImport to this component's ExportAsync /
   TriggerImportAsync (via @ref); the component owns the hidden .xlsx file input
   and the import-result modal and talks to the generic
   /account/api/admin/{Resource}/export|import BFF routes (which forward to the
   API's generic grid endpoints). One component for every resource — the only
   per-page input is the Resource slug. *@
@using SIMF.Common
@using SIMF.Contracts.Admin

<input type="file" id="@InputId" accept=".xlsx" class="simf-hidden-input"
       aria-label="@L["Grid.Import.Picker"]" @onchange="OnFileSelectedAsync" />

@if (_result is not null)
{
    <SimfModal Open="true" Title="@L["Grid.Import.ResultTitle"]" OnClose="CloseResult">
        <ChildContent>
            <p>@string.Format(L["Grid.Import.ResultBody"],
                _result.Created, _result.Updated, _result.Skipped)</p>
            @if (_result.Errors.Count > 0)
            {
                <ul class="simf-import-errors">
                    @foreach (var error in _result.Errors)
                    {
                        <li>@string.Format(L["Grid.Import.RowError"],
                            error.Row, error.Key ?? string.Empty, error.Reason)</li>
                    }
                </ul>
            }
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary" OnClick="CloseResult">
                @L["Grid.Import.Close"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
