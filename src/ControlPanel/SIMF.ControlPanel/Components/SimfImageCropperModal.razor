@* SimfImageCropperModal — image cropper modal (D-116). Ports the V10 ERP
   UserLogoCropperDialog cropping ALGORITHM byte-for-byte (same Options,
   same 400×400 PNG output via GetCroppedCanvasDataInBackgroundAsync), but
   replaces the MudBlazor dialog shell with SimfModal + SimfButton +
   SimfSpinner and moves all styles into simf-components.css using theme
   tokens (CLAUDE.md §8 — no inline styles, no hex).

   Lives in SIMF.ControlPanel for now because CP is the only consumer
   today. Move to SIMF.Components when a second project needs it; the
   public component contract is already reusable. *@
@using Cropper.Blazor.Components
@using Cropper.Blazor.Models
@using Microsoft.Extensions.Logging

@if (Open)
{
    <SimfModal Open="true" RequireExplicitClose="true" Title="@(Title ?? L["Crop.Title"])" OnClose="OnCancelInternal">
        <ChildContent>
            <div class="simf-cropper">
                <CropperComponent @ref="_cropper"
                                  Src="@ImageUrl"
                                  Options="_options"
                                  Class="simf-cropper__element" />
            </div>
        </ChildContent>
        <Footer>
            <SimfButton Type="button" Variant="secondary"
                        Disabled="_submitting"
                        OnClick="OnCancelInternal">
                @L["Crop.Cancel"]
            </SimfButton>
            <SimfButton Type="button" Variant="primary"
                        Loading="_submitting"
                        LoadingLabel="@L["Crop.Processing"]"
                        OnClick="OnSubmitInternal">
                @L["Crop.Submit"]
            </SimfButton>
        </Footer>
    </SimfModal>
}
