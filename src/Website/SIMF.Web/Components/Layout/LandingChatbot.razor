@* LandingChatbot — public floating help assistant. A lighthouse launcher opens a
   chat panel; questions post to the same-origin /chat/ask BFF proxy, which asks the
   anonymous FAQ assistant (grounded on the forum FAQ) and returns the answer.
   Progressive JS only (initChatbot in landing.js) — no Blazor circuit, so it adds
   no per-visitor cost to the SSR public pages. Bilingual inline (AR/EN) off the
   request culture. *@
@{
    var chatRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}

<div class="ln-chat" id="ln-chat">
    <div class="ln-chat__panel" id="ln-chat-panel" role="dialog" aria-modal="false"
         aria-label="@(chatRtl ? "مساعد الملتقى" : "Forum assistant")" hidden>
        <header class="ln-chat__head">
            <span class="ln-chat__head-mark" aria-hidden="true">
                <svg class="ln-chat__lh" viewBox="0 0 40 40" fill="none">
                    <path d="M13 12l-3.5-2M27 12l3.5-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M20 6v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <rect x="16" y="9" width="8" height="5" rx="1" stroke="currentColor" stroke-width="1.5" />
                    <path d="M17 14l-2.5 18h11L23 14" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                    <path d="M16.6 22h6.8M15.9 27.5h8.2" stroke="currentColor" stroke-width="1.3" />
                    <path d="M14 32h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
            </span>
            <span class="ln-chat__title">@(chatRtl ? "مساعد الملتقى" : "Forum assistant")</span>
            <button type="button" class="ln-chat__close" id="ln-chat-close"
                    aria-label="@(chatRtl ? "إغلاق" : "Close")">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            </button>
        </header>
        <div class="ln-chat__log" id="ln-chat-log" aria-live="polite">
            <div class="ln-chat__msg ln-chat__msg--ai">
                @(chatRtl
                    ? "مرحباً 👋 أنا مساعد الملتقى البحري. اسألني عن البرنامج أو المتحدثين أو التسجيل."
                    : "Hi 👋 I'm the maritime forum assistant. Ask me about the programme, speakers or registration.")
            </div>
        </div>
        <form class="ln-chat__composer" id="ln-chat-form">
            <input type="text" class="ln-chat__input" id="ln-chat-input" autocomplete="off"
                   placeholder="@(chatRtl ? "اكتب سؤالك…" : "Type your question…")"
                   aria-label="@(chatRtl ? "اكتب سؤالك" : "Type your question")" />
            <button type="submit" class="ln-chat__send" aria-label="@(chatRtl ? "إرسال" : "Send")">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12l16-8-6 8 6 8-16-8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
            </button>
        </form>
    </div>

    <button type="button" class="ln-chat__launcher" id="ln-chat-launcher"
            aria-expanded="false" aria-controls="ln-chat-panel"
            aria-label="@(chatRtl ? "افتح مساعد الملتقى" : "Open the forum assistant")">
        <span class="ln-chat__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M5 5h14a2 2 0 012 2v7a2 2 0 01-2 2h-8l-4 3v-3H5a2 2 0 01-2-2V7a2 2 0 012-2z" fill="currentColor" /><path d="M8 9.5h8M8 12.5h5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" /></svg>
        </span>
        <span class="ln-chat__mark" aria-hidden="true">
            <svg class="ln-chat__lh" viewBox="0 0 40 40" fill="none">
                <path d="M13 12l-3.5-2M27 12l3.5-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                <path d="M20 6v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                <rect x="16" y="9" width="8" height="5" rx="1" stroke="currentColor" stroke-width="1.5" />
                <path d="M17 14l-2.5 18h11L23 14" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M16.6 22h6.8M15.9 27.5h8.2" stroke="currentColor" stroke-width="1.3" />
                <path d="M14 32h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
        </span>
    </button>
</div>
