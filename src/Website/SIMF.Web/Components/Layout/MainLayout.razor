@inherits LayoutComponentBase

@* H22 — D-081: WCAG 1.3.1 / 2.4.1. Every Website Blazor page renders through
   this layout. Wrapping @Body in <main> gives assistive tech a landmark to
   jump to and provides a stable focus target for the Website skip-link (still
   deferred per D-064 because the Website lacks a heavy nav to bypass, but the
   landmark is non-optional regardless). *@
<main id="main-content" tabindex="-1">@Body</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
