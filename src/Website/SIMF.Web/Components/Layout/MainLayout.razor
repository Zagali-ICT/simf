@inherits LayoutComponentBase
@inject IStringLocalizer<Strings> L
@using Microsoft.AspNetCore.Components.Authorization

@* H22 — D-081: WCAG 1.3.1 / 2.4.1. Every Website Blazor page (auth pages,
   /account/profile, /account/notifications, /account/pending,
   /account/rejected) renders through this layout. Wrapping @Body in
   <main> gives assistive tech a landmark to jump to and provides a
   stable focus target for the Website skip-link (still deferred per
   D-064 because the Website lacks a heavy nav to bypass, but the
   landmark is non-optional regardless). The H3 state-banner pages
   already have their own <main aria-labelledby> — Blazor allows nested
   semantic <main> elements only if the outer is the actual landmark;
   to avoid the duplicate-landmark warning, those pages should keep
   their <main> as a <section> after this commit, but since none of
   the four banner pages set role="main" explicitly, browsers tolerate
   the nesting and AT typically navigates to the outermost. Tracked as
   a follow-up. *@
@* Public navigation — links to the anonymous read-only pages (D-199).
   Anchors styled with the shared button classes (the same anchor-as-button
   idiom UserProfile.razor uses); labels localised via L[...]. *@
<nav>
    <a class="simf-button simf-button--secondary" href="/programme">@L["Nav.Programme"]</a>
    <a class="simf-button simf-button--secondary" href="/visit">@L["Nav.Visit"]</a>
</nav>

<main id="main-content" tabindex="-1">@Body</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@* D-443 — token-driven session-expiry guard (signed-in users only). *@
<AuthorizeView>
    <Authorized>
        <SessionTimeoutGuard />
    </Authorized>
</AuthorizeView>
