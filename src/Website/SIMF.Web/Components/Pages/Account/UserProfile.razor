@* User self-service profile — assembles the D-044(c) Simf* primitives
   on top of the D-046(b) backend, renamed in P8 (D-049) from
   /account/visitor-profile to /account/profile. Closes myComment #18
   end-to-end: the user signs in, lands here, fills the form, uploads
   their ID, sees the QR code their account was minted with on Approval
   (D-046 a). The legacy "I am attending as" radio (Visitor / Exhibitor
   / Press) is gone in P8 — the profile-type now flows through
   ProfileTypeId, admin-assigned. *@
@page "/account/profile"
@rendermode AppRenderMode.InteractiveServerNoPrerender
@attribute [Authorize]
@implements IDisposable

<PageTitle>@L["Account.Profile.Title"]</PageTitle>

<div class="simf-account-page">
    <header class="simf-account-page__head">
        <h1 class="simf-account-page__title">@L["Account.Profile.Title"]</h1>
        @* D-132 — surface a link to the notifications inbox so the page
           is reachable from the main post-login surface (it was orphan
           — reachable only by typing the URL). *@
        <div class="simf-account-page__actions">
            <a class="simf-button simf-button--secondary"
               href="/account/notifications">@L["Account.Notifications.Title"]</a>
            <SimfButton Type="button" Variant="secondary"
                        OnClick="SignOutAsync">@L["Account.Profile.SignOut"]</SimfButton>
        </div>
    </header>

    @if (_loadError is not null)
    {
        <SimfAlert Variant="error">@_loadError</SimfAlert>
    }
    else if (_response is null)
    {
        <SimfAlert Variant="info">@L["Account.Profile.Loading"]</SimfAlert>
    }
    else
    {
        @* Saved-state notice. *@
        @if (_saveSuccess)
        {
            <SimfAlert Variant="success">@L["Account.Profile.Saved"]</SimfAlert>
        }
        @if (_saveError is not null)
        {
            <SimfAlert Variant="error">@_saveError</SimfAlert>
        }

        @* QR card. *@
        <section class="simf-card simf-page-card simf-qr-card">
            <h2 class="simf-card__title">@L["Account.Profile.QrTitle"]</h2>
            @if (!string.IsNullOrEmpty(_response.QrId))
            {
                <p class="simf-card__supporting">@L["Account.Profile.QrSupporting"]</p>
                <div class="simf-qr">@((MarkupString)_qrSvg)</div>
                <p class="simf-totp-secret">@_response.QrId</p>
            }
            else
            {
                <SimfAlert Variant="info">@L["Account.Profile.QrPending"]</SimfAlert>
            }
        </section>

        @* Form. *@
        <section class="simf-card simf-page-card">
            <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
                <div class="simf-form__fields">
                    <SimfTextField Label="@L["Account.Profile.ArabicName"]"
                                   MaxLength="100"
                                   @bind-Value="_model.ArabicName"
                                   Disabled="_saving" />

                    <SimfTextField Label="@L["Account.Profile.EnglishName"]"
                                   MaxLength="100"
                                   @bind-Value="_model.EnglishName"
                                   Helper="@L["Account.Profile.EnglishNameHint"]"
                                   Disabled="_saving" />

                    @* D-163 (PDF §2.6) — optional job title, max 100 (owner 2026-07-06). *@
                    <SimfTextField Label="@L["Account.Profile.JobTitle"]"
                                   Helper="@L["Account.Profile.JobTitleHint"]"
                                   MaxLength="100"
                                   Value="@(_model.JobTitle ?? string.Empty)"
                                   ValueChanged="@(v => _model.JobTitle = string.IsNullOrWhiteSpace(v) ? null : v)"
                                   ValueExpression="@(() => _model.JobTitle)"
                                   Disabled="_saving" />

                    @* B3 — D-221 (الجهة): required organisation typeahead via a
                       native datalist (no custom CSS — Web centralises styling
                       in the theme; datalist needs none). *@
                    <div class="simf-field @(_orgError is not null ? "simf-field--error" : null)">
                        <label class="simf-field__label" for="profile-org">
                            @L["Account.Profile.Organisation"]
                        </label>
                        <div class="simf-field__control">
                            <input id="profile-org" class="simf-field__input"
                                   list="profile-org-list" autocomplete="off"
                                   placeholder="@L["Account.Profile.OrganisationSearch"]"
                                   value="@_orgSearch"
                                   @oninput="OnOrgInputAsync" @onchange="OnOrgCommitted"
                                   disabled="@_saving"
                                   aria-invalid="@(_orgError is not null ? "true" : null)" />
                            <datalist id="profile-org-list">
                                @foreach (var o in _orgResults)
                                {
                                    <option value="@OrgLabel(o)"></option>
                                }
                            </datalist>
                        </div>
                        @if (_orgError is not null)
                        {
                            <p class="simf-field__error" role="alert">
                                <SimfIcon Name="alert" Size="14" Class="simf-field__error-icon" />
                                @_orgError
                            </p>
                        }
                        else
                        {
                            <p class="simf-field__helper">@L["Account.Profile.OrganisationHint"]</p>
                        }
                    </div>

                    <SimfSelect TValue="string"
                                Label="@L["Account.Profile.Nationality"]"
                                Placeholder="@L["Account.Profile.NationalityPlaceholder"]"
                                Items="_countryCodes"
                                ValueFor="@(code => code)"
                                LabelFor="@(code => CountryLabel(code))"
                                Value="@_model.NationalityCode"
                                ValueChanged="@(v => _model.NationalityCode = v ?? string.Empty)"
                                Disabled="_saving" />

                    <SimfDatePicker Label="@L["Account.Profile.DateOfBirth"]"
                                    Value="@(_model.DateOfBirth?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                    ValueChanged="OnDateOfBirthChangedAsync"
                                    Disabled="_saving" />

                    <SimfTextField Label="@L["Account.Profile.PlaceOfBirth"]"
                                   @bind-Value="_model.PlaceOfBirth"
                                   Disabled="_saving" />

                    <SimfRadioGroup TValue="bool"
                                    Label="@L["Account.Profile.IsSaudi"]"
                                    Inline="true"
                                    Items="@(new[] { true, false })"
                                    ValueFor="@(b => b ? "true" : "false")"
                                    LabelFor="@(b => b ? L["Account.Profile.IsSaudi.Yes"] : L["Account.Profile.IsSaudi.No"])"
                                    Value="@_model.IsSaudi"
                                    ValueChanged="@(v => _model.IsSaudi = v)" />

                    @if (_model.IsSaudi)
                    {
                        <SimfTextField Label="@L["Account.Profile.NationalId"]"
                                       @bind-Value="_nationalIdInput"
                                       Helper="@L["Account.Profile.NationalIdHint"]"
                                       MaxLength="10" Numeric="true" Autocomplete="off"
                                       Disabled="_saving" />
                    }
                    else
                    {
                        <SimfTextField Label="@L["Account.Profile.Iqama"]"
                                       @bind-Value="_iqamaInput"
                                       Helper="@L["Account.Profile.IqamaHint"]"
                                       MaxLength="10" Numeric="true" Autocomplete="off"
                                       Disabled="_saving" />
                        <SimfTextField Label="@L["Account.Profile.Passport"]"
                                       @bind-Value="_passportInput"
                                       Helper="@L["Account.Profile.PassportHint"]"
                                       Autocomplete="off"
                                       Disabled="_saving" />
                    }

                    <SimfPhoneInput Label="@L["Account.Profile.SaudiMobile"]"
                                    Value="@(_model.SaudiMobile ?? string.Empty)"
                                    ValueChanged="@(v => _model.SaudiMobile = string.IsNullOrWhiteSpace(v) ? null : v)"
                                    Disabled="_saving" />

                    <SimfPhoneInput Label="@L["Account.Profile.IntlMobile"]"
                                    Value="@(_model.InternationalMobile ?? string.Empty)"
                                    ValueChanged="@(v => _model.InternationalMobile = string.IsNullOrWhiteSpace(v) ? null : v)"
                                    Disabled="_saving" />

                    @* P9 — Interests (الاهتمامات): 1-10 picked from the
                       admin-managed lookup. The Save button validates the
                       count server-side; the helper text tells the user. *@
                    @if (_interests.Length == 0)
                    {
                        <SimfAlert Variant="info">@L["Account.Profile.Interests.Empty"]</SimfAlert>
                    }
                    else
                    {
                        <SimfCheckList TItem="InterestDto"
                                       Label="@L["Account.Profile.Interests.Title"]"
                                       Helper="@L["Account.Profile.Interests.Hint"]"
                                       Inline="true"
                                       Items="_interests"
                                       ValueFor="@(item => item.Id.ToString())"
                                       LabelFor="@(item => InterestLabel(item))"
                                       Values="_selectedInterests"
                                       ValuesChanged="OnInterestsChanged"
                                       Disabled="_saving" />
                    }
                </div>

                <div class="simf-form__actions">
                    <SimfButton Loading="_saving"
                                LoadingLabel="@L["Account.Profile.Submitting"]">
                        @L["Account.Profile.Submit"]
                    </SimfButton>
                </div>
            </EditForm>
        </section>

        @* ID image card. *@
        <section class="simf-card simf-page-card">
            <h2 class="simf-card__title">@L["Account.Profile.IdImageTitle"]</h2>
            <p class="simf-card__supporting">@L["Account.Profile.IdImageSupporting"]</p>

            @if (_response.HasIdImage)
            {
                <SimfAlert Variant="success">@L["Account.Profile.IdImageOnFile"]</SimfAlert>
            }
            @if (_idImageError is not null)
            {
                <SimfAlert Variant="error">@_idImageError</SimfAlert>
            }
            @if (_idImageSuccess)
            {
                <SimfAlert Variant="success">@L["Account.Profile.IdImageUpdated"]</SimfAlert>
            }

            <SimfFileUpload Label="@L["Account.Profile.IdImagePicker"]"
                            Helper="@L["Account.Profile.IdImageHint"]"
                            Accept="image/png,image/jpeg,image/webp"
                            Disabled="_uploadingIdImage"
                            @ref="_idImagePicker" />
            <div class="simf-form__actions">
                <SimfButton Type="button"
                            Loading="_uploadingIdImage"
                            LoadingLabel="@L["Account.Profile.IdImageUploading"]"
                            OnClick="UploadIdImageAsync">
                    @L["Account.Profile.IdImageUpload"]
                </SimfButton>
            </div>
        </section>
    }
</div>
