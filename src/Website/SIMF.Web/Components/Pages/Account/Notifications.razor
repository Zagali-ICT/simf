@* Website — full notification list page (P12 — D-053). The bell links
   here via "View all". Mark-read on click, delete on the row action. *@
@page "/account/notifications"
@rendermode AppRenderMode.InteractiveServerNoPrerender
@attribute [Authorize]

<PageTitle>@L["Account.Notifications.Title"]</PageTitle>

<div class="simf-account-page">
    <header class="simf-account-page__head">
        <h1 class="simf-account-page__title">@L["Account.Notifications.Title"]</h1>
    </header>

    <div class="simf-surface">
        @if (_toast is not null)
        {
            <SimfAlert Variant="@_toast.Variant">@_toast.Message</SimfAlert>
        }

        <SimfDataGrid TItem="NotificationDto"
                      Query="_query"
                      Page="_page"
                      Loading="_loading"
                      OnQueryChanged="OnQueryChangedAsync"
                      OnDeleteOne="OnDeleteAsync"
                      Caption="@L["Account.Notifications.Title"]"
                      FilterColumnLabel="@L["Account.Notifications.FilterColumn"]"
                      PrevLabel="@L["Account.Notifications.Prev"]"
                      NextLabel="@L["Account.Notifications.Next"]"
                      LoadingLabel="@L["Account.Notifications.Loading"]"
                      FilterPlaceholder="@L["Account.Notifications.FilterPlaceholder"]"
                      ActionsHeader="@L["Account.Notifications.Column.Actions"]"
                      DeleteLabel="@L["Account.Notifications.Action.Delete"]"
                      SummaryFormatter="@FormatSummary">
            <Columns>
                <SimfDataGridColumn TItem="NotificationDto" Key="title"
                                    Header="@L["Account.Notifications.Column.Title"]">
                    <CellTemplate>
                        <strong>@TitleFor(context)</strong>
                        @if (context.ReadAt is null)
                        {
                            <SimfPill Variant="admin">@L["Account.Notifications.New"]</SimfPill>
                        }
                    </CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="NotificationDto" Key="body"
                                    Header="@L["Account.Notifications.Column.Body"]">
                    <CellTemplate>@BodyFor(context)</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="NotificationDto" Key="severity"
                                    Header="@L["Account.Notifications.Column.Severity"]">
                    <CellTemplate>@context.Severity</CellTemplate>
                </SimfDataGridColumn>
                <SimfDataGridColumn TItem="NotificationDto" Key="createdAt"
                                    Header="@L["Account.Notifications.Column.CreatedAt"]">
                    <CellTemplate>@context.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</CellTemplate>
                </SimfDataGridColumn>
            </Columns>
        </SimfDataGrid>

        <div class="simf-form__actions">
            <SimfButton Type="button" Variant="secondary" OnClick="MarkAllReadAsync">
                @L["Account.Notifications.MarkAllRead"]
            </SimfButton>
        </div>
    </div>
</div>
