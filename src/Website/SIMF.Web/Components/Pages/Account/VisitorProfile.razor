@* Visitor self-service profile — assembles the D-044(c) Simf* primitives
   on top of the D-046(b) backend (decision D-046 c). Closes myComment #18
   end-to-end: the visitor signs in, lands here, fills the form, uploads
   their ID, sees the QR code their account was minted with on Approval
   (D-046 a). *@
@page "/account/visitor-profile"
@rendermode AppRenderMode.InteractiveServerNoPrerender
@attribute [Authorize]
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@L["Visitor.Profile.Title"]</PageTitle>

<div class="simf-account-page">
    <header class="simf-account-page__head">
        <h1 class="simf-account-page__title">@L["Visitor.Profile.Title"]</h1>
        <SimfButton Type="button" Variant="secondary"
                    OnClick="SignOutAsync">@L["Visitor.Profile.SignOut"]</SimfButton>
    </header>

    @if (_loadError is not null)
    {
        <SimfAlert Variant="error">@_loadError</SimfAlert>
    }
    else if (_response is null)
    {
        <SimfAlert Variant="info">@L["Visitor.Profile.Loading"]</SimfAlert>
    }
    else
    {
        @* Saved-state notice. *@
        @if (_saveSuccess)
        {
            <SimfAlert Variant="success">@L["Visitor.Profile.Saved"]</SimfAlert>
        }
        @if (_saveError is not null)
        {
            <SimfAlert Variant="error">@_saveError</SimfAlert>
        }

        @* QR card. *@
        <section class="simf-card simf-page-card simf-qr-card">
            <h2 class="simf-card__title">@L["Visitor.Profile.QrTitle"]</h2>
            @if (!string.IsNullOrEmpty(_response.QrId))
            {
                <p class="simf-card__supporting">@L["Visitor.Profile.QrSupporting"]</p>
                <div class="simf-qr">@((MarkupString)_qrSvg)</div>
                <p class="simf-totp-secret">@_response.QrId</p>
            }
            else
            {
                <SimfAlert Variant="info">@L["Visitor.Profile.QrPending"]</SimfAlert>
            }
        </section>

        @* Form. *@
        <section class="simf-card simf-page-card">
            <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
                <div class="simf-form__fields">
                    <SimfRadioGroup TValue="string"
                                    Label="@L["Visitor.Profile.Type"]"
                                    Inline="true"
                                    Items="_visitorTypes"
                                    ValueFor="@(item => item)"
                                    LabelFor="@(item => L[$"Visitor.Profile.Type.{item}"])"
                                    Value="@_model.VisitorType"
                                    ValueChanged="@(v => _model.VisitorType = v ?? "Visitor")" />

                    <SimfTextField Label="@L["Visitor.Profile.ArabicName"]"
                                   @bind-Value="_model.ArabicName"
                                   Disabled="_saving" />

                    <SimfTextField Label="@L["Visitor.Profile.EnglishName"]"
                                   @bind-Value="_model.EnglishName"
                                   Helper="@L["Visitor.Profile.EnglishNameHint"]"
                                   Disabled="_saving" />

                    <SimfSelect TValue="string"
                                Label="@L["Visitor.Profile.Nationality"]"
                                Placeholder="@L["Visitor.Profile.NationalityPlaceholder"]"
                                Items="_countryCodes"
                                ValueFor="@(code => code)"
                                LabelFor="@(code => CountryLabel(code))"
                                Value="@_model.NationalityCode"
                                ValueChanged="@(v => _model.NationalityCode = v ?? string.Empty)"
                                Disabled="_saving" />

                    <SimfDatePicker Label="@L["Visitor.Profile.DateOfBirth"]"
                                    Value="@(_model.DateOfBirth?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                    ValueChanged="OnDateOfBirthChangedAsync"
                                    Disabled="_saving" />

                    <SimfTextField Label="@L["Visitor.Profile.PlaceOfBirth"]"
                                   @bind-Value="_model.PlaceOfBirth"
                                   Disabled="_saving" />

                    <SimfRadioGroup TValue="bool"
                                    Label="@L["Visitor.Profile.IsSaudi"]"
                                    Inline="true"
                                    Items="@(new[] { true, false })"
                                    ValueFor="@(b => b ? "true" : "false")"
                                    LabelFor="@(b => b ? L["Visitor.Profile.IsSaudi.Yes"] : L["Visitor.Profile.IsSaudi.No"])"
                                    Value="@_model.IsSaudi"
                                    ValueChanged="@(v => _model.IsSaudi = v)" />

                    @if (_model.IsSaudi)
                    {
                        <SimfTextField Label="@L["Visitor.Profile.NationalId"]"
                                       @bind-Value="_nationalIdInput"
                                       Helper="@L["Visitor.Profile.NationalIdHint"]"
                                       Disabled="_saving" />
                    }
                    else
                    {
                        <SimfTextField Label="@L["Visitor.Profile.Iqama"]"
                                       @bind-Value="_iqamaInput"
                                       Helper="@L["Visitor.Profile.IqamaHint"]"
                                       Disabled="_saving" />
                        <SimfTextField Label="@L["Visitor.Profile.Passport"]"
                                       @bind-Value="_passportInput"
                                       Helper="@L["Visitor.Profile.PassportHint"]"
                                       Disabled="_saving" />
                    }

                    <SimfPhoneInput Label="@L["Visitor.Profile.SaudiMobile"]"
                                    Value="@(_model.SaudiMobile ?? string.Empty)"
                                    ValueChanged="@(v => _model.SaudiMobile = string.IsNullOrWhiteSpace(v) ? null : v)"
                                    Disabled="_saving" />

                    <SimfPhoneInput Label="@L["Visitor.Profile.IntlMobile"]"
                                    Value="@(_model.InternationalMobile ?? string.Empty)"
                                    ValueChanged="@(v => _model.InternationalMobile = string.IsNullOrWhiteSpace(v) ? null : v)"
                                    Disabled="_saving" />
                </div>

                <div class="simf-form__actions">
                    <SimfButton Loading="_saving"
                                LoadingLabel="@L["Visitor.Profile.Submitting"]">
                        @L["Visitor.Profile.Submit"]
                    </SimfButton>
                </div>
            </EditForm>
        </section>

        @* ID image card. *@
        <section class="simf-card simf-page-card">
            <h2 class="simf-card__title">@L["Visitor.Profile.IdImageTitle"]</h2>
            <p class="simf-card__supporting">@L["Visitor.Profile.IdImageSupporting"]</p>

            @if (_response.HasIdImage)
            {
                <SimfAlert Variant="success">@L["Visitor.Profile.IdImageOnFile"]</SimfAlert>
            }
            @if (_idImageError is not null)
            {
                <SimfAlert Variant="error">@_idImageError</SimfAlert>
            }
            @if (_idImageSuccess)
            {
                <SimfAlert Variant="success">@L["Visitor.Profile.IdImageUpdated"]</SimfAlert>
            }

            <SimfFileUpload Label="@L["Visitor.Profile.IdImagePicker"]"
                            Helper="@L["Visitor.Profile.IdImageHint"]"
                            Accept="image/png,image/jpeg,image/webp"
                            Disabled="_uploadingIdImage"
                            @ref="_idImagePicker" />
            <div class="simf-form__actions">
                <SimfButton Type="button"
                            Loading="_uploadingIdImage"
                            LoadingLabel="@L["Visitor.Profile.IdImageUploading"]"
                            OnClick="UploadIdImageAsync">
                    @L["Visitor.Profile.IdImageUpload"]
                </SimfButton>
            </div>
        </section>
    }
</div>

@code {
    private VisitorProfileResponse? _response;
    private string _qrSvg = string.Empty;
    private string[] _countryCodes = Array.Empty<string>();
    private Dictionary<string, CountryDto> _countriesByCode = new();
    private readonly string[] _visitorTypes = { "Visitor", "Exhibitor", "Press" };

    private readonly UpsertVisitorProfileRequest _model = new();
    private string _nationalIdInput = string.Empty;
    private string _iqamaInput = string.Empty;
    private string _passportInput = string.Empty;

    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private bool _saving;
    private bool _saveSuccess;
    private string? _saveError;
    private string? _loadError;

    private SimfFileUpload? _idImagePicker;
    private bool _uploadingIdImage;
    private bool _idImageSuccess;
    private string? _idImageError;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
        _messages = new ValidationMessageStore(_editContext);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            // Two parallel fetches — the page can't render without both.
            var profileTask = JS.InvokeAsync<ApiResult<VisitorProfileResponse>>(
                "simfAccount.getJson", "/account/api/visitor-profile").AsTask();
            var countriesTask = JS.InvokeAsync<ApiResult<CountryListResponse>>(
                "simfAccount.getJson", "/account/api/visitor-profile/countries").AsTask();
            await Task.WhenAll(profileTask, countriesTask);

            var profileEnvelope = await profileTask;
            var countriesEnvelope = await countriesTask;

            if (profileEnvelope is null || !profileEnvelope.Success || profileEnvelope.Data is null
                || countriesEnvelope is null || !countriesEnvelope.Success || countriesEnvelope.Data is null)
            {
                _loadError = profileEnvelope?.Error?.MessageForCurrentCulture()
                    ?? countriesEnvelope?.Error?.MessageForCurrentCulture()
                    ?? L["Visitor.Profile.LoadFailed"];
                StateHasChanged();
                return;
            }

            _response = profileEnvelope.Data;
            _countriesByCode = countriesEnvelope.Data.Countries.ToDictionary(c => c.Code);
            _countryCodes = countriesEnvelope.Data.Countries.Select(c => c.Code).ToArray();

            _model.VisitorType = _response.VisitorType;
            _model.ArabicName = _response.ArabicName;
            _model.EnglishName = _response.EnglishName;
            _model.NationalityCode = _response.NationalityCode;
            _model.DateOfBirth = _response.DateOfBirth;
            _model.PlaceOfBirth = _response.PlaceOfBirth;
            _model.IsSaudi = _response.IsSaudi;
            _nationalIdInput = _response.NationalId ?? string.Empty;
            _iqamaInput = _response.IqamaNumber ?? string.Empty;
            _passportInput = _response.PassportNumber ?? string.Empty;
            _model.SaudiMobile = _response.SaudiMobile;
            _model.InternationalMobile = _response.InternationalMobile;

            if (!string.IsNullOrEmpty(_response.QrId))
            {
                _qrSvg = BuildQrSvg(_response.QrId);
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _loadError = $"{L["Visitor.Profile.LoadFailed"]} ({ex.Message})";
            StateHasChanged();
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (_saving) return;
        _messages.Clear();
        _saveSuccess = false;
        _saveError = null;

        // Map the conditional ID fields back into the request shape — the
        // API normalises NationalId / Iqama / Passport against IsSaudi but
        // sending the right field upfront keeps the audit-log detail clean.
        _model.NationalId = _model.IsSaudi
            ? (string.IsNullOrWhiteSpace(_nationalIdInput) ? null : _nationalIdInput.Trim())
            : null;
        _model.IqamaNumber = !_model.IsSaudi
            ? (string.IsNullOrWhiteSpace(_iqamaInput) ? null : _iqamaInput.Trim())
            : null;
        _model.PassportNumber = !_model.IsSaudi
            ? (string.IsNullOrWhiteSpace(_passportInput) ? null : _passportInput.Trim())
            : null;

        _saving = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<VisitorProfileResponse>>(
                "simfAccount.postJson", "/account/api/visitor-profile", _model);
            if (envelope is { Success: true, Data: not null })
            {
                _response = envelope.Data;
                _saveSuccess = true;
                if (!string.IsNullOrEmpty(envelope.Data.QrId))
                {
                    _qrSvg = BuildQrSvg(envelope.Data.QrId);
                }
            }
            else
            {
                _saveError = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Visitor.Profile.Fallback"];
            }
        }
        finally { _saving = false; }
    }

    private Task OnDateOfBirthChangedAsync(string value)
    {
        _model.DateOfBirth = DateOnly.TryParse(value, out var parsed) ? parsed : null;
        return Task.CompletedTask;
    }

    private async Task UploadIdImageAsync()
    {
        if (_uploadingIdImage || _idImagePicker is null) return;
        _idImageError = null;
        _idImageSuccess = false;
        _uploadingIdImage = true;
        try
        {
            var envelope = await JS.InvokeAsync<ApiResult<bool>>(
                "simfAccount.uploadFile",
                "/account/api/visitor-profile/id-image",
                _idImagePicker.ElementId);
            if (envelope is { Success: true })
            {
                _idImageSuccess = true;
                if (_response is not null)
                {
                    _response.HasIdImage = true;
                }
            }
            else
            {
                _idImageError = envelope?.Error?.MessageForCurrentCulture()
                    ?? L["Visitor.Profile.IdImageFallback"];
            }
        }
        finally { _uploadingIdImage = false; }
    }

    private async Task SignOutAsync() =>
        await JS.InvokeVoidAsync("simfAccount.signOut");

    private string CountryLabel(string code)
    {
        if (!_countriesByCode.TryGetValue(code, out var country)) return code;
        var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
        return isArabic ? country.NameAr : country.NameEn;
    }

    private static string BuildQrSvg(string qrId)
    {
        // Server-side SVG QR via QRCoder — no client dependency, ships in
        // the SignalR diff as plain markup.
        using var generator = new QRCoder.QRCodeGenerator();
        using var data = generator.CreateQrCode(qrId, QRCoder.QRCodeGenerator.ECCLevel.Q);
        var svg = new QRCoder.SvgQRCode(data);
        return svg.GetGraphic(4);
    }
}
