@* Website — the second factor: a 6-digit code emailed to the visitor. Reached
   only from the sign-in step when the account has TwoFactorEnabled=true. *@
@page "/login/verify"
@rendermode AppRenderMode.InteractiveServerNoPrerender

<PageTitle>@L["Auth.PageTitle.Verify"]</PageTitle>

@if (Session.PendingOtpToken is not null)
{
    <SimfAuthLayout>
        <Brand>
            <SimfBrandPanel AltText="@L["Brand.LogoAlt"]" Subtitle="@L["Brand.Subtitle"]" Caption="@L["Brand.Caption"]" />
        </Brand>
        <ChildContent>
            <SimfAuthCard Title="@L["Auth.Verify.Title"]"
                          SupportingText="@L["Auth.Verify.Supporting"]"
                          Wide="true">
                <TopControls>
                    <SimfLanguageSwitch Label="@L["Auth.LanguageSwitch"]" />
                    <SimfThemeToggle />
                </TopControls>
                <ChildContent>
                    <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" class="simf-form">
                        @if (_error is not null)
                        {
                            <SimfAlert Variant="error">@_error</SimfAlert>
                        }
                        else if (Session.PendingEmail is not null)
                        {
                            <SimfAlert Variant="info">
                                @string.Format(L["Auth.Verify.CodeSentTo"], SimfAuthSession.MaskEmail(Session.PendingEmail))
                            </SimfAlert>
                        }
                        <div class="simf-form__fields">
                            <SimfCodeField Label="@L["Auth.Verify.Code"]" @bind-Value="_model.Code"
                                           Helper="@L["Auth.Verify.CodeFormat"]" Disabled="_loading" />
                        </div>
                        <div class="simf-form__actions">
                            <SimfButton Block="true" Loading="_loading" LoadingLabel="@L["Auth.Verify.Submitting"]">
                                @L["Auth.Verify.Submit"]
                            </SimfButton>
                        </div>
                        <div class="simf-form__secondary">
                            <SimfLink Href="/login">@L["Auth.Verify.BackToSignIn"]</SimfLink>
                        </div>
                    </EditForm>
                </ChildContent>
                <Footer>@L["Auth.Footer"]</Footer>
            </SimfAuthCard>
        </ChildContent>
    </SimfAuthLayout>
}
