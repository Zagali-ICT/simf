@* Website — public programme / agenda page (D-199, Mockup page 16 "Agenda").
   A static-SSR public read over the ANONYMOUS backend: on load it fetches the
   published sessions and groups them by the local calendar date of StartUtc
   into day sections. Each row shows the bilingual title, hall, the local time
   window and — when the primary theme carries a name — a neutral theme pill.
   An optional speakers strip is shown when GET /speakers returns rows.
   Bilingual throughout via L[...] with the Arabic-preferred-then-English
   fallback for the *Arabic fields. *@
@page "/programme"
@using SIMF.Contracts.Programme

<PageTitle>@L["Programme.PageTitle"]</PageTitle>

<div class="simf-account-page">
    <SimfBanner Title="@L["Programme.Banner.Title"]" Subtitle="@L["Programme.Banner.Subtitle"]" />

    @if (_error)
    {
        <SimfAlert Variant="error">@L["Programme.Error"]</SimfAlert>
    }
    else if (_days.Count == 0)
    {
        <SimfEmptyState Title="@L["Programme.Empty.Title"]"
                        Description="@L["Programme.Empty.Text"]" />
    }
    else
    {
        @foreach (var day in _days)
        {
            <section class="simf-card simf-page-card" aria-label="@day.Heading">
                <h2 class="simf-card__title">@day.Heading</h2>
                <ul class="simf-role-list">
                    @foreach (var session in day.Sessions)
                    {
                        <li>
                            <p class="simf-card__supporting">@TimeWindow(session) — @Title(session)</p>
                            <p class="simf-card__supporting">@Hall(session)</p>
                            @if (!string.IsNullOrWhiteSpace(session.PrimaryThemeName)
                                 || !string.IsNullOrWhiteSpace(session.PrimaryThemeNameArabic))
                            {
                                <SimfPill Variant="neutral">@ThemeName(session)</SimfPill>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    }

    @if (_speakers.Count > 0)
    {
        <section class="simf-card simf-page-card" aria-label="@L["Programme.Speakers.Title"]">
            <h2 class="simf-card__title">@L["Programme.Speakers.Title"]</h2>
            <ul class="simf-role-list">
                @foreach (var speaker in _speakers)
                {
                    <li>
                        <span class="simf-card__supporting">@SpeakerName(speaker)</span>
                        @if (!string.IsNullOrWhiteSpace(speaker.Rank))
                        {
                            <SimfPill Variant="neutral">@speaker.Rank</SimfPill>
                        }
                    </li>
                }
            </ul>
        </section>
    }
</div>
