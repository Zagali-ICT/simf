@* Website — the post-sign-in landing placeholder. The public site content is a
   later increment; this confirms the sign-in and offers sign-out. An
   unauthenticated visitor is sent to the sign-in page. *@
@page "/"
@rendermode InteractiveServer
@inject SimfAuthClient Api
@inject SimfAuthSession Session
@inject NavigationManager Nav

<PageTitle>Saudi International Maritime Forum</PageTitle>

@if (Session.IsSignedIn)
{
    <SimfSignedInLanding Title="You're signed in"
                         Text="Your SIMF account is ready. The forum experience is being prepared.">
        <SimfButton Type="button" Disabled="true">Continue</SimfButton>
        <SimfButton Variant="secondary" Type="button" Loading="_signingOut"
                    LoadingLabel="Signing out" OnClick="SignOutAsync">
            Sign out
        </SimfButton>
    </SimfSignedInLanding>
}

@code {
    private bool _signingOut;

    protected override void OnInitialized()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task SignOutAsync()
    {
        _signingOut = true;
        var accessToken = Session.Tokens?.AccessToken;
        if (accessToken is not null)
        {
            await Api.SignOutAsync(accessToken);
        }
        Session.Clear();
        Nav.NavigateTo("/login");
    }
}
