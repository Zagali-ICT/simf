<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Nullable, ImplicitUsings and TreatWarningsAsErrors come from Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\SIMF.ApiClient\SIMF.ApiClient.csproj" />
    <ProjectReference Include="..\..\Shared\SIMF.Common\SIMF.Common.csproj" />
    <ProjectReference Include="..\..\Shared\SIMF.Components\SIMF.Components.csproj" />
    <ProjectReference Include="..\..\Shared\SIMF.Contracts\SIMF.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-774 — QRCoder (the /account/profile visitor QR) and
         System.IdentityModel.Tokens.Jwt (the /auth/complete claim decode) went
         with the removed login/account area; the public site has no caller left
         for either, so neither ships with the Website any more. -->
    <!-- P6: per-project log files under {Storage:LogDirectory}/SIMF.Web/ -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
